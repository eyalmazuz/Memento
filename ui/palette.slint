// Memento Unified Dark Theme Palette
// Single source of truth for design tokens across Settings, Anki Help, Player, and Popup UI.

export global MementoPalette {
    // Kept exported for compatibility with existing bindings
    in-out property <string> scheme: "dark";
    out property <bool> dark: scheme == "dark";

    // Surface hierarchy (deep -> elevated)
    out property <color> window-bg:        #111215;
    out property <color> sidebar-bg:       #14161B;
    out property <color> card-inset:       #14171D;
    out property <color> surface-bg:       #17191E;
    out property <color> card-bg:          #1C1F26;
    out property <color> surface-elevated: #22262F;
    out property <color> osc-bg:           #141418EE;
    out property <color> hover-bg:         #262A34;
    out property <color> active-bg:        #2E3440;
    out property <color> scrim:            #000000A8;
    out property <color> shadow:           #000000CC;
    out property <color> tooltip-bg:       #0E1015;

    // Interactive control surfaces
    out property <color> button-bg:        #1F242E;
    out property <color> button-hover:     #29303D;
    out property <color> button-pressed:   #323B4B;
    out property <color> track-bg:         #2B313E;
    out property <color> checker-dark:     #1A1E24;
    out property <color> checker-light:    #363E4A;

    // Typography & SVG icon tinting
    out property <color> text:             #F8FAFC;
    out property <color> text-secondary:   #94A3B8;
    out property <color> text-muted:       #64748B;
    out property <color> icon:             #E2E8F0;
    out property <color> icon-muted:       #94A3B8;

    // Borders & dividers
    out property <color> border:           #262A34;
    out property <color> card-border:      #2A2F3B;
    out property <color> border-light:     #363C4A;
    out property <color> focus-ring:       #38A3E5;

    // Brand accents
    out property <color> cyan-accent:        #38A3E5;
    out property <color> cyan-hover:         #60BAF5;
    out property <color> cyan-text:          #7DD3FC;
    out property <color> accent-muted:       #1A2C3D;
    out property <color> accent-muted-hover: #21384D;
    out property <color> accent-subtle:      #38A3E526;

    out property <color> teal-accent:      #0D8269;
    out property <color> teal-hover:       #109B87;
    out property <color> teal-pressed:     #0A6B5C;
    out property <color> teal-border:      #14B8A6;
    out property <color> teal-muted:       #0D826933;
    out property <color> teal-text:        #5EEAD4;

    // Semantic status colors
    out property <color> success:          #10B981;
    out property <color> success-bg:       #064E3B;
    out property <color> success-text:     #6EE7B7;
    out property <color> warning:          #EAB308;
    out property <color> warning-bg:       #422006;
    out property <color> warning-border:   #B45309;
    out property <color> warning-text:     #FDE68A;
    out property <color> danger:           #EF4444;
    out property <color> danger-hover:     #DC2626;
    out property <color> danger-pressed:   #B91C1C;
    out property <color> danger-bg:        #450A0A;
    out property <color> danger-text:      #FCA5A5;

    // Badges & tag colors (Yomitan popup)
    out property <color> badge-blue:        #1E3A8A;
    out property <color> badge-blue-text:   #93C5FD;
    out property <color> badge-green:       #064E3B;
    out property <color> badge-green-text:  #6EE7B7;
    out property <color> badge-purple:      #4C1D95;
    out property <color> badge-purple-text: #C4B5FD;

    // Subtitle list hover and selection
    out property <color> list-hover:     #222630;
    out property <color> list-selected:  #1E3A8A;
    out property <color> list-sel-text:  #FFFFFF;
    out property <color> list-sel-hover: #2563EB;
    out property <color> active-cue:     #10B981;
}
