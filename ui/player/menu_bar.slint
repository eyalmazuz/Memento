import { ScrollView } from "std-widgets.slint";
import { SubomiPalette } from "../palette.slint";
import { PlayerTrack } from "types.slint";

component MenuBarButton inherits Rectangle {
    in property <string> label;
    in property <int> menu-id;
    in property <length> item-width;
    in-out property <int> open-menu: -1;
    out property <bool> hovered: touch.has-hover;
    callback activity();
    callback interacted();

    width: root.item-width;
    height: 24px;
    border-radius: 5px;
    background: root.open-menu == root.menu-id
        ? SubomiPalette.active-bg
        : (touch.has-hover ? SubomiPalette.hover-bg : transparent);

    animate background { duration: 100ms; }

    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        font-size: 12px;
        font-weight: root.open-menu == root.menu-id ? 600 : 500;
        color: SubomiPalette.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if self.has-hover && root.open-menu >= 0 && root.open-menu != root.menu-id {
                root.open-menu = root.menu-id;
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.activity(); }
            else if event.kind == PointerEventKind.down { root.interacted(); }
        }
        clicked => {
            root.open-menu = root.open-menu == root.menu-id ? -1 : root.menu-id;
        }
    }
}

// ── Top Native Menu Bar ─────────────────────────────────────────────────
export component TopMenuBar inherits Rectangle {
    in-out property <int> open-menu: -1; // -1: none, 0: Media, 1: Audio, 2: Subtitle, 3: Tools, 4: Settings
    out property <bool> is-hovered:
        top-touch.has-hover || m0.hovered || m1.hovered
        || m2.hovered || m3.hovered || m4.hovered;
    callback activity();
    callback interacted();

    height: 30px;
    background: SubomiPalette.surface-bg;
    border-width: 1px;
    border-color: SubomiPalette.border;

    top-touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.activity(); }
            else if event.kind == PointerEventKind.down { root.interacted(); }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        spacing: 2px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            m0 := MenuBarButton {
                label: "Media";
                menu-id: 0;
                item-width: 56px;
                open-menu <=> root.open-menu;
                activity => { root.activity(); }
                interacted => { root.interacted(); }
            }
        }

        VerticalLayout {
            alignment: center;
            m1 := MenuBarButton {
                label: "Audio";
                menu-id: 1;
                item-width: 56px;
                open-menu <=> root.open-menu;
                activity => { root.activity(); }
                interacted => { root.interacted(); }
            }
        }

        VerticalLayout {
            alignment: center;
            m2 := MenuBarButton {
                label: "Subtitle";
                menu-id: 2;
                item-width: 66px;
                open-menu <=> root.open-menu;
                activity => { root.activity(); }
                interacted => { root.interacted(); }
            }
        }

        VerticalLayout {
            alignment: center;
            m3 := MenuBarButton {
                label: "Tools";
                menu-id: 3;
                item-width: 56px;
                open-menu <=> root.open-menu;
                activity => { root.activity(); }
                interacted => { root.interacted(); }
            }
        }

        VerticalLayout {
            alignment: center;
            m4 := MenuBarButton {
                label: "Settings";
                menu-id: 4;
                item-width: 68px;
                open-menu <=> root.open-menu;
                activity => { root.activity(); }
                interacted => { root.interacted(); }
            }
        }
    }
}

// ── Dropdown Menu Item ──────────────────────────────────────────────────
component DropdownItem inherits Rectangle {
    in property <string> text: "";
    in property <string> shortcut: "";
    in property <bool> checkable: false;
    in property <bool> reserve-check-gutter: false;
    in property <bool> checked: false;
    in property <bool> has-submenu: false;
    in property <bool> submenu-active: false;
    in property <bool> is-disabled: false;
    callback clicked();

    property <bool> show-gutter: root.checkable || root.reserve-check-gutter;
    property <length> left-pad: self.show-gutter ? 30px : 10px;
    property <length> arrow-w: root.has-submenu ? 12px : 0px;
    property <length> shortcut-w: root.shortcut != "" ? shortcut-lbl.preferred-width : 0px;
    property <length> right-reserve: 10px
        + self.arrow-w
        + (root.shortcut != "" ? (self.shortcut-w + (root.has-submenu ? 6px : 0px) + 8px) : (root.has-submenu ? 8px : 0px));

    height: 30px;
    border-radius: 5px;
    background: root.is-disabled
        ? transparent
        : (root.submenu-active
            ? SubomiPalette.active-bg
            : (touch.has-hover ? SubomiPalette.hover-bg : transparent));

    animate background { duration: 100ms; }

    Text {
        visible: root.show-gutter;
        x: 10px;
        y: 0px;
        width: 14px;
        height: parent.height;
        text: (root.checkable && root.checked) ? "✓" : "";
        font-size: 11px;
        font-weight: 700;
        color: SubomiPalette.cyan-accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: root.left-pad;
        y: 0px;
        width: max(0px, parent.width - root.left-pad - root.right-reserve);
        height: parent.height;
        text: root.text;
        font-size: 12px;
        color: root.is-disabled ? SubomiPalette.text-muted : SubomiPalette.text;
        vertical-alignment: center;
        overflow: elide;
    }

    shortcut-lbl := Text {
        visible: root.shortcut != "";
        x: parent.width - 10px - root.arrow-w - (root.has-submenu ? 6px : 0px) - self.preferred-width;
        y: 0px;
        height: parent.height;
        text: root.shortcut;
        font-size: 11px;
        color: SubomiPalette.text-muted;
        vertical-alignment: center;
    }

    Text {
        visible: root.has-submenu;
        x: parent.width - 10px - self.preferred-width;
        y: 0px;
        height: parent.height;
        text: root.has-submenu ? "›" : "";
        font-size: 14px;
        font-weight: 700;
        color: SubomiPalette.text-secondary;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: !root.is-disabled;
        mouse-cursor: root.is-disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ── Dropdown Menu Separator ─────────────────────────────────────────────
component DropdownSeparator inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 6px;
        y: 4px;
        width: parent.width - 12px;
        height: 1px;
        background: SubomiPalette.border;
    }
}

struct MenuActionRow {
    id: int,
    text: string,
    shortcut: string,
    checkable: bool,
    reserve-gutter: bool,
    checked: bool,
    has-submenu: bool,
    submenu-active: bool,
    is-disabled: bool,
    is-separator: bool,
    shown: bool,
}

// ── Dropdown Menus Overlay ──────────────────────────────────────────────
export component MenuDropdown inherits Rectangle {
    in property <int> menu-index: -1;
    in property <length> max-dropdown-height: 460px;
    in-out property <int> submenu-index: -1; // 0 Recent, 1 Size/Position, 2 Secondary, 3 Primary, 4 Anki profile, 5 Video Track
    property <length> submenu-anchor-y: 0px;
    in property <[PlayerTrack]> video-tracks: [];
    in property <[PlayerTrack]> audio-tracks: [];
    in property <[PlayerTrack]> subtitle-tracks: [];
    in property <[string]> recent-files: [];
    in property <[string]> recent-file-labels: [];
    in property <[string]> anki-profiles: [];
    in property <int> video-id: 0;
    in property <int> audio-id: 0;
    in property <int> primary-sid: 0;
    in property <int> secondary-sid: 0;
    in property <string> anki-profile: "";
    in property <bool> anki-enabled: false;
    in property <bool> asr-enabled: false;
    in property <bool> furigana-enabled: false;
    in property <bool> asr-running: false;
    in property <bool> asr-track-selected: false;
    in property <bool> ocr-enabled: false;
    in property <bool> auto-pause: false;
    in property <bool> subtitles-visible: true;
    in property <bool> furigana-visible: false;
    in property <bool> dict-search-open: false;
    in property <bool> sub-drawer-open: false;
    in property <bool> can-increase-sub-size: true;
    in property <bool> can-decrease-sub-size: true;
    in property <bool> can-move-sub-up: true;
    in property <bool> can-move-sub-down: true;
    in property <string> key-open-file: "";
    in property <string> key-open-url: "";
    in property <string> key-quit: "Ctrl+Q";
    in property <string> key-show-search: "";
    in property <string> key-show-sub-list: "";
    in property <string> key-start-ocr: "";
    in property <string> key-sub-auto-pause: "";
    in property <string> key-sub-show: "";
    in property <string> key-sub-furigana: "";
    in property <string> key-sub-increase-size: "";
    in property <string> key-sub-decrease-size: "";
    in property <string> key-sub-move-up: "";
    in property <string> key-sub-move-down: "";

    callback open-file();
    callback open-url();
    callback quit-app();
    callback add-subtitle();
    callback open-recent(string);
    callback clear-recent();
    callback select-video-track(int);
    callback select-audio-track(int);
    callback select-subtitle-track(int);
    callback select-secondary-subtitle-track(int);
    callback select-asr();
    callback auto-pause-changed(bool);
    callback adjust-subtitle-scale(float);
    callback adjust-subtitle-offset(float);
    callback subtitles-visible-changed(bool);
    callback furigana-visible-changed(bool);
    callback toggle-search();
    callback toggle-sub-drawer();
    callback start-ocr();
    callback open-options();
    callback open-config();
    callback check-updates();
    callback show-about();
    callback select-anki-profile(string);
    callback close-menu();

    changed menu-index => {
        root.submenu-index = -1;
        root.submenu-anchor-y = 0px;
    }

    function toggle-submenu(id: int, item-y: length) {
        if root.submenu-index == id {
            root.submenu-index = -1;
        } else {
            root.submenu-anchor-y = item-y + 6px + menu-scroll.viewport-y;
            root.submenu-index = id;
        }
    }

    function dispatch-action(action-id: int, item-y: length) {
        if action-id == 1 { root.open-file(); root.close-menu(); }
        else if action-id == 2 { root.open-url(); root.close-menu(); }
        else if action-id == 3 { root.toggle-submenu(0, item-y); }
        else if action-id == 4 { root.toggle-submenu(5, item-y); }
        else if action-id == 5 { root.close-menu(); root.quit-app(); }
        else if action-id == 10 { root.auto-pause-changed(!root.auto-pause); root.close-menu(); }
        else if action-id == 11 { root.toggle-submenu(1, item-y); }
        else if action-id == 12 { root.subtitles-visible-changed(!root.subtitles-visible); root.close-menu(); }
        else if action-id == 13 { root.furigana-visible-changed(!root.furigana-visible); root.close-menu(); }
        else if action-id == 14 { root.add-subtitle(); root.close-menu(); }
        else if action-id == 15 { root.toggle-submenu(3, item-y); }
        else if action-id == 16 { root.toggle-submenu(2, item-y); }
        else if action-id == 20 { root.toggle-search(); root.close-menu(); }
        else if action-id == 21 { root.toggle-sub-drawer(); root.close-menu(); }
        else if action-id == 22 { root.start-ocr(); root.close-menu(); }
        else if action-id == 30 { root.toggle-submenu(4, item-y); }
        else if action-id == 31 { root.open-options(); root.close-menu(); }
        else if action-id == 32 { root.open-config(); root.close-menu(); }
        else if action-id == 33 { root.check-updates(); root.close-menu(); }
        else if action-id == 34 { root.show-about(); root.close-menu(); }
        else if action-id == 40 { root.adjust-subtitle-scale(0.005); root.close-menu(); }
        else if action-id == 41 { root.adjust-subtitle-scale(-0.005); root.close-menu(); }
        else if action-id == 42 { root.adjust-subtitle-offset(0.005); root.close-menu(); }
        else if action-id == 43 { root.adjust-subtitle-offset(-0.005); root.close-menu(); }
    }

    property <[MenuActionRow]> media-menu-rows: [
        { id: 1, text: "Open File…", shortcut: root.key-open-file, shown: true },
        { id: 2, text: "Open URL…", shortcut: root.key-open-url, shown: true },
        { id: 3, text: "Recent", has-submenu: true, submenu-active: root.submenu-index == 0, is-disabled: root.recent-files.length == 0, shown: true },
        { id: 0, is-separator: true, shown: true },
        { id: 4, text: "Video Track", has-submenu: true, submenu-active: root.submenu-index == 5, is-disabled: root.video-tracks.length == 0, shown: true },
        { id: 0, is-separator: true, shown: true },
        { id: 5, text: "Quit", shortcut: root.key-quit, shown: true },
    ];
    property <[MenuActionRow]> subtitle-menu-rows: [
        { id: 10, text: "Auto Pause", shortcut: root.key-sub-auto-pause, checkable: true, reserve-gutter: true, checked: root.auto-pause, shown: true },
        { id: 11, text: "Size and Position", reserve-gutter: true, has-submenu: true, submenu-active: root.submenu-index == 1, shown: true },
        { id: 0, is-separator: true, shown: true },
        { id: 12, text: "Show Subtitles", shortcut: root.key-sub-show, checkable: true, reserve-gutter: true, checked: root.subtitles-visible, shown: true },
        { id: 13, text: "Show Furigana", shortcut: root.key-sub-furigana, checkable: true, reserve-gutter: true, checked: root.furigana-visible, shown: root.furigana-enabled },
        { id: 0, is-separator: true, shown: true },
        { id: 14, text: "Add Subtitle…", reserve-gutter: true, shown: true },
        { id: 15, text: "Primary Track", reserve-gutter: true, has-submenu: true, submenu-active: root.submenu-index == 3, shown: true },
        { id: 16, text: "Second Track", reserve-gutter: true, has-submenu: true, submenu-active: root.submenu-index == 2, shown: true },
    ];
    property <[MenuActionRow]> tools-menu-rows: [
        { id: 20, text: "Show Search", shortcut: root.key-show-search, checkable: true, reserve-gutter: true, checked: root.dict-search-open, shown: true },
        { id: 21, text: "Show Subtitle List", shortcut: root.key-show-sub-list, checkable: true, reserve-gutter: true, checked: root.sub-drawer-open, shown: true },
        { id: 22, text: "Start OCR", shortcut: root.key-start-ocr, reserve-gutter: true, shown: root.ocr-enabled },
    ];
    property <[MenuActionRow]> settings-menu-rows: [
        { id: 30, text: "Anki Profile", has-submenu: true, submenu-active: root.submenu-index == 4, shown: root.anki-enabled },
        { id: 31, text: "Options…", shortcut: "Ctrl+,", shown: true },
        { id: 32, text: "Open Config", shown: true },
        { id: 33, text: "Check for Updates", shown: true },
        { id: 0, is-separator: true, shown: true },
        { id: 34, text: "About Subomi", shown: true },
    ];
    property <[MenuActionRow]> active-menu-rows:
        root.menu-index == 0 ? root.media-menu-rows :
        root.menu-index == 2 ? root.subtitle-menu-rows :
        root.menu-index == 3 ? root.tools-menu-rows :
        root.menu-index == 4 ? root.settings-menu-rows : [];

    property <[PlayerTrack]> active-submenu-tracks:
        root.submenu-index == 5 ? root.video-tracks : root.subtitle-tracks;

    visible: root.menu-index >= 0;
    x: root.menu-index == 0 ? 8px :
       root.menu-index == 1 ? 66px :
       root.menu-index == 2 ? 124px :
       root.menu-index == 3 ? 192px : 250px;
    y: 30px;
    width: root.menu-index == 1 ? (root.audio-tracks.length > 0 ? 228px : 150px) :
           root.menu-index == 2 ? 236px :
           root.menu-index == 3 ? 196px : 210px;
    height: min(menu-content.preferred-height, max(120px, root.max-dropdown-height));
    background: SubomiPalette.surface-elevated;
    border-width: 1px;
    border-color: SubomiPalette.border-light;
    border-radius: 8px;
    drop-shadow-blur: 18px;
    drop-shadow-color: SubomiPalette.shadow;

    menu-scroll := ScrollView {
        width: parent.width;
        height: parent.height;

        menu-content := VerticalLayout {
            width: parent.width;
            padding: 6px;
            spacing: 0px;

            // Static menus (Media, Subtitle, Tools, Settings) via unified data-driven repeater
            if root.menu-index != 1 : VerticalLayout {
                spacing: 0px;
                for item in root.active-menu-rows : Rectangle {
                    visible: item.shown;
                    height: !item.shown ? 0px : (item.is-separator ? 11px : 32px);
                    background: transparent;

                    Rectangle {
                        visible: item.shown && item.is-separator;
                        x: 6px;
                        y: 5px;
                        width: parent.width - 12px;
                        height: 1px;
                        background: SubomiPalette.border;
                    }

                    DropdownItem {
                        visible: item.shown && !item.is-separator;
                        x: 0px;
                        y: 1px;
                        width: parent.width;
                        height: 30px;
                        text: item.text;
                        shortcut: item.shortcut;
                        checkable: item.checkable;
                        reserve-check-gutter: item.reserve-gutter;
                        checked: item.checked;
                        has-submenu: item.has-submenu;
                        submenu-active: item.submenu-active;
                        is-disabled: item.is-disabled;
                        clicked => { root.dispatch-action(item.id, parent.y); }
                    }
                }
            }

            // Audio tracks (bounded scroll list when many tracks exist)
            if root.menu-index == 1 : VerticalLayout {
                spacing: 2px;
                DropdownItem {
                    text: "None";
                    checkable: true;
                    checked: root.audio-id == 0;
                    clicked => { root.select-audio-track(0); root.close-menu(); }
                }
                for track[index] in root.audio-tracks : DropdownItem {
                    text: track.label;
                    checkable: true;
                    checked: track.id == root.audio-id;
                    clicked => { root.select-audio-track(track.id); root.close-menu(); }
                }
            }
        }
    }

    // Dynamic Submenu Flyout positioned cleanly from clicked row's anchor-y and clamped to viewport
    if root.submenu-index >= 0 : Rectangle {
        x: parent.width - 4px;
        y: max(0px, min(root.submenu-anchor-y, max(0px, root.max-dropdown-height - self.height)));
        width: root.submenu-index == 0 ? 380px : 260px;
        height: min(sub-content.preferred-height, max(120px, min(360px, root.max-dropdown-height)));
        background: SubomiPalette.surface-elevated;
        border-width: 1px;
        border-color: SubomiPalette.border-light;
        border-radius: 8px;
        drop-shadow-blur: 18px;
        drop-shadow-color: SubomiPalette.shadow;

        ScrollView {
            width: parent.width;
            height: parent.height;

            sub-content := VerticalLayout {
                width: parent.width;
                padding: 6px;
                spacing: 2px;

                // Recent Files (0) & Anki Profiles (4)
                if root.submenu-index == 0 || root.submenu-index == 4 : VerticalLayout {
                    spacing: 2px;
                    DropdownItem {
                        visible: root.submenu-index == 0 && root.recent-files.length == 0;
                        height: (root.submenu-index == 0 && root.recent-files.length == 0) ? 30px : 0px;
                        text: "No recent files";
                        is-disabled: true;
                    }
                    for entry[index] in (root.submenu-index == 0 ? root.recent-files : root.anki-profiles) : DropdownItem {
                        text: root.submenu-index == 0
                            ? (index < root.recent-file-labels.length && root.recent-file-labels[index] != ""
                                ? root.recent-file-labels[index]
                                : entry)
                            : entry;
                        checkable: root.submenu-index == 4;
                        checked: root.submenu-index == 4 && entry == root.anki-profile;
                        clicked => {
                            if root.submenu-index == 0 {
                                root.open-recent(entry);
                            } else {
                                root.select-anki-profile(entry);
                            }
                            root.close-menu();
                        }
                    }
                    if root.submenu-index == 0 : DropdownSeparator {}
                    if root.submenu-index == 0 : DropdownItem {
                        text: "Clear Recents";
                        clicked => { root.clear-recent(); root.close-menu(); }
                    }
                }

                // Subtitle Size and Position (1)
                if root.submenu-index == 1 : VerticalLayout {
                    spacing: 2px;
                    for item in [
                        { id: 40, text: "Increase Size", shortcut: root.key-sub-increase-size, is-disabled: !root.can-increase-sub-size },
                        { id: 41, text: "Decrease Size", shortcut: root.key-sub-decrease-size, is-disabled: !root.can-decrease-sub-size },
                        { id: 42, text: "Move Up", shortcut: root.key-sub-move-up, is-disabled: !root.can-move-sub-up },
                        { id: 43, text: "Move Down", shortcut: root.key-sub-move-down, is-disabled: !root.can-move-sub-down },
                    ] : DropdownItem {
                        text: item.text;
                        shortcut: item.shortcut;
                        is-disabled: item.is-disabled;
                        clicked => { root.dispatch-action(item.id, 0px); }
                    }
                }

                // Shared Track Selector (2: Secondary Sub, 3: Primary Sub, 5: Video Track)
                if root.submenu-index == 2 || root.submenu-index == 3 || root.submenu-index == 5 : VerticalLayout {
                    spacing: 2px;
                    DropdownItem {
                        text: "None";
                        checkable: true;
                        checked: root.submenu-index == 2
                            ? root.secondary-sid == 0
                            : (root.submenu-index == 3
                                ? (root.primary-sid == 0 && !root.asr-track-selected)
                                : root.video-id == 0);
                        clicked => {
                            if root.submenu-index == 2 { root.select-secondary-subtitle-track(0); }
                            else if root.submenu-index == 3 { root.select-subtitle-track(0); }
                            else { root.select-video-track(0); }
                            root.close-menu();
                        }
                    }
                    if root.submenu-index == 3 && root.asr-enabled : DropdownItem {
                        text: root.asr-running ? "ASR subtitles…" : "ASR subtitles";
                        checkable: true;
                        checked: root.asr-track-selected;
                        clicked => { root.select-asr(); root.close-menu(); }
                    }
                    for track[index] in root.active-submenu-tracks : DropdownItem {
                        property <bool> track-disabled: (root.submenu-index == 2 && track.id == root.primary-sid)
                            || (root.submenu-index == 3 && track.id == root.secondary-sid);
                        text: track.label;
                        checkable: true;
                        checked: root.submenu-index == 2
                            ? track.id == root.secondary-sid
                            : (root.submenu-index == 3
                                ? (track.id == root.primary-sid && !root.asr-track-selected)
                                : track.id == root.video-id);
                        is-disabled: self.track-disabled;
                        clicked => {
                            if !self.track-disabled {
                                if root.submenu-index == 2 { root.select-secondary-subtitle-track(track.id); }
                                else if root.submenu-index == 3 { root.select-subtitle-track(track.id); }
                                else { root.select-video-track(track.id); }
                                root.close-menu();
                            }
                        }
                    }
                }
            }
        }
    }
}
