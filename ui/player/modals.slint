import { LineEdit, ScrollView } from "std-widgets.slint";
import { SubomiPalette } from "../palette.slint";
import { ModalDialog } from "../components/modal.slint";
import { ChangelogSection } from "types.slint";

export component OpenUrlModal inherits ModalDialog {
    in-out property <string> url-text: "";
    in property <bool> dialog-enabled: true;
    callback submitted(string);

    public function focus-input() {
        url-line-edit.focus();
        url-line-edit.select-all();
    }

    title: "Open Stream";
    dialog-width: 440px;
    cancel-text: "Cancel";
    primary-text: "OK";
    primary-clicked => {
        root.submitted(root.url-text);
    }

    url-line-edit := LineEdit {
        enabled: root.dialog-enabled;
        placeholder-text: "Enter stream URL (https://…)";
        text <=> root.url-text;
        accepted(val) => {
            root.submitted(val);
        }
    }
}

export component AboutModal inherits ModalDialog {
    in property <string> app-version: "";
    in property <string> app-version-display: "";
    callback open-link(string);
    callback open-whats-new();

    title: "";
    dialog-width: 420px;
    primary-text: "Close";
    primary-clicked => { root.dismissed(); }

    VerticalLayout {
        spacing: 10px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 56px;
                    height: 56px;
                    source: @image-url("../../res/subomi.svg");
                    image-fit: contain;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "Subomi";
                    color: SubomiPalette.text;
                    font-size: 26px;
                    font-weight: 700;
                }
                Text {
                    text: root.app-version-display != "" ? root.app-version-display : ("Version " + root.app-version);
                    color: SubomiPalette.text-secondary;
                    font-size: 13px;
                }
            }
        }

        Text {
            text: "An mpv-based video player for studying Japanese";
            color: SubomiPalette.text;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: "Originally forked from ripose-jp/Memento";
            color: SubomiPalette.text-muted;
            horizontal-alignment: center;
            font-size: 12px;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 16px;

            Rectangle {
                width: site-lbl.preferred-width + 18px;
                height: 28px;
                border-radius: 6px;
                background: site-touch.has-hover ? SubomiPalette.hover-bg : transparent;
                animate background { duration: 100ms; }
                site-lbl := Text {
                    text: "Releases";
                    color: SubomiPalette.cyan-accent;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                site-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-link("https://github.com/eyalmazuz/Subomi/releases"); }
                }
            }

            Rectangle {
                width: gh-lbl.preferred-width + 18px;
                height: 28px;
                border-radius: 6px;
                background: gh-touch.has-hover ? SubomiPalette.hover-bg : transparent;
                animate background { duration: 100ms; }
                gh-lbl := Text {
                    text: "GitHub";
                    color: SubomiPalette.cyan-accent;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                gh-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-link("https://github.com/eyalmazuz/Subomi"); }
                }
            }

            Rectangle {
                width: wn-lbl.preferred-width + 18px;
                height: 28px;
                border-radius: 6px;
                background: wn-touch.has-hover ? SubomiPalette.hover-bg : transparent;
                animate background { duration: 100ms; }
                wn-lbl := Text {
                    text: "What's New";
                    color: SubomiPalette.cyan-accent;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                wn-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-whats-new(); }
                }
            }
        }
    }
}

export component WhatsNewModal inherits ModalDialog {
    in property <string> release-title: "What's New";
    in property <string> release-subtitle: "";
    in property <[ChangelogSection]> sections: [];
    in property <string> release-url: "https://github.com/eyalmazuz/Subomi/releases";
    callback open-link(string);

    title: root.release-title;
    dialog-width: 520px;
    primary-text: "Close";
    primary-clicked => { root.dismissed(); }

    VerticalLayout {
        spacing: 10px;

        if root.release-subtitle != "" : Text {
            text: root.release-subtitle;
            color: SubomiPalette.text-muted;
            font-size: 12px;
        }

        Rectangle {
            height: 1px;
            background: SubomiPalette.border;
        }

        ScrollView {
            height: min(max(120px, wn-content.preferred-height), 340px);
            viewport-width: self.width;

            wn-content := VerticalLayout {
                width: parent.width - 12px;
                padding-top: 2px;
                padding-bottom: 4px;
                padding-right: 4px;
                spacing: 12px;

                if root.sections.length == 0 : Text {
                    text: "No release notes are bundled in this build. Check GitHub Releases for the full changelog.";
                    color: SubomiPalette.text-secondary;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                for section in root.sections : VerticalLayout {
                    spacing: 5px;

                    Text {
                        text: section.heading;
                        color: SubomiPalette.cyan-accent;
                        font-size: 12.5px;
                        font-weight: 700;
                    }

                    for item in section.items : HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "•";
                            color: SubomiPalette.text-muted;
                            font-size: 13px;
                            vertical-alignment: top;
                        }

                        Text {
                            text: item;
                            color: SubomiPalette.text;
                            font-size: 13px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: SubomiPalette.border;
        }

        HorizontalLayout {
            alignment: start;

            Rectangle {
                width: notes-link-lbl.preferred-width + 14px;
                height: 26px;
                border-radius: 6px;
                background: notes-link-touch.has-hover ? SubomiPalette.hover-bg : transparent;
                animate background { duration: 100ms; }
                notes-link-lbl := Text {
                    text: "View full release notes on GitHub ↗";
                    color: SubomiPalette.cyan-accent;
                    font-size: 12.5px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                notes-link-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-link(root.release-url); }
                }
            }
        }
    }
}

export component NoDictionariesModal inherits ModalDialog {
    title: "No Dictionaries Installed";
    dialog-width: 440px;
    cancel-text: "Later";
    primary-text: "Open Dictionary Settings";

    VerticalLayout {
        spacing: 10px;

        Text {
            text: "Subomi needs at least one Yomitan dictionary (.zip) installed before hovering or searching words can display definitions.";
            color: SubomiPalette.text;
            font-size: 13px;
            wrap: word-wrap;
        }

        Text {
            text: "Open Options → Dictionaries to import Yomitan dictionary archives, or drag and drop .zip dictionary files into the Settings window at any time.";
            color: SubomiPalette.text-secondary;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
