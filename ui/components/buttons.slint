import { SubomiPalette } from "../palette.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> ghost: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    private property <bool> interactive: root.enabled && !root.loading;

    height: root.compact ? 28px : 32px;
    width: max(root.compact ? 32px : 72px, btn-lbl.preferred-width + (root.compact ? 18px : 26px));
    border-radius: 7px;
    opacity: root.enabled ? 1.0 : 0.45;
    border-width: 1px;
    border-color: root.danger
        ? (touch.has-hover && root.interactive ? SubomiPalette.danger-text : SubomiPalette.danger)
        : (root.primary
            ? (touch.has-hover && root.interactive ? SubomiPalette.teal-border : SubomiPalette.teal-hover)
            : (root.ghost
                ? (touch.has-hover && root.interactive ? SubomiPalette.border-light : transparent)
                : (touch.has-hover && root.interactive ? SubomiPalette.cyan-accent : SubomiPalette.border-light)));
    background: root.danger
        ? (touch.pressed && root.interactive
            ? SubomiPalette.danger-pressed
            : (touch.has-hover && root.interactive ? SubomiPalette.danger-hover : SubomiPalette.danger))
        : (root.primary
            ? (touch.pressed && root.interactive
                ? SubomiPalette.teal-pressed
                : (touch.has-hover && root.interactive ? SubomiPalette.teal-hover : SubomiPalette.teal-accent))
            : (root.ghost
                ? (touch.pressed && root.interactive
                    ? SubomiPalette.active-bg
                    : (touch.has-hover && root.interactive ? SubomiPalette.hover-bg : transparent))
                : (touch.pressed && root.interactive
                    ? SubomiPalette.button-pressed
                    : (touch.has-hover && root.interactive ? SubomiPalette.button-hover : SubomiPalette.button-bg))));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    btn-lbl := Text {
        text: root.text;
        color: (root.primary || root.danger) ? #FFFFFF : SubomiPalette.text;
        font-size: root.compact ? 12px : 12.5px;
        font-weight: (root.primary || root.danger) ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => {
            if root.interactive {
                root.clicked();
            }
        }
    }
}

export component TooltipActionButton inherits ActionButton {
    in property <string> tooltip: "";

    Rectangle {
        visible: root.tooltip != "" && root.hovered;
        x: (parent.width - self.width) / 2;
        y: -self.height - 6px;
        width: tip-lbl.preferred-width + 14px;
        height: 24px;
        border-radius: 5px;
        background: SubomiPalette.tooltip-bg;
        border-width: 1px;
        border-color: SubomiPalette.border-light;
        tip-lbl := Text {
            text: root.tooltip;
            color: SubomiPalette.tooltip-text;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: SubomiPalette.icon;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <length> size: 30px;
    in property <length> icon-size: 16px;
    in property <string> tooltip: "";
    in property <bool> tooltip-below: false;
    in property <bool> tooltip-align-right: false;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: 6px;
    border-width: 1px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: !root.enabled
        ? transparent
        : (touch.pressed
            ? (root.danger ? SubomiPalette.danger-bg : SubomiPalette.active-bg)
            : (root.active
                ? SubomiPalette.accent-muted
                : (touch.has-hover
                    ? (root.danger ? SubomiPalette.danger-bg : SubomiPalette.hover-bg)
                    : transparent)));
    border-color: !root.enabled
        ? transparent
        : (root.active
            ? SubomiPalette.cyan-accent
            : (touch.has-hover
                ? (root.danger ? SubomiPalette.danger : SubomiPalette.border-light)
                : transparent));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: !root.enabled
            ? SubomiPalette.text-muted
            : (root.danger ? SubomiPalette.danger : (root.active ? SubomiPalette.cyan-text : root.tint));
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }

    Rectangle {
        visible: root.tooltip != "" && touch.has-hover;
        x: root.tooltip-align-right
            ? parent.width - self.width
            : (parent.width - self.width) / 2;
        y: root.tooltip-below ? parent.height + 6px : -self.height - 6px;
        width: tip-lbl.preferred-width + 14px;
        height: 24px;
        border-radius: 5px;
        background: SubomiPalette.tooltip-bg;
        border-width: 1px;
        border-color: SubomiPalette.border-light;
        tip-lbl := Text {
            text: root.tooltip;
            color: SubomiPalette.tooltip-text;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component ToggleChip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> bold-text: false;
    in property <bool> italic-text: false;
    in property <bool> enabled: true;
    in property <string> tooltip: "";
    in property <bool> tooltip-below: false;
    in property <length> chip-width: 30px;
    callback clicked();

    width: root.chip-width;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    opacity: root.enabled ? 1.0 : 0.45;
    border-color: root.active
        ? SubomiPalette.teal-border
        : (chip-touch.has-hover && root.enabled ? SubomiPalette.cyan-accent : SubomiPalette.border-light);
    background: root.active
        ? (chip-touch.pressed && root.enabled ? SubomiPalette.teal-pressed : SubomiPalette.teal-accent)
        : (chip-touch.pressed && root.enabled
            ? SubomiPalette.button-pressed
            : (chip-touch.has-hover && root.enabled ? SubomiPalette.button-hover : SubomiPalette.surface-bg));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    Text {
        text: root.text;
        color: root.active ? #FFFFFF : SubomiPalette.text;
        font-size: 12.5px;
        font-weight: root.bold-text ? 700 : 600;
        font-italic: root.italic-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    chip-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }

    Rectangle {
        visible: root.tooltip != "" && chip-touch.has-hover;
        x: (parent.width - self.width) / 2;
        y: root.tooltip-below ? parent.height + 6px : -self.height - 6px;
        width: tip-lbl.preferred-width + 14px;
        height: 24px;
        border-radius: 5px;
        background: SubomiPalette.tooltip-bg;
        border-width: 1px;
        border-color: SubomiPalette.border-light;
        tip-lbl := Text {
            text: root.tooltip;
            color: SubomiPalette.tooltip-text;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 26px;
    width: chip-lbl.preferred-width + 22px;
    border-radius: 13px;
    border-width: 1px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.active
        ? (touch.pressed ? SubomiPalette.teal-pressed : SubomiPalette.teal-accent)
        : (touch.pressed
            ? SubomiPalette.button-pressed
            : (touch.has-hover && root.enabled ? SubomiPalette.hover-bg : SubomiPalette.card-bg));
    border-color: root.active
        ? SubomiPalette.teal-border
        : (touch.has-hover && root.enabled ? SubomiPalette.cyan-accent : SubomiPalette.border-light);

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    chip-lbl := Text {
        text: root.label;
        color: root.active ? #FFFFFF : SubomiPalette.text-secondary;
        font-size: 11.5px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

export component TabPill inherits Rectangle {
    in property <string> label;
    in property <string> badge: "";
    in property <bool> active: false;
    in property <bool> compact: false;
    callback clicked();

    height: root.compact ? 30px : 34px;
    width: pill-row.preferred-width;
    border-radius: 7px;
    border-width: 1px;
    background: root.active
        ? SubomiPalette.accent-muted
        : (touch.pressed
            ? SubomiPalette.active-bg
            : (touch.has-hover ? SubomiPalette.hover-bg : transparent));
    border-color: root.active
        ? SubomiPalette.cyan-accent
        : (touch.has-hover ? SubomiPalette.border-light : SubomiPalette.border);

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    pill-row := HorizontalLayout {
        padding-left: root.compact ? 12px : 14px;
        padding-right: root.compact ? 12px : 14px;
        spacing: root.badge != "" ? 7px : 0px;
        alignment: center;

        Text {
            text: root.label;
            color: root.active ? SubomiPalette.text : SubomiPalette.text-secondary;
            font-size: root.compact ? 12px : 13px;
            font-weight: root.active ? 700 : 600;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                visible: root.badge != "";
                height: root.badge != "" ? 18px : 0px;
                width: root.badge != "" ? max(22px, badge-lbl.preferred-width + 10px) : 0px;
                border-radius: 9px;
                background: root.active ? SubomiPalette.accent-subtle : SubomiPalette.track-bg;
                badge-lbl := Text {
                    text: root.badge;
                    color: root.active ? SubomiPalette.cyan-text : SubomiPalette.text-muted;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
