import { SubomiPalette } from "../palette.slint";
import { ActionButton } from "buttons.slint";

export component ModalDialog inherits Rectangle {
    in property <string> title;
    in property <color> title-color: SubomiPalette.text;
    in property <color> accent-border: SubomiPalette.border-light;
    in property <length> dialog-width: 460px;
    in property <bool> dismiss-on-backdrop: true;
    in property <string> cancel-text: "";
    in property <string> primary-text: "OK";
    in property <bool> primary-danger: false;
    in property <bool> primary-enabled: true;
    in property <bool> show-footer: true;
    callback dismissed();
    callback primary-clicked();

    width: 100%;
    height: 100%;
    background: SubomiPalette.scrim;

    TouchArea {
        clicked => {
            if root.dismiss-on-backdrop {
                root.dismissed();
            }
        }
    }

    Rectangle {
        width: min(root.dialog-width, parent.width - 48px);
        height: min(card-layout.preferred-height, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: SubomiPalette.surface-elevated;
        border-width: 1px;
        border-color: root.accent-border;
        border-radius: 12px;
        drop-shadow-blur: 28px;
        drop-shadow-color: SubomiPalette.shadow;

        // Absorb clicks inside the dialog surface so they don't dismiss the backdrop
        TouchArea { }

        card-layout := VerticalLayout {
            width: parent.width;
            padding-top: root.title != "" ? 20px : 6px;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
            spacing: 14px;

            title-lbl := Text {
                visible: root.title != "";
                height: root.title != "" ? self.preferred-height : 0px;
                text: root.title;
                color: root.title-color;
                font-size: 16px;
                font-weight: 700;
                overflow: elide;
            }

            @children

            HorizontalLayout {
                visible: root.show-footer;
                height: root.show-footer ? self.preferred-height : 0px;
                alignment: end;
                spacing: 8px;

                ActionButton {
                    visible: root.cancel-text != "";
                    width: root.cancel-text != "" ? self.preferred-width : 0px;
                    text: root.cancel-text;
                    ghost: true;
                    clicked => { root.dismissed(); }
                }

                ActionButton {
                    text: root.primary-text;
                    primary: !root.primary-danger;
                    danger: root.primary-danger;
                    enabled: root.primary-enabled;
                    clicked => { root.primary-clicked(); }
                }
            }
        }
    }
}

export component DropOverlay inherits Rectangle {
    in property <bool> active: false;
    in property <string> label: "";

    visible: root.active;
    width: 100%;
    height: 100%;
    background: SubomiPalette.accent-subtle;
    border-width: 3px;
    border-color: SubomiPalette.cyan-accent;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 64px, drop-lbl.preferred-width + 44px);
        height: 54px;
        border-radius: 12px;
        background: SubomiPalette.surface-elevated;
        border-width: 1.5px;
        border-color: SubomiPalette.cyan-accent;
        drop-shadow-blur: 20px;
        drop-shadow-color: SubomiPalette.shadow;

        drop-lbl := Text {
            text: root.label;
            color: SubomiPalette.text;
            font-size: 14px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
