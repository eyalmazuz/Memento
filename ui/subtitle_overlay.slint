import { SubomiPalette } from "palette.slint";

export struct SubtitleWord {
    text: string,
    reading: string,
    query: string,
    index: int,
}

export struct SubtitleLine {
    words: [SubtitleWord],
}

export struct SubtitleTokenMetrics {
    width-px: float,
    height-px: float,
    bleed-x-px: float,
    glyph-y-px: float,
    glyph-height-px: float,
    sel-x-px: float,
    sel-width-px: float,
    sel-join-left: bool,
    sel-join-right: bool,
    has-selection: bool,
    has-stroke: bool,
    rendered-stroke: image,
    rendered: image,
}

export struct AssLineHitbox {
    event-index: int,
    line-index: int,
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct AssHighlightPatch {
    x: length,
    y: length,
    width: length,
    height: length,
    patch-x: length,
    patch-y: length,
    patch-width: length,
    patch-height: length,
    glyph-patch: image,
    has-patch: bool,
}

export struct AssRubyItem {
    text: string,
    x: length,
    y: length,
    width: length,
    font-size: length,
}

export global SubtitleOverlayBridge {
    in-out property <bool> rich-enabled: false;
    in-out property <color> subtitle-bg-color: #00000000;
    // User-configured subtitle style properties (shared by primary fallback & secondary subtitles)
    in-out property <string> sub-font-family: "Noto Sans CJK JP";
    in-out property <bool> sub-font-bold: true;
    in-out property <bool> sub-font-italic: false;
    in-out property <color> sub-text-color: #FFFFFF;
    in-out property <color> sub-stroke-color: #000000;
    in-out property <float> sub-stroke-width: 1.5;
    in-out property <color> sub-bg-color: #00000099;
    in-out property <int> style-revision: 0;
    in-out property <int> highlight-revision: 0;
    in-out property <int> hovered-token-index: -1;
    in-out property <int> hovered-char-offset: -1;
    in-out property <int> hovered-global-char-index: -1;
    in-out property <string> hovered-query: "";
    in-out property <bool> keyboard-scan-active: false;
    in-out property <int> keyboard-scan-char-index: -1;
    in-out property <bool> middle-mouse-scan-enabled: false;

    // Native libmpv/libass interactive overlay state
    in-out property <bool> ass-native-active: false;
    in-out property <[AssLineHitbox]> ass-line-hitboxes: [];
    in-out property <[AssHighlightPatch]> ass-highlight-patches: [];
    in-out property <[AssRubyItem]> ass-ruby-items: [];
    in-out property <bool> ass-anchor-active: false;
    in-out property <length> ass-anchor-x: 0px;
    in-out property <length> ass-anchor-top: 0px;
    in-out property <length> ass-anchor-bottom: 0px;
    in-out property <length> ass-anchor-width: 0px;
    in-out property <bool> ass-hovered: false;

    pure callback render-token(SubtitleWord, float, bool, bool, int, int) -> SubtitleTokenMetrics;
    pure callback cluster-char-offset(SubtitleWord, float, bool, float, float) -> int;
    pure callback should-capture-hover-focus() -> bool;

    callback pointer-hovered(SubtitleWord, float, bool, float, float, bool, bool, bool, bool);
    callback pointer-left(int);
    callback token-left-clicked(SubtitleWord, float, bool, float, float);
    callback token-middle-clicked(SubtitleWord, float, bool, float, float);
    callback hover-key-pressed(string, bool, bool, bool, bool) -> bool;
    callback stationary-modifier-changed(bool, bool, bool, bool);

    callback ass-pointer-hovered(float, float, bool, bool, bool, bool);
    callback ass-line-hover-changed(int, int, bool);
    callback ass-pointer-left();
    callback ass-left-clicked(float, float);
    callback ass-middle-clicked(float, float);
}

// Layer 0 (bottom): continuous selection highlight behind all strokes & fills in a line
export component SubtitleTokenSelectionSlice inherits Rectangle {
    in property <SubtitleWord> word;
    in property <length> type-size;
    in property <bool> selected;
    in property <bool> show-furigana: false;

    private property <SubtitleTokenMetrics> rich-metrics: SubtitleOverlayBridge.rich-enabled
        ? SubtitleOverlayBridge.render-token(
            root.word,
            root.type-size / 1px,
            root.show-furigana,
            root.selected,
            SubtitleOverlayBridge.style-revision,
            SubtitleOverlayBridge.highlight-revision
        )
        : {
            width-px: 0.0,
            height-px: 0.0,
            bleed-x-px: 0.0,
            glyph-y-px: 0.0,
            glyph-height-px: 0.0,
            sel-x-px: 0.0,
            sel-width-px: 0.0,
            sel-join-left: false,
            sel-join-right: false,
            has-selection: false,
            has-stroke: false,
        };
    private property <bool> use-rich: SubtitleOverlayBridge.rich-enabled && root.rich-metrics.width-px > 0.0;

    preferred-width: root.use-rich ? root.rich-metrics.width-px * 1px : 0px;
    min-width: root.preferred-width;
    preferred-height: root.use-rich ? root.rich-metrics.height-px * 1px : 0px;
    min-height: root.preferred-height;
    background: transparent;

    Rectangle {
        visible: root.use-rich && root.rich-metrics.has-selection && root.word.query != "";
        x: root.rich-metrics.sel-x-px * 1px;
        y: root.rich-metrics.glyph-y-px * 1px;
        width: root.rich-metrics.sel-width-px * 1px;
        height: root.rich-metrics.glyph-height-px * 1px;
        border-top-left-radius: root.rich-metrics.sel-join-left ? 0px : 3px;
        border-bottom-left-radius: root.rich-metrics.sel-join-left ? 0px : 3px;
        border-top-right-radius: root.rich-metrics.sel-join-right ? 0px : 3px;
        border-bottom-right-radius: root.rich-metrics.sel-join-right ? 0px : 3px;
        background: #38a6d6;
    }
}

// Layer 1 (middle): outer stroke + drop-shadow pass for every token in a line, painted beneath all fills
export component SubtitleTokenStrokeSlice inherits Rectangle {
    in property <SubtitleWord> word;
    in property <length> type-size;
    in property <bool> show-furigana: false;

    private property <SubtitleTokenMetrics> rich-metrics: SubtitleOverlayBridge.rich-enabled
        ? SubtitleOverlayBridge.render-token(
            root.word,
            root.type-size / 1px,
            root.show-furigana,
            false,
            SubtitleOverlayBridge.style-revision,
            0
        )
        : {
            width-px: 0.0,
            height-px: 0.0,
            bleed-x-px: 0.0,
            glyph-y-px: 0.0,
            glyph-height-px: 0.0,
            sel-x-px: 0.0,
            sel-width-px: 0.0,
            sel-join-left: false,
            sel-join-right: false,
            has-selection: false,
            has-stroke: false,
        };
    private property <bool> use-rich: SubtitleOverlayBridge.rich-enabled && root.rich-metrics.width-px > 0.0;

    preferred-width: root.use-rich ? root.rich-metrics.width-px * 1px : 0px;
    min-width: root.preferred-width;
    preferred-height: root.use-rich ? root.rich-metrics.height-px * 1px : 0px;
    min-height: root.preferred-height;
    background: transparent;

    Image {
        visible: root.use-rich && root.rich-metrics.has-stroke;
        x: -root.rich-metrics.bleed-x-px * 1px;
        y: 0px;
        width: (root.rich-metrics.width-px + root.rich-metrics.bleed-x-px * 2.0) * 1px;
        height: root.rich-metrics.height-px * 1px;
        source: root.rich-metrics.rendered-stroke;
        image-fit: fill;
    }
}

export component InteractiveSubtitleToken inherits Rectangle {
    in property <SubtitleWord> word;
    in property <length> type-size;
    in property <bool> selected;
    in property <bool> show-furigana: false;
    callback clicked();
    callback double-clicked();
    callback hovered(string, bool, bool, bool, bool);
    callback hover-state(bool);
    callback popup-anchor-requested(length);

    private property <length> ruby-space: root.show-furigana ? root.type-size * 0.7 + 2px : 0px;
    private property <SubtitleTokenMetrics> rich-metrics: SubtitleOverlayBridge.rich-enabled
        ? SubtitleOverlayBridge.render-token(
            root.word,
            root.type-size / 1px,
            root.show-furigana,
            false,
            SubtitleOverlayBridge.style-revision,
            0
        )
        : {
            width-px: 0.0,
            height-px: 0.0,
            bleed-x-px: 0.0,
            glyph-y-px: 0.0,
            glyph-height-px: 0.0,
            sel-x-px: 0.0,
            sel-width-px: 0.0,
            sel-join-left: false,
            sel-join-right: false,
            has-selection: false,
            has-stroke: false,
        };
    private property <bool> use-rich: SubtitleOverlayBridge.rich-enabled && root.rich-metrics.width-px > 0.0;

    preferred-width: root.use-rich
        ? root.rich-metrics.width-px * 1px
        : max(glyph.preferred-width, ruby.visible ? ruby.preferred-width : 0px);
    min-width: root.preferred-width;
    preferred-height: root.use-rich
        ? root.rich-metrics.height-px * 1px
        : glyph.preferred-height + root.ruby-space;
    min-height: root.preferred-height;
    background: transparent;

    // Plain fallback selection highlight (rich mode renders selection in SubtitleTokenSelectionSlice)
    Rectangle {
        visible: !root.use-rich && root.selected && root.word.query != "";
        x: glyph.x;
        y: glyph.y;
        width: glyph.width;
        height: glyph.height;
        border-radius: 3px;
        background: #38a6d6;
    }

    Image {
        visible: root.use-rich;
        x: -root.rich-metrics.bleed-x-px * 1px;
        y: 0px;
        width: (root.rich-metrics.width-px + root.rich-metrics.bleed-x-px * 2.0) * 1px;
        height: root.rich-metrics.height-px * 1px;
        source: root.rich-metrics.rendered;
        image-fit: fill;
    }

    ruby := Text {
        visible: !root.use-rich && root.show-furigana && root.word.reading != "";
        text: root.word.reading;
        width: self.preferred-width;
        height: self.preferred-height;
        wrap: no-wrap;
        font-size: root.type-size * 0.5;
        font-family: SubtitleOverlayBridge.sub-font-family;
        color: SubtitleOverlayBridge.sub-text-color;
        x: round((parent.width - self.preferred-width) / 2 / 1px) * 1px;
        y: max(0px, root.ruby-space - self.preferred-height);
    }

    glyph := Text {
        visible: !root.use-rich;
        text: root.word.text;
        width: self.preferred-width;
        height: self.preferred-height;
        wrap: no-wrap;
        x: round((parent.width - self.preferred-width) / 2 / 1px) * 1px;
        y: root.ruby-space;
        font-size: root.type-size;
        font-weight: SubtitleOverlayBridge.sub-font-bold ? 700 : 400;
        font-italic: SubtitleOverlayBridge.sub-font-italic;
        font-family: SubtitleOverlayBridge.sub-font-family;
        color: SubtitleOverlayBridge.sub-text-color;
    }

    token-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: SubtitleOverlayBridge.rich-enabled;
        key-pressed(event) => {
            if (SubtitleOverlayBridge.hover-key-pressed(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            )) {
                return accept;
            }
            reject
        }
        key-released(event) => {
            SubtitleOverlayBridge.stationary-modifier-changed(
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            );
            reject
        }
    }

    touch := TouchArea {
        x: root.use-rich ? 0px : glyph.x;
        y: root.use-rich ? 0px : glyph.y;
        width: root.use-rich ? parent.width : glyph.width;
        height: root.use-rich ? parent.height : glyph.height;
        enabled: root.word.query != "";
        mouse-cursor: pointer;
        clicked => {
            if (root.word.query != "") {
                root.popup-anchor-requested(self.mouse-x);
            }
            if (SubtitleOverlayBridge.rich-enabled) {
                SubtitleOverlayBridge.token-left-clicked(
                    root.word,
                    root.type-size / 1px,
                    root.show-furigana,
                    self.mouse-x / 1px,
                    self.mouse-y / 1px
                );
            } else {
                root.clicked();
            }
        }
        double-clicked => {
            root.double-clicked();
        }
        pointer-event(event) => {
            if (SubtitleOverlayBridge.rich-enabled) {
                if (event.kind == PointerEventKind.move
                    && !token-focus.has-focus
                    && SubtitleOverlayBridge.should-capture-hover-focus())
                {
                    token-focus.focus();
                }
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                    if (root.word.query != "") {
                        root.popup-anchor-requested(self.mouse-x);
                    }
                    SubtitleOverlayBridge.token-middle-clicked(
                        root.word,
                        root.type-size / 1px,
                        root.show-furigana,
                        self.mouse-x / 1px,
                        self.mouse-y / 1px
                    );
                } else if (event.kind == PointerEventKind.move
                    || (event.kind == PointerEventKind.down && event.button == PointerEventButton.left))
                {
                    if (root.word.query != "") {
                        root.popup-anchor-requested(self.mouse-x);
                    }
                    SubtitleOverlayBridge.pointer-hovered(
                        root.word,
                        root.type-size / 1px,
                        root.show-furigana,
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                        event.modifiers.control,
                        event.modifiers.shift,
                        event.modifiers.alt,
                        event.modifiers.meta
                    );
                } else if (event.kind == PointerEventKind.cancel) {
                    SubtitleOverlayBridge.pointer-left(root.word.index);
                    root.hovered("", false, false, false, false);
                }
            } else {
                if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.down) {
                    if (root.word.query != "") {
                        root.popup-anchor-requested(self.mouse-x);
                    }
                    root.hovered(
                        root.word.query,
                        event.modifiers.control,
                        event.modifiers.shift,
                        event.modifiers.alt,
                        event.modifiers.meta
                    );
                } else if (event.kind == PointerEventKind.cancel) {
                    root.hovered("", false, false, false, false);
                }
            }
        }
        changed has-hover => {
            root.hover-state(self.has-hover);
            if self.has-hover {
                if (SubtitleOverlayBridge.rich-enabled && SubtitleOverlayBridge.should-capture-hover-focus()) {
                    token-focus.focus();
                }
            } else {
                if (SubtitleOverlayBridge.rich-enabled) {
                    SubtitleOverlayBridge.pointer-left(root.word.index);
                }
                root.hovered("", false, false, false, false);
            }
        }
    }
}
