import { MementoPalette } from "palette.slint";
import { ActionButton } from "components/buttons.slint";
import { SettingsWindow } from "settings.slint";
import { AnkiHelpWindow, HelpArgument, HelpMarker, HelpSection } from "anki_help.slint";
import {
    PitchMora, PitchGraph, PopupFrequency, PopupFrequencyLine,
    PopupGlossaryBlock, PopupAudioSource, DictResult,
    PopupDictStyle, PopupFreqStyle, DefinitionGridRow,
    PopupLayout, YomitanPopup, NestedYomitanPopup, DictionarySearchPanel, PopupBridge,
} from "popup.slint";
import {
    SubtitleWord, SubtitleLine, InteractiveSubtitleToken, SubtitleOverlayBridge,
    AssLineHitbox, AssHighlightPatch, AssRubyItem,
} from "subtitle_overlay.slint";
import { SubEntry, PlayerTrack, ChapterMark } from "player/types.slint";
import { PlayerOscBar } from "player/osc_bar.slint";
import { TopMenuBar, MenuDropdown } from "player/menu_bar.slint";
import { SubtitleDrawerPanel } from "player/subtitle_drawer.slint";
import { AboutModal, OpenUrlModal } from "player/modals.slint";

export { MementoPalette, SettingsWindow, AnkiHelpWindow, HelpArgument, HelpMarker, HelpSection }
export { SubEntry, PlayerTrack, ChapterMark }
export {
    PitchMora, PitchGraph, PopupFrequency, PopupFrequencyLine,
    PopupGlossaryBlock, PopupAudioSource, DictResult, PopupLayout,
    PopupDictStyle, PopupFreqStyle, DefinitionGridRow,
    PopupBridge,
}
export {
    SubtitleWord, SubtitleLine, SubtitleOverlayBridge,
    AssLineHitbox, AssHighlightPatch, AssRubyItem,
}

// ── Main Memento Application Window ─────────────────────────────────────
export component MementoApp inherits Window {
    title: root.media-title != "" ? (root.media-title + " — Memento") : "Memento";
    min-width: 900px;
    min-height: 580px;
    preferred-width: 1200px;
    preferred-height: 720px;
    background: #000000;

    in-out property <string> media-title: "";
    in-out property <bool> is-playing: false;
    in-out property <float> position: 0.0;
    in-out property <float> duration: 0.0;
    in-out property <float> volume: 100.0;
    in-out property <float> volume-max: 100.0;
    in-out property <bool> is-muted: false;
    in-out property <string> current-time: "00:00";
    in-out property <string> duration-time: "00:00";
    in-out property <image> video-frame;
    in-out property <image> thumbnail-frame;
    in-out property <bool> preview-thumbnails-enabled: true;
    in-out property <string> hover-chapter-title: "";
    in-out property <[float]> chapters: [];
    in-out property <[ChapterMark]> chapter-marks: [];
    callback update-video();
    callback video-frame-ready();
    in-out property <int> pending-playback-generation: -1;
    callback video-load-presented(int);
    out property <int> video-width: round(video-area.width / 1px);
    out property <int> video-height: round(video-area.height / 1px);
    changed video-width => { root.update-video(); }
    changed video-height => { root.update-video(); }
    in-out property <string> status-message: "";
    in-out property <float> subtitle-scale: 0.05;
    in-out property <float> subtitle-offset: 0.045;
    in-out property <string> active-sub-text: "";
    in-out property <string> secondary-sub-text: "";
    in-out property <int> selected-token-index: -1;
    in-out property <int> selected-token-count: 1;
    in-out property <bool> dict-search-open: false;
    in-out property <bool> sub-drawer-open: false;
    in-out property <length> sidebar-width: 360px;
    in-out property <float> sidebar-split-ratio: 0.45;
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> osc-visible: true;
    in-out property <int> osc-visibility-mode: 0; // 0: Auto, 1: Hidden, 2: Visible
    in-out property <int> osc-duration-ms: 700;
    in-out property <int> osc-fade-ms: 250;
    in-out property <int> osc-min-move: 0;
    in-out property <bool> osc-mpv-cursor: false;
    in-out property <bool> cursor-hidden: false;
    in-out property <bool> autofit-enabled: true;
    in-out property <int> autofit-percent: 100;
    in-out property <bool> subtitle-cursor-show-enabled: false;
    in-out property <bool> secondary-subtitle-cursor-show-enabled: false;
    in-out property <bool> cursor-in-bottom-sub-zone: false;
    in-out property <bool> cursor-in-top-sub-zone: false;
    in-out property <bool> auto-play-audio-enabled: false;
    in-out property <string> search-remove-regex: "";
    in-out property <bool> search-replace-lines: false;
    in-out property <string> search-replace-with: "";
    out property <bool> menu-open: menu-bar.open-menu >= 0;
    out property <bool> osc-hovered:
        osc.is-hovered || menu-bar.is-hovered || root.menu-open
        || subtitle-hover-area.has-hover || secondary-hover-area.has-hover
        || root.token-hovered || SubtitleOverlayBridge.ass-hovered;
    out property <bool> primary-subtitle-effective-visible:
        SubtitleOverlayBridge.ass-native-active
            ? root.ass-overlay-visible
            : subtitle-box.visible;
    out property <bool> secondary-subtitle-effective-visible: secondary-subtitle-box.visible;
    out property <bool> primary-cursor-reveal-active: root.primary-cursor-reveal;
    out property <bool> secondary-cursor-reveal-active: root.secondary-cursor-reveal;
    out property <float> osc-opacity: osc.opacity;
    out property <float> menu-bar-opacity: menu-bar.opacity;
    in-out property <bool> token-hovered: false;
    in-out property <bool> ocr-mode: false;
    in-out property <bool> ocr-enabled: false;
    in-out property <bool> asr-enabled: false;
    in-out property <bool> asr-running: false;
    in-out property <bool> asr-track-selected: false;
    in-out property <bool> auto-pause: false;
    in-out property <bool> subtitles-visible: true;
    in-out property <bool> sub-ass-native: true;
    in-out property <bool> furigana-visible: false;
    // Loading the first reading must finish before releasing the playback clock.
    in-out property <bool> subtitle-furigana-pending: false;
    in-out property <bool> furigana-enabled: true;
    in-out property <bool> hide-mpv-subtitles: true;
    in-out property <bool> hide-memento-while-playing: false;
    in-out property <bool> hover-pause-enabled: false;
    in-out property <[string]> recent-files: [];
    in-out property <[string]> recent-file-labels: [];
    in-out property <[PlayerTrack]> audio-tracks: [];
    in-out property <[PlayerTrack]> subtitle-tracks: [];
    in-out property <int> audio-id: 0;
    in-out property <int> primary-sid: 0;
    in-out property <int> secondary-sid: 0;
    in-out property <[string]> anki-profiles: [];
    in-out property <string> anki-profile: "";
    in-out property <bool> anki-enabled: false;
    in-out property <bool> show-anki-checkbox: true;
    in-out property <string> app-version: "";
    in-out property <string> key-open-file: "Ctrl+O";
    in-out property <string> key-open-url: "Ctrl+U";
    in-out property <string> key-show-search: "Ctrl+R";
    in-out property <string> key-show-sub-list: "Ctrl+E";
    in-out property <string> key-start-ocr: "Ctrl+L";
    in-out property <string> key-sub-auto-pause: "Ctrl+P";
    in-out property <string> key-sub-show: "Ctrl+0";
    in-out property <string> key-sub-furigana: "Alt+A";
    in-out property <string> key-sub-increase-size: "Ctrl+2";
    in-out property <string> key-sub-decrease-size: "Ctrl+1";
    in-out property <string> key-sub-move-up: "Alt+1";
    in-out property <string> key-sub-move-down: "Alt+2";
    in-out property <string> key-card-add: "Ctrl+D";
    in-out property <string> key-card-next: "Ctrl+Down";
    in-out property <string> key-card-prev: "Ctrl+Up";
    in-out property <string> key-osc-visibility: "Delete";
    in-out property <string> key-sub-list-copy: "Ctrl+Shift+C";
    in-out property <string> key-sub-list-find: "Ctrl+F";
    in-out property <string> key-sub-list-find-next: "F3";
    in-out property <string> key-sub-list-find-prev: "Shift+F3";
    in-out property <bool> custom-key-handler-installed: false;
    in-out property <length> window-bottom-margin: 0px;

    in-out property <bool> dict-open: false;
    in-out property <string> dict-query: "";
    in-out property <string> dict-reading: "";
    in-out property <string> dict-pitch-accent: "";
    in-out property <string> dict-freq-rank: "";
    in-out property <string> dict-jpdb-rank: "";
    in-out property <[DictResult]> dict-results: [];
    in-out property <[DictResult]> popup-results: [];
    in-out property <int> popup-loaded-count: 0;
    in-out property <int> popup-focused-index: 0;
    in-out property <length> popup-configured-width: 480px;
    in-out property <length> popup-configured-height: 440px;
    out property <bool> popup-needs-more: yomi-card.needs-more;
    out property <length> popup-x: yomi-card.x;
    out property <length> popup-y: yomi-card.y;
    out property <length> popup-width: yomi-card.width;
    out property <length> popup-height: yomi-card.height;
    out property <length> primary-subtitle-y: subtitle-box.y;
    out property <length> primary-subtitle-height: subtitle-box.height;
    out property <length> secondary-subtitle-y: secondary-subtitle-box.y;
    out property <length> secondary-subtitle-width: secondary-subtitle-box.width;
    out property <length> secondary-subtitle-height: secondary-subtitle-box.height;
    in-out property <bool> subtitle-drawer-user-scrolling <=> sub-drawer.user-scrolling;
    out property <length> subtitle-drawer-viewport-y: sub-drawer.viewport-y;
    in-out property <[PopupAudioSource]> popup-audio-sources: [];
    in-out property <bool> popup-audio-sources-loading: false;
    in-out property <int> popup-selected-audio-source: -1;
    in-out property <string> anki-added-note-id: "";
    in-out property <int> anki-added-result-index: -1;
    in-out property <bool> about-open: false;
    in-out property <bool> url-dialog-open: false;
    in-out property <string> url-dialog-text: "";
    in-out property <bool> update-dialog-open: false;
    in-out property <bool> update-dialog-opt-in: false;
    in-out property <string> update-dialog-title: "";
    in-out property <string> update-dialog-message: "";
    in-out property <string> update-dialog-release-tag: "";
    in-out property <string> update-dialog-release-url: "https://github.com/ripose-jp/Memento/releases/latest";
    in-out property <string> copied-subtitle-text: "";

    // Subtitle Entries & Interactive Words
    in-out property <[SubEntry]> subtitle-entries: [];
    in-out property <[SubEntry]> secondary-subtitle-entries: [];
    in-out property <int> subtitle-drawer-tab: 0;
    in-out property <string> subtitle-search-query: "";
    in-out property <int> subtitle-search-current-match: 0;
    in-out property <int> subtitle-search-total-matches: 0;
    in-out property <int> subtitle-search-focused-row: -1;
    in-out property <bool> sub-list-show-timestamps: false;
    in-out property <bool> subtitle-search-ignore-whitespace: false;
    in-out property <bool> subtitle-search-auto-seek: false;
    in-out property <color> sub-list-bg-color: MementoPalette.surface-bg;
    in-out property <color> sub-list-text-color: MementoPalette.text;
    in-out property <color> sub-list-hover-color: MementoPalette.list-hover;
    in-out property <color> sub-list-selected-color: MementoPalette.accent-muted;
    in-out property <color> sub-list-selected-hover-color: MementoPalette.accent-muted-hover;
    in-out property <string> sub-list-primary-font-family: "";
    in-out property <length> sub-list-primary-font-size: 13px;
    in-out property <bool> sub-list-primary-font-bold: false;
    in-out property <bool> sub-list-primary-font-italic: false;
    in-out property <string> sub-list-secondary-font-family: "";
    in-out property <length> sub-list-secondary-font-size: 13px;
    in-out property <bool> sub-list-secondary-font-bold: false;
    in-out property <bool> sub-list-secondary-font-italic: false;
    in-out property <[SubtitleWord]> active-sub-words: [];
    in-out property <[SubtitleLine]> active-sub-lines: [];
    in-out property <length> popup-offset-x: 0px;
    in-out property <length> pending-popup-offset-x: 0px;

    callback toggle-play();
    callback seek-to(float);
    callback seek-relative(float);
    callback sub-seek(int);
    callback playlist-prev();
    callback playlist-next();
    callback set-volume(float);
    callback toggle-mute();
    callback volume-up();
    callback volume-down();
    callback open-file();
    callback open-url();
    callback open-url-submitted(string);
    callback open-recent(string);
    callback clear-recent();
    callback reload-media();
    callback close-media();
    callback quit-app();
    callback file-dropped(string);
    callback files-dropped([string]);
    callback select-audio-track(int);
    callback select-subtitle-track(int);
    callback select-secondary-subtitle-track(int);
    callback select-asr();
    callback select-anki-profile(string);
    callback auto-pause-changed(bool);
    callback adjust-subtitle-scale(float);
    callback adjust-subtitle-offset(float);
    callback subtitles-visible-changed(bool);
    callback furigana-visible-changed(bool);
    callback subtitle-hover-changed(bool);
    callback toggle-subtitles();
    callback add-subtitle();
    callback adjust-sub-delay(float);
    callback start-ocr();
    callback ocr-region(float, float, float, float);
    callback open-config();
    callback check-updates();
    callback update-opt-in-responded(bool);
    callback update-dialog-dismissed();
    callback open-external-link(string);
    callback toggle-fullscreen();
    callback timeline-hover-moved(float);
    callback pointer-moved(float, float);
    callback video-pointer-button(float, float, int, bool, bool, bool, bool, bool);
    callback video-wheel(float, float, float, float);
    callback osc-activity();
    callback select-row(int, bool);
    callback select-subtitle-range(int, int, bool);
    callback mark-subtitle-row(int);
    callback search-subtitles(string);
    callback next-subtitle-search-match();
    callback prev-subtitle-search-match();
    callback sub-list-show-timestamps-toggled(bool);
    callback subtitle-search-ignore-whitespace-changed(bool);
    callback subtitle-search-auto-seek-changed(bool);
    callback copy-selected-subtitles();
    callback scroll-subtitle-drawer-to-row(int);
    callback scroll-subtitle-drawer-to-offset(float, float, float);
    callback focus-subtitle-search();
    callback subtitle-drawer-tab-changed(int);
    callback subtitle-drawer-user-scrolled();
    callback search-dictionary(string);
    callback lookup-word(string);
    callback open-glossary-link(string);
    callback lookup-kanji(string);
    callback hover-word(string, int, bool, bool, bool, bool);
    callback toggle-definition-selection(int);
    callback toggle-term-collapse(int);
    callback load-more-definition-results(bool);
    callback navigate-popup(int);
    callback add-anki-note(int);
    callback browse-anki-note(string);
    callback reset-definition-scroll();
    callback open-options();
    callback play-audio-for-word(string, string);
    callback popup-audio-sources-requested(string, string);
    callback key-pressed(string, bool, bool, bool, bool) -> bool;
    callback key-released(bool, bool, bool, bool);
    callback dismiss-definition();

    dismiss-definition => {
        root.dict-open = false;
        root.selected-token-index = -1;
        root.selected-token-count = 1;
        root.popup-focused-index = 0;
        root.popup-offset-x = 0px;
        SubtitleOverlayBridge.ass-highlight-patches = [];
        SubtitleOverlayBridge.ass-anchor-active = false;
        // Cancel delayed hover searches and invalidate results already in flight.
        root.hover-word("", -1, false, false, false, false);
    }

    scroll-subtitle-drawer-to-row(row-idx) => {
        sub-drawer.scroll-to-row(row-idx);
    }

    scroll-subtitle-drawer-to-offset(row-y, row-h, total-h) => {
        sub-drawer.scroll-to-offset(row-y * 1px, row-h * 1px, total-h * 1px);
    }

    focus-subtitle-search => {
        root.sub-drawer-open = true;
        sub-drawer.focus-search();
    }

    navigate-popup(direction) => {
        if direction > 0 {
            let count = root.popup-results.length;
            if count > 0 {
                root.popup-focused-index = min(count - 1, root.popup-focused-index + 1);
            }
            root.load-more-definition-results(true);
        } else {
            root.popup-focused-index = max(0, root.popup-focused-index - 1);
            yomi-card.reset-scroll();
        }
    }

    reset-definition-scroll => {
        root.popup-focused-index = 0;
        yomi-card.reset-scroll();
    }
    pure callback format-timestamp(float) -> string;

    property <bool> subtitle-hover-latched: false;
    property <bool> split-v-hovered: false;
    property <bool> non-subtitle-hovered:
        video-motion.has-hover
        || osc.is-hovered
        || menu-bar.is-hovered
        || sub-drawer.is-hovered
        || root.split-v-hovered
        || split-h-touch.has-hover
        || sidebar-bg-touch.has-hover
        || root.menu-open
        || root.about-open
        || root.url-dialog-open
        || root.update-dialog-open
        || root.ocr-mode;
    property <bool> ass-overlay-visible:
        SubtitleOverlayBridge.ass-native-active
        && (root.subtitle-cursor-show-enabled
            ? root.primary-cursor-reveal
            : root.subtitles-visible);
    property <bool> primary-cursor-reveal:
        root.subtitle-cursor-show-enabled
        && (root.cursor-in-bottom-sub-zone
            || subtitle-hover-area.has-hover
            || root.token-hovered
            || SubtitleOverlayBridge.ass-hovered
            || hover-bridge.has-hover
            || osc.is-hovered
            || (root.dict-open && root.subtitle-hover-latched));
    property <bool> secondary-cursor-reveal:
        root.secondary-subtitle-cursor-show-enabled
        && (root.cursor-in-top-sub-zone
            || secondary-hover-area.has-hover
            || menu-bar.is-hovered);
    property <bool> direct-subtitle-hovered:
        subtitle-hover-area.has-hover
        || secondary-hover-area.has-hover
        || root.token-hovered
        || SubtitleOverlayBridge.ass-hovered
        || hover-bridge.has-hover;
    changed direct-subtitle-hovered => {
        if self.direct-subtitle-hovered {
            root.subtitle-hover-latched = true;
        }
    }
    changed non-subtitle-hovered => {
        if self.non-subtitle-hovered {
            root.subtitle-hover-latched = false;
        }
    }
    property <bool> effective-subtitle-hover:
        root.direct-subtitle-hovered
        || (root.subtitle-hover-latched
            && root.dict-open
            && root.popup-results.length > 0
            && !root.non-subtitle-hovered);
    changed effective-subtitle-hover => {
        root.subtitle-hover-changed(self.effective-subtitle-hover);
    }

    changed url-dialog-open => {
        if root.url-dialog-open {
            url-modal.focus-input();
        } else {
            f-scope.focus();
        }
    }
    changed about-open => {
        if !root.about-open {
            f-scope.focus();
        }
    }
    changed update-dialog-open => {
        if !root.update-dialog-open {
            f-scope.focus();
        }
    }
    changed sub-drawer-open => {
        if !root.sub-drawer-open {
            f-scope.focus();
        }
    }
    changed dict-search-open => {
        if root.dict-search-open {
            root.dict-query = "";
            root.dict-results = [];
            root.dismiss-definition();
        } else {
            f-scope.focus();
        }
    }
    changed dict-open => {
        if !root.dict-open {
            root.subtitle-hover-latched = false;
            if !root.url-dialog-open && !root.about-open && !root.update-dialog-open && !root.dict-search-open && !root.sub-drawer-open {
                f-scope.focus();
            }
        }
    }
    changed active-sub-lines => {
        if !root.token-hovered && !root.dict-open && !root.url-dialog-open && !root.about-open && !root.update-dialog-open && !root.dict-search-open && !root.sub-drawer-open {
            f-scope.focus();
        }
    }
    changed active-sub-text => {
        if !root.token-hovered && !root.dict-open && !root.url-dialog-open && !root.about-open && !root.update-dialog-open && !root.dict-search-open && !root.sub-drawer-open {
            f-scope.focus();
        }
    }
    changed token-hovered => {
        if !root.token-hovered && !root.dict-open && !root.url-dialog-open && !root.about-open && !root.update-dialog-open && !root.dict-search-open && !root.sub-drawer-open {
            f-scope.focus();
        }
    }
    changed secondary-sid => {
        if root.secondary-sid == 0 && root.secondary-subtitle-entries.length == 0 && root.subtitle-drawer-tab == 1 {
            root.subtitle-drawer-tab = 0;
        }
    }

    forward-focus: f-scope;
    f-scope := FocusScope {
        width: 100%;
        height: 100%;

        capture-key-pressed(event) => {
            // Escape immediately closes open top-level dropdown menus
            if (event.text == Key.Escape && menu-bar.open-menu >= 0) {
                menu-bar.open-menu = -1;
                return accept;
            }
            // Route bare modifier keys to PopupBridge first while the dictionary popup is open so
            // recursive glossary scanning works regardless of which FocusScope currently has focus.
            if (root.dict-open && PopupBridge.rich-enabled
                && (event.text == Key.Shift || event.text == Key.ShiftR
                    || event.text == Key.Control || event.text == Key.ControlR
                    || event.text == Key.Alt || event.text == Key.AltGr
                    || event.text == Key.Meta || event.text == Key.MetaR
                    || (event.text == ""
                        && (event.modifiers.control || event.modifiers.shift
                            || event.modifiers.alt || event.modifiers.meta)))) {
                if (PopupBridge.popup-key-pressed(
                    event.text,
                    event.modifiers.control || event.text == Key.Control || event.text == Key.ControlR,
                    event.modifiers.shift || event.text == Key.Shift || event.text == Key.ShiftR,
                    event.modifiers.alt || event.text == Key.Alt || event.text == Key.AltGr,
                    event.modifiers.meta || event.text == Key.Meta || event.text == Key.MetaR,
                )) {
                    return accept;
                }
            }
            if (event.text == Key.F3) {
                if (root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta)) {
                    return accept;
                }
                if (!root.custom-key-handler-installed) {
                    if (event.modifiers.shift) { root.prev-subtitle-search-match(); }
                    else { root.next-subtitle-search-match(); }
                    return accept;
                }
            }
            if (!root.url-dialog-open
                && event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == "c" || event.text == "C")) {
                if (root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta)) {
                    return accept;
                }
                if (!root.custom-key-handler-installed) {
                    root.copy-selected-subtitles();
                    return accept;
                }
            }
            reject
        }

        key-pressed(event) => {
            if (root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta)) {
                return accept;
            }
            if (root.custom-key-handler-installed) {
                return reject;
            }
            // Built-in fallback for standalone Slint component tests when `main.rs` handler is not attached:
            if (event.text == Key.Shift || event.text == Key.ShiftR
                || event.text == Key.Control || event.text == Key.ControlR
                || event.text == Key.Alt || event.text == Key.AltGr
                || event.text == Key.Meta || event.text == Key.MetaR
                || event.text == Key.CapsLock || event.text == "") {
                return reject;
            }
            if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                if (root.dict-open) {
                    root.navigate-popup(event.text == Key.DownArrow ? 1 : -1);
                } else if (root.sub-drawer-open) {
                    if (event.text == Key.DownArrow) { root.next-subtitle-search-match(); }
                    else { root.prev-subtitle-search-match(); }
                }
                return accept;
            }
            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == "d" || event.text == "D")) {
                if (root.dict-open && root.anki-enabled && root.dict-results.length > 0) {
                    root.add-anki-note(0);
                } else {
                    root.dict-search-open = !root.dict-search-open;
                }
                return accept;
            }
            let had-dict = root.dict-open;
            root.dismiss-definition();
            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == "f" || event.text == "F")) {
                root.focus-subtitle-search();
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == "c" || event.text == "C")) {
                root.copy-selected-subtitles();
                return accept;
            }
            if (event.text == Key.F3) {
                if (event.modifiers.shift) { root.prev-subtitle-search-match(); }
                else { root.next-subtitle-search-match(); }
                return accept;
            }
            if (event.text == Key.Delete) {
                root.osc-visibility-mode = mod(root.osc-visibility-mode + 1, 3);
                root.osc-visible = root.osc-visibility-mode != 2;
                return accept;
            }
            if (event.text == Key.Escape) {
                if (menu-bar.open-menu >= 0) { menu-bar.open-menu = -1; return accept; }
                if (root.ocr-mode) { root.ocr-mode = false; return accept; }
                if (root.update-dialog-open) {
                    if (root.update-dialog-opt-in) {
                        root.update-opt-in-responded(false);
                    } else {
                        root.update-dialog-open = false;
                        root.update-dialog-dismissed();
                    }
                    return accept;
                }
                if (root.url-dialog-open) { root.url-dialog-open = false; return accept; }
                if (root.about-open) { root.about-open = false; return accept; }
                if (had-dict) { return accept; }
                if (root.dict-search-open) { root.dict-search-open = false; return accept; }
                if (root.sub-drawer-open) { root.sub-drawer-open = false; return accept; }
                if (root.is-fullscreen) { root.toggle-fullscreen(); return accept; }
            }
            reject
        }
        key-released(event) => {
            if (root.dict-open && PopupBridge.rich-enabled && !root.custom-key-handler-installed) {
                PopupBridge.popup-key-released(
                    event.modifiers.control,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.meta,
                );
            }
            root.key-released(
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta,
            );
            reject
        }

        // Window Content Layout
        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-bottom: root.window-bottom-margin;
            spacing: 0;

            // Top Native Menu Bar
            menu-bar := TopMenuBar {
                property <bool> target-visible: root.osc-visible || self.open-menu >= 0;
                opacity: self.target-visible ? 1.0 : 0.0;
                animate opacity { duration: max(0, root.osc-fade-ms) * 1ms; }
                visible: self.target-visible || self.opacity > 0.01;
                activity => { root.osc-activity(); }
                interacted => { root.dismiss-definition(); }
            }

            // Center Area: Video Surface + Optional Resizable Sidebar (Search + Subtitle Drawer)
            HorizontalLayout {
                spacing: 0;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                // Video & Overlays Surface
                video-area := Rectangle {
                    background: #000000;
                    horizontal-stretch: 1;

                    // libmpv frame shares the same Slint scene as all interactive overlays.
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.video-frame;
                        image-fit: contain;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Track video-surface movement and forward unhandled mouse/wheel events to mpv.
                    video-motion := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: (root.cursor-hidden
                            || (!root.osc-mpv-cursor && root.is-fullscreen && !root.osc-visible && !root.osc-hovered && !root.dict-open && !root.menu-open && !root.ocr-mode && !root.about-open && !root.url-dialog-open && !root.update-dialog-open))
                            ? none
                            : default;
                        changed has-hover => {
                            if !self.has-hover {
                                root.cursor-in-top-sub-zone = false;
                                root.cursor-in-bottom-sub-zone = false;
                            }
                            if self.has-hover && !subtitle-hover-area.has-hover && !secondary-hover-area.has-hover && !root.token-hovered && !SubtitleOverlayBridge.ass-hovered {
                                root.subtitle-hover-changed(false);
                            }
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move {
                                root.cursor-hidden = false;
                                if video-area.height > 0px {
                                    let y-ratio = self.mouse-y / video-area.height;
                                    root.cursor-in-top-sub-zone = y-ratio >= 0.0 && y-ratio <= 0.20;
                                    root.cursor-in-bottom-sub-zone = y-ratio >= 0.80 && y-ratio <= 1.0;
                                } else {
                                    root.cursor-in-top-sub-zone = false;
                                    root.cursor-in-bottom-sub-zone = false;
                                }
                                if !subtitle-hover-area.has-hover && !secondary-hover-area.has-hover && !root.token-hovered && !SubtitleOverlayBridge.ass-hovered {
                                    root.subtitle-hover-changed(false);
                                }
                                root.pointer-moved(self.mouse-x / 1px, self.mouse-y / 1px);
                            } else if event.kind == PointerEventKind.down || event.kind == PointerEventKind.up {
                                root.cursor-hidden = false;
                                f-scope.focus();
                                let btn = event.button == PointerEventButton.left ? 1
                                    : event.button == PointerEventButton.right ? 2
                                    : event.button == PointerEventButton.middle ? 4
                                    : event.button == PointerEventButton.back ? 8
                                    : event.button == PointerEventButton.forward ? 16 : 0;
                                let had-popup = root.dict-open;
                                if event.kind == PointerEventKind.down {
                                    root.dismiss-definition();
                                }
                                if !had-popup && !root.menu-open && !root.ocr-mode && !root.about-open && !root.url-dialog-open && !root.update-dialog-open && btn > 0 {
                                    root.video-pointer-button(
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px,
                                        btn,
                                        event.kind == PointerEventKind.down,
                                        event.modifiers.control,
                                        event.modifiers.shift,
                                        event.modifiers.alt,
                                        event.modifiers.meta
                                    );
                                }
                            } else if event.kind == PointerEventKind.cancel {
                                root.video-pointer-button(0.0, 0.0, 0, false, false, false, false, false);
                            }
                        }
                        scroll-event(event) => {
                            if !root.dict-open && !root.menu-open && !root.ocr-mode && !root.about-open && !root.url-dialog-open && !root.update-dialog-open {
                                root.video-wheel(
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px,
                                    event.delta-x / 1px,
                                    event.delta-y / 1px
                                );
                                return accept;
                            }
                            reject
                        }
                        double-clicked => { root.toggle-fullscreen(); }
                    }

                    // Branded Empty / Placeholder State
                    if root.duration <= 0.0 : VerticalLayout {
                        alignment: center;
                        spacing: 14px;

                        HorizontalLayout {
                            alignment: center;
                            Image {
                                width: 68px;
                                height: 68px;
                                source: @image-url("../res/memento.svg");
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: "Memento";
                            font-size: 26px;
                            font-weight: 700;
                            color: MementoPalette.text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Open a video file (Ctrl+O) or drag and drop media to start";
                            font-size: 13.5px;
                            color: MementoPalette.text-secondary;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            padding-top: 4px;
                            ActionButton {
                                text: "Open Media…";
                                primary: true;
                                clicked => { root.open-file(); }
                            }
                        }
                    }

                    // Invisible hover bridge between active primary subtitles (subtitle-box or active ASS anchor)
                    // and YomitanPopup so moving the cursor between subtitle and yomi-card keeps hover-pause active.
                    hover-bridge := TouchArea {
                        property <bool> anchor-vis: SubtitleOverlayBridge.ass-native-active
                            ? (root.ass-overlay-visible && SubtitleOverlayBridge.ass-anchor-active)
                            : subtitle-box.visible;
                        property <length> anchor-x: SubtitleOverlayBridge.ass-native-active
                            ? SubtitleOverlayBridge.ass-anchor-x
                            : subtitle-box.x;
                        property <length> anchor-top: SubtitleOverlayBridge.ass-native-active
                            ? SubtitleOverlayBridge.ass-anchor-top
                            : subtitle-box.y;
                        property <length> anchor-bottom: SubtitleOverlayBridge.ass-native-active
                            ? SubtitleOverlayBridge.ass-anchor-bottom
                            : (subtitle-box.y + subtitle-box.height);
                        property <length> anchor-width: SubtitleOverlayBridge.ass-native-active
                            ? SubtitleOverlayBridge.ass-anchor-width
                            : subtitle-box.width;
                        visible: yomi-card.visible && self.anchor-vis;
                        property <length> gap-top: min(self.anchor-bottom, yomi-card.y + yomi-card.height);
                        property <length> gap-bottom: max(self.anchor-top, yomi-card.y);
                        x: min(self.anchor-x, yomi-card.x);
                        y: self.gap-top;
                        width: max(self.anchor-x + self.anchor-width, yomi-card.x + yomi-card.width) - self.x;
                        height: max(0px, self.gap-bottom - self.gap-top);
                    }

                    // Native ASS/SSA Interactive Overlay (above video-motion, strictly below yomi-card).
                    ass-overlay := Rectangle {
                        visible: root.ass-overlay-visible;
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        ass-focus := FocusScope {
                            width: 0px;
                            height: 0px;
                            enabled: root.ass-overlay-visible;
                            key-pressed(event) => {
                                if (SubtitleOverlayBridge.hover-key-pressed(
                                    event.text,
                                    event.modifiers.control,
                                    event.modifiers.shift,
                                    event.modifiers.alt,
                                    event.modifiers.meta
                                )) {
                                    return accept;
                                }
                                reject
                            }
                            key-released(event) => {
                                SubtitleOverlayBridge.stationary-modifier-changed(
                                    event.modifiers.control,
                                    event.modifiers.shift,
                                    event.modifiers.alt,
                                    event.modifiers.meta
                                );
                                reject
                            }
                        }

                        // Solid #38a6d6 continuous highlight pill BEHIND tight libass glyph patch on top.
                        for hl in SubtitleOverlayBridge.ass-highlight-patches : Rectangle {
                            x: hl.x;
                            y: hl.y;
                            width: hl.width;
                            height: hl.height;
                            border-radius: 3px;
                            background: #38a6d6;
                        }

                        for hl in SubtitleOverlayBridge.ass-highlight-patches : Image {
                            visible: hl.has-patch;
                            x: hl.patch-x;
                            y: hl.patch-y;
                            width: hl.patch-width;
                            height: hl.patch-height;
                            source: hl.glyph-patch;
                            image-fit: fill;
                        }

                        // Optional Alt+A furigana mapped directly above exact libass kanji bounding boxes.
                        if root.furigana-visible : Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: transparent;
                            for ruby in SubtitleOverlayBridge.ass-ruby-items : Rectangle {
                                x: ruby.x;
                                y: ruby.y;
                                width: max(ruby.width, ruby-txt.preferred-width + 6px);
                                height: ruby-txt.preferred-height + 2px;
                                border-radius: 3px;
                                background: MementoPalette.scrim;
                                ruby-txt := Text {
                                    x: (parent.width - self.preferred-width) / 2;
                                    y: 1px;
                                    text: ruby.text;
                                    font-size: ruby.font-size;
                                    font-weight: 700;
                                    font-family: "Noto Sans CJK JP";
                                    color: MementoPalette.text;
                                    wrap: no-wrap;
                                }
                            }
                        }

                        // Per-line ASS hitboxes (positioned in logical video-area coordinates).
                        for hb in SubtitleOverlayBridge.ass-line-hitboxes : TouchArea {
                            x: hb.x;
                            y: hb.y;
                            width: hb.width;
                            height: hb.height;
                            mouse-cursor: pointer;
                            clicked => {
                                SubtitleOverlayBridge.ass-left-clicked(
                                    (hb.x + self.mouse-x) / 1px,
                                    (hb.y + self.mouse-y) / 1px
                                );
                            }
                            pointer-event(event) => {
                                let vx = (hb.x + self.mouse-x) / 1px;
                                let vy = (hb.y + self.mouse-y) / 1px;
                                if (event.kind == PointerEventKind.move
                                    && !ass-focus.has-focus
                                    && SubtitleOverlayBridge.should-capture-hover-focus())
                                {
                                    ass-focus.focus();
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                                    SubtitleOverlayBridge.ass-middle-clicked(vx, vy);
                                } else if (event.kind == PointerEventKind.move
                                    || (event.kind == PointerEventKind.down && event.button == PointerEventButton.left))
                                {
                                    root.osc-activity();
                                    SubtitleOverlayBridge.ass-pointer-hovered(
                                        vx,
                                        vy,
                                        event.modifiers.control,
                                        event.modifiers.shift,
                                        event.modifiers.alt,
                                        event.modifiers.meta
                                    );
                                } else if (event.kind == PointerEventKind.cancel) {
                                    SubtitleOverlayBridge.ass-line-hover-changed(hb.event-index, hb.line-index, false);
                                    SubtitleOverlayBridge.ass-pointer-left();
                                }
                            }
                            changed has-hover => {
                                SubtitleOverlayBridge.ass-line-hover-changed(hb.event-index, hb.line-index, self.has-hover);
                                if self.has-hover {
                                    if (SubtitleOverlayBridge.should-capture-hover-focus()) {
                                        ass-focus.focus();
                                    }
                                } else {
                                    SubtitleOverlayBridge.ass-pointer-left();
                                    if !SubtitleOverlayBridge.ass-hovered && !root.token-hovered && !root.dict-open && !root.url-dialog-open && !root.about-open && !root.update-dialog-open && !root.dict-search-open && !root.sub-drawer-open {
                                        f-scope.focus();
                                    }
                                }
                            }
                        }
                    }

                    // Secondary Subtitles cleanly positioned at the top edge of the video viewport
                    secondary-subtitle-box := Rectangle {
                        visible: root.secondary-sub-text != ""
                            && (root.secondary-subtitle-cursor-show-enabled
                                ? root.secondary-cursor-reveal
                                : (root.subtitles-visible && !(root.hide-memento-while-playing && root.is-playing)));
                        x: (parent.width - self.width) / 2;
                        y: 12px;
                        width: min(parent.width - 40px, secondary-subtitle-text.preferred-width + 32px);
                        height: secondary-subtitle-text.preferred-height + 16px;
                        background: #00000099;
                        border-radius: 4px;
                        secondary-subtitle-text := Text {
                            x: 16px;
                            y: 8px;
                            width: min(video-area.width - 72px, self.preferred-width);
                            text: root.secondary-sub-text;
                            font-size: video-area.height * root.subtitle-scale;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        secondary-hover-area := TouchArea {
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Clickable primary subtitle tokens supply the search suffix at each token.
                    subtitle-box := Rectangle {
                        visible: !SubtitleOverlayBridge.ass-native-active
                            && root.active-sub-text != ""
                            && (root.subtitle-cursor-show-enabled
                                ? root.primary-cursor-reveal
                                : (root.subtitles-visible && !(root.hide-memento-while-playing && root.is-playing)));
                        x: (parent.width - self.width) / 2;
                        y: max(10px, parent.height - self.height - max(62px, parent.height * root.subtitle-offset));
                        width: min(parent.width - 40px, subtitle-lines-layout.preferred-width + 32px);
                        height: subtitle-lines-layout.preferred-height + 16px;
                        background: SubtitleOverlayBridge.rich-enabled ? SubtitleOverlayBridge.subtitle-bg-color : #00000099;
                        border-radius: 4px;
                        subtitle-hover-area := TouchArea {
                            width: 100%;
                            height: 100%;
                        }
                        subtitle-lines-layout := VerticalLayout {
                            x: (parent.width - self.width) / 2;
                            y: 8px;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            spacing: 4px;
                            alignment: center;
                            for line in root.active-sub-lines : HorizontalLayout {
                                alignment: center;
                                spacing: 0px;
                                for word in line.words : InteractiveSubtitleToken {
                                    word: word;
                                    type-size: video-area.height * root.subtitle-scale;
                                    show-furigana: root.furigana-visible;
                                    selected: word.index >= root.selected-token-index && word.index < (root.selected-token-index + root.selected-token-count);
                                    popup-anchor-requested(local-x) => {
                                        root.pending-popup-offset-x = (16px + self.x + local-x) - subtitle-box.width / 2;
                                    }
                                    hover-state(hovering) => {
                                        root.token-hovered = hovering;
                                        if hovering && word.query != "" && !SubtitleOverlayBridge.rich-enabled {
                                            root.pending-popup-offset-x = (16px + self.x + self.width / 2) - subtitle-box.width / 2;
                                        }
                                    }
                                    hovered(query, control, shift, alt, meta) => {
                                        root.osc-activity();
                                        root.hover-word(query, word.index, control, shift, alt, meta);
                                    }
                                    clicked => {
                                        root.popup-offset-x = root.pending-popup-offset-x;
                                        root.selected-token-index = word.index;
                                        root.hover-word("", word.index, false, false, false, false);
                                        root.lookup-word(word.query);
                                    }
                                }
                            }
                        }
                    }

                    // Floating Yomitan Dictionary Card (integer-rounded geometry preserved for 1:1 sharpness)
                    yomi-card := YomitanPopup {
                        property <bool> has-sub-anchor: SubtitleOverlayBridge.ass-native-active
                            ? (root.ass-overlay-visible && SubtitleOverlayBridge.ass-anchor-active)
                            : subtitle-box.visible;
                        property <length> sub-top: SubtitleOverlayBridge.ass-native-active
                            ? (self.has-sub-anchor ? SubtitleOverlayBridge.ass-anchor-top : (parent.height - 62px))
                            : (subtitle-box.visible ? subtitle-box.y : (parent.height - 62px));
                        property <length> sub-bottom: SubtitleOverlayBridge.ass-native-active
                            ? (self.has-sub-anchor ? SubtitleOverlayBridge.ass-anchor-bottom : (parent.height - 62px))
                            : (subtitle-box.visible ? (subtitle-box.y + subtitle-box.height) : (parent.height - 62px));
                        property <length> anchor-center-x: SubtitleOverlayBridge.ass-native-active
                            ? (SubtitleOverlayBridge.ass-anchor-x + SubtitleOverlayBridge.ass-anchor-width / 2)
                            : (subtitle-box.x + subtitle-box.width / 2 + root.popup-offset-x);
                        property <length> space-above: max(0px, self.sub-top - 22px);
                        property <length> space-below: max(0px, parent.height - self.sub-bottom - 22px);
                        property <bool> place-below: self.has-sub-anchor && self.space-above < 220px && self.space-below > self.space-above;

                        width: round(min(
                            PopupBridge.css-popup-width > 0px ? PopupBridge.css-popup-width : root.popup-configured-width,
                            parent.width - 40px
                        ) / 1px) * 1px;
                        height: round(min(
                            PopupBridge.css-popup-height > 0px ? PopupBridge.css-popup-height : root.popup-configured-height,
                            self.has-sub-anchor
                                ? max(80px, self.place-below ? self.space-below : self.space-above)
                                : (parent.height - 80px)
                        ) / 1px) * 1px;
                        x: round(min(
                            parent.width - self.width - 20px,
                            max(20px, self.anchor-center-x - self.width / 2)
                        ) / 1px) * 1px;
                        y: round((self.place-below
                            ? min(parent.height - self.height - 10px, self.sub-bottom + 12px)
                            : max(10px, self.sub-top - self.height - 12px)) / 1px) * 1px;
                        is-open: root.dict-open;
                        anki-enabled: root.anki-enabled;
                        show-anki-checkbox: root.show-anki-checkbox;
                        added-note-id: root.anki-added-note-id;
                        added-result-index: root.anki-added-result-index;
                        headword: root.dict-query;
                        reading: root.dict-reading;
                        pitch-accent: root.dict-pitch-accent;
                        freq-rank: root.dict-freq-rank;
                        jpdb-rank: root.dict-jpdb-rank;
                        results: root.popup-results;
                        has-more-results: root.popup-loaded-count < root.dict-results.length;
                        audio-sources: root.popup-audio-sources;
                        audio-sources-loading: root.popup-audio-sources-loading;
                        selected-audio-source: root.popup-selected-audio-source;
                        close-requested => { root.dismiss-definition(); }
                        add-anki-note(idx) => { root.add-anki-note(idx); }
                        browse-anki-note(id) => { root.browse-anki-note(id); }
                        play-audio(word, reading) => { root.play-audio-for-word(word, reading); }
                        request-audio-sources(word, reading) => { root.popup-audio-sources-requested(word, reading); }
                        kanji-info(word) => { root.lookup-kanji(word); }
                        toggle-select-definition(idx) => { root.toggle-definition-selection(idx); }
                        toggle-term-collapse(idx) => { root.toggle-term-collapse(idx); }
                        load-more-results(force) => { root.load-more-definition-results(force); }
                        select-audio-source(idx) => { root.popup-selected-audio-source = idx; }
                        open-rich-link(link) => { root.open-glossary-link(link); }
                    }

                    // Yomitan-style floating recursive child popup (integer-rounded geometry preserved)
                    nested-yomi-card := NestedYomitanPopup {
                        is-open: root.dict-open;
                        viewport-width: round(parent.width / 1px) * 1px;
                        viewport-height: round(parent.height / 1px) * 1px;
                        parent-x: round(yomi-card.x / 1px) * 1px;
                        parent-y: round(yomi-card.y / 1px) * 1px;
                        configured-width: root.popup-configured-width;
                        configured-height: root.popup-configured-height;
                        anki-enabled: root.anki-enabled;
                        show-anki-checkbox: root.show-anki-checkbox;
                        added-note-id: root.anki-added-note-id;
                        added-result-index: root.anki-added-result-index;
                        audio-sources: root.popup-audio-sources;
                        audio-sources-loading: root.popup-audio-sources-loading;
                        selected-audio-source: root.popup-selected-audio-source;
                        browse-anki-note(id) => { root.browse-anki-note(id); }
                        play-audio(word, reading) => { root.play-audio-for-word(word, reading); }
                        request-audio-sources(word, reading) => { root.popup-audio-sources-requested(word, reading); }
                        select-audio-source(idx) => { root.popup-selected-audio-source = idx; }
                        open-rich-link(link) => { root.open-glossary-link(link); }
                        close-parent-requested => { root.dismiss-definition(); }
                    }

                    // Status Toast (content-fit pill centered over video-area with opacity fade)
                    status-toast := Rectangle {
                        property <bool> active: root.status-message != "";
                        opacity: self.active ? 1.0 : 0.0;
                        animate opacity { duration: 150ms; }
                        visible: self.active || self.opacity > 0.01;
                        width: min(max(160px, toast-lbl.preferred-width + 32px), parent.width - 48px);
                        height: max(36px, toast-lbl.preferred-height + 16px);
                        x: (parent.width - self.width) / 2;
                        y: parent.height - 112px;
                        background: MementoPalette.surface-elevated;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: MementoPalette.border-light;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: MementoPalette.shadow;

                        toast-lbl := Text {
                            x: 16px;
                            width: parent.width - 32px;
                            height: parent.height;
                            text: root.status-message;
                            color: MementoPalette.text;
                            font-size: 12.5px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // Bottom OSC Bar (Floating, 50px)
                    osc := PlayerOscBar {
                        property <bool> target-visible: root.osc-visible && !root.ocr-mode;
                        opacity: self.target-visible ? 1.0 : 0.0;
                        animate opacity { duration: max(0, root.osc-fade-ms) * 1ms; }
                        visible: self.target-visible || self.opacity > 0.01;
                        x: 16px;
                        y: parent.height - self.height - 12px;
                        width: parent.width - 32px;
                        playing: root.is-playing;
                        position: root.position;
                        duration: root.duration;
                        volume: root.volume;
                        volume-max: root.volume-max;
                        is-muted: root.is-muted;
                        current-time: root.current-time;
                        duration-time: root.duration-time;
                        is-fullscreen: root.is-fullscreen;
                        sub-drawer-open: root.sub-drawer-open;
                        ocr-enabled: root.ocr-enabled;
                        chapters: root.chapters;
                        chapter-marks: root.chapter-marks;
                        toggle-play => { root.toggle-play(); }
                        seek(val) => { root.seek-to(val); }
                        subtitle-seek(dir) => { root.sub-seek(dir); }
                        playlist-prev => { root.playlist-prev(); }
                        playlist-next => { root.playlist-next(); }
                        toggle-mute => { root.toggle-mute(); }
                        start-ocr => { root.start-ocr(); }
                        volume-changed(val) => { root.set-volume(val); }
                        timeline-hover-moved(sec) => { root.timeline-hover-moved(sec); }
                        toggle-sub-list => {
                            root.sub-drawer-open = !root.sub-drawer-open;
                        }
                        toggle-fullscreen => { root.toggle-fullscreen(); }
                        activity => { root.osc-activity(); }
                        interacted => { root.dismiss-definition(); }
                    }

                    // Timeline Hover Preview Card (Thumbnail + Chapter Label + Timestamp)
                    if root.osc-visible && !root.ocr-mode && osc.timeline-hovered && root.duration > 0.0 : Rectangle {
                        property <bool> has-thumb: root.preview-thumbnails-enabled && root.thumbnail-frame.width > 0;
                        width: self.has-thumb ? 212px : max(84px, preview-col.preferred-width + 20px);
                        height: preview-col.preferred-height + 16px;
                        x: max(16px, min(parent.width - self.width - 16px, osc.x + osc.hover-x - self.width / 2));
                        y: max(10px, osc.y - self.height - 8px);
                        background: MementoPalette.surface-elevated;
                        border-width: 1px;
                        border-color: MementoPalette.border-light;
                        border-radius: 8px;
                        drop-shadow-blur: 14px;
                        drop-shadow-color: MementoPalette.shadow;

                        preview-col := VerticalLayout {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            height: self.preferred-height;
                            spacing: 4px;
                            alignment: center;

                            if root.preview-thumbnails-enabled && root.thumbnail-frame.width > 0 : Image {
                                width: 192px;
                                height: 108px;
                                source: root.thumbnail-frame;
                                image-fit: contain;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.hover-chapter-title != "" : Text {
                                text: root.hover-chapter-title;
                                font-size: 11px;
                                font-weight: 600;
                                color: MementoPalette.cyan-accent;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: root.format-timestamp(min(root.duration, osc.hover-time));
                                font-family: "monospace";
                                font-size: 12px;
                                font-weight: 700;
                                color: MementoPalette.text;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Drag a rectangle over the current video frame for OCR.
                    if root.ocr-mode : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        ocr-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: crosshair;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up) {
                                    let min-x = min(self.pressed-x, self.mouse-x);
                                    let min-y = min(self.pressed-y, self.mouse-y);
                                    let max-x = max(self.pressed-x, self.mouse-x);
                                    let max-y = max(self.pressed-y, self.mouse-y);
                                    let box-w = max-x - min-x;
                                    let box-h = max-y - min-y;
                                    if (box-w >= 6px && box-h >= 6px && self.width > 0px && self.height > 0px) {
                                        root.ocr-region(
                                            min-x / self.width,
                                            min-y / self.height,
                                            box-w / self.width,
                                            box-h / self.height
                                        );
                                    }
                                    root.ocr-mode = false;
                                } else if (event.kind == PointerEventKind.cancel) {
                                    root.ocr-mode = false;
                                }
                            }
                        }
                        if ocr-touch.pressed : Rectangle {
                            x: min(ocr-touch.pressed-x, ocr-touch.mouse-x);
                            y: min(ocr-touch.pressed-y, ocr-touch.mouse-y);
                            width: max(1px, max(ocr-touch.pressed-x, ocr-touch.mouse-x) - self.x);
                            height: max(1px, max(ocr-touch.pressed-y, ocr-touch.mouse-y) - self.y);
                            background: MementoPalette.accent-subtle;
                            border-width: 2px;
                            border-color: MementoPalette.cyan-accent;
                        }
                    }
                }

                // Right Sidebar: Resizable Split Container for DictionarySearchPanel & SubtitleDrawerPanel
                sidebar-container := Rectangle {
                    width: (root.dict-search-open || root.sub-drawer-open) ? root.sidebar-width : 0px;
                    visible: self.width > 0px;
                    background: MementoPalette.surface-bg;

                    sidebar-bg-touch := TouchArea {
                        width: 100%;
                        height: 100%;

                        dict-panel := DictionarySearchPanel {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: !root.dict-search-open
                                ? 0px
                                : (root.sub-drawer-open
                                    ? max(140px, min(parent.height - 160px, parent.height * root.sidebar-split-ratio))
                                    : parent.height);
                            visible: root.dict-search-open;
                            results: root.dict-results;
                            query <=> root.dict-query;
                            search-changed(query) => {
                                if PopupBridge.rich-enabled {
                                    PopupBridge.panel-search-requested(query);
                                } else {
                                    root.search-dictionary(query);
                                }
                            }
                            lookup(word) => { root.lookup-word(word); }
                            close => { root.dict-search-open = false; f-scope.focus(); }
                        }

                        // Resizable horizontal splitter between DictionarySearchPanel and SubtitleDrawerPanel
                        if root.dict-search-open && root.sub-drawer-open : Rectangle {
                            x: 0px;
                            y: dict-panel.height;
                            width: parent.width;
                            height: 6px;
                            background: split-v-touch.pressed || split-v-touch.has-hover
                                ? MementoPalette.cyan-accent
                                : MementoPalette.border;
                            animate background { duration: 100ms; }
                            split-v-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: ns-resize;
                                changed has-hover => { root.split-v-hovered = self.has-hover; }
                                moved => {
                                    if self.pressed && sidebar-container.height > 200px {
                                        let delta = (self.mouse-y - self.pressed-y) / sidebar-container.height;
                                        root.sidebar-split-ratio = max(0.2, min(0.8, root.sidebar-split-ratio + delta));
                                    }
                                }
                            }
                        }

                        sub-drawer := SubtitleDrawerPanel {
                            x: 0px;
                            y: root.dict-search-open ? (dict-panel.height + 6px) : 0px;
                            width: parent.width;
                            height: !root.sub-drawer-open
                                ? 0px
                                : (root.dict-search-open
                                    ? max(0px, parent.height - dict-panel.height - 6px)
                                    : parent.height);
                            visible: root.sub-drawer-open;
                            entries: root.subtitle-entries;
                            secondary-entries: root.secondary-subtitle-entries;
                            has-secondary: root.secondary-sid > 0;
                            active-tab <=> root.subtitle-drawer-tab;
                            search-text <=> root.subtitle-search-query;
                            current-match: root.subtitle-search-current-match;
                            total-matches: root.subtitle-search-total-matches;
                            focused-match-row: root.subtitle-search-focused-row;
                            show-timestamps <=> root.sub-list-show-timestamps;
                            ignore-whitespace <=> root.subtitle-search-ignore-whitespace;
                            auto-seek <=> root.subtitle-search-auto-seek;
                            bg-color: root.sub-list-bg-color;
                            text-color: root.sub-list-text-color;
                            hover-color: root.sub-list-hover-color;
                            selected-color: root.sub-list-selected-color;
                            selected-hover-color: root.sub-list-selected-hover-color;
                            primary-font-family: root.sub-list-primary-font-family;
                            primary-font-size: root.sub-list-primary-font-size;
                            primary-font-bold: root.sub-list-primary-font-bold;
                            primary-font-italic: root.sub-list-primary-font-italic;
                            secondary-font-family: root.sub-list-secondary-font-family;
                            secondary-font-size: root.sub-list-secondary-font-size;
                            secondary-font-bold: root.sub-list-secondary-font-bold;
                            secondary-font-italic: root.sub-list-secondary-font-italic;
                            format-timestamp(sec) => { root.format-timestamp(sec) }
                            row-clicked(idx, extend-range) => { root.dismiss-definition(); root.select-row(idx, extend-range); f-scope.focus(); }
                            range-dragged(first, last, begin) => { root.dismiss-definition(); root.select-subtitle-range(first, last, begin); }
                            row-activated(idx, sec) => { root.dismiss-definition(); root.mark-subtitle-row(idx); root.seek-to(sec); f-scope.focus(); }
                            search-changed(q) => { root.dismiss-definition(); root.search-subtitles(q); }
                            next-match => { root.next-subtitle-search-match(); }
                            prev-match => { root.prev-subtitle-search-match(); }
                            tab-changed(tab) => { root.subtitle-drawer-tab-changed(tab); }
                            toggle-timestamps(show) => { root.sub-list-show-timestamps-toggled(show); }
                            ignore-whitespace-changed(enabled) => { root.subtitle-search-ignore-whitespace-changed(enabled); }
                            auto-seek-changed(enabled) => { root.subtitle-search-auto-seek-changed(enabled); }
                            user-scrolled => { root.subtitle-drawer-user-scrolled(); }
                            close-requested => { root.sub-drawer-open = false; f-scope.focus(); }
                        }
                    }

                    // Left-edge draggable width resize handle (8px hit target over 1px divider + hover grip pill)
                    Rectangle {
                        x: -3px;
                        y: 0px;
                        width: 8px;
                        height: parent.height;
                        background: transparent;

                        // 1px visual divider line
                        Rectangle {
                            x: 3px;
                            y: 0px;
                            width: 1px;
                            height: parent.height;
                            background: split-h-touch.pressed || split-h-touch.has-hover
                                ? MementoPalette.cyan-accent
                                : MementoPalette.border;
                            animate background { duration: 100ms; }
                        }

                        // Subtle centered grip pill on hover/drag
                        Rectangle {
                            x: 2px;
                            y: (parent.height - self.height) / 2;
                            width: 3px;
                            height: 36px;
                            border-radius: 1.5px;
                            background: split-h-touch.pressed || split-h-touch.has-hover
                                ? MementoPalette.cyan-accent
                                : MementoPalette.border-light;
                            opacity: split-h-touch.pressed || split-h-touch.has-hover ? 1.0 : 0.45;
                            animate opacity { duration: 120ms; }
                            animate background { duration: 100ms; }
                        }

                        split-h-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: ew-resize;
                            moved => {
                                if self.pressed {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.sidebar-width = max(260px, min(root.width - 360px, root.sidebar-width - delta));
                                }
                            }
                        }
                    }
                }
            }
        }

        // Dismiss overlay when any menu is open (click outside menu bar to close)
        if menu-bar.open-menu >= 0 : TouchArea {
            y: 30px;
            width: 100%;
            height: parent.height - 30px;
            clicked => {
                menu-bar.open-menu = -1;
            }
        }

        // Dropdown Menus Overlay
        menu-drop := MenuDropdown {
            menu-index: menu-bar.open-menu;
            max-dropdown-height: max(160px, root.height - 48px);
            audio-tracks: root.audio-tracks;
            subtitle-tracks: root.subtitle-tracks;
            recent-files: root.recent-files;
            recent-file-labels: root.recent-file-labels;
            anki-profiles: root.anki-profiles;
            audio-id: root.audio-id;
            primary-sid: root.primary-sid;
            secondary-sid: root.secondary-sid;
            anki-profile: root.anki-profile;
            anki-enabled: root.anki-enabled;
            asr-enabled: root.asr-enabled;
            asr-running: root.asr-running;
            asr-track-selected: root.asr-track-selected;
            ocr-enabled: root.ocr-enabled;
            furigana-enabled: root.furigana-enabled;
            auto-pause: root.auto-pause;
            subtitles-visible: root.subtitles-visible;
            furigana-visible: root.furigana-visible;
            key-open-file: root.key-open-file;
            key-open-url: root.key-open-url;
            key-show-search: root.key-show-search;
            key-show-sub-list: root.key-show-sub-list;
            key-start-ocr: root.key-start-ocr;
            key-sub-auto-pause: root.key-sub-auto-pause;
            key-sub-show: root.key-sub-show;
            key-sub-furigana: root.key-sub-furigana;
            key-sub-increase-size: root.key-sub-increase-size;
            key-sub-decrease-size: root.key-sub-decrease-size;
            key-sub-move-up: root.key-sub-move-up;
            key-sub-move-down: root.key-sub-move-down;
            open-file => { root.open-file(); }
            open-url => { root.open-url(); }
            open-recent(path) => { root.open-recent(path); }
            clear-recent => { root.clear-recent(); }
            select-audio-track(id) => { root.select-audio-track(id); }
            select-subtitle-track(id) => { root.select-subtitle-track(id); }
            select-secondary-subtitle-track(id) => { root.select-secondary-subtitle-track(id); }
            select-asr => { root.select-asr(); }
            select-anki-profile(name) => { root.select-anki-profile(name); }
            auto-pause-changed(enabled) => { root.auto-pause-changed(enabled); }
            adjust-subtitle-scale(delta) => { root.adjust-subtitle-scale(delta); }
            adjust-subtitle-offset(delta) => { root.adjust-subtitle-offset(delta); }
            subtitles-visible-changed(visible) => { root.subtitles-visible-changed(visible); }
            furigana-visible-changed(visible) => { root.furigana-visible-changed(visible); }
            add-subtitle => { root.add-subtitle(); }
            toggle-search => {
                root.dict-search-open = !root.dict-search-open;
            }
            toggle-sub-drawer => {
                root.sub-drawer-open = !root.sub-drawer-open;
            }
            start-ocr => { root.start-ocr(); }
            open-options => { root.open-options(); }
            open-config => { root.open-config(); }
            check-updates => { root.check-updates(); }
            show-about => { root.about-open = true; }
            close-menu => { menu-bar.open-menu = -1; root.osc-activity(); }
        }

        // Open Stream URL Modal (standardized onto ModalDialog)
        url-modal := OpenUrlModal {
            visible: root.url-dialog-open;
            dialog-enabled: root.url-dialog-open;
            url-text <=> root.url-dialog-text;
            dismissed => {
                root.url-dialog-open = false;
                f-scope.focus();
            }
            submitted(val) => {
                root.url-dialog-open = false;
                root.open-url-submitted(val);
                f-scope.focus();
            }
        }

        // About Memento Modal (standardized onto ModalDialog)
        if root.about-open : AboutModal {
            app-version: root.app-version;
            dismissed => {
                root.about-open = false;
                f-scope.focus();
            }
            open-link(url) => { root.open-external-link(url); }
        }

        // Update Check & First-Launch Auto-Update Opt-In Modal
        // Matches ModalDialog tokens/geometry while keeping exact `MementoApp::update-*` test IDs.
        if root.update-dialog-open : Rectangle {
            width: 100%;
            height: 100%;
            background: MementoPalette.scrim;
            TouchArea {
                clicked => {
                    if root.update-dialog-opt-in {
                        root.update-opt-in-responded(false);
                    } else {
                        root.update-dialog-open = false;
                        root.update-dialog-dismissed();
                    }
                    f-scope.focus();
                }
            }
            update-card := Rectangle {
                width: min(460px, parent.width - 48px);
                height: min(update-col.preferred-height, parent.height - 48px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: MementoPalette.surface-elevated;
                border-color: MementoPalette.border-light;
                border-width: 1px;
                border-radius: 12px;
                drop-shadow-blur: 28px;
                drop-shadow-color: MementoPalette.shadow;
                // Click-shield prevents clicks inside the dialog from dismissing it
                TouchArea {}
                // Subtle top accent highlight
                Rectangle {
                    x: 16px;
                    y: 0px;
                    width: parent.width - 32px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: MementoPalette.cyan-accent;
                }
                update-col := VerticalLayout {
                    width: parent.width;
                    padding: 22px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 7px;
                                    background: MementoPalette.accent-subtle;
                                    border-width: 1px;
                                    border-color: MementoPalette.cyan-accent;
                                    Text {
                                        text: "↻";
                                        color: MementoPalette.cyan-accent;
                                        font-size: 15px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: root.update-dialog-title != "" ? root.update-dialog-title : "Updates";
                                color: MementoPalette.text;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        if !root.update-dialog-opt-in && root.update-dialog-release-tag != "" : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 24px;
                                width: tag-lbl.preferred-width + 16px;
                                border-radius: 12px;
                                background: MementoPalette.accent-muted;
                                border-width: 1px;
                                border-color: MementoPalette.cyan-accent;
                                tag-lbl := Text {
                                    text: root.update-dialog-release-tag;
                                    color: MementoPalette.cyan-text;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    update-message-box := Rectangle {
                        width: update-card.width - 44px;
                        height: update-message-text.preferred-height;
                        update-message-text := Text {
                            width: parent.width;
                            text: root.update-dialog-message;
                            color: MementoPalette.text-secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: MementoPalette.border;
                    }

                    // Opt-in footer: [No] [Yes (primary)]
                    if root.update-dialog-opt-in : HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        update-btn-no := ActionButton {
                            width: 88px;
                            text: "No";
                            ghost: true;
                            clicked => {
                                root.update-opt-in-responded(false);
                                f-scope.focus();
                            }
                        }
                        update-btn-yes := ActionButton {
                            width: 88px;
                            text: "Yes";
                            primary: true;
                            clicked => {
                                root.update-opt-in-responded(true);
                                f-scope.focus();
                            }
                        }
                    }

                    // Release footer: [Dismiss] [Open GitHub Releases (primary)]
                    if !root.update-dialog-opt-in : HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        update-btn-dismiss := ActionButton {
                            width: 96px;
                            text: "Dismiss";
                            ghost: root.update-dialog-release-url != "" && root.update-dialog-release-tag != "";
                            primary: root.update-dialog-release-tag == "";
                            clicked => {
                                root.update-dialog-open = false;
                                root.update-dialog-dismissed();
                                f-scope.focus();
                            }
                        }
                        if root.update-dialog-release-url != "" && (root.update-dialog-release-tag != "" || root.update-dialog-title == "Update Check Failed") : update-btn-releases := ActionButton {
                            text: "Open GitHub Releases";
                            primary: root.update-dialog-release-tag != "";
                            clicked => {
                                root.open-external-link(root.update-dialog-release-url);
                            }
                        }
                    }
                }
            }
        }
    }
}
