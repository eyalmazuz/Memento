import { MementoPalette } from "palette.slint";
import { ListView, LineEdit, Button, CheckBox, ComboBox, Slider, ScrollView } from "std-widgets.slint";
import { SettingsWindow } from "settings.slint";
import { AnkiHelpWindow, HelpArgument, HelpMarker } from "anki_help.slint";

export { MementoPalette, SettingsWindow, AnkiHelpWindow, HelpArgument, HelpMarker }

export struct SubEntry {
    id: int,
    start: float,
    end: float,
    text: string,
    selected: bool,
    is_active: bool,
}

export struct PitchMora { text: string, high: bool, rises_after: bool, falls_after: bool }
export struct PitchGraph { dictionary: string, position: int, mora: [PitchMora] }
export struct PopupFrequency { dictionary: string, value: string }
export struct PopupFrequencyLine { entries: [PopupFrequency] }
export struct PopupGlossaryBlock { text: string, kind: int, href: string }
export struct PopupAudioSource { name: string, index: int }

export struct DictResult {
    index: int,
    expression: string,
    reading: string,
    pos_tags: string,
    dict_name: string,
    glossary: string,
    glossary-blocks: [PopupGlossaryBlock],
    notes: string,
    example_ja: string,
    example_en: string,
    selected: bool,
    score: int,
    is_kanji: bool,
    has_kanji: bool,
    term_start: bool,
    term_end: bool,
    collapsed: bool,
    pitch_graphs: [PitchGraph],
    frequencies: [PopupFrequency],
}

export struct SubtitleWord {
    text: string,
    reading: string,
    query: string,
    index: int,
}

export struct SubtitleLine {
    words: [SubtitleWord],
}

export struct PlayerTrack {
    id: int,
    label: string,
    selected: bool,
}


// ── Floating Yomitan Dictionary Card ────────────────────────────────────
// Japanese text uses one family; Slint accepts a single name, not a CSS list.
component DictionaryText inherits Text {
    font-family: "Noto Sans CJK JP";
}

export global PopupLayout {
    pure callback frequency-lines([PopupFrequency], float) -> [PopupFrequencyLine];
}

component YomitanPopup inherits Rectangle {
    in property <string> headword: "";
    in property <string> reading: "";
    in property <string> pitch-accent: "";
    in property <string> freq-rank: "";
    in property <string> jpdb-rank: "";
    in property <[DictResult]> results;
    in property <bool> has-more-results: false;
    in property <[PopupAudioSource]> audio-sources;
    in property <bool> audio-sources-loading: false;
    in-out property <int> selected-audio-source: -1;
    in-out property <bool> audio-menu-open: false;
    in-out property <string> audio-menu-expression: "";
    in-out property <string> audio-menu-reading: "";
    in property <bool> is-open: false;
    in property <bool> anki-enabled: false;
    in property <bool> show-anki-checkbox: true;
    in property <string> added-note-id: "";
    in property <int> added-result-index: -1;
    callback close-requested();
    callback add-anki-note(int);
    callback browse-anki-note(string);
    callback play-audio(string, string);
    callback request-audio-sources(string, string);
    callback kanji-info(string);
    callback toggle-select-definition(int);
    callback toggle-term-collapse(int);
    callback select-audio-source(int);
    callback open-rich-link(string);
    callback reset-scroll();
    callback load-more-results(bool);
    out property <bool> needs-more: root.is-open && root.has-more-results
        && definition-list.height > 0px
        && definition-list.viewport-height + definition-list.viewport-y <= definition-list.height + 180px;

    visible: root.is-open && root.results.length > 0;
    width: 480px;
    height: 500px;
    background: #1C2024;
    border-width: 1px;
    border-color: #384046;
    border-radius: 8px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000DD;

    changed is-open => {
        root.audio-menu-open = false;
        if root.is-open {
            definition-list.viewport-y = 0px;
            definition-list.fill-viewport();
        }
    }
    reset-scroll => { definition-list.viewport-y = 0px; root.audio-menu-open = false; }

    // Keep clicks on the card's padding from reaching the video underneath.
    TouchArea { }

    popup-content := VerticalLayout {
        cache-rendering-hint: true;
        padding: 12px;
        spacing: 0px;

        // Definitions List
        definition-list := ScrollView {
            vertical-stretch: 1;
            callback fill-viewport();
            fill-viewport => {
                if root.needs-more {
                    root.load-more-results(false);
                }
            }
            changed viewport-y => { self.fill-viewport(); }
            changed viewport-height => { self.fill-viewport(); }
            changed height => { self.fill-viewport(); }
            definition-content := VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                spacing: 0px;
                for res[idx] in root.results : Rectangle {
                width: parent.width - 6px;
                height: res.collapsed && !res.term-start ? 0px : term-segment.height + ((res.term-end || (res.collapsed && res.term-start)) ? 10px : 0px);
                visible: !res.collapsed || res.term-start;
                background: transparent;
                term-segment := Rectangle {
                    width: parent.width;
                    height: card-content.preferred-height + 16px;
                    background: transparent;
                    if res.term-start && res.index > 1 : Rectangle { y: 0px; height: 2px; width: parent.width; background: #52616B; }
                    if !res.term-end && !res.collapsed : Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: #30373D; }
                    card-content := VerticalLayout {
                    x: 0px;
                    y: 6px;
                    width: parent.width;
                    height: self.preferred-height;
                    spacing: 6px;

                    if res.term-start : HorizontalLayout {
                        width: parent.width;
                        spacing: 6px;
                        min-height: 34px;
                        term-title := VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            if res.reading != "" && res.reading != res.expression : DictionaryText {
                                text: res.reading;
                                height: self.preferred-height;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: #94A3B8;
                            }
                            DictionaryText {
                                text: res.expression;
                                height: self.preferred-height;
                                wrap: word-wrap;
                                font-size: 23px;
                                font-weight: 700;
                                font-family: "Noto Sans CJK JP";
                                color: #FFFFFF;
                            }
                        }
                        if root.added-note-id != "" && root.added-result-index == res.index - 1 : Rectangle {
                            width: 62px;
                            height: 28px;
                            border-radius: 3px;
                            background: browse-touch.has-hover ? #385D75 : #24465C;
                            DictionaryText {
                                text: "Browse";
                                color: #BAE6FD;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            browse-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.browse-anki-note(root.added-note-id); }
                            }
                        }
                        if !res.is-kanji && res.has-kanji : Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: kanji-touch.has-hover ? #384046 : transparent;
                            DictionaryText { text: "字"; color: #CBD5E1; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                            kanji-touch := TouchArea { mouse-cursor: pointer; clicked => { root.kanji-info(res.expression); } }
                        }
                        if !res.is-kanji : Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: row-audio-touch.has-hover ? #384046 : #2B3238;
                            Image {
                                x: 6px;
                                y: 6px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("icons/volume-on.svg");
                                colorize: #CBD5E1;
                            }
                            row-audio-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { if (!root.audio-menu-open) { root.play-audio(res.expression, res.reading); } }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        root.audio-menu-expression = res.expression;
                                        root.audio-menu-reading = res.reading;
                                        root.audio-menu-open = true;
                                        root.request-audio-sources(res.expression, res.reading);
                                    }
                                }
                            }
                        }
                        if root.anki-enabled : Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: row-anki-touch.has-hover ? #2D624D : #20503E;
                            DictionaryText {
                                text: "+";
                                color: #A7F3D0;
                                font-size: 20px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            row-anki-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add-anki-note(res.index - 1); }
                            }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: collapse-touch.has-hover ? #384046 : #2B3238;
                            DictionaryText { text: res.collapsed ? "›" : "⌄"; color: #CBD5E1; font-size: 19px; horizontal-alignment: center; vertical-alignment: center; }
                            collapse-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-term-collapse(res.index - 1); } }
                        }
                        // Leave room for the close control pinned above the list.
                        if res.index == 1 : Rectangle { width: 28px; height: 28px; }
                    }

                    if !res.collapsed && res.index == 1 && res.frequencies.length == 0 && (root.jpdb-rank != "" || root.freq-rank != "" || root.pitch-accent != "") : HorizontalLayout {
                        width: parent.width;
                        spacing: 6px;
                        alignment: start;
                        if root.jpdb-rank != "" : DictionaryText { text: "JPDB " + root.jpdb-rank; color: #6EE7B7; font-size: 11px; }
                        if root.freq-rank != "" : DictionaryText { text: root.freq-rank; color: #6EE7B7; font-size: 11px; }
                        if root.pitch-accent != "" : DictionaryText { text: root.pitch-accent; color: #C4B5FD; font-size: 11px; }
                    }

                    if !res.collapsed && res.term-start && res.frequencies.length > 0 : VerticalLayout {
                        width: parent.width;
                        spacing: 3px;
                        for line in PopupLayout.frequency-lines(res.frequencies, self.width / 1px) : HorizontalLayout {
                            width: parent.width;
                            alignment: start;
                            spacing: 4px;
                            for frequency in line.entries : Rectangle {
                                width: min(frequency-label.preferred-width + 10px, parent.width);
                                height: max(18px, frequency-label.preferred-height + 2px);
                                background: #07513E;
                                border-radius: 3px;
                                frequency-label := DictionaryText {
                                    x: 5px;
                                    width: parent.width - 10px;
                                    height: parent.height;
                                    text: frequency.dictionary + " " + frequency.value;
                                    font-size: 10px;
                                    color: #9CE5C7;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if !res.collapsed && res.term-start : VerticalLayout {
                        spacing: 4px;
                        for pitch in res.pitch-graphs : Rectangle {
                            width: parent.width;
                            height: 28px;
                            background: transparent;
                            HorizontalLayout {
                                width: parent.width;
                                height: 28px;
                                spacing: 8px;
                                alignment: start;
                                DictionaryText {
                                    text: pitch.dictionary + " [" + pitch.position + "]";
                                    width: min(self.preferred-width, parent.width * 0.4);
                                    horizontal-stretch: 0;
                                    font-size: 11px;
                                    color: #C4B5FD;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    width: self.preferred-width;
                                    height: 28px;
                                    horizontal-stretch: 0;
                                    spacing: 0px;
                                    for mora in pitch.mora : Rectangle {
                                        width: max(18px, mora-label.preferred-width + 3px);
                                        height: 28px;
                                        Rectangle { x: 0px; y: mora.high ? 3px : 11px; width: parent.width; height: 1px; background: #B9A1E8; }
                                        if mora.rises-after || mora.falls-after : Rectangle { x: parent.width - 1px; y: 3px; width: 1px; height: 9px; background: #B9A1E8; }
                                        mora-label := DictionaryText { text: mora.text; y: 13px; horizontal-alignment: center; width: parent.width; font-size: 10px; color: #D9CFF0; }
                                    }
                                }
                            }
                        }
                    }

                    // Header row: POS tags, Dictionary tag
                    if !res.collapsed : HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        if root.show-anki-checkbox : Rectangle {
                            width: 17px;
                            height: 17px;
                            border-width: 1px;
                            border-color: res.selected ? #34D399 : #94A3B8;
                            border-radius: 3px;
                            background: res.selected ? #047857 : transparent;
                            DictionaryText {
                                text: res.selected ? "✓" : "";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 13px;
                            }
                            select-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-select-definition(res.index - 1); }
                            }
                        }

                        // Part of Speech badge(s)
                        if res.pos-tags != "" : Rectangle {
                            height: 18px;
                            background: #2b3238;
                            border-radius: 3px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                DictionaryText {
                                    text: res.pos-tags;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #cbd5e1;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Dictionary Source Badge
                        if res.dict-name != "" : Rectangle {
                            height: 18px;
                            background: #6D28D9;
                            border-radius: 3px;
                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;
                                DictionaryText {
                                    text: res.dict-name;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #EDE9FE;
                                    vertical-alignment: center;
                                }
                            }
                        }

                    }

                    // Definition Meaning Text
                    if !res.collapsed && res.glossary-blocks.length > 0 : VerticalLayout {
                        width: parent.width;
                        spacing: 4px;
                        for block in res.glossary-blocks : Rectangle {
                            width: parent.width;
                            height: rich-text.preferred-height + 2px;
                            rich-text := DictionaryText {
                                width: parent.width;
                                height: self.preferred-height;
                                text: block.kind == 2 ? "◦  " + block.text : block.text;
                                wrap: word-wrap;
                                font-size: block.kind == 1 ? 13px : 15px;
                                font-weight: block.kind == 1 ? 700 : 400;
                                color: !res.selected ? #87929C : block.kind == 3 ? #93C5FD : block.kind == 1 ? #D8C9FC : #FFFFFF;
                            }
                            if block.href != "" : TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-rich-link(block.href); }
                            }
                        }
                    }
                    if !res.collapsed && res.glossary-blocks.length == 0 : DictionaryText {
                        width: parent.width;
                        text: res.glossary;
                        font-size: 15px;
                        font-weight: 400;
                        color: res.selected ? #FFFFFF : #87929C;
                        wrap: word-wrap;
                        height: self.preferred-height;
                    }

                    // Japanese Example Sentence
                    if !res.collapsed && res.example-ja != "" : HorizontalLayout {
                        width: parent.width;
                        spacing: 5px;
                        Rectangle {
                            width: 16px;
                            Image { y: 4px; width: 16px; height: 11px; source: @image-url("icons/flag-jp.svg"); }
                        }
                        DictionaryText {
                            text: res.example-ja;
                            font-size: 13px;
                            color: #E2E8F0;
                            wrap: word-wrap;
                            height: self.preferred-height;
                            horizontal-stretch: 1;
                        }
                    }

                    // English Example Translation
                    if !res.collapsed && res.example-en != "" : HorizontalLayout {
                        width: parent.width;
                        spacing: 5px;
                        Rectangle {
                            width: 16px;
                            Image { y: 4px; width: 16px; height: 11px; source: @image-url("icons/flag-gb.svg"); }
                        }
                        DictionaryText {
                            text: res.example-en;
                            font-size: 12px;
                            color: #94A3B8;
                            wrap: word-wrap;
                            height: self.preferred-height;
                            horizontal-stretch: 1;
                        }
                    }

                    // Notes / Explanations
                    if !res.collapsed && res.notes != "" : DictionaryText {
                        width: parent.width;
                        text: "Note: " + res.notes;
                        font-size: 12px;
                        color: #94A3B8;
                        wrap: word-wrap;
                        height: self.preferred-height;
                    }

                    }
                }
                }
                if root.has-more-results : Rectangle {
                    width: parent.width - 6px;
                    height: 28px;
                    background: more-touch.has-hover ? #2A3238 : transparent;
                    DictionaryText {
                        text: "Show more results ↓";
                        font-size: 11px;
                        color: #84939E;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    more-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.load-more-results(true); }
                    }
                }
            }
        }
    }
    Rectangle {
        x: parent.width - 46px;
        y: 18px;
        width: 28px;
        height: 28px;
        border-radius: 3px;
        background: close-touch.has-hover ? #384046 : #1C2024;
        DictionaryText { text: "×"; font-size: 18px; color: #CBD5E1; horizontal-alignment: center; vertical-alignment: center; }
        close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.close-requested(); } }
    }
    if root.audio-menu-open : TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.audio-menu-open = false; }
    }
    if root.audio-menu-open : Rectangle {
        x: parent.width - self.width - 40px;
        y: 62px;
        width: 230px;
        height: min(source-items.preferred-height + 12px, parent.height - 75px);
        background: #252A2F;
        border-width: 1px;
        border-color: #52616B;
        border-radius: 4px;
        source-scroll := ScrollView {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            source-items := VerticalLayout {
            x: 0px; y: 0px; width: parent.width - 6px; height: self.preferred-height;
            alignment: start;
            if root.audio-sources-loading : DictionaryText {
                text: "Loading recordings…";
                height: 24px;
                color: #94A3B8;
                vertical-alignment: center;
            }
            if !root.audio-sources-loading && root.audio-sources.length == 0 : DictionaryText {
                text: "No audio sources available";
                height: 30px;
                color: #94A3B8;
                vertical-alignment: center;
            }
            for source in root.audio-sources : Rectangle {
                height: 30px;
                background: source-touch.has-hover ? #384046 : transparent;
                DictionaryText { text: (root.selected-audio-source == source.index ? "✓  " : "   ") + source.name; color: #E2E8F0; vertical-alignment: center; x: 7px; }
                source-touch := TouchArea { mouse-cursor: pointer; clicked => {
                    root.select-audio-source(source.index);
                    root.audio-menu-open = false;
                    root.play-audio(root.audio-menu-expression, root.audio-menu-reading);
                } }
            }
            }
        }
    }
}


component InteractiveSubtitleToken inherits Rectangle {
    in property <SubtitleWord> word;
    in property <length> type-size;
    in property <bool> selected;
    in property <bool> show-furigana: false;
    callback clicked();
    callback hovered(string, bool, bool, bool, bool);
    callback hover-state(bool);
    private property <length> ruby-space: root.show-furigana ? root.type-size * 0.7 + 2px : 0px;

    preferred-width: max(glyph.preferred-width, ruby.visible ? ruby.preferred-width : 0px);
    min-width: max(glyph.preferred-width, ruby.visible ? ruby.preferred-width : 0px);
    preferred-height: glyph.preferred-height + root.ruby-space;
    min-height: glyph.preferred-height + root.ruby-space;
    background: transparent;

    if root.selected && root.word.query != "" : Rectangle {
        x: glyph.x;
        y: glyph.y;
        width: glyph.width;
        height: glyph.height;
        background: #38a6d6;
    }

    ruby := Text {
        visible: root.show-furigana && root.word.reading != "";
        text: root.word.reading;
        width: self.preferred-width;
        height: self.preferred-height;
        wrap: no-wrap;
        font-size: root.type-size * 0.5;
        font-family: "Noto Sans CJK JP";
        color: #E2E8F0;
        x: (parent.width - self.preferred-width) / 2;
        y: max(0px, root.ruby-space - self.preferred-height);
    }

    glyph := Text {
        text: root.word.text;
        width: self.preferred-width;
        height: self.preferred-height;
        wrap: no-wrap;
        x: (parent.width - self.preferred-width) / 2;
        y: root.ruby-space;
        font-size: root.type-size;
        font-weight: 700;
        font-family: "Noto Sans CJK JP";
        color: white;
    }
    touch := TouchArea {
        x: glyph.x;
        y: glyph.y;
        width: glyph.width;
        height: glyph.height;
        enabled: root.word.query != "";
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.down) {
                root.hovered(
                    root.word.query,
                    event.modifiers.control,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.meta
                );
            } else if (event.kind == PointerEventKind.cancel) {
                root.hovered("", false, false, false, false);
            }
        }
        changed has-hover => {
            root.hover-state(self.has-hover);
            if !self.has-hover {
                root.hovered("", false, false, false, false);
            }
        }
    }
}

// ── OSC Bottom Controls Bar ─────────────────────────────────────────────
component PlayerOscBar inherits Rectangle {
    in property <bool> playing: false;
    in property <float> position: 0.0;
    in property <float> duration: 0.0;
    in property <float> volume: 100.0;
    in property <string> current-time: "00:00";
    in property <string> duration-time: "00:00";
    in property <bool> is-fullscreen: false;
    in property <bool> ocr-enabled: false;

    callback toggle-play();
    callback seek(float);
    callback subtitle-seek(int);
    callback playlist-prev();
    callback playlist-next();
    callback toggle-mute();
    callback volume-changed(float);
    callback toggle-sub-list();
    callback start-ocr();
    callback toggle-fullscreen();
    callback activity();
    callback interacted();

    height: 50px;
    background: MementoPalette.osc-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: #28283088;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000066;

    TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;

        // Left transport controls
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 4px;
            alignment: center;

            // Play / Pause
            btn-play := Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 4px;
                background: p-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                }
                p-touch := TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } clicked => { root.toggle-play(); } }
            }

            // Previous playlist item
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                background: sp-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: @image-url("icons/skip-previous.svg");
                }
                sp-touch := TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } clicked => { root.playlist-prev(); } }
            }

            // Previous subtitle cue
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                background: rw-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: @image-url("icons/fast-rewind.svg");
                }
                rw-touch := TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } clicked => { root.subtitle-seek(-1); } }
            }

            // Next subtitle cue
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                background: ff-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: @image-url("icons/fast-forward.svg");
                }
                ff-touch := TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } clicked => { root.subtitle-seek(1); } }
            }

            // Next playlist item
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                background: sn-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: @image-url("icons/skip-next.svg");
                }
                sn-touch := TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } clicked => { root.playlist-next(); } }
            }

            // Current Time label
            Text {
                text: root.current-time;
                font-size: 12px;
                color: #E2E8F0;
                vertical-alignment: center;
                min-width: 45px;
            }
        }

        // Center: Segmented Timeline Slider
        timeline := Rectangle {
            height: 24px;
            horizontal-stretch: 1;
            min-width: 120px;

            track := Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 6px;
                border-radius: 3px;
                background: #3E3E4C;

                // Cyan Progress Bar
                progress-fill := Rectangle {
                    x: 0;
                    y: 0;
                    width: max(0px, min(parent.width, parent.width * (root.position / max(1.0, root.duration))));
                    height: parent.height;
                    border-radius: 3px;
                    background: MementoPalette.cyan-accent;
                }

                // White Scrubber Knob
                if root.duration > 0.0 : Rectangle {
                    x: max(0px, min(parent.width - 12px, progress-fill.width - 6px));
                    y: (parent.height - 12px) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #FFFFFF;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: #00000088;
                }
            }

            slider-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); }
                }
                moved => {
                    if (self.pressed) {
                        let ratio = self.mouse-x / self.width;
                        root.seek(max(0.0, min(root.duration, root.duration * ratio)));
                    }
                }
                clicked => {
                    let ratio = self.mouse-x / self.width;
                    root.seek(max(0.0, min(root.duration, root.duration * ratio)));
                }
            }
        }

        // Right: Remaining time, Volume, Subtitle Drawer, Fullscreen
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            alignment: center;

            // Duration label
            Text {
                text: root.duration-time;
                font-size: 12px;
                color: #E2E8F0;
                vertical-alignment: center;
            }

            // Volume Icon / Mute Toggle Button
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: vol-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: root.volume > 0.0 ? @image-url("icons/volume-on.svg") : @image-url("icons/volume-off.svg");
                }
                vol-touch := TouchArea {
                    pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } }
                    clicked => { root.toggle-mute(); }
                }
            }

            // Mini Volume Slider
            Slider {
                width: 70px;
                minimum: 0.0;
                maximum: 100.0;
                value: root.volume;
                changed(val) => { root.interacted(); root.activity(); root.volume-changed(val); }
            }

            // Volume % Label
            Text {
                text: round(root.volume) + "%";
                font-size: 11px;
                color: #94A3B8;
                vertical-alignment: center;
                min-width: 32px;
            }

            // Subtitle Drawer Toggle Button
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: sub-t-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: @image-url("icons/list.svg");
                }
                sub-t-touch := TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } clicked => { root.toggle-sub-list(); } }
            }

            if root.ocr-enabled : Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: ocr-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: @image-url("icons/eye.svg");
                }
                ocr-touch := TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } clicked => { root.start-ocr(); } }
            }

            // Fullscreen Toggle Button
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: fs-touch.has-hover ? #2A2A32 : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 15px;
                    height: 15px;
                    source: root.is-fullscreen ? @image-url("icons/fullscreen-exit.svg") : @image-url("icons/fullscreen.svg");
                }
                fs-touch := TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } clicked => { root.toggle-fullscreen(); } }
            }
        }
    }
}

// ── Subtitle Drawer Panel ───────────────────────────────────────────────
component SubtitleDrawerPanel inherits Rectangle {
    in property <[SubEntry]> entries;
    in-out property <string> search-text: "";
    pure callback format-timestamp(float) -> string;
    callback row-clicked(int);
    callback row-activated(float);
    callback search-changed(string);

    background: #181A1D;
    border-width: 1px;
    border-color: #2D3136;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Header + Search
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Search subtitles (Ctrl+F)…";
                text <=> root.search-text;
                edited(val) => { root.search-changed(val); }
            }
        }

        // Subtitle Cues List
        ListView {
            for entry[idx] in root.entries : Rectangle {
                height: 36px;
                border-radius: 4px;
                background: entry.selected
                    ? (d-touch.has-hover ? #2A3B4C : #1E2D3D)
                    : (entry.is_active
                        ? #134E4A
                        : (d-touch.has-hover ? #262A30 : transparent));

                // Emerald indicator for active playing cue
                if entry.is_active : Rectangle {
                    x: 3px;
                    y: 4px;
                    width: 3px;
                    height: parent.height - 8px;
                    background: #10B981;
                    border-radius: 2px;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;
                    alignment: start;

                    // Timecode
                    Text {
                        width: 52px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        font-size: 11px;
                        font-weight: 600;
                        color: entry.selected ? #6EE7B7 : #8A949E;
                        text: root.format-timestamp(entry.start);
                    }

                    // Cue Text
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: 13px;
                        font-weight: entry.is_active ? 700 : 400;
                        color: entry.selected ? #FFFFFF : #F0F4F8;
                        overflow: elide;
                        text: entry.text;
                    }
                }

                d-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.row-clicked(idx); }
                    double-clicked => { root.row-activated(entry.start); }
                }
            }
        }
    }
}

// ── Manual Dictionary Search ───────────────────────────────────────────────
component DictionarySearchPanel inherits Rectangle {
    in property <[DictResult]> results;
    in-out property <string> query: "";
    callback search-changed(string);
    callback lookup(string);
    callback close();

    background: MementoPalette.surface-bg;
    border-color: MementoPalette.border;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            Text {
                text: "Search";
                font-size: 16px;
                font-weight: 700;
                color: #F1F5F9;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button { text: "×"; clicked => { root.close(); } }
        }
        LineEdit {
            placeholder-text: "Search Japanese…";
            text <=> root.query;
            edited(value) => { root.search-changed(value); }
        }
        ListView {
            for hit[index] in root.results : Rectangle {
                height: 124px;
                border-radius: 5px;
                background: result-touch.has-hover ? MementoPalette.list-hover : transparent;
                VerticalLayout {
                    padding: 7px;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: hit.expression;
                            font-size: 18px;
                            font-weight: 700;
                            color: #F8FAFC;
                            vertical-alignment: center;
                        }
                        Text {
                            text: hit.reading;
                            font-size: 12px;
                            color: #94A3B8;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: hit.dict-name;
                        font-size: 11px;
                        color: #72C9B9;
                        overflow: elide;
                    }
                    Text {
                        text: hit.glossary;
                        font-size: 12px;
                        color: #E2E8F0;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
                result-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.lookup(hit.expression); }
                }
            }
        }
    }
}

// ── Top Native Menu Bar ─────────────────────────────────────────────────
component TopMenuBar inherits Rectangle {
    in-out property <int> open-menu: -1; // -1: none, 0: Media, 1: Audio, 2: Subtitle, 3: Tools, 4: Settings
    callback activity();
    callback interacted();

    height: 30px;
    background: MementoPalette.surface-bg;
    // border-bottom

    border-color: MementoPalette.border;

    TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } } }

    HorizontalLayout {
        padding-left: 8px;
        spacing: 2px;
        alignment: start;

        // Media
        m0 := Rectangle {
            width: 56px;
            height: 26px;
            border-radius: 4px;
            background: root.open-menu == 0 ? #2E2E36 : (m0-t.has-hover ? #25252C : transparent);
            Text {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                text: "Media";
                font-size: 12px;
                color: #E2E8F0;
            }
            m0-t := TouchArea {
                pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } }
                clicked => { root.open-menu = root.open-menu == 0 ? -1 : 0; }
            }
        }

        // Audio
        m1 := Rectangle {
            width: 56px;
            height: 26px;
            border-radius: 4px;
            background: root.open-menu == 1 ? #2E2E36 : (m1-t.has-hover ? #25252C : transparent);
            Text {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                text: "Audio";
                font-size: 12px;
                color: #E2E8F0;
            }
            m1-t := TouchArea {
                pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } }
                clicked => { root.open-menu = root.open-menu == 1 ? -1 : 1; }
            }
        }

        // Subtitle
        m2 := Rectangle {
            width: 66px;
            height: 26px;
            border-radius: 4px;
            background: root.open-menu == 2 ? #2E2E36 : (m2-t.has-hover ? #25252C : transparent);
            Text {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                text: "Subtitle";
                font-size: 12px;
                color: #E2E8F0;
            }
            m2-t := TouchArea {
                pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } }
                clicked => { root.open-menu = root.open-menu == 2 ? -1 : 2; }
            }
        }

        // Tools
        m3 := Rectangle {
            width: 56px;
            height: 26px;
            border-radius: 4px;
            background: root.open-menu == 3 ? #2E2E36 : (m3-t.has-hover ? #25252C : transparent);
            Text {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                text: "Tools";
                font-size: 12px;
                color: #E2E8F0;
            }
            m3-t := TouchArea {
                pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } }
                clicked => { root.open-menu = root.open-menu == 3 ? -1 : 3; }
            }
        }

        // Settings
        m4 := Rectangle {
            width: 68px;
            height: 26px;
            border-radius: 4px;
            background: root.open-menu == 4 ? #2E2E36 : (m4-t.has-hover ? #25252C : transparent);
            Text {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                text: "Settings";
                font-size: 12px;
                color: #E2E8F0;
            }
            m4-t := TouchArea {
                pointer-event(event) => { if event.kind == PointerEventKind.move { root.activity(); }
                    else if event.kind == PointerEventKind.down { root.interacted(); } }
                clicked => { root.open-menu = root.open-menu == 4 ? -1 : 4; }
            }
        }
    }
}

// ── Dropdown Menu Item ──────────────────────────────────────────────────
component DropdownItem inherits Rectangle {
    in property <string> text: "";
    in property <string> shortcut: "";
    in property <bool> checkable: false;
    in property <bool> checked: false;
    in property <bool> has-submenu: false;
    in property <bool> is-disabled: false;
    callback clicked();

    height: 30px;
    border-radius: 4px;
    background: root.is-disabled ? transparent : (touch.has-hover ? #2A2A32 : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            horizontal-stretch: 1;

            if root.checkable : Text {
                width: 14px;
                text: root.checked ? "✓" : "";
                font-size: 11px;
                font-weight: 700;
                color: MementoPalette.cyan-accent;
                vertical-alignment: center;
            }

            Text {
                text: root.text;
                font-size: 12px;
                color: root.is-disabled ? #64748B : #F8FAFC;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            if root.shortcut != "" : Text {
                text: root.shortcut;
                font-size: 11px;
                color: #888890;
                vertical-alignment: center;
            }

            if root.has-submenu : Text {
                text: "›";
                font-size: 14px;
                font-weight: 700;
                color: #888890;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: !root.is-disabled;
        mouse-cursor: root.is-disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ── Dropdown Menu Separator ─────────────────────────────────────────────
component DropdownSeparator inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: #28282E;
    }
}

// ── Dropdown Menus Overlay ──────────────────────────────────────────────
component MenuDropdown inherits Rectangle {
    in property <int> menu-index: -1;
    in-out property <int> submenu-index: -1; // 0 Recent, 1 Size/Position, 2 Secondary, 3 Primary, 4 Anki profile
    in property <[PlayerTrack]> audio-tracks: [];
    in property <[PlayerTrack]> subtitle-tracks: [];
    in property <[string]> recent-files: [];
    in property <[string]> anki-profiles: [];
    in property <int> audio-id: 0;
    in property <int> primary-sid: 0;
    in property <int> secondary-sid: 0;
    in property <string> anki-profile: "";
    in property <bool> anki-enabled: false;
    in property <bool> asr-enabled: false;
    in property <bool> furigana-enabled: false;
    in property <bool> asr-running: false;
    in property <bool> ocr-enabled: false;
    in property <bool> auto-pause: false;
    in property <bool> subtitles-visible: true;
    in property <bool> furigana-visible: false;
    in property <string> key-open-file: "";
    in property <string> key-open-url: "";
    in property <string> key-show-search: "";
    in property <string> key-show-sub-list: "";
    in property <string> key-start-ocr: "";
    in property <string> key-sub-auto-pause: "";
    in property <string> key-sub-show: "";
    in property <string> key-sub-furigana: "";
    in property <string> key-sub-increase-size: "";
    in property <string> key-sub-decrease-size: "";
    in property <string> key-sub-move-up: "";
    in property <string> key-sub-move-down: "";

    callback open-file();
    callback open-url();
    callback add-subtitle();
    callback open-recent(string);
    callback clear-recent();
    callback select-audio-track(int);
    callback select-subtitle-track(int);
    callback select-secondary-subtitle-track(int);
    callback select-asr();
    callback auto-pause-changed(bool);
    callback adjust-subtitle-scale(float);
    callback adjust-subtitle-offset(float);
    callback subtitles-visible-changed(bool);
    callback furigana-visible-changed(bool);
    callback toggle-search();
    callback toggle-sub-drawer();
    callback start-ocr();
    callback open-options();
    callback open-config();
    callback check-updates();
    callback show-about();
    callback select-anki-profile(string);
    callback close-menu();

    changed menu-index => { root.submenu-index = -1; }

    visible: root.menu-index >= 0;
    x: root.menu-index == 0 ? 8px :
       root.menu-index == 1 ? 66px :
       root.menu-index == 2 ? 124px :
       root.menu-index == 3 ? 192px : 250px;
    y: 30px;
    width: root.menu-index == 1 ? (root.audio-tracks.length > 0 ? 210px : 140px) :
           root.menu-index == 2 ? 220px :
           root.menu-index == 3 ? 180px : 200px;
    height: menu-content.preferred-height;
    background: #1E1E22;
    border-width: 1px;
    border-color: #28282E;
    border-radius: 6px;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000088;

    menu-content := VerticalLayout {
        padding: 6px;
        spacing: 2px;

        // Media: recent files are the only submenu; their paths stay intact.
        if root.menu-index == 0 : VerticalLayout {
            spacing: 2px;
            DropdownItem {
                text: "Open File…";
                shortcut: root.key-open-file;
                clicked => { root.open-file(); root.close-menu(); }
            }
            DropdownItem {
                text: "Open URL…";
                shortcut: root.key-open-url;
                clicked => { root.open-url(); root.close-menu(); }
            }
            DropdownItem {
                text: "Recent";
                has-submenu: true;
                is-disabled: root.recent-files.length == 0;
                clicked => { root.submenu-index = root.submenu-index == 0 ? -1 : 0; }
            }
        }

        // Audio tracks, including the mpv "None" track (SID 0).
        if root.menu-index == 1 : VerticalLayout {
            spacing: 2px;
            DropdownItem {
                text: "None";
                checkable: true;
                checked: root.audio-id == 0;
                clicked => { root.select-audio-track(0); root.close-menu(); }
            }
            for track[index] in root.audio-tracks : DropdownItem {
                text: track.label;
                checkable: true;
                checked: track.id == root.audio-id;
                clicked => { root.select-audio-track(track.id); root.close-menu(); }
            }
        }

        // Subtitle controls plus independently selectable primary/secondary tracks.
        if root.menu-index == 2 : VerticalLayout {
            spacing: 2px;
            DropdownItem {
                text: "Auto Pause";
                shortcut: root.key-sub-auto-pause;
                checkable: true;
                checked: root.auto-pause;
                clicked => { root.auto-pause-changed(!root.auto-pause); root.close-menu(); }
            }
            DropdownItem {
                text: "Size and Position";
                has-submenu: true;
                clicked => { root.submenu-index = root.submenu-index == 1 ? -1 : 1; }
            }
            DropdownSeparator {}
            DropdownItem {
                text: "Show Subtitles";
                shortcut: root.key-sub-show;
                checkable: true;
                checked: root.subtitles-visible;
                clicked => { root.subtitles-visible-changed(!root.subtitles-visible); root.close-menu(); }
            }
            if root.furigana-enabled : DropdownItem {
                text: "Show Furigana";
                shortcut: root.key-sub-furigana;
                checkable: true;
                checked: root.furigana-visible;
                clicked => { root.furigana-visible-changed(!root.furigana-visible); root.close-menu(); }
            }
            DropdownSeparator {}
            DropdownItem {
                text: "Add Subtitle…";
                clicked => { root.add-subtitle(); root.close-menu(); }
            }
            DropdownItem {
                text: "Second Track";
                has-submenu: true;
                clicked => { root.submenu-index = root.submenu-index == 2 ? -1 : 2; }
            }
            DropdownItem {
                text: "Primary Track";
                has-submenu: true;
                clicked => { root.submenu-index = root.submenu-index == 3 ? -1 : 3; }
            }
        }

        // Search, subtitle list, and OCR are the only real Tools actions.
        if root.menu-index == 3 : VerticalLayout {
            spacing: 2px;
            DropdownItem {
                text: "Show Search";
                shortcut: root.key-show-search;
                clicked => { root.toggle-search(); root.close-menu(); }
            }
            DropdownItem {
                text: "Show Subtitle List";
                shortcut: root.key-show-sub-list;
                clicked => { root.toggle-sub-drawer(); root.close-menu(); }
            }
            if root.ocr-enabled : DropdownItem {
                text: "Start OCR";
                shortcut: root.key-start-ocr;
                clicked => { root.start-ocr(); root.close-menu(); }
            }
        }

        // Settings: profiles are model-driven and update actions are delegated.
        if root.menu-index == 4 : VerticalLayout {
            spacing: 2px;
            if root.anki-enabled : DropdownItem {
                text: "Anki Profile";
                has-submenu: true;
                clicked => { root.submenu-index = root.submenu-index == 4 ? -1 : 4; }
            }
            DropdownItem {
                text: "Options…";
                shortcut: "Ctrl+,";
                clicked => { root.open-options(); root.close-menu(); }
            }
            DropdownItem {
                text: "Open Config";
                clicked => { root.open-config(); root.close-menu(); }
            }
            DropdownItem {
                text: "Check for Updates";
                clicked => { root.check-updates(); root.close-menu(); }
            }
            DropdownSeparator {}
            DropdownItem {
                text: "About Memento";
                clicked => { root.show-about(); root.close-menu(); }
            }
        }
    }

    // Dynamic Recent, Size/Position, track, and Anki profile flyouts.
    if root.submenu-index >= 0 : Rectangle {
        x: parent.width - 4px;
        y: root.submenu-index == 0 ? 58px :
           root.submenu-index == 1 ? 34px :
           root.submenu-index == 2 ? max(10px, parent.height - self.height - 30px) :
           root.submenu-index == 3 ? max(10px, parent.height - self.height) : 6px;
        width: root.submenu-index == 0 ? 320px : 260px;
        height: root.submenu-index == 0 ? max(44px, min(360px, (root.recent-files.length == 0 ? 1 : root.recent-files.length + 2) * 30px + 14px)) :
                root.submenu-index == 1 ? 134px :
                root.submenu-index == 2 ? max(44px, min(300px, (root.subtitle-tracks.length + 1) * 30px + 14px)) :
                root.submenu-index == 3 ? max(44px, min(300px, (root.subtitle-tracks.length + (root.asr-enabled ? 2 : 1)) * 30px + 14px)) :
                max(44px, min(300px, max(1, root.anki-profiles.length) * 30px + 14px));
        background: #1E1E22;
        border-width: 1px;
        border-color: #28282E;
        border-radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000088;

        ScrollView {
            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                if root.submenu-index == 0 : VerticalLayout {
                    spacing: 2px;
                    if root.recent-files.length == 0 : DropdownItem {
                        text: "No recent files";
                        is-disabled: true;
                    }
                    for file[index] in root.recent-files : DropdownItem {
                        text: file;
                        clicked => { root.open-recent(file); root.close-menu(); }
                    }
                    DropdownSeparator {}
                    DropdownItem {
                        text: "Clear Recents";
                        clicked => { root.clear-recent(); root.close-menu(); }
                    }
                }

                if root.submenu-index == 1 : VerticalLayout {
                    spacing: 2px;
                    DropdownItem {
                        text: "Increase Size";
                        shortcut: root.key-sub-increase-size;
                        clicked => { root.adjust-subtitle-scale(0.005); root.close-menu(); }
                    }
                    DropdownItem {
                        text: "Decrease Size";
                        shortcut: root.key-sub-decrease-size;
                        clicked => { root.adjust-subtitle-scale(-0.005); root.close-menu(); }
                    }
                    DropdownItem {
                        text: "Move Up";
                        shortcut: root.key-sub-move-up;
                        clicked => { root.adjust-subtitle-offset(0.005); root.close-menu(); }
                    }
                    DropdownItem {
                        text: "Move Down";
                        shortcut: root.key-sub-move-down;
                        clicked => { root.adjust-subtitle-offset(-0.005); root.close-menu(); }
                    }
                }

                if root.submenu-index == 2 : VerticalLayout {
                    spacing: 2px;
                    DropdownItem {
                        text: "None";
                        checkable: true;
                        checked: root.secondary-sid == 0;
                        clicked => { root.select-secondary-subtitle-track(0); root.close-menu(); }
                    }
                    for track[index] in root.subtitle-tracks : DropdownItem {
                        text: track.label;
                        checkable: true;
                        checked: track.id == root.secondary-sid;
                        is-disabled: track.id == root.primary-sid;
                        clicked => {
                            if (track.id != root.primary-sid) {
                                root.select-secondary-subtitle-track(track.id);
                                root.close-menu();
                            }
                        }
                    }
                }

                if root.submenu-index == 3 : VerticalLayout {
                    spacing: 2px;
                    DropdownItem {
                        text: "None";
                        checkable: true;
                        checked: root.primary-sid == 0 && !root.asr-running;
                        clicked => { root.select-subtitle-track(0); root.close-menu(); }
                    }
                    if root.asr-enabled : DropdownItem {
                        text: root.asr-running ? "ASR subtitles…" : "ASR subtitles";
                        checkable: true;
                        checked: root.asr-running;
                        clicked => { root.select-asr(); root.close-menu(); }
                    }
                    for track[index] in root.subtitle-tracks : DropdownItem {
                        text: track.label;
                        checkable: true;
                        checked: track.id == root.primary-sid && !root.asr-running;
                        is-disabled: track.id == root.secondary-sid;
                        clicked => {
                            if (track.id != root.secondary-sid) {
                                root.select-subtitle-track(track.id);
                                root.close-menu();
                            }
                        }
                    }
                }

                if root.submenu-index == 4 : VerticalLayout {
                    spacing: 2px;
                    for profile[index] in root.anki-profiles : DropdownItem {
                        text: profile;
                        checkable: true;
                        checked: profile == root.anki-profile;
                        clicked => { root.select-anki-profile(profile); root.close-menu(); }
                    }
                }
            }
        }
    }
}

// ── Main Memento Application Window ─────────────────────────────────────
export component MementoApp inherits Window {
    title: root.media-title != "" ? (root.media-title + " — Memento") : "Memento";
    min-width: 900px;
    min-height: 580px;
    preferred-width: 1200px;
    preferred-height: 720px;
    background: #000000;

    in-out property <string> media-title: "";
    in-out property <bool> is-playing: false;
    in-out property <float> position: 0.0;
    in-out property <float> duration: 0.0;
    in-out property <float> volume: 100.0;
    in-out property <string> current-time: "00:00";
    in-out property <string> duration-time: "00:00";
    in-out property <image> video-frame;
    callback update-video();
    callback video-frame-ready();
    in-out property <int> pending-playback-generation: -1;
    callback video-load-presented(int);
    out property <int> video-width: round(video-area.width / 1px);
    out property <int> video-height: round(video-area.height / 1px);
    changed video-width => { root.update-video(); }
    changed video-height => { root.update-video(); }
    in-out property <string> status-message: "";
    in-out property <float> subtitle-scale: 0.05;
    in-out property <float> subtitle-offset: 0.045;
    in-out property <string> active-sub-text: "";
    in-out property <string> secondary-sub-text: "";
    in-out property <int> selected-token-index: -1;
    in-out property <int> selected-token-count: 1;
    in-out property <bool> dict-search-open: false;
    in-out property <bool> sub-drawer-open: false;
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> osc-visible: true;
    in-out property <int> osc-duration-ms: 700;
    in-out property <int> osc-min-move: 0;
    out property <bool> menu-open: menu-bar.open-menu >= 0;
    in-out property <bool> ocr-mode: false;
    in-out property <bool> ocr-enabled: false;
    in-out property <bool> asr-enabled: false;
    in-out property <bool> asr-running: false;
    in-out property <bool> auto-pause: false;
    in-out property <bool> subtitles-visible: true;
    in-out property <bool> furigana-visible: false;
    // Loading the first reading must finish before releasing the playback clock.
    in-out property <bool> subtitle-furigana-pending: false;
    in-out property <bool> furigana-enabled: true;
    in-out property <bool> hide-mpv-subtitles: true;
    in-out property <bool> hide-memento-while-playing: false;
    in-out property <bool> hover-pause-enabled: false;
    in-out property <[string]> recent-files: [];
    in-out property <[PlayerTrack]> audio-tracks: [];
    in-out property <[PlayerTrack]> subtitle-tracks: [];
    in-out property <int> audio-id: 0;
    in-out property <int> primary-sid: 0;
    in-out property <int> secondary-sid: 0;
    in-out property <[string]> anki-profiles: [];
    in-out property <string> anki-profile: "";
    in-out property <bool> anki-enabled: false;
    in-out property <bool> show-anki-checkbox: true;
    in-out property <string> app-version: "";
    in-out property <string> key-open-file: "Ctrl+O";
    in-out property <string> key-open-url: "Ctrl+U";
    in-out property <string> key-show-search: "Ctrl+R";
    in-out property <string> key-show-sub-list: "Ctrl+E";
    in-out property <string> key-start-ocr: "Ctrl+L";
    in-out property <string> key-sub-auto-pause: "Ctrl+P";
    in-out property <string> key-sub-show: "Ctrl+0";
    in-out property <string> key-sub-furigana: "Alt+A";
    in-out property <string> key-sub-increase-size: "Ctrl+2";
    in-out property <string> key-sub-decrease-size: "Ctrl+1";
    in-out property <string> key-sub-move-up: "Alt+1";
    in-out property <string> key-sub-move-down: "Alt+2";
    in-out property <bool> dict-open: false;
    in-out property <string> dict-query: "";
    in-out property <string> dict-reading: "";
    in-out property <string> dict-pitch-accent: "";
    in-out property <string> dict-freq-rank: "";
    in-out property <string> dict-jpdb-rank: "";
    in-out property <[DictResult]> dict-results: [];
    in-out property <[DictResult]> popup-results: [];
    in-out property <int> popup-loaded-count: 0;
    out property <bool> popup-needs-more: yomi-card.needs-more;
    in-out property <[PopupAudioSource]> popup-audio-sources: [];
    in-out property <bool> popup-audio-sources-loading: false;
    in-out property <int> popup-selected-audio-source: -1;
    in-out property <string> anki-added-note-id: "";
    in-out property <int> anki-added-result-index: -1;
    in-out property <bool> about-open: false;

    // Subtitle Entries & Interactive Words
    in-out property <[SubEntry]> subtitle-entries: [];
    in-out property <[SubtitleWord]> active-sub-words: [];
    in-out property <[SubtitleLine]> active-sub-lines: [];
    in-out property <length> popup-offset-x: 0px;

    callback toggle-play();
    callback seek-to(float);
    callback seek-relative(float);
    callback sub-seek(int);
    callback playlist-prev();
    callback playlist-next();
    callback set-volume(float);
    callback toggle-mute();
    callback volume-up();
    callback volume-down();
    callback open-file();
    callback open-url();
    callback open-recent(string);
    callback clear-recent();
    callback reload-media();
    callback close-media();
    callback quit-app();
    callback select-audio-track(int);
    callback select-subtitle-track(int);
    callback select-secondary-subtitle-track(int);
    callback select-asr();
    callback select-anki-profile(string);
    callback auto-pause-changed(bool);
    callback adjust-subtitle-scale(float);
    callback adjust-subtitle-offset(float);
    callback subtitles-visible-changed(bool);
    callback furigana-visible-changed(bool);
    callback subtitle-hover-changed(bool);
    callback toggle-subtitles();
    callback add-subtitle();
    callback adjust-sub-delay(float);
    callback start-ocr();
    callback ocr-region(float, float, float, float);
    callback open-config();
    callback check-updates();
    callback toggle-fullscreen();
    callback pointer-moved(float, float);
    callback osc-activity();
    callback select-row(int);
    callback search-subtitles(string);
    callback search-dictionary(string);
    callback lookup-word(string);
    callback open-glossary-link(string);
    callback lookup-kanji(string);
    callback hover-word(string, int, bool, bool, bool, bool);
    callback toggle-definition-selection(int);
    callback toggle-term-collapse(int);
    callback load-more-definition-results(bool);
    callback add-anki-note(int);
    callback browse-anki-note(string);
    callback reset-definition-scroll();
    callback open-options();
    callback play-audio-for-word(string, string);
    callback popup-audio-sources-requested(string, string);
    callback key-pressed(string, bool, bool, bool, bool) -> bool;
    callback dismiss-definition();

    dismiss-definition => {
        root.dict-open = false;
        root.selected-token-index = -1;
        root.selected-token-count = 1;
        // Cancel delayed hover searches and invalidate results already in flight.
        root.hover-word("", -1, false, false, false, false);
    }

    reset-definition-scroll => { yomi-card.reset-scroll(); }
    pure callback format-timestamp(float) -> string;
    changed dict-search-open => {
        if root.dict-search-open {
            root.dict-query = "";
            root.dict-results = [];
            root.dismiss-definition();
        }
    }

    forward-focus: f-scope;
    f-scope := FocusScope {
        key-pressed(event) => {
            if (root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta)) {
                return accept;
            }
            reject
        }
    }

    // Window Content Layout
    VerticalLayout {
        spacing: 0;

        // Top Native Menu Bar
        menu-bar := TopMenuBar {
            visible: root.osc-visible || self.open-menu >= 0;
            activity => { root.osc-activity(); }
            interacted => { root.dismiss-definition(); }
        }

        // Center Area: Video Surface + Optional Subtitle Drawer
        HorizontalLayout {
            spacing: 0;
            horizontal-stretch: 1;

            // Video & Overlays Surface
            video-area := Rectangle {
                background: #000000;
                horizontal-stretch: 1;

                // libmpv frame shares the same Slint scene as all interactive overlays.
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.video-frame;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // Track video-surface movement without blocking the subtitle or OSC controls.
                video-motion := TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.pointer-moved(self.mouse-x / 1px, self.mouse-y / 1px);
                        } else if event.kind == PointerEventKind.down {
                            root.dismiss-definition();
                        }
                    }
                    double-clicked => { root.toggle-fullscreen(); }
                }

                // Empty / Placeholder state
                if root.duration <= 0.0 : VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: center;
                        Image {
                            width: 64px;
                            height: 64px;
                            source: @image-url("icons/window.svg");
                            colorize: #94A3B8;
                        }
                    }
                    Text {
                        text: "Memento";
                        font-size: 26px;
                        font-weight: 700;
                        color: #E2E8F0;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Open a video file (Ctrl+O) or drag and drop media to start";
                        font-size: 14px;
                        color: #94A3B8;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 140px;
                            height: 36px;
                            border-radius: 6px;
                            background: MementoPalette.cyan-accent;
                            Text {
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                text: "Open Media…";
                                font-weight: 700;
                                color: #000000;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-file(); }
                            }
                        }
                    }
                }

                // Clickable text units supply the search suffix at each token.
                subtitle-box := Rectangle {
                    visible: root.active-sub-text != "" && root.subtitles-visible && !(root.hide-memento-while-playing && root.is-playing);
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - max(62px, parent.height * root.subtitle-offset);
                    width: min(parent.width - 40px, subtitle-lines-layout.preferred-width + 32px);
                    height: subtitle-lines-layout.preferred-height + 16px;
                    background: #00000099;
                    border-radius: 4px;
                    subtitle-hover-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        changed has-hover => { root.subtitle-hover-changed(self.has-hover); }
                    }
                    subtitle-lines-layout := VerticalLayout {
                        x: 16px;
                        y: 8px;
                        width: self.preferred-width;
                        height: self.preferred-height;
                        spacing: 4px;
                        alignment: center;
                        for line in root.active-sub-lines : HorizontalLayout {
                            width: self.preferred-width;
                            height: self.preferred-height;
                            alignment: center;
                            spacing: 0px;
                            for word in line.words : InteractiveSubtitleToken {
                                word: word;
                                type-size: video-area.height * root.subtitle-scale;
                                show-furigana: root.furigana-visible;
                                selected: word.index >= root.selected-token-index && word.index < (root.selected-token-index + root.selected-token-count);
                                hover-state(hovering) => { root.subtitle-hover-changed(hovering); }
                                hovered(query, control, shift, alt, meta) => {
                                    root.osc-activity();
                                    root.hover-word(query, word.index, control, shift, alt, meta);
                                }
                                clicked => {
                                    root.selected-token-index = word.index;
                                    root.hover-word("", word.index, false, false, false, false);
                                    root.lookup-word(word.query);
                                }
                            }
                        }
                    }
                }

                if root.secondary-sub-text != "" && root.subtitles-visible && !(root.hide-memento-while-playing && root.is-playing) : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - max(116px, parent.height * root.subtitle-offset + 54px);
                    width: min(parent.width - 40px, secondary-subtitle-text.preferred-width + 32px);
                    height: secondary-subtitle-text.preferred-height + 16px;
                    background: #00000099;
                    border-radius: 4px;
                    secondary-subtitle-text := Text {
                        x: 16px;
                        y: 8px;
                        width: min(parent.width - 72px, self.preferred-width);
                        text: root.secondary-sub-text;
                        font-size: video-area.height * root.subtitle-scale;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    secondary-hover-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        changed has-hover => { root.subtitle-hover-changed(self.has-hover); }
                    }
                }

                // Floating Yomitan Dictionary Card
                yomi-card := YomitanPopup {
                    width: min(480px, parent.width - 40px);
                    height: min(440px, parent.height - 80px);
                    x: min(parent.width - self.width - 20px, max(20px, subtitle-box.x + (subtitle-box.width - self.width) / 2));
                    // Clamp toward the top when space above the subtitles is tight.
                    // Falling below them would put definitions behind the OSC.
                    y: max(10px, subtitle-box.y - self.height - 12px);
                    is-open: root.dict-open;
                    anki-enabled: root.anki-enabled;
                    show-anki-checkbox: root.show-anki-checkbox;
                    added-note-id: root.anki-added-note-id;
                    added-result-index: root.anki-added-result-index;
                    headword: root.dict-query;
                    reading: root.dict-reading;
                    pitch-accent: root.dict-pitch-accent;
                    freq-rank: root.dict-freq-rank;
                    jpdb-rank: root.dict-jpdb-rank;
                    results: root.popup-results;
                    has-more-results: root.popup-loaded-count < root.dict-results.length;
                    audio-sources: root.popup-audio-sources;
                    audio-sources-loading: root.popup-audio-sources-loading;
                    selected-audio-source: root.popup-selected-audio-source;
                    close-requested => { root.dismiss-definition(); }
                    add-anki-note(idx) => { root.add-anki-note(idx); }
                    browse-anki-note(id) => { root.browse-anki-note(id); }
                    play-audio(word, reading) => { root.play-audio-for-word(word, reading); }
                    request-audio-sources(word, reading) => { root.popup-audio-sources-requested(word, reading); }
                    kanji-info(word) => { root.lookup-kanji(word); }
                    toggle-select-definition(idx) => { root.toggle-definition-selection(idx); }
                    toggle-term-collapse(idx) => { root.toggle-term-collapse(idx); }
                    load-more-results(force) => { root.load-more-definition-results(force); }
                    select-audio-source(idx) => { root.popup-selected-audio-source = idx; }
                    open-rich-link(link) => { root.open-glossary-link(link); }
                }

                // Bottom OSC Bar (Floating, 50px)
                osc := PlayerOscBar {
                    visible: root.osc-visible && !root.ocr-mode;
                    x: 16px;
                    y: parent.height - self.height - 12px;
                    width: parent.width - 32px;
                    playing: root.is-playing;
                    position: root.position;
                    duration: root.duration;
                    volume: root.volume;
                    current-time: root.current-time;
                    duration-time: root.duration-time;
                    is-fullscreen: root.is-fullscreen;
                    ocr-enabled: root.ocr-enabled;
                    toggle-play => { root.toggle-play(); }
                    seek(val) => { root.seek-to(val); }
                    subtitle-seek(dir) => { root.sub-seek(dir); }
                    playlist-prev => { root.playlist-prev(); }
                    playlist-next => { root.playlist-next(); }
                    toggle-mute => { root.toggle-mute(); }
                    start-ocr => { root.start-ocr(); }
                    volume-changed(val) => { root.set-volume(val); }
                    toggle-sub-list => {
                        root.sub-drawer-open = !root.sub-drawer-open;
                        root.dict-search-open = false;
                    }
                    toggle-fullscreen => { root.toggle-fullscreen(); }
                    activity => { root.osc-activity(); }
                    interacted => { root.dismiss-definition(); }
                }

                // Drag a rectangle over the current video frame for OCR.
                if root.ocr-mode : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    ocr-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) {
                                let min-x = min(self.pressed-x, self.mouse-x);
                                let min-y = min(self.pressed-y, self.mouse-y);
                                let max-x = max(self.pressed-x, self.mouse-x);
                                let max-y = max(self.pressed-y, self.mouse-y);
                                let box-w = max-x - min-x;
                                let box-h = max-y - min-y;
                                if (box-w >= 6px && box-h >= 6px && self.width > 0px && self.height > 0px) {
                                    root.ocr-region(
                                        min-x / self.width,
                                        min-y / self.height,
                                        box-w / self.width,
                                        box-h / self.height
                                    );
                                }
                                root.ocr-mode = false;
                            } else if (event.kind == PointerEventKind.cancel) {
                                root.ocr-mode = false;
                            }
                        }
                    }
                    if ocr-touch.pressed : Rectangle {
                        x: min(ocr-touch.pressed-x, ocr-touch.mouse-x);
                        y: min(ocr-touch.pressed-y, ocr-touch.mouse-y);
                        width: max(1px, max(ocr-touch.pressed-x, ocr-touch.mouse-x) - self.x);
                        height: max(1px, max(ocr-touch.pressed-y, ocr-touch.mouse-y) - self.y);
                        background: #21a5bb33;
                        border-width: 2px;
                        border-color: #21a5bb;
                    }
                }
            }

            DictionarySearchPanel {
                width: root.dict-search-open ? 340px : 0px;
                visible: self.width > 0px;
                results: root.dict-results;
                query <=> root.dict-query;
                search-changed(query) => { root.search-dictionary(query); }
                lookup(word) => { root.lookup-word(word); }
                close => { root.dict-search-open = false; }
            }
            SubtitleDrawerPanel {
                width: (root.sub-drawer-open && !root.dict-search-open) ? 360px : 0px;
                visible: self.width > 0px;
                entries: root.subtitle-entries;
                format-timestamp(sec) => { root.format-timestamp(sec) }
                row-clicked(idx) => { root.dismiss-definition(); root.select-row(idx); }
                row-activated(sec) => { root.dismiss-definition(); root.seek-to(sec); }
                search-changed(q) => { root.dismiss-definition(); root.search-subtitles(q); }
            }
        }
    }

    // Dismiss overlay when any menu is open (click outside menu bar to close)
    if menu-bar.open-menu >= 0 : TouchArea {
        y: 30px;
        width: 100%;
        height: parent.height - 30px;
        clicked => {
            menu-bar.open-menu = -1;
        }
    }

    // Dropdown Menus Overlay
    menu-drop := MenuDropdown {
        menu-index: menu-bar.open-menu;
        audio-tracks: root.audio-tracks;
        subtitle-tracks: root.subtitle-tracks;
        recent-files: root.recent-files;
        anki-profiles: root.anki-profiles;
        audio-id: root.audio-id;
        primary-sid: root.primary-sid;
        secondary-sid: root.secondary-sid;
        anki-profile: root.anki-profile;
        anki-enabled: root.anki-enabled;
        asr-enabled: root.asr-enabled;
        asr-running: root.asr-running;
        ocr-enabled: root.ocr-enabled;
        furigana-enabled: root.furigana-enabled;
        auto-pause: root.auto-pause;
        subtitles-visible: root.subtitles-visible;
        furigana-visible: root.furigana-visible;
        key-open-file: root.key-open-file;
        key-open-url: root.key-open-url;
        key-show-search: root.key-show-search;
        key-show-sub-list: root.key-show-sub-list;
        key-start-ocr: root.key-start-ocr;
        key-sub-auto-pause: root.key-sub-auto-pause;
        key-sub-show: root.key-sub-show;
        key-sub-furigana: root.key-sub-furigana;
        key-sub-increase-size: root.key-sub-increase-size;
        key-sub-decrease-size: root.key-sub-decrease-size;
        key-sub-move-up: root.key-sub-move-up;
        key-sub-move-down: root.key-sub-move-down;
        open-file => { root.open-file(); }
        open-url => { root.open-url(); }
        open-recent(path) => { root.open-recent(path); }
        clear-recent => { root.clear-recent(); }
        select-audio-track(id) => { root.select-audio-track(id); }
        select-subtitle-track(id) => { root.select-subtitle-track(id); }
        select-secondary-subtitle-track(id) => { root.select-secondary-subtitle-track(id); }
        select-asr => { root.select-asr(); }
        select-anki-profile(name) => { root.select-anki-profile(name); }
        auto-pause-changed(enabled) => { root.auto-pause-changed(enabled); }
        adjust-subtitle-scale(delta) => { root.adjust-subtitle-scale(delta); }
        adjust-subtitle-offset(delta) => { root.adjust-subtitle-offset(delta); }
        subtitles-visible-changed(visible) => { root.subtitles-visible-changed(visible); }
        furigana-visible-changed(visible) => { root.furigana-visible-changed(visible); }
        add-subtitle => { root.add-subtitle(); }
        toggle-search => {
            root.dict-search-open = !root.dict-search-open;
            root.sub-drawer-open = false;
        }
        toggle-sub-drawer => {
            root.sub-drawer-open = !root.sub-drawer-open;
            root.dict-search-open = false;
        }
        start-ocr => { root.start-ocr(); }
        open-options => { root.open-options(); }
        open-config => { root.open-config(); }
        check-updates => { root.check-updates(); }
        show-about => { root.about-open = true; }
        close-menu => { menu-bar.open-menu = -1; root.osc-activity(); }
    }

    if root.status-message != "" : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 112px;
        width: min(650px, parent.width - 40px);
        height: 42px;
        background: #252b2ee8;
        border-radius: 5px;
        border-width: 1px;
        border-color: #48535a;
        Text {
            text: root.status-message;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width - 16px;
            height: parent.height;
            x: 8px;
            overflow: elide;
        }
    }

    if root.about-open : Rectangle {
        background: #00000099;
        TouchArea { clicked => { root.about-open = false; } }
        Rectangle {
            width: 400px;
            height: 195px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #30363a;
            border-color: #48535a;
            border-width: 1px;
            border-radius: 7px;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { text: "Memento " + root.app-version; color: white; font-size: 22px; }
                Text { text: "An mpv-based video player for studying Japanese"; color: #dde4e6; }
                Text { text: "Copyright © Ripose · GPL-2.0-only"; color: #b6c0c4; }
                Button { text: "Close"; clicked => { root.about-open = false; } }
            }
        }
    }
}
