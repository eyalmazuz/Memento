import { MementoPalette } from "palette.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";
import { FilterChip, IconButton, TabPill } from "components/buttons.slint";
import { SectionHeader } from "components/controls.slint";

export struct HelpArgument {
    name: string,
    description: string,
    default-value: string,
}

export struct HelpMarker {
    name: string,
    description: string,
    arguments: [HelpArgument],
}

export struct HelpSection {
    title: string,
    subtitle: string,
    markers: [HelpMarker],
}

component CodeExampleChip inherits Rectangle {
    in property <string> snippet;
    callback clicked(string);

    height: 28px;
    width: code-row.preferred-width;
    border-radius: 6px;
    background: touch.pressed
        ? MementoPalette.accent-muted-hover
        : (touch.has-hover ? MementoPalette.accent-muted : MementoPalette.card-inset);
    border-width: 1px;
    border-color: touch.has-hover ? MementoPalette.cyan-accent : MementoPalette.border-light;

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    code-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        Text {
            text: root.snippet;
            color: MementoPalette.cyan-text;
            font-family: "monospace";
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            width: 28px;
            text: "Copy";
            color: MementoPalette.cyan-text;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
            opacity: touch.has-hover ? 0.9 : 0.0;
            animate opacity { duration: 120ms; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.snippet); }
    }
}

component SyntaxCard inherits Rectangle {
    in property <string> title;
    in property <string> badge;
    in property <string> body;
    in property <[string]> examples: [];
    callback copy-snippet(string);

    background: MementoPalette.card-bg;
    border-width: 1px;
    border-color: MementoPalette.card-border;
    border-radius: 10px;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Text {
                text: root.title;
                color: MementoPalette.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.badge != "" : VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 20px;
                    width: b-lbl.preferred-width + 14px;
                    border-radius: 10px;
                    background: MementoPalette.teal-muted;
                    border-width: 1px;
                    border-color: MementoPalette.teal-border;
                    b-lbl := Text {
                        text: root.badge;
                        color: MementoPalette.teal-text;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: root.body;
            color: MementoPalette.text-secondary;
            font-size: 13px;
            wrap: word-wrap;
        }

        if root.examples.length > 0 : VerticalLayout {
            spacing: 6px;
            for ex in root.examples : HorizontalLayout {
                alignment: start;
                CodeExampleChip {
                    snippet: ex;
                    clicked(s) => { root.copy-snippet(s); }
                }
            }
        }
    }
}

component MarkerCard inherits Rectangle {
    in property <HelpMarker> marker;
    callback copy-marker(string);

    background: MementoPalette.card-bg;
    border-width: 1px;
    border-color: MementoPalette.card-border;
    border-radius: 9px;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            alignment: space-between;
            spacing: 8px;

            // Clickable marker pill copies `{name}` without width jitter on hover
            marker-pill := Rectangle {
                height: 26px;
                width: pill-row.preferred-width;
                border-radius: 6px;
                background: pill-touch.pressed
                    ? MementoPalette.accent-muted-hover
                    : (pill-touch.has-hover ? MementoPalette.accent-muted : MementoPalette.card-inset);
                border-width: 1px;
                border-color: pill-touch.has-hover ? MementoPalette.cyan-accent : MementoPalette.border-light;

                animate background { duration: 100ms; }
                animate border-color { duration: 100ms; }

                pill-row := HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "{" + root.marker.name + "}";
                        color: MementoPalette.cyan-text;
                        font-family: "monospace";
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        width: 28px;
                        text: "Copy";
                        color: MementoPalette.cyan-text;
                        font-size: 10px;
                        font-weight: 600;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        opacity: pill-touch.has-hover ? 0.9 : 0.0;
                        animate opacity { duration: 120ms; }
                    }
                }

                pill-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.copy-marker("{" + root.marker.name + "}"); }
                }
            }

            if root.marker.arguments.length > 0 : VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 22px;
                    width: arg-cnt.preferred-width + 14px;
                    border-radius: 11px;
                    background: MementoPalette.track-bg;
                    arg-cnt := Text {
                        text: root.marker.arguments.length == 1
                            ? "1 argument"
                            : root.marker.arguments.length + " arguments";
                        color: MementoPalette.text-secondary;
                        font-size: 10px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: root.marker.description;
            color: MementoPalette.text-secondary;
            font-size: 13px;
            wrap: word-wrap;
        }

        if root.marker.arguments.length > 0 : Rectangle {
            background: MementoPalette.card-inset;
            border-width: 1px;
            border-color: MementoPalette.border;
            border-radius: 7px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                for argument[idx] in root.marker.arguments : VerticalLayout {
                    spacing: 4px;
                    if idx > 0 : Rectangle {
                        height: 1px;
                        background: MementoPalette.border;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 20px;
                                width: arg-name.preferred-width + 12px;
                                border-radius: 4px;
                                background: MementoPalette.accent-muted;
                                arg-name := Text {
                                    text: argument.name;
                                    color: MementoPalette.badge-blue-text;
                                    font-family: "monospace";
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "Default: " + argument.default-value;
                            color: MementoPalette.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    Text {
                        text: argument.description;
                        color: MementoPalette.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component AnkiHelpWindow inherits Window {
    title: "Anki Integration Help";
    preferred-width: 960px;
    preferred-height: 720px;
    min-width: 600px;
    min-height: 460px;
    background: MementoPalette.window-bg;
    default-font-family: "Noto Sans, sans-serif";

    in-out property <int> active-tab: 0; // 0: Overview & Syntax, 1: Term Markers, 2: Kanji Markers
    in-out property <int> active-term-section: -1; // -1: All, 0..N: specific section
    in-out property <int> active-kanji-section: -1;
    in-out property <string> search-query: "";
    in-out property <string> copied-notice: "";

    in property <[HelpSection]> term-sections;
    in property <[HelpSection]> kanji-sections;
    in property <[string]> term-section-names;
    in property <[string]> kanji-section-names;
    in property <int> term-total-count: 0;
    in property <int> kanji-total-count: 0;

    callback search-changed(string);
    callback copy-marker(string);
    callback close();

    changed active-tab => {
        help-scroll.viewport-y = 0px;
    }

    root-focus := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.modifiers.control
                && (event.text == "f" || event.text == "F" || event.text == "\u{0006}") {
                search-input.focus();
                return accept;
            }
            if event.text == Key.Escape {
                if root.search-query != "" {
                    root.search-query = "";
                    root.search-changed("");
                } else {
                    root.close();
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            // Top Header + Tabs + Filter
            Rectangle {
                background: MementoPalette.surface-bg;

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 12px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: "Anki Integration Help";
                                color: MementoPalette.text;
                                font-size: 19px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Click any {marker} badge to copy it straight to your clipboard. Press Ctrl+F to filter.";
                                color: MementoPalette.text-muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        if root.copied-notice != "" : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 28px;
                                width: copied-lbl.preferred-width + 20px;
                                border-radius: 14px;
                                background: MementoPalette.success-bg;
                                border-width: 1px;
                                border-color: MementoPalette.success;
                                copied-lbl := Text {
                                    text: root.copied-notice;
                                    color: MementoPalette.success-text;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;

                                VerticalLayout {
                                    alignment: center;
                                    search-input := LineEdit {
                                        width: 240px;
                                        text <=> root.search-query;
                                        placeholder-text: "Filter markers… (Ctrl+F)";
                                        edited(q) => {
                                            root.search-changed(q);
                                        }
                                    }
                                }

                                if root.search-query != "" : VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: @image-url("icons/close.svg");
                                        size: 28px;
                                        icon-size: 14px;
                                        tooltip: "Clear filter";
                                        tooltip-below: true;
                                        tooltip-align-right: true;
                                        clicked => {
                                            root.search-query = "";
                                            root.search-changed("");
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Main Tab Strip
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        TabPill {
                            label: "Overview & Syntax";
                            active: root.active-tab == 0;
                            clicked => { root.active-tab = 0; }
                        }
                        TabPill {
                            label: "Term Markers";
                            badge: root.term-total-count + "";
                            active: root.active-tab == 1;
                            clicked => { root.active-tab = 1; }
                        }
                        TabPill {
                            label: "Kanji Markers";
                            badge: root.kanji-total-count + "";
                            active: root.active-tab == 2;
                            clicked => { root.active-tab = 2; }
                        }
                    }

                    // Category Sub-filter Strip (Term Markers — wraps onto 2 rows at narrow widths without layout loops)
                    if root.active-tab == 1 : Rectangle {
                        property <bool> compact-wrap: root.width < 680px;
                        height: compact-wrap ? 58px : 26px;

                        if !compact-wrap : HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: 26px;
                            spacing: 6px;
                            alignment: start;

                            FilterChip {
                                label: "All Sections";
                                active: root.active-term-section == -1;
                                clicked => {
                                    root.active-term-section = -1;
                                    help-scroll.viewport-y = 0px;
                                }
                            }
                            for name[idx] in root.term-section-names : FilterChip {
                                label: name;
                                active: root.active-term-section == idx;
                                clicked => {
                                    root.active-term-section = idx;
                                    help-scroll.viewport-y = 0px;
                                }
                            }
                        }

                        if compact-wrap : VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: 58px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 0px;
                                alignment: start;
                                HorizontalLayout {
                                    padding-right: 6px;
                                    FilterChip {
                                        label: "All Sections";
                                        active: root.active-term-section == -1;
                                        clicked => {
                                            root.active-term-section = -1;
                                            help-scroll.viewport-y = 0px;
                                        }
                                    }
                                }
                                for name[idx] in root.term-section-names : HorizontalLayout {
                                    padding-right: idx < 2 ? 6px : 0px;
                                    if idx < 2 : FilterChip {
                                        label: name;
                                        active: root.active-term-section == idx;
                                        clicked => {
                                            root.active-term-section = idx;
                                            help-scroll.viewport-y = 0px;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 0px;
                                alignment: start;
                                for name[idx] in root.term-section-names : HorizontalLayout {
                                    padding-right: idx >= 2 ? 6px : 0px;
                                    if idx >= 2 : FilterChip {
                                        label: name;
                                        active: root.active-term-section == idx;
                                        clicked => {
                                            root.active-term-section = idx;
                                            help-scroll.viewport-y = 0px;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Category Sub-filter Strip (Kanji Markers — wraps onto 2 rows at narrow widths without layout loops)
                    if root.active-tab == 2 : Rectangle {
                        property <bool> compact-wrap: root.width < 660px;
                        height: compact-wrap ? 58px : 26px;

                        if !compact-wrap : HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: 26px;
                            spacing: 6px;
                            alignment: start;

                            FilterChip {
                                label: "All Sections";
                                active: root.active-kanji-section == -1;
                                clicked => {
                                    root.active-kanji-section = -1;
                                    help-scroll.viewport-y = 0px;
                                }
                            }
                            for name[idx] in root.kanji-section-names : FilterChip {
                                label: name;
                                active: root.active-kanji-section == idx;
                                clicked => {
                                    root.active-kanji-section = idx;
                                    help-scroll.viewport-y = 0px;
                                }
                            }
                        }

                        if compact-wrap : VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: 58px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 0px;
                                alignment: start;
                                HorizontalLayout {
                                    padding-right: 6px;
                                    FilterChip {
                                        label: "All Sections";
                                        active: root.active-kanji-section == -1;
                                        clicked => {
                                            root.active-kanji-section = -1;
                                            help-scroll.viewport-y = 0px;
                                        }
                                    }
                                }
                                for name[idx] in root.kanji-section-names : HorizontalLayout {
                                    padding-right: idx < 2 ? 6px : 0px;
                                    if idx < 2 : FilterChip {
                                        label: name;
                                        active: root.active-kanji-section == idx;
                                        clicked => {
                                            root.active-kanji-section = idx;
                                            help-scroll.viewport-y = 0px;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 0px;
                                alignment: start;
                                for name[idx] in root.kanji-section-names : HorizontalLayout {
                                    padding-right: idx >= 2 ? 6px : 0px;
                                    if idx >= 2 : FilterChip {
                                        label: name;
                                        active: root.active-kanji-section == idx;
                                        clicked => {
                                            root.active-kanji-section = idx;
                                            help-scroll.viewport-y = 0px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: MementoPalette.border; }

            // Centered Scrollable Tab Body (scrollbar width reserved)
            help-scroll := ScrollView {
                vertical-stretch: 1;

                Rectangle {
                    width: max(0px, help-scroll.width - 12px);
                    height: content-col.preferred-height;

                    content-col := VerticalLayout {
                        width: min(parent.width, 920px);
                        x: (parent.width - self.width) / 2;
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 16px;
                        padding-bottom: 24px;
                        spacing: 14px;
                        alignment: start;

                        // ── Tab 0: Overview & Syntax ───────────────────────────────
                        if root.active-tab == 0 : VerticalLayout {
                            spacing: 14px;

                            SyntaxCard {
                                title: "Basic Markers";
                                badge: "{name}";
                                body: "Wrap a marker name in curly braces inside any Anki field mapping. When Memento exports a card, each marker is replaced with live data from the active subtitle, lookup popup, or video frame.";
                                examples: [
                                    "{expression}",
                                    "{furigana}",
                                    "{subtitle}",
                                    "{glossary}",
                                ];
                                copy-snippet(s) => { root.copy-marker(s); }
                            }

                            SyntaxCard {
                                title: "Marker Arguments";
                                badge: ": key = value";
                                body: "Some markers accept arguments after a colon (:). Separate multiple arguments with commas (,). For example, you can target a single dictionary ID (shown in Options → Dictionary) or cap screenshot dimensions.";
                                examples: [
                                    "{glossary : dict = 1}",
                                    "{frequencies : min-value = true, value-only = true}",
                                    "{screenshot : max-width = 1280, max-height = 720}",
                                    "{video : source = context, subtitles = false}",
                                ];
                                copy-snippet(s) => { root.copy-marker(s); }
                            }

                            SyntaxCard {
                                title: "Fallback Chains";
                                badge: "a | b";
                                body: "Separate alternatives with a pipe (|) to fall back gracefully when earlier values are empty. Evaluation stops at the first non-empty result — ideal for preferring selected glossary text or your clipboard before falling back to full definitions.";
                                examples: [
                                    "{selection | clipboard}",
                                    "{selection | clipboard | glossary : dict = 1}",
                                    "{audio | audio-media}",
                                ];
                                copy-snippet(s) => { root.copy-marker(s); }
                            }

                            SyntaxCard {
                                title: "Context Selection & One-Click Presets";
                                badge: "Tips";
                                body: "Click or drag across rows in the Subtitle List drawer (or Shift-click a range) to mark multi-line context for {context}, {context-2}, {audio-context}, {video}, and {cloze-prefix}/{cloze-suffix}. Need a fast starting point? Use the one-click Lapis, Kiku, Senren, Animecards, or JPMN preset buttons right under Term Notes in Options → Anki Integration.";
                                examples: [
                                    "{cloze-prefix}<b>{cloze-body}</b>{cloze-suffix}",
                                    "{audio-context}",
                                ];
                                copy-snippet(s) => { root.copy-marker(s); }
                            }
                        }

                        // ── Tab 1: Term Markers ────────────────────────────────────
                        if root.active-tab == 1 : VerticalLayout {
                            spacing: 18px;

                            if root.term-sections.length == 0 : Rectangle {
                                height: 80px;
                                border-radius: 10px;
                                background: MementoPalette.card-bg;
                                border-width: 1px;
                                border-color: MementoPalette.card-border;
                                Text {
                                    text: "No term markers match \"" + root.search-query + "\".";
                                    color: MementoPalette.text-muted;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            for section[s-idx] in root.term-sections : VerticalLayout {
                                spacing: 10px;
                                visible: root.active-term-section == -1 || root.active-term-section == s-idx;

                                if (root.active-term-section == -1 || root.active-term-section == s-idx) && section.markers.length > 0 : VerticalLayout {
                                    spacing: 10px;

                                    SectionHeader {
                                        title: section.title;
                                        subtitle: section.subtitle;
                                        accent: MementoPalette.cyan-accent;
                                    }

                                    for marker in section.markers : MarkerCard {
                                        marker: marker;
                                        copy-marker(s) => { root.copy-marker(s); }
                                    }
                                }
                            }
                        }

                        // ── Tab 2: Kanji Markers ───────────────────────────────────
                        if root.active-tab == 2 : VerticalLayout {
                            spacing: 18px;

                            if root.kanji-sections.length == 0 : Rectangle {
                                height: 80px;
                                border-radius: 10px;
                                background: MementoPalette.card-bg;
                                border-width: 1px;
                                border-color: MementoPalette.card-border;
                                Text {
                                    text: "No kanji markers match \"" + root.search-query + "\".";
                                    color: MementoPalette.text-muted;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            for section[s-idx] in root.kanji-sections : VerticalLayout {
                                spacing: 10px;
                                visible: root.active-kanji-section == -1 || root.active-kanji-section == s-idx;

                                if (root.active-kanji-section == -1 || root.active-kanji-section == s-idx) && section.markers.length > 0 : VerticalLayout {
                                    spacing: 10px;

                                    SectionHeader {
                                        title: section.title;
                                        subtitle: section.subtitle;
                                        accent: MementoPalette.teal-border;
                                    }

                                    for marker in section.markers : MarkerCard {
                                        marker: marker;
                                        copy-marker(s) => { root.copy-marker(s); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
