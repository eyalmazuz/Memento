import { ComboBox, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { SubomiPalette } from "palette.slint";
import { ActionButton, IconButton, TooltipActionButton } from "components/buttons.slint";
import { SubomiSwitch } from "components/controls.slint";
import {
    AnkiAutocompleteItem,
    AnkiExcludedDictRow,
    AsrModelStatusRow,
    InstalledDictionaryRow,
    SettingsField,
    SettingsGroup,
    TextReplacementRow,
} from "settings/types.slint";
import { SubtitlePreviewCard } from "settings/controls.slint";
import { SettingsSection } from "settings/section.slint";
import { SettingsSidebar } from "settings/sidebar.slint";
import { DictionariesPanel } from "settings/dictionaries.slint";
import { AsrModelsPanel } from "settings/asr.slint";
import { CustomPopupCssPanel } from "settings/custom_css.slint";
import { TextReplacementsPanel } from "settings/text_replacements.slint";
import { DropOverlay, ModalDialog } from "components/modal.slint";
import { ColorPickerModal, ProfileModal } from "settings/modals.slint";

export {
    SettingsField,
    SettingsGroup,
    InstalledDictionaryRow,
    AsrModelStatusRow,
    AnkiExcludedDictRow,
    AnkiAutocompleteItem,
    TextReplacementRow,
}

// Apply/Reset/Defaults operate on the selected category.
// The owner refreshes settings-groups after reset/default/profile/list/category actions.
export component SettingsWindow inherits Window {
    title: "Options — Subomi";
    preferred-width: 1040px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: SubomiPalette.window-bg;
    default-font-family: "Noto Sans, sans-serif";

    in-out property <bool> is-light-theme <=> SubomiPalette.light-mode;
    in-out property <bool> drop-hover-active: false;
    in-out property <int> active-category: 0;
    in property <[SettingsGroup]> settings-groups;
    in property <[InstalledDictionaryRow]> installed-dictionaries;
    in property <[string]> font-families: [];
    in property <[string]> anki-profile-list: [];
    in property <string> current-anki-profile;
    in property <bool> anki-show-tag: false;
    in property <string> current-keybind-profile;
    in property <int> keybind-conflict-count: 0;
    in property <string> settings-status;
    in property <bool> ocr-built: false;
    in property <bool> ocr-available: false;
    in property <bool> asr-available: false;
    in-out property <[string]> available-anki-decks: [];
    in-out property <[string]> available-anki-models: [];
    in-out property <bool> adding-entry: false;
    in-out property <string> new-entry-name: "";
    in-out property <bool> profile-modal-open: false;
    in-out property <bool> profile-modal-is-rename: false;
    in-out property <bool> copy-current-profile: true;
    in-out property <string> profile-name-error: "";
    in-out property <bool> showing-advanced: false;
    in-out property <bool> showing-audio-help: false;
    in-out property <bool> connection-popup-open: false;
    in-out property <bool> connection-popup-ok: false;
    in-out property <string> connection-popup-text: "";

    // Sidebar filter & dirty category indicators
    in-out property <string> settings-search-query: "";
    in property <[bool]> dirty-categories: [false, false, false, false, false, false, false, false, false, false];
    in-out property <bool> testing-anki-connection: false;

    // Delete confirmation modal state
    in-out property <bool> confirm-delete-open: false;
    in-out property <string> confirm-delete-kind: ""; // "entry" or "dictionary"
    in-out property <int> confirm-delete-category: 0;
    in-out property <string> confirm-delete-id: "";
    in-out property <int> confirm-delete-dict-id: -1;
    in-out property <string> confirm-delete-title: "";
    in-out property <string> confirm-delete-message: "";

    // Dictionary background busy/progress UI
    in-out property <bool> dictionary-busy: false;
    in-out property <string> dictionary-progress-text: "";

    // ASR model status & non-blocking download UI
    in property <[AsrModelStatusRow]> asr-model-rows: [];
    in property <string> asr-models-dir: "";
    in-out property <bool> asr-download-active: false;
    in-out property <float> asr-download-progress: 0.0;
    in-out property <string> asr-download-text: "";
    in-out property <string> asr-download-model: "";

    // Color picker modal state
    in-out property <bool> color-picker-open: false;
    in-out property <string> color-picker-key: "";
    in-out property <string> color-picker-label: "";
    in-out property <int> color-picker-a: 255;
    in-out property <int> color-picker-r: 255;
    in-out property <int> color-picker-g: 255;
    in-out property <int> color-picker-b: 255;
    in-out property <string> color-picker-hex: "#FFFFFFFF";

    // Custom Popup CSS editor state (Interface category — split like Yomitan)
    in-out property <int> custom-css-tab: 0;
    in-out property <string> custom-popup-css: "";
    in property <string> custom-popup-css-path: "";
    in-out property <string> custom-popup-outer-css: "";
    in property <string> custom-popup-outer-css-path: "";

    // Live Subtitle Style Preview state (Interface category)
    in-out property <string> preview-sub-font-family: "Noto Sans CJK JP";
    in-out property <length> preview-sub-font-size: 24px;
    in-out property <bool> preview-sub-font-bold: false;
    in-out property <bool> preview-sub-font-italic: false;
    in-out property <color> preview-sub-text-color: #FFFFFF;
    in-out property <color> preview-sub-bg-color: #00000080;
    in-out property <color> preview-sub-stroke-color: #000000;
    in-out property <float> preview-sub-stroke-width: 1.5;
    in-out property <float> preview-sub-furigana-ratio: 0.45;
    in-out property <bool> preview-sub-show-furigana: true;

    // Anki excluded glossary dictionary checklist (`ex-glos`) & marker autocomplete
    in property <[AnkiExcludedDictRow]> anki-excluded-dicts: [];
    in property <[AnkiAutocompleteItem]> anki-autocomplete-items: [];
    in-out property <bool> anki-autocomplete-open: false;
    in-out property <string> anki-autocomplete-field-key: "";
    in-out property <int> anki-autocomplete-selected: 0;

    // Custom Text Replacements rule editor state (Search category)
    in property <[TextReplacementRow]> text-replacement-rows: [];
    in-out property <bool> text-replacements-search-original: true;

    callback close();
    callback anki-help-requested();
    callback category-changed(int);
    callback settings-search-changed(string);
    callback setting-edited(string, string);
    callback browse-folder-setting(string);
    callback color-hex-committed(string, string);
    callback color-picker-hex-edited(string);
    callback open-color-picker-requested(string, string);
    callback font-edited(string, string, string, bool, bool);
    callback font-size-typed(string, string, string, bool, bool);
    callback color-edited(string, int, int, int, int);
    callback keybind-captured(string, string, bool, bool, bool, bool);
    callback apply-anki-preset(string);
    callback anki-excluded-dict-toggled(string, bool);
    callback anki-field-autocomplete-query(string, string, int);
    callback anki-field-autocomplete-accepted(string, string);
    callback anki-field-autocomplete-dismissed();
    callback profile-name-edited(int, string, bool);
    callback add-profile-with-options(int, string, bool) -> bool;
    callback rename-profile(int, string, string);
    callback add-text-replacement-rule();
    callback remove-text-replacement-rule(int);
    callback move-text-replacement-rule(int, int);
    callback update-text-replacement-rule(int, string, string, bool, bool);
    callback text-replacements-search-original-changed(bool);
    callback apply-settings(int);
    callback reset-settings(int);
    callback defaults-settings(int);
    callback test-anki-connection();
    callback load-anki-fields(string);
    callback anki-fields-loaded();
    callback add-entry(int, string);
    callback remove-entry(int, string);
    callback move-entry(int, string, int);
    callback add-dictionary-archive();
    callback dictionary-enabled-changed(int, bool);
    callback move-dictionary-up(int);
    callback move-dictionary-down(int);
    callback delete-dictionary(int);
    callback download-asr-model(string, string);
    callback cancel-asr-download();
    callback refresh-asr-models();
    callback dictionary-archive-picked(string);
    callback dictionary-op-completed();
    callback asr-download-finished(bool, string);
    callback save-custom-popup-css(string, string);
    callback open-custom-popup-css(int);
    callback insert-custom-popup-css-template(int);

    private property <bool> searching: root.settings-search-query != "";

    init => {
        Palette.color-scheme = root.is-light-theme ? ColorScheme.light : ColorScheme.dark;
    }

    changed is-light-theme => {
        Palette.color-scheme = root.is-light-theme ? ColorScheme.light : ColorScheme.dark;
    }

    changed active-category => {
        body-scroll.viewport-y = 0px;
        root.anki-autocomplete-open = false;
    }

    changed settings-search-query => {
        body-scroll.viewport-y = 0px;
    }

    function open-confirm-entry-delete(category: int, entry-id: string, title: string, detail: string) {
        root.confirm-delete-kind = "entry";
        root.confirm-delete-category = category;
        root.confirm-delete-id = entry-id;
        root.confirm-delete-dict-id = -1;
        root.confirm-delete-title = title;
        root.confirm-delete-message = detail;
        root.confirm-delete-open = true;
    }

    function open-confirm-dictionary-delete(dict-id: int, dict-title: string) {
        root.confirm-delete-kind = "dictionary";
        root.confirm-delete-category = 4;
        root.confirm-delete-id = "";
        root.confirm-delete-dict-id = dict-id;
        root.confirm-delete-title = "Delete Dictionary?";
        root.confirm-delete-message = "Permanently remove \"" + dict-title + "\" (ID " + dict-id + ") from Subomi's dictionary database? You will need to re-import its ZIP archive to restore it.";
        root.confirm-delete-open = true;
    }

    function submit-new-entry() {
        if root.new-entry-name != "" {
            root.add-entry(root.active-category, root.new-entry-name);
            root.new-entry-name = "";
            root.adding-entry = false;
        }
    }

    root-focus := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.modifiers.control
                && (event.text == "f" || event.text == "F" || event.text == "\u{0006}") {
                sidebar.focus-search();
                return accept;
            }
            if event.text == Key.Escape {
                if root.anki-autocomplete-open {
                    root.anki-autocomplete-open = false;
                    root.anki-field-autocomplete-dismissed();
                } else if root.confirm-delete-open {
                    root.confirm-delete-open = false;
                } else if root.profile-modal-open {
                    root.profile-modal-open = false;
                    root.profile-name-error = "";
                } else if root.color-picker-open {
                    root.color-picker-open = false;
                } else if root.showing-audio-help {
                    root.showing-audio-help = false;
                } else if root.connection-popup-open {
                    root.connection-popup-open = false;
                } else if root.adding-entry {
                    root.new-entry-name = "";
                    root.adding-entry = false;
                } else if root.settings-search-query != "" {
                    root.settings-search-query = "";
                    root.settings-search-changed("");
                } else {
                    root.close();
                }
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            spacing: 0px;

            // ── Categorized Sidebar + Quick Search + Dirty Dots ──────────
            sidebar := SettingsSidebar {
                active-category: root.active-category;
                ocr-built: root.ocr-built;
                asr-available: root.asr-available;
                dirty-categories: root.dirty-categories;
                search-query <=> root.settings-search-query;
                select-category(cat) => {
                    root.settings-search-query = "";
                    root.active-category = cat;
                    root.adding-entry = false;
                    body-scroll.viewport-y = 0px;
                    root.category-changed(cat);
                }
                search-changed(q) => {
                    root.adding-entry = false;
                    body-scroll.viewport-y = 0px;
                    root.settings-search-changed(q);
                }
            }

            Rectangle { width: 1px; background: SubomiPalette.border; }

            // ── Main Content Area ─────────────────────────────────────────
            VerticalLayout {
                spacing: 0px;

                // Contextual Category Header Bar (strictly vertically centered)
                Rectangle {
                    height: 60px;
                    background: SubomiPalette.surface-bg;

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        alignment: space-between;
                        spacing: 14px;

                        // Page Title & Subtitle
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.searching ? "Search Results"
                                    : root.active-category == 0 ? "Anki Integration"
                                    : root.active-category == 1 ? "Application"
                                    : root.active-category == 2 ? "Audio Sources"
                                    : root.active-category == 3 ? "Behavior"
                                    : root.active-category == 4 ? "Dictionaries"
                                    : root.active-category == 5 ? "Interface"
                                    : root.active-category == 6 ? "Keybinds"
                                    : root.active-category == 7 ? "Manga OCR"
                                    : root.active-category == 8 ? "Speech Recognition (ASR)"
                                    : "Dictionary Search";
                                color: SubomiPalette.text;
                                font-size: 17px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.searching
                                    ? "Showing settings matching \"" + root.settings-search-query + "\""
                                    : root.active-category == 0 ? "Configure AnkiConnect profiles, card templates, and field mappings"
                                    : root.active-category == 1 ? "Interface language and automatic update preferences"
                                    : root.active-category == 2 ? "Manage word pronunciation audio endpoints and fallback priority"
                                    : root.active-category == 3 ? "Playback controls, auto-pause, OSC, and subtitle list behavior"
                                    : root.active-category == 4 ? "Import Yomitan .zip dictionaries, toggle visibility, and set priority order"
                                    : root.active-category == 5 ? "Customize subtitle fonts, stroke, colors, popup sizing, and styling"
                                    : root.active-category == 6 ? "Click any shortcut pill to record a new keyboard binding"
                                    : root.active-category == 7 ? "Configure Manga OCR model and GPU acceleration"
                                    : root.active-category == 8 ? "Select Whisper or ONNX speech models and manage local downloads"
                                    : "Configure hover/modifier lookup triggers, MeCab matching, and glossary layout";
                                color: SubomiPalette.text-muted;
                                font-size: 11.5px;
                                overflow: elide;
                            }
                        }

                        // Contextual Right Controls (vertically centered)
                        if !root.searching : VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                // Anki profile picker & Show Tag toggle
                                if root.active-category == 0 && !root.adding-entry : HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    Text {
                                        text: "Profile";
                                        color: SubomiPalette.text-muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ComboBox {
                                            width: 136px;
                                            model: root.anki-profile-list;
                                            current-value: root.current-anki-profile;
                                            selected(profile) => { root.setting-edited("anki/profile", profile); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 30px;
                                            width: tag-row.preferred-width;
                                            border-radius: 7px;
                                            background: SubomiPalette.card-bg;
                                            border-width: 1px;
                                            border-color: SubomiPalette.card-border;
                                            tag-row := HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: center;
                                                Text {
                                                    text: "Show tag";
                                                    color: SubomiPalette.text-secondary;
                                                    font-size: 11.5px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    SubomiSwitch {
                                                        checked: root.anki-show-tag;
                                                        toggled(value) => {
                                                            root.setting-edited("anki/profile/show-tag", value ? "true" : "false");
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Inline Add Profile: [LineEdit] [Cancel] [Add (primary)] + Enter submit
                                if root.adding-entry : HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;
                                    VerticalLayout {
                                        alignment: center;
                                        new-entry-input := LineEdit {
                                            width: 168px;
                                            text <=> root.new-entry-name;
                                            placeholder-text: "New profile name";
                                            init => { self.focus(); }
                                            accepted => { root.submit-new-entry(); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            text: "Cancel";
                                            ghost: true;
                                            compact: true;
                                            clicked => {
                                                root.new-entry-name = "";
                                                root.adding-entry = false;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            text: "Add";
                                            primary: true;
                                            compact: true;
                                            enabled: root.new-entry-name != "";
                                            clicked => { root.submit-new-entry(); }
                                        }
                                    }
                                }

                                // Audio Sources: labeled "+ Add Source" matching Dictionaries' "+ Import ZIP…"
                                if root.active-category == 2 && !root.adding-entry : VerticalLayout {
                                    alignment: center;
                                    ActionButton {
                                        text: "+ Add Source";
                                        primary: true;
                                        compact: true;
                                        clicked => { root.add-entry(2, ""); }
                                    }
                                }

                                // Profile actions: [+ Add] [Rename] LEFT of destructive [Delete]
                                if (root.active-category == 0 || root.active-category == 6) && !root.adding-entry : HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;

                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            icon: @image-url("icons/add.svg");
                                            tint: SubomiPalette.cyan-accent;
                                            tooltip: root.active-category == 0 ? "Add Anki profile" : "Add keybind profile";
                                            tooltip-below: true;
                                            clicked => {
                                                root.new-entry-name = "";
                                                root.profile-name-error = "";
                                                root.copy-current-profile = true;
                                                root.profile-modal-is-rename = false;
                                                root.profile-modal-open = true;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        TooltipActionButton {
                                            text: "Rename";
                                            compact: true;
                                            ghost: true;
                                            tooltip: root.active-category == 0 ? "Rename Anki profile" : "Rename keybind profile";
                                            clicked => {
                                                root.new-entry-name = root.active-category == 0
                                                    ? root.current-anki-profile
                                                    : root.current-keybind-profile;
                                                root.profile-name-error = "";
                                                root.profile-modal-is-rename = true;
                                                root.profile-modal-open = true;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            icon: @image-url("icons/delete.svg");
                                            danger: true;
                                            // Allow deleting even the last/Default profile (resets cleanly to "Default")
                                            enabled: true;
                                            tooltip: root.active-category == 0
                                                ? (root.anki-profile-list.length <= 1 ? "Reset Default profile" : "Delete current profile")
                                                : (root.current-keybind-profile == "Default" ? "Reset Default profile" : "Delete keybind profile");
                                            tooltip-below: true;
                                            tooltip-align-right: true;
                                            clicked => {
                                                if root.active-category == 0 {
                                                    root.open-confirm-entry-delete(
                                                        0,
                                                        root.current-anki-profile,
                                                        root.anki-profile-list.length <= 1 ? "Reset Default Anki Profile?" : "Delete Anki Profile?",
                                                        root.anki-profile-list.length <= 1
                                                            ? "Reset \"" + root.current-anki-profile + "\" back to factory defaults as \"Default\"? Click Apply afterward to persist."
                                                            : "Delete Anki profile \"" + root.current-anki-profile + "\" and its note field mappings? Click Apply afterward to persist.",
                                                    );
                                                } else {
                                                    root.open-confirm-entry-delete(
                                                        6,
                                                        root.current-keybind-profile,
                                                        root.current-keybind-profile == "Default" ? "Reset Default Keybind Profile?" : "Delete Keybind Profile?",
                                                        root.current-keybind-profile == "Default"
                                                            ? "Reset the \"Default\" keybind profile back to factory default shortcuts?"
                                                            : "Delete keybind profile \"" + root.current-keybind-profile + "\" and all of its shortcut bindings?",
                                                    );
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: SubomiPalette.border; }

                // Scrollable Settings Body (scrollbar width reserved so cards never overlap scrollbar)
                body-scroll := ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: max(0px, body-scroll.width - 12px);
                        padding-top: 18px;
                        padding-bottom: 26px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 18px;
                        alignment: start;

                        if (root.searching && root.settings-groups.length == 0)
                            || (!root.searching && ((root.active-category == 7 && !root.ocr-available) || (root.active-category == 8 && !root.asr-available))) : Rectangle {
                            property <bool> is-empty-search: root.searching && root.settings-groups.length == 0;
                            height: self.is-empty-search ? 92px : 40px;
                            background: self.is-empty-search ? SubomiPalette.card-bg : SubomiPalette.warning-bg;
                            border-width: 1px;
                            border-color: self.is-empty-search ? SubomiPalette.card-border : SubomiPalette.warning-border;
                            border-radius: self.is-empty-search ? 10px : 8px;
                            Text {
                                x: self.horizontal-alignment == TextHorizontalAlignment.center ? 0px : 14px;
                                width: self.horizontal-alignment == TextHorizontalAlignment.center ? parent.width : parent.width - 28px;
                                height: parent.height;
                                text: parent.is-empty-search
                                    ? ("No settings match \"" + root.settings-search-query + "\".")
                                    : (root.active-category == 7
                                        ? "⚠ manga-ocr not found — install into ~/.local/share/subomi/ocr-venv or set SUBOMI_OCR_PYTHON."
                                        : "⚠ ASR runtime unavailable; preferences remain editable.");
                                color: parent.is-empty-search ? SubomiPalette.text-muted : SubomiPalette.warning-text;
                                font-size: parent.is-empty-search ? 13px : 12px;
                                horizontal-alignment: parent.is-empty-search ? center : left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        // ── Live Subtitle Style Preview Card (Interface category) ─
                        if !root.searching && root.active-category == 5 : SubtitlePreviewCard {
                            sub-font-family: root.preview-sub-font-family;
                            sub-font-size: root.preview-sub-font-size;
                            sub-font-bold: root.preview-sub-font-bold;
                            sub-font-italic: root.preview-sub-font-italic;
                            sub-text-color: root.preview-sub-text-color;
                            sub-bg-color: root.preview-sub-bg-color;
                            sub-stroke-color: root.preview-sub-stroke-color;
                            sub-stroke-width: root.preview-sub-stroke-width;
                            sub-furigana-ratio: root.preview-sub-furigana-ratio;
                            show-furigana <=> root.preview-sub-show-furigana;
                        }

                        for group[g-idx] in root.settings-groups : VerticalLayout {
                            if group.category != 4 &&
                                (root.searching || group.category != 0 || group.title != "Advanced" || root.showing-advanced) : SettingsSection {
                                group: group;
                                anki-decks: root.available-anki-decks;
                                anki-models: root.available-anki-models;
                                font-families: root.font-families;
                                anki-excluded-dicts: root.anki-excluded-dicts;
                                anki-autocomplete-items: root.anki-autocomplete-items;
                                anki-autocomplete-open: root.anki-autocomplete-open;
                                anki-autocomplete-field-key: root.anki-autocomplete-field-key;
                                anki-autocomplete-selected <=> root.anki-autocomplete-selected;
                                keybind-conflict-count: root.keybind-conflict-count;
                                testing-anki: root.testing-anki-connection;
                                can-move-up: g-idx > 0;
                                can-move-down: g-idx < root.settings-groups.length - 1;
                                show-advanced: root.showing-advanced;
                                edited(key, value) => { root.setting-edited(key, value); }
                                browse-folder-setting(key) => { root.browse-folder-setting(key); }
                                color-hex-committed(key, value) => { root.color-hex-committed(key, value); }
                                font-edited(key, family, size, bold, italic) => {
                                    root.font-edited(key, family, size, bold, italic);
                                }
                                font-size-typed(key, family, size, bold, italic) => {
                                    root.font-size-typed(key, family, size, bold, italic);
                                }
                                open-color-picker(f) => {
                                    root.open-color-picker-requested(f.key, f.label);
                                }
                                keybind-captured(key, text, ctrl, alt, shift, meta) => {
                                    root.keybind-captured(key, text, ctrl, alt, shift, meta);
                                }
                                anki-excluded-dict-toggled(name, excluded) => {
                                    root.anki-excluded-dict-toggled(name, excluded);
                                }
                                anki-field-autocomplete-query(key, text, pos) => {
                                    root.anki-field-autocomplete-query(key, text, pos);
                                }
                                anki-field-autocomplete-accepted(key, insert-text) => {
                                    root.anki-autocomplete-open = false;
                                    root.anki-field-autocomplete-accepted(key, insert-text);
                                }
                                anki-field-autocomplete-dismissed => {
                                    root.anki-autocomplete-open = false;
                                    root.anki-field-autocomplete-dismissed();
                                }
                                apply-anki-preset(preset) => { root.apply-anki-preset(preset); }
                                advanced-changed(value) => { root.showing-advanced = value; }
                                move-entry(id, direction) => { root.move-entry(group.category, id, direction); }
                                remove-entry(id, label) => {
                                    root.open-confirm-entry-delete(
                                        group.category,
                                        id,
                                        "Delete Audio Source?",
                                        "Remove \"" + label + "\" from your audio sources list?",
                                    );
                                }
                                test-anki-connection => { root.test-anki-connection(); }
                                load-anki-fields(section) => { root.load-anki-fields(section); }
                            }
                        }

                        // ── Custom Text Replacements Editor (Search category) ─
                        if !root.searching && root.active-category == 9 : TextReplacementsPanel {
                            rows: root.text-replacement-rows;
                            search-original <=> root.text-replacements-search-original;
                            add-rule => { root.add-text-replacement-rule(); }
                            remove-rule(idx) => { root.remove-text-replacement-rule(idx); }
                            move-rule(idx, delta) => { root.move-text-replacement-rule(idx, delta); }
                            update-rule(idx, pat, repl, icase, en) => {
                                root.update-text-replacement-rule(idx, pat, repl, icase, en);
                            }
                            search-original-changed(val) => {
                                root.text-replacements-search-original-changed(val);
                            }
                        }

                        // ── Custom Popup CSS Card (Interface category) ───────
                        if !root.searching && root.active-category == 5 : CustomPopupCssPanel {
                            custom-css-tab <=> root.custom-css-tab;
                            custom-popup-css <=> root.custom-popup-css;
                            custom-popup-css-path: root.custom-popup-css-path;
                            custom-popup-outer-css <=> root.custom-popup-outer-css;
                            custom-popup-outer-css-path: root.custom-popup-outer-css-path;
                            save-custom-popup-css(inner, outer) => { root.save-custom-popup-css(inner, outer); }
                            open-custom-popup-css(tab) => { root.open-custom-popup-css(tab); }
                            insert-custom-popup-css-template(tab) => { root.insert-custom-popup-css-template(tab); }
                        }

                        // ── ASR Models Card ───────────────────────────────────
                        if !root.searching && root.active-category == 8 : AsrModelsPanel {
                            asr-model-rows: root.asr-model-rows;
                            asr-models-dir: root.asr-models-dir;
                            asr-download-active: root.asr-download-active;
                            asr-download-progress: root.asr-download-progress;
                            asr-download-text: root.asr-download-text;
                            download-asr-model(backend, name) => { root.download-asr-model(backend, name); }
                            cancel-asr-download => { root.cancel-asr-download(); }
                            refresh-asr-models => { root.refresh-asr-models(); }
                        }

                        // ── Installed Dictionaries Section ────────────────────
                        if !root.searching && root.active-category == 4 : DictionariesPanel {
                            installed-dictionaries: root.installed-dictionaries;
                            dictionary-busy: root.dictionary-busy;
                            dictionary-progress-text: root.dictionary-progress-text;
                            drop-hover-active: root.drop-hover-active;
                            add-dictionary-archive => { root.add-dictionary-archive(); }
                            dictionary-enabled-changed(id, enabled) => { root.dictionary-enabled-changed(id, enabled); }
                            move-dictionary-up(id) => { root.move-dictionary-up(id); }
                            move-dictionary-down(id) => { root.move-dictionary-down(id); }
                            request-delete-dictionary(id, title) => { root.open-confirm-dictionary-delete(id, title); }
                        }
                    }
                }

                Rectangle { height: 1px; background: SubomiPalette.border; }

                // ── Footer Bar (strictly vertically centered, category-aware) ──
                Rectangle {
                    height: 54px;
                    background: SubomiPalette.surface-bg;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            horizontal-stretch: 1;

                            if !root.searching && (root.active-category == 0 || root.active-category == 2) : VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    text: root.active-category == 0 ? "Marker Help" : "Audio Help";
                                    clicked => {
                                        if root.active-category == 0 {
                                            root.anki-help-requested();
                                        } else {
                                            root.showing-audio-help = true;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.settings-status != ""
                                    ? root.settings-status
                                    : (!root.searching && root.active-category == 4
                                        ? "Dictionary changes apply immediately"
                                        : "");
                                color: SubomiPalette.text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                // Dictionaries instant-save; hide Reset / Defaults / Apply there
                                if root.searching || root.active-category != 4 : HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        text: "Reset";
                                        ghost: true;
                                        clicked => { root.reset-settings(root.active-category); }
                                    }
                                    ActionButton {
                                        text: "Defaults";
                                        clicked => { root.defaults-settings(root.active-category); }
                                    }
                                    ActionButton {
                                        text: "Apply";
                                        primary: true;
                                        clicked => { root.apply-settings(root.active-category); }
                                    }
                                }

                                ActionButton {
                                    text: "Close";
                                    ghost: root.searching || root.active-category != 4;
                                    primary: !root.searching && root.active-category == 4;
                                    clicked => { root.close(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Modals (standardized onto ModalDialog) ────────────────────────
        if root.color-picker-open : ColorPickerModal {
            color-key: root.color-picker-key;
            color-label: root.color-picker-label;
            color-a <=> root.color-picker-a;
            color-r <=> root.color-picker-r;
            color-g <=> root.color-picker-g;
            color-b <=> root.color-picker-b;
            color-hex <=> root.color-picker-hex;
            dismissed => { root.color-picker-open = false; }
            hex-input-edited(val) => { root.color-picker-hex-edited(val); }
            apply-color(key, a, r, g, b) => {
                root.color-edited(key, a, r, g, b);
                root.color-picker-open = false;
            }
        }

        if root.showing-audio-help || root.connection-popup-open || root.confirm-delete-open : ModalDialog {
            title: root.confirm-delete-open
                ? root.confirm-delete-title
                : (root.connection-popup-open
                    ? (root.connection-popup-ok ? "✔ Connected to Anki" : "✖ Connection Failed")
                    : "Audio Sources Help");
            title-color: root.confirm-delete-open
                ? SubomiPalette.text
                : (root.connection-popup-open
                    ? (root.connection-popup-ok ? SubomiPalette.success-text : SubomiPalette.danger-text)
                    : SubomiPalette.text);
            accent-border: root.confirm-delete-open
                ? SubomiPalette.danger
                : (root.connection-popup-open
                    ? (root.connection-popup-ok ? SubomiPalette.success : SubomiPalette.danger)
                    : SubomiPalette.border-light);
            dialog-width: root.confirm-delete-open || root.connection-popup-open ? 420px : 540px;
            cancel-text: root.confirm-delete-open ? "Cancel" : "";
            primary-text: root.confirm-delete-open ? "Delete" : "OK";
            primary-danger: root.confirm-delete-open;
            dismissed => {
                if root.confirm-delete-open {
                    root.confirm-delete-open = false;
                } else if root.connection-popup-open {
                    root.connection-popup-open = false;
                } else {
                    root.showing-audio-help = false;
                }
            }
            primary-clicked => {
                if root.confirm-delete-open {
                    root.confirm-delete-open = false;
                    if root.confirm-delete-kind == "dictionary" {
                        root.delete-dictionary(root.confirm-delete-dict-id);
                    } else {
                        root.remove-entry(root.confirm-delete-category, root.confirm-delete-id);
                    }
                } else if root.connection-popup-open {
                    root.connection-popup-open = false;
                } else {
                    root.showing-audio-help = false;
                }
            }

            Text {
                text: root.confirm-delete-open
                    ? root.confirm-delete-message
                    : (root.connection-popup-open
                        ? root.connection-popup-text
                        : "Source Name: The name of the audio source as it will appear in Subomi.\n\nURL: The URL of the audio source. Supports inserting {expression} and {reading} markers into the URL.\n\nMD5 Skip Hash: Audio that matches this MD5 hash will be ignored.");
                color: SubomiPalette.text-secondary;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        if root.profile-modal-open : ProfileModal {
            is-rename: root.profile-modal-is-rename;
            kind-label: root.active-category == 0 ? "Anki" : "Keybind";
            profile-name <=> root.new-entry-name;
            copy-current-profile <=> root.copy-current-profile;
            profile-name-error: root.profile-name-error;
            name-changed(val) => {
                root.profile-name-edited(root.active-category, val, root.profile-modal-is-rename);
            }
            dismissed => {
                root.profile-modal-open = false;
                root.profile-name-error = "";
                root.new-entry-name = "";
            }
            submitted(name, copy-cur) => {
                if name != "" && root.profile-name-error == "" {
                    root.profile-modal-open = false;
                    if root.profile-modal-is-rename {
                        let old-name = root.active-category == 0
                            ? root.current-anki-profile
                            : root.current-keybind-profile;
                        root.rename-profile(root.active-category, old-name, name);
                    } else if !root.add-profile-with-options(root.active-category, name, copy-cur) {
                        root.add-entry(root.active-category, name);
                    }
                    root.new-entry-name = "";
                    root.profile-name-error = "";
                }
            }
        }

        // Subtle OS Drag-and-Drop Overlay for Yomitan .zip dictionary imports (C2)
        DropOverlay {
            active: root.drop-hover-active;
            label: "Drop Yomitan .zip dictionary archive to import";
        }
    }
}
