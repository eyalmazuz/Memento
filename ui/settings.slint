import { Button, ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";

// Values and choices are supplied by ConfigController, not by sample settings.
export struct SettingsField {
    key: string,
    label: string,
    kind: string, // "switch", "choice", "text", "font", "color", or "keybind"
    value: string,
    choices: [string],
    enabled: bool,
    visible: bool,
    font-family: string,
    font-size: string,
    font-bold: bool,
    font-italic: bool,
    color-swatch: color,
    color-a: int,
    color-r: int,
    color-g: int,
    color-b: int,
    conflict: string,
}

export struct SettingsGroup {
    category: int,
    title: string,
    entry_id: string, // an audio-source index, or empty for ordinary sections
    fields: [SettingsField],
}

export struct InstalledDictionaryRow {
    id: int,
    title: string,
    disabled: bool,
}

export struct AsrModelStatusRow {
    backend: string,
    name: string,
    path: string,
    installed: bool,
    selected: bool,
    status-text: string,
}

component SettingsSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px;
    height: 20px;
    border-radius: 10px;
    opacity: enabled ? 1 : 0.45;
    background: checked ? #00867c : #384045;
    Rectangle {
        x: root.checked ? 20px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        animate x { duration: 120ms; }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: selected ? #007A65 : (touch.has-hover ? #2e353a : transparent);
    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.selected ? white : #b0b8bc;
    }
    Text {
        x: 40px;
        y: 0;
        width: parent.width - 50px;
        height: parent.height;
        text: root.label;
        color: root.selected ? white : #dce0e2;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ToolIcon inherits Rectangle {
    in property <image> icon;
    in property <color> tint: #d8dcde;
    in property <bool> enabled: true;
    callback clicked();
    width: 30px;
    height: 30px;
    background: (root.enabled && touch.has-hover) ? #384046 : transparent;
    border-radius: 4px;
    Image {
        x: 6px;
        y: 6px;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.enabled ? root.tint : #5a6469;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

component ToggleChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> bold-text: false;
    in property <bool> italic-text: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 30px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.active ? #00a896 : #485259;
    background: root.active ? #007A65 : (chip-touch.has-hover && root.enabled ? #333b41 : #2a3035);
    opacity: root.enabled ? 1.0 : 0.45;
    Text {
        text: root.text;
        color: root.active ? white : #dce0e2;
        font-size: 13px;
        font-weight: root.bold-text ? 700 : 500;
        font-italic: root.italic-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    chip-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component FontPickerControl inherits HorizontalLayout {
    in property <SettingsField> field;
    in property <[string]> font-families;
    property <bool> custom-family: false;
    callback font-edited(string, string, string, bool, bool);
    callback font-size-typed(string, string, string, bool, bool);
    spacing: 6px;
    alignment: end;

    if !root.custom-family : ComboBox {
        width: 190px;
        enabled: root.field.enabled;
        model: root.font-families;
        current-value: root.field.font-family;
        selected(value) => {
            root.font-edited(
                root.field.key,
                value,
                size-edit.text,
                root.field.font-bold,
                root.field.font-italic,
            );
        }
    }
    if root.custom-family : LineEdit {
        width: 190px;
        enabled: root.field.enabled;
        text: root.field.font-family;
        placeholder-text: "Font family";
        edited(value) => {
            root.font-size-typed(
                root.field.key,
                value,
                size-edit.text,
                root.field.font-bold,
                root.field.font-italic,
            );
        }
    }
    ToggleChip {
        text: "✎";
        active: root.custom-family;
        enabled: root.field.enabled;
        clicked => { root.custom-family = !root.custom-family; }
    }
    Button {
        text: "-";
        enabled: root.field.enabled;
        clicked => {
            let next = max(1, Math.round(size-edit.text.to-float()) - 1);
            root.font-edited(
                root.field.key,
                root.field.font-family,
                next + "",
                root.field.font-bold,
                root.field.font-italic,
            );
        }
    }
    size-edit := LineEdit {
        width: 54px;
        enabled: root.field.enabled;
        text: root.field.font-size;
        edited(value) => {
            root.font-size-typed(
                root.field.key,
                root.field.font-family,
                value,
                root.field.font-bold,
                root.field.font-italic,
            );
        }
    }
    Button {
        text: "+";
        enabled: root.field.enabled;
        clicked => {
            let next = min(500, max(1, Math.round(size-edit.text.to-float()) + 1));
            root.font-edited(
                root.field.key,
                root.field.font-family,
                next + "",
                root.field.font-bold,
                root.field.font-italic,
            );
        }
    }
    ToggleChip {
        text: "B";
        bold-text: true;
        active: root.field.font-bold;
        enabled: root.field.enabled;
        clicked => {
            root.font-edited(
                root.field.key,
                root.field.font-family,
                size-edit.text,
                !root.field.font-bold,
                root.field.font-italic,
            );
        }
    }
    ToggleChip {
        text: "I";
        italic-text: true;
        active: root.field.font-italic;
        enabled: root.field.enabled;
        clicked => {
            root.font-edited(
                root.field.key,
                root.field.font-family,
                size-edit.text,
                root.field.font-bold,
                !root.field.font-italic,
            );
        }
    }
}

component ColorSwatchControl inherits HorizontalLayout {
    in property <SettingsField> field;
    callback edited(string, string);
    callback open-color-picker(SettingsField);
    spacing: 8px;
    alignment: end;

    Rectangle {
        width: 38px;
        height: 28px;
        border-radius: 5px;
        border-width: 1px;
        border-color: swatch-touch.has-hover ? #00a896 : #50606A;
        background: #14181b;
        // Subtle checkerboard cue for alpha-transparent colors
        Rectangle {
            x: 3px;
            y: 3px;
            width: 16px;
            height: 11px;
            background: #2f383e;
        }
        Rectangle {
            x: 19px;
            y: 14px;
            width: 16px;
            height: 11px;
            background: #2f383e;
        }
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: 4px;
            background: root.field.color-swatch;
        }
        swatch-touch := TouchArea {
            enabled: root.field.enabled;
            mouse-cursor: root.field.enabled ? pointer : default;
            clicked => { root.open-color-picker(root.field); }
        }
    }
    LineEdit {
        width: 116px;
        enabled: root.field.enabled;
        text: root.field.value;
        edited(value) => { root.edited(root.field.key, value); }
    }
    Button {
        text: "Pick…";
        enabled: root.field.enabled;
        clicked => { root.open-color-picker(root.field); }
    }
}

component KeybindCaptureControl inherits VerticalLayout {
    in property <SettingsField> field;
    property <bool> recording: false;
    callback edited(string, string);
    callback keybind-captured(string, string, bool, bool, bool, bool);
    spacing: 3px;

    HorizontalLayout {
        spacing: 6px;
        alignment: end;
        capture-focus := FocusScope {
            width: 196px;
            height: 30px;
            enabled: root.field.enabled;
            changed has-focus => {
                if !self.has-focus {
                    root.recording = false;
                }
            }
            key-pressed(event) => {
                if !root.recording {
                    return reject;
                }
                if event.text == ""
                    || event.text == Key.Shift
                    || event.text == Key.Control
                    || event.text == Key.Alt
                    || event.text == Key.Meta
                    || event.text == Key.AltGr
                    || event.text == Key.CapsLock {
                    return accept;
                }
                if event.text == Key.Escape
                    && !event.modifiers.control
                    && !event.modifiers.alt
                    && !event.modifiers.shift
                    && !event.modifiers.meta {
                    root.recording = false;
                    return accept;
                }
                root.recording = false;
                root.keybind-captured(
                    root.field.key,
                    event.text,
                    event.modifiers.control,
                    event.modifiers.alt,
                    event.modifiers.shift,
                    event.modifiers.meta,
                );
                return accept;
            }
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 5px;
                border-width: root.recording || root.field.conflict != "" ? 1.5px : 1px;
                border-color: root.recording
                    ? #00a896
                    : (root.field.conflict != "" ? #eab308 : (cap-touch.has-hover ? #677680 : #485259));
                background: root.recording ? #1a3330 : #2a3035;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: root.recording
                        ? "Press shortcut… (Esc)"
                        : (root.field.value == "" ? "Unassigned" : root.field.value);
                    color: root.recording
                        ? #6ee7b7
                        : (root.field.value == "" ? #7a8387 : #dce0e2);
                    font-size: 12px;
                    font-weight: root.recording ? 600 : 500;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                cap-touch := TouchArea {
                    enabled: root.field.enabled;
                    mouse-cursor: root.field.enabled ? pointer : default;
                    clicked => {
                        root.recording = true;
                        capture-focus.focus();
                    }
                }
            }
        }
        ToggleChip {
            text: "×";
            active: false;
            enabled: root.field.enabled && root.field.value != "";
            clicked => {
                root.recording = false;
                root.edited(root.field.key, "");
            }
        }
    }
    if root.field.conflict != "" : Text {
        text: "⚠ " + root.field.conflict;
        color: #fbbf24;
        font-size: 11px;
        horizontal-alignment: right;
        overflow: elide;
    }
}

component FieldRow inherits VerticalLayout {
    in property <SettingsField> field;
    in property <[string]> anki-decks;
    in property <[string]> anki-models;
    in property <[string]> font-families;
    property <bool> use-anki-decks: (root.field.key == "anki/profile/term/deck" || root.field.key == "anki/profile/kanji/deck") && root.anki-decks.length > 0;
    property <bool> use-anki-models: (root.field.key == "anki/profile/term/model" || root.field.key == "anki/profile/kanji/model") && root.anki-models.length > 0;
    callback edited(string, string);
    callback font-edited(string, string, string, bool, bool);
    callback font-size-typed(string, string, string, bool, bool);
    callback open-color-picker(SettingsField);
    callback keybind-captured(string, string, bool, bool, bool, bool);
    visible: root.field.visible;
    padding-top: 6px;
    padding-bottom: 6px;
    min-height: 42px;
    alignment: center;

    HorizontalLayout {
        spacing: 12px;
        alignment: space-between;
        Text {
            text: root.field.label;
            font-size: 13px;
            color: root.field.enabled ? #dce0e2 : #7a8387;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.field.kind == "switch" : VerticalLayout {
            alignment: center;
            SettingsSwitch {
                checked: root.field.value == "true";
                enabled: root.field.enabled;
                toggled(value) => { root.edited(root.field.key, value ? "true" : "false"); }
            }
        }
        if root.field.kind == "choice" : VerticalLayout {
            alignment: center;
            ComboBox {
                width: 220px;
                enabled: root.field.enabled;
                model: root.field.choices;
                current-value: root.field.value;
                selected(value) => { root.edited(root.field.key, value); }
            }
        }
        if root.field.kind == "font" : VerticalLayout {
            alignment: center;
            FontPickerControl {
                field: root.field;
                font-families: root.font-families;
                font-edited(key, family, size, bold, italic) => {
                    root.font-edited(key, family, size, bold, italic);
                }
                font-size-typed(key, family, size, bold, italic) => {
                    root.font-size-typed(key, family, size, bold, italic);
                }
            }
        }
        if root.field.kind == "color" : VerticalLayout {
            alignment: center;
            ColorSwatchControl {
                field: root.field;
                edited(key, value) => { root.edited(key, value); }
                open-color-picker(f) => { root.open-color-picker(f); }
            }
        }
        if root.field.kind == "keybind" : VerticalLayout {
            alignment: center;
            KeybindCaptureControl {
                field: root.field;
                edited(key, value) => { root.edited(key, value); }
                keybind-captured(key, text, ctrl, alt, shift, meta) => {
                    root.keybind-captured(key, text, ctrl, alt, shift, meta);
                }
            }
        }
        if root.field.kind == "text" && (root.use-anki-decks || root.use-anki-models) : VerticalLayout {
            alignment: center;
            ComboBox {
                width: 220px;
                enabled: root.field.enabled;
                model: root.use-anki-decks ? root.anki-decks : root.anki-models;
                current-value: root.field.value;
                selected(value) => { root.edited(root.field.key, value); }
            }
        }
        if root.field.kind == "text" && !root.use-anki-decks && !root.use-anki-models : VerticalLayout {
            alignment: center;
            LineEdit {
                width: 220px;
                enabled: root.field.enabled;
                text: root.field.value;
                edited(value) => { root.edited(root.field.key, value); }
            }
        }
    }
}

component SettingsSection inherits VerticalLayout {
    in property <SettingsGroup> group;
    in property <[string]> anki-decks;
    in property <[string]> anki-models;
    in property <[string]> font-families;
    in property <int> keybind-conflict-count: 0;
    in-out property <bool> show-advanced: false;
    callback edited(string, string);
    callback font-edited(string, string, string, bool, bool);
    callback font-size-typed(string, string, string, bool, bool);
    callback open-color-picker(SettingsField);
    callback keybind-captured(string, string, bool, bool, bool, bool);
    callback apply-anki-preset(string);
    callback advanced-changed(bool);
    callback move-entry(string, int);
    callback remove-entry(string);
    callback test-anki-connection();
    callback load-anki-fields(string);

    spacing: 6px;
    horizontal-stretch: 1;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        alignment: space-between;
        Text {
            text: root.group.title;
            font-size: 13px;
            font-weight: 700;
            color: #dce0e2;
            vertical-alignment: center;
        }
        if root.group.entry_id != "" : HorizontalLayout {
            spacing: 4px;
            ToolIcon {
                icon: @image-url("icons/arrow-up.svg");
                clicked => { root.move-entry(root.group.entry_id, -1); }
            }
            ToolIcon {
                icon: @image-url("icons/arrow-down.svg");
                clicked => { root.move-entry(root.group.entry_id, 1); }
            }
            ToolIcon {
                icon: @image-url("icons/delete.svg");
                tint: #ed6b72;
                clicked => { root.remove-entry(root.group.entry_id); }
            }
        }
    }
    if root.group.category == 6 && root.group.title == "Keyboard Shortcuts" && root.keybind-conflict-count > 0 : Rectangle {
        height: 36px;
        background: #493a24;
        border-width: 1px;
        border-color: #b45309;
        border-radius: 6px;
        Text {
            x: 14px;
            width: parent.width - 28px;
            text: "⚠ Duplicate shortcut conflict detected in this profile. Click any shortcut to reassign.";
            color: #fde68a;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        background: #21262a;
        border-width: 1px;
        border-color: #384046;
        border-radius: 8px;
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 0px;
            for field[index] in root.group.fields : VerticalLayout {
                spacing: 0px;
                if index > 0 : Rectangle { height: 1px; background: #2f363b; }
                FieldRow {
                    field: field;
                    anki-decks: root.anki-decks;
                    anki-models: root.anki-models;
                    font-families: root.font-families;
                    edited(key, value) => { root.edited(key, value); }
                    font-edited(key, family, size, bold, italic) => {
                        root.font-edited(key, family, size, bold, italic);
                    }
                    font-size-typed(key, family, size, bold, italic) => {
                        root.font-size-typed(key, family, size, bold, italic);
                    }
                    open-color-picker(f) => { root.open-color-picker(f); }
                    keybind-captured(key, text, ctrl, alt, shift, meta) => {
                        root.keybind-captured(key, text, ctrl, alt, shift, meta);
                    }
                }
            }
            if root.group.category == 0 && root.group.title == "Term Notes" : VerticalLayout {
                spacing: 0px;
                Rectangle { height: 1px; background: #2f363b; }
                HorizontalLayout {
                    height: 44px;
                    spacing: 6px;
                    alignment: space-between;
                    Text {
                        text: "One-click presets";
                        font-size: 12px;
                        color: #9ca6aa;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button { text: "Lapis"; clicked => { root.apply-anki-preset("Lapis"); } }
                    Button { text: "Kiku"; clicked => { root.apply-anki-preset("Kiku"); } }
                    Button { text: "Senren"; clicked => { root.apply-anki-preset("Senren"); } }
                    Button { text: "Animecards"; clicked => { root.apply-anki-preset("Animecards"); } }
                    Button { text: "JPMN"; clicked => { root.apply-anki-preset("JPMN"); } }
                }
            }
            if root.group.category == 0 && (root.group.title == "Term Notes" || root.group.title == "Kanji Notes") : HorizontalLayout {
                height: 44px;
                alignment: end;
                if root.group.fields.length <= 2 : Text {
                    text: "No model fields loaded.";
                    color: #9CA6AA;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    font-size: 12px;
                }
                Button {
                    text: "Load model fields";
                    clicked => { root.load-anki-fields(root.group.title == "Term Notes" ? "term" : "kanji"); }
                }
            }
            if root.group.category == 0 && root.group.title == "General" : VerticalLayout {
                spacing: 0px;
                Rectangle { height: 1px; background: #2f363b; }
                HorizontalLayout {
                    height: 42px;
                    alignment: space-between;
                    Text {
                        text: "Show advanced settings";
                        font-size: 13px;
                        color: #dce0e2;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        SettingsSwitch {
                            checked: root.show-advanced;
                            toggled(value) => {
                                root.show-advanced = value;
                                root.advanced-changed(value);
                            }
                        }
                    }
                }
            }
            if root.group.category == 0 && root.group.title == "AnkiConnect" : VerticalLayout {
                spacing: 0px;
                Rectangle { height: 1px; background: #2f363b; }
                HorizontalLayout {
                    height: 42px;
                    alignment: space-between;
                    Text {
                        text: "Test connection";
                        font-size: 13px;
                        color: #dce0e2;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Connect";
                            clicked => { root.test-anki-connection(); }
                        }
                    }
                }
            }
        }
    }
}

// Apply/Reset/Defaults operate on the selected category, as in the QML pages.
// The owner refreshes settings-groups after reset/default/profile/list/category actions.
export component SettingsWindow inherits Window {
    title: "Options";
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 800px;
    min-height: 550px;
    background: #282e32;
    default-font-family: "Noto Sans, sans-serif";

    in-out property <int> active-category: 0;
    in property <[SettingsGroup]> settings-groups;
    in property <[InstalledDictionaryRow]> installed-dictionaries;
    in property <[string]> font-families: [];
    in property <[string]> anki-profile-list: [];
    in property <string> current-anki-profile;
    in property <bool> anki-show-tag: false;
    in property <string> current-keybind-profile;
    in property <int> keybind-conflict-count: 0;
    in property <string> settings-status;
    in property <bool> ocr-built: false;
    in property <bool> ocr-available: false;
    in property <bool> asr-available: false;
    in-out property <[string]> available-anki-decks: [];
    in-out property <[string]> available-anki-models: [];
    in-out property <bool> adding-entry: false;
    in-out property <string> new-entry-name: "";
    in-out property <bool> showing-advanced: false;
    in-out property <bool> showing-audio-help: false;
    in-out property <bool> connection-popup-open: false;
    in-out property <bool> connection-popup-ok: false;
    in-out property <string> connection-popup-text: "";

    // Dictionary background busy/progress UI
    in-out property <bool> dictionary-busy: false;
    in-out property <string> dictionary-progress-text: "";

    // ASR model status & non-blocking download UI
    in property <[AsrModelStatusRow]> asr-model-rows: [];
    in property <string> asr-models-dir: "";
    in-out property <bool> asr-download-active: false;
    in-out property <float> asr-download-progress: 0.0;
    in-out property <string> asr-download-text: "";
    in-out property <string> asr-download-model: "";

    // Color picker modal state
    in-out property <bool> color-picker-open: false;
    in-out property <string> color-picker-key: "";
    in-out property <string> color-picker-label: "";
    in-out property <int> color-picker-a: 255;
    in-out property <int> color-picker-r: 255;
    in-out property <int> color-picker-g: 255;
    in-out property <int> color-picker-b: 255;
    in-out property <string> color-picker-hex: "#FFFFFFFF";

    callback close();
    callback anki-help-requested();
    callback category-changed(int);
    callback setting-edited(string, string);
    callback font-edited(string, string, string, bool, bool);
    callback font-size-typed(string, string, string, bool, bool);
    callback color-edited(string, int, int, int, int);
    callback keybind-captured(string, string, bool, bool, bool, bool);
    callback apply-anki-preset(string);
    callback apply-settings(int);
    callback reset-settings(int);
    callback defaults-settings(int);
    callback test-anki-connection();
    callback load-anki-fields(string);
    callback add-entry(int, string);
    callback remove-entry(int, string);
    callback move-entry(int, string, int);
    callback add-dictionary-archive();
    callback dictionary-enabled-changed(int, bool);
    callback move-dictionary-up(int);
    callback move-dictionary-down(int);
    callback delete-dictionary(int);
    callback download-asr-model(string, string);
    callback cancel-asr-download();
    callback refresh-asr-models();
    callback dictionary-archive-picked(string);
    callback dictionary-op-completed();
    callback asr-download-finished(bool, string);

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 240px;
            background: #1e2225;
            VerticalLayout {
                padding-top: 20px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 3px;
                SidebarItem { label: "Anki Integration"; icon: @image-url("icons/anki.svg"); selected: root.active-category == 0; clicked => { root.active-category = 0; root.adding-entry = false; root.category-changed(0); } }
                SidebarItem { label: "Application"; icon: @image-url("icons/settings.svg"); selected: root.active-category == 1; clicked => { root.active-category = 1; root.adding-entry = false; root.category-changed(1); } }
                SidebarItem { label: "Audio Sources"; icon: @image-url("icons/volume-on.svg"); selected: root.active-category == 2; clicked => { root.active-category = 2; root.adding-entry = false; root.category-changed(2); } }
                SidebarItem { label: "Behavior"; icon: @image-url("icons/gear.svg"); selected: root.active-category == 3; clicked => { root.active-category = 3; root.adding-entry = false; root.category-changed(3); } }
                SidebarItem { label: "Dictionary"; icon: @image-url("icons/dictionary.svg"); selected: root.active-category == 4; clicked => { root.active-category = 4; root.adding-entry = false; root.category-changed(4); } }
                SidebarItem { label: "Interface"; icon: @image-url("icons/window.svg"); selected: root.active-category == 5; clicked => { root.active-category = 5; root.adding-entry = false; root.category-changed(5); } }
                SidebarItem { label: "Keybinds"; icon: @image-url("icons/keyboard.svg"); selected: root.active-category == 6; clicked => { root.active-category = 6; root.adding-entry = false; root.category-changed(6); } }
                if root.ocr-built : SidebarItem { label: "OCR"; icon: @image-url("icons/eye.svg"); selected: root.active-category == 7; clicked => { root.active-category = 7; root.adding-entry = false; root.category-changed(7); } }
                if root.asr-available : SidebarItem { label: "ASR"; icon: @image-url("icons/volume-on.svg"); selected: root.active-category == 8; clicked => { root.active-category = 8; root.adding-entry = false; root.category-changed(8); } }
                SidebarItem { label: "Search"; icon: @image-url("icons/search.svg"); selected: root.active-category == 9; clicked => { root.active-category = 9; root.adding-entry = false; root.category-changed(9); } }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
        Rectangle { width: 1px; background: #384046; }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 40px;
                background: #262c30;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if root.active-category == 0 : Text {
                            text: "Profile:";
                            color: #9ca6aa;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if root.active-category == 0 : ComboBox {
                            width: 150px;
                            model: root.anki-profile-list;
                            current-value: root.current-anki-profile;
                            selected(profile) => { root.setting-edited("anki/profile", profile); }
                        }
                        if root.active-category == 0 : Text {
                            text: "Show tag";
                            color: #dce0e2;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if root.active-category == 0 : VerticalLayout {
                            alignment: center;
                            SettingsSwitch {
                                checked: root.anki-show-tag;
                                toggled(value) => {
                                    root.setting-edited("anki/profile/show-tag", value ? "true" : "false");
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        if root.adding-entry : LineEdit {
                            width: 180px;
                            text <=> root.new-entry-name;
                            placeholder-text: "Profile name";
                        }
                        if root.adding-entry : Button {
                            text: "Add profile";
                            enabled: root.new-entry-name != "";
                            clicked => {
                                root.add-entry(root.active-category, root.new-entry-name);
                                root.new-entry-name = "";
                                root.adding-entry = false;
                            }
                        }
                        if root.active-category == 0 || root.active-category == 6 : ToolIcon {
                            icon: @image-url("icons/delete.svg");
                            tint: #ed6b72;
                            clicked => {
                                root.remove-entry(root.active-category, root.active-category == 0 ? root.current-anki-profile : root.current-keybind-profile);
                            }
                        }
                        if root.active-category == 0 || root.active-category == 2 || root.active-category == 6 : ToolIcon {
                            icon: @image-url("icons/add.svg");
                            clicked => {
                                if root.active-category == 2 { root.add-entry(2, ""); }
                                else { root.adding-entry = true; }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: #384046; }
            ScrollView {
                VerticalLayout {
                    width: parent.width;
                    padding-top: 16px;
                    padding-bottom: 24px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;
                    alignment: start;
                    if root.active-category == 7 && !root.ocr-available : Rectangle {
                        height: 38px;
                        background: #493a24;
                        border-radius: 6px;
                        Text {
                            x: 14px;
                            text: "OCR runtime unavailable; preferences remain editable.";
                            color: #ffe0a3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    if root.active-category == 8 && !root.asr-available : Rectangle {
                        height: 38px;
                        background: #493a24;
                        border-radius: 6px;
                        Text {
                            x: 14px;
                            text: "ASR runtime unavailable; preferences remain editable.";
                            color: #ffe0a3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    for group in root.settings-groups : VerticalLayout {
                        if group.category != 4 &&
                            (group.category != 0 || group.title != "Advanced" || root.showing-advanced) : SettingsSection {
                            group: group;
                            anki-decks: root.available-anki-decks;
                            anki-models: root.available-anki-models;
                            font-families: root.font-families;
                            keybind-conflict-count: root.keybind-conflict-count;
                            show-advanced: root.showing-advanced;
                            edited(key, value) => { root.setting-edited(key, value); }
                            font-edited(key, family, size, bold, italic) => {
                                root.font-edited(key, family, size, bold, italic);
                            }
                            font-size-typed(key, family, size, bold, italic) => {
                                root.font-size-typed(key, family, size, bold, italic);
                            }
                            open-color-picker(f) => {
                                root.color-picker-key = f.key;
                                root.color-picker-label = f.label;
                                root.color-picker-a = f.color-a;
                                root.color-picker-r = f.color-r;
                                root.color-picker-g = f.color-g;
                                root.color-picker-b = f.color-b;
                                root.color-picker-hex = f.value;
                                root.color-picker-open = true;
                            }
                            keybind-captured(key, text, ctrl, alt, shift, meta) => {
                                root.keybind-captured(key, text, ctrl, alt, shift, meta);
                            }
                            apply-anki-preset(preset) => { root.apply-anki-preset(preset); }
                            advanced-changed(value) => { root.showing-advanced = value; }
                            move-entry(id, direction) => { root.move-entry(root.active-category, id, direction); }
                            remove-entry(id) => { root.remove-entry(root.active-category, id); }
                            test-anki-connection => { root.test-anki-connection(); }
                            load-anki-fields(section) => { root.load-anki-fields(section); }
                        }
                    }
                    if root.active-category == 8 : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "ASR Models";
                                color: #dce0e2;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.asr-models-dir;
                                    color: #8a9499;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Button {
                                    text: "Refresh";
                                    clicked => { root.refresh-asr-models(); }
                                }
                            }
                        }
                        if root.asr-download-active : Rectangle {
                            background: #1b282b;
                            border-width: 1px;
                            border-color: #00867c;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: space-between;
                                    Text {
                                        text: root.asr-download-text;
                                        color: #dce0e2;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Button {
                                        text: "Cancel";
                                        clicked => { root.cancel-asr-download(); }
                                    }
                                }
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #2f383e;
                                    clip: true;
                                    Rectangle {
                                        x: root.asr-download-progress >= 0.0
                                            ? 0px
                                            : (parent.width * 0.72) * abs(sin(animation-tick() / 900ms * 180deg));
                                        width: root.asr-download-progress >= 0.0
                                            ? parent.width * max(0.02, min(1.0, root.asr-download-progress))
                                            : parent.width * 0.28;
                                        height: parent.height;
                                        border-radius: 4px;
                                        background: #00a896;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            background: #21262a;
                            border-width: 1px;
                            border-color: #384046;
                            border-radius: 8px;
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 0px;
                                for model[index] in root.asr-model-rows : VerticalLayout {
                                    spacing: 0px;
                                    if index > 0 : Rectangle { height: 1px; background: #2f363b; }
                                    HorizontalLayout {
                                        min-height: 44px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    text: (model.backend == "whisper" ? "Whisper: " : "ONNX: ") + model.name;
                                                    color: #dce0e2;
                                                    font-size: 13px;
                                                    font-weight: model.selected ? 700 : 500;
                                                }
                                                if model.selected : Text {
                                                    text: "(Active)";
                                                    color: #6ee7b7;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: model.path;
                                                color: #7a8387;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                        }
                                        Text {
                                            text: model.status-text;
                                            color: model.installed ? #6ee7b7 : #fbbf24;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        if !model.installed : VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: "Download";
                                                enabled: !root.asr-download-active;
                                                clicked => { root.download-asr-model(model.backend, model.name); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.active-category == 4 : VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            Text {
                                text: "Installed dictionaries";
                                color: #dce0e2;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Add ZIP…";
                                enabled: !root.dictionary-busy;
                                clicked => { root.add-dictionary-archive(); }
                            }
                        }
                        if root.dictionary-busy : Rectangle {
                            background: #1b282b;
                            border-width: 1px;
                            border-color: #00867c;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text {
                                    text: root.dictionary-progress-text != "" ? root.dictionary-progress-text : "Working on dictionary database…";
                                    color: #dce0e2;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #2f383e;
                                    clip: true;
                                    Rectangle {
                                        x: (parent.width * 0.72) * abs(sin(animation-tick() / 900ms * 180deg));
                                        width: parent.width * 0.28;
                                        height: parent.height;
                                        border-radius: 4px;
                                        background: #00a896;
                                    }
                                }
                            }
                        }
                        if root.installed-dictionaries.length == 0 : Text {
                            text: "No dictionaries installed.";
                            color: #8a9499;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                        for dictionary[index] in root.installed-dictionaries : Rectangle {
                            height: 48px;
                            background: #21262a;
                            border-width: 1px;
                            border-color: #384046;
                            border-radius: 6px;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 14px;
                                VerticalLayout {
                                    alignment: center;
                                    SettingsSwitch {
                                        checked: !dictionary.disabled;
                                        enabled: !root.dictionary-busy;
                                        toggled(val) => {
                                            root.dictionary-enabled-changed(dictionary.id, !val);
                                        }
                                    }
                                }
                                Text {
                                    text: dictionary.title + " [" + dictionary.id + "]";
                                    color: dictionary.disabled ? #7a8387 : #dce0e2;
                                    font-size: 13px;
                                    font-weight: 500;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;
                                        ToolIcon {
                                            icon: @image-url("icons/arrow-up.svg");
                                            enabled: !root.dictionary-busy && index > 0;
                                            clicked => { root.move-dictionary-up(dictionary.id); }
                                        }
                                        ToolIcon {
                                            icon: @image-url("icons/arrow-down.svg");
                                            enabled: !root.dictionary-busy && index < root.installed-dictionaries.length - 1;
                                            clicked => { root.move-dictionary-down(dictionary.id); }
                                        }
                                        ToolIcon {
                                            icon: @image-url("icons/delete.svg");
                                            tint: #ed6b72;
                                            enabled: !root.dictionary-busy;
                                            clicked => { root.delete-dictionary(dictionary.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: #384046; }
            Rectangle {
                height: 48px;
                background: #21262a;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    alignment: end;
                    Text {
                        text: root.settings-status;
                        color: #9ca6aa;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.active-category == 0 : Button { text: "Help"; clicked => { root.anki-help-requested(); } }
                    if root.active-category == 2 : Button { text: "Help"; clicked => { root.showing-audio-help = true; } }
                    Button { text: "Reset"; clicked => { root.reset-settings(root.active-category); } }
                    Button { text: "Defaults"; clicked => { root.defaults-settings(root.active-category); } }
                    Button { text: "Apply"; clicked => { root.apply-settings(root.active-category); } }
                }
            }
        }
    }

    if root.color-picker-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.color-picker-open = false; } }
        Rectangle {
            width: 420px;
            height: 400px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #21262a;
            border-width: 1px;
            border-color: #50606A;
            border-radius: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000DD;
            TouchArea { }
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: "Pick Color: " + root.color-picker-label;
                    color: white;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 64px;
                        height: 44px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #50606A;
                        background: #14181b;
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            border-radius: 5px;
                            background: Colors.rgba(
                                root.color-picker-r / 255.0,
                                root.color-picker-g / 255.0,
                                root.color-picker-b / 255.0,
                                root.color-picker-a / 255.0,
                            );
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text {
                            text: "RGBA (" + root.color-picker-r + ", " + root.color-picker-g + ", " + root.color-picker-b + ", " + root.color-picker-a + ")";
                            color: #dce0e2;
                            font-size: 13px;
                        }
                        Text {
                            text: "Previous: " + root.color-picker-hex;
                            color: #8a9499;
                            font-size: 11px;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 58px; text: "Red"; color: #f87171; font-size: 12px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 255;
                        value: root.color-picker-r;
                        changed(val) => { root.color-picker-r = Math.round(val); }
                    }
                    Text { width: 32px; text: root.color-picker-r + ""; color: #dce0e2; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 58px; text: "Green"; color: #4ade80; font-size: 12px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 255;
                        value: root.color-picker-g;
                        changed(val) => { root.color-picker-g = Math.round(val); }
                    }
                    Text { width: 32px; text: root.color-picker-g + ""; color: #dce0e2; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 58px; text: "Blue"; color: #60a5fa; font-size: 12px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 255;
                        value: root.color-picker-b;
                        changed(val) => { root.color-picker-b = Math.round(val); }
                    }
                    Text { width: 32px; text: root.color-picker-b + ""; color: #dce0e2; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 58px; text: "Alpha"; color: #cbd5e1; font-size: 12px; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 255;
                        value: root.color-picker-a;
                        changed(val) => { root.color-picker-a = Math.round(val); }
                    }
                    Text { width: 32px; text: root.color-picker-a + ""; color: #dce0e2; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    for swatch in [
                        { a: 255, r: 255, g: 255, b: 255, c: #FFFFFFFF },
                        { a: 255, r: 0,   g: 0,   b: 0,   c: #000000FF },
                        { a: 0,   r: 0,   g: 0,   b: 0,   c: #00000000 },
                        { a: 160, r: 0,   g: 0,   b: 0,   c: #000000A0 },
                        { a: 255, r: 255, g: 224, b: 102, c: #FFE066FF },
                        { a: 255, r: 56,  g: 189, b: 248, c: #38BDF8FF },
                        { a: 255, r: 26,  g: 59,  b: 92,  c: #1A3B5CFF },
                        { a: 255, r: 41,  g: 90,  b: 138, c: #295A8AFF },
                        { a: 255, r: 237, g: 107, b: 114, c: #ED6B72FF },
                    ] : Rectangle {
                        width: 28px;
                        height: 24px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #50606A;
                        background: swatch.c;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.color-picker-a = swatch.a;
                                root.color-picker-r = swatch.r;
                                root.color-picker-g = swatch.g;
                                root.color-picker-b = swatch.b;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.color-picker-open = false; } }
                    Button {
                        text: "Apply Color";
                        clicked => {
                            root.color-edited(
                                root.color-picker-key,
                                root.color-picker-a,
                                root.color-picker-r,
                                root.color-picker-g,
                                root.color-picker-b,
                            );
                            root.color-picker-open = false;
                        }
                    }
                }
            }
        }
    }

    if root.showing-audio-help : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.showing-audio-help = false; } }
        Rectangle {
            width: min(560px, parent.width - 48px);
            height: 270px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #21262a;
            border-width: 1px;
            border-color: #50606A;
            border-radius: 8px;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text {
                    text: "Audio Sources Help";
                    color: white;
                    font-size: 20px;
                    font-weight: 700;
                }
                Text {
                    text: "Source Name: The name of the audio source as it will appear in Memento.\n\nURL: The URL of the audio source. Supports inserting {expression} and {reading} markers into the URL.\n\nMD5 Skip Hash: Audio that matches this MD5 hash will be ignored.";
                    color: #DCE3E7;
                    font-size: 14px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    Button { text: "OK"; clicked => { root.showing-audio-help = false; } }
                }
            }
        }
    }

    // Modal result popup for the AnkiConnect "Connect" button.
    if root.connection-popup-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { clicked => { root.connection-popup-open = false; } }
        Rectangle {
            width: 380px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #21262a;
            border-radius: 10px;
            border-width: 2px;
            border-color: root.connection-popup-ok ? #2F8F5B : #ED6B72;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000DD;
            TouchArea { }
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.connection-popup-ok ? "✔ Connected to Anki" : "✖ Connection failed";
                    color: root.connection-popup-ok ? #6EE7B7 : #ED6B72;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.connection-popup-text;
                    color: #dce0e2;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: center;
                    Button { text: "OK"; clicked => { root.connection-popup-open = false; } }
                }
            }
        }
    }
}
