import { SubomiPalette } from "../palette.slint";
import { ActionButton, FilterChip, IconButton } from "../components/buttons.slint";
import { SubomiCheckBox, SubomiSwitch, SectionHeader } from "../components/controls.slint";
import { AnkiAutocompleteItem, AnkiExcludedDictRow, SettingsField, SettingsGroup } from "types.slint";
import { FieldRow } from "controls.slint";

export component SettingsSection inherits VerticalLayout {
    in property <SettingsGroup> group;
    in property <[string]> anki-decks;
    in property <[string]> anki-models;
    in property <[string]> font-families;
    in property <[AnkiExcludedDictRow]> anki-excluded-dicts: [];
    in property <[AnkiAutocompleteItem]> anki-autocomplete-items: [];
    in property <bool> anki-autocomplete-open: false;
    in property <string> anki-autocomplete-field-key: "";
    in-out property <int> anki-autocomplete-selected: 0;
    in property <int> keybind-conflict-count: 0;
    in property <bool> testing-anki: false;
    in property <bool> can-move-up: true;
    in property <bool> can-move-down: true;
    in-out property <bool> show-advanced: false;
    callback edited(string, string);
    callback color-hex-committed(string, string);
    callback font-edited(string, string, string, bool, bool);
    callback font-size-typed(string, string, string, bool, bool);
    callback open-color-picker(SettingsField);
    callback keybind-captured(string, string, bool, bool, bool, bool);
    callback browse-folder-setting(string);
    callback anki-excluded-dict-toggled(string, bool);
    callback anki-field-autocomplete-query(string, string, int);
    callback anki-field-autocomplete-accepted(string, string);
    callback anki-field-autocomplete-dismissed();
    callback apply-anki-preset(string);
    callback advanced-changed(bool);
    callback move-entry(string, int);
    callback remove-entry(string, string);
    callback test-anki-connection();
    callback load-anki-fields(string);

    spacing: 8px;
    horizontal-stretch: 1;

    SectionHeader {
        title: root.group.title;

        if root.group.entry_id != "" : HorizontalLayout {
            spacing: 6px;
            alignment: end;

            IconButton {
                icon: @image-url("../icons/arrow-up.svg");
                enabled: root.can-move-up;
                tooltip: "Move source up";
                clicked => { root.move-entry(root.group.entry_id, -1); }
            }
            IconButton {
                icon: @image-url("../icons/arrow-down.svg");
                enabled: root.can-move-down;
                tooltip: "Move source down";
                clicked => { root.move-entry(root.group.entry_id, 1); }
            }
            IconButton {
                icon: @image-url("../icons/delete.svg");
                danger: true;
                tooltip: "Delete audio source";
                tooltip-align-right: true;
                clicked => { root.remove-entry(root.group.entry_id, root.group.title); }
            }
        }
    }

    if root.group.category == 6 && root.group.title == "Keyboard Shortcuts" && root.keybind-conflict-count > 0 : Rectangle {
        height: 38px;
        background: SubomiPalette.warning-bg;
        border-width: 1px;
        border-color: SubomiPalette.warning-border;
        border-radius: 8px;
        Text {
            x: 14px;
            width: parent.width - 28px;
            height: parent.height;
            text: "⚠ Duplicate shortcut conflict detected in this profile. Click any shortcut to reassign.";
            color: SubomiPalette.warning-text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    settings-card := Rectangle {
        background: SubomiPalette.card-bg;
        border-width: 1px;
        border-color: SubomiPalette.card-border;
        border-radius: 10px;
        height: card-col.preferred-height;

        card-col := VerticalLayout {
            width: parent.width;
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 0px;

            for field[index] in root.group.fields : VerticalLayout {
                spacing: 0px;
                Rectangle {
                    visible: index > 0 && field.visible;
                    height: (index > 0 && field.visible) ? 1px : 0px;
                    background: SubomiPalette.border;
                }
                field-row := FieldRow {
                    field: field;
                    group-category: root.group.category;
                    group-title: root.group.title;
                    anki-decks: root.anki-decks;
                    anki-models: root.anki-models;
                    font-families: root.font-families;
                    anki-autocomplete-items: root.anki-autocomplete-items;
                    anki-autocomplete-open: root.anki-autocomplete-open;
                    anki-autocomplete-field-key: root.anki-autocomplete-field-key;
                    anki-autocomplete-selected <=> root.anki-autocomplete-selected;
                    edited(key, value) => { root.edited(key, value); }
                    color-hex-committed(key, value) => { root.color-hex-committed(key, value); }
                    font-edited(key, family, size, bold, italic) => {
                        root.font-edited(key, family, size, bold, italic);
                    }
                    font-size-typed(key, family, size, bold, italic) => {
                        root.font-size-typed(key, family, size, bold, italic);
                    }
                    open-color-picker(f) => { root.open-color-picker(f); }
                    keybind-captured(key, text, ctrl, alt, shift, meta) => {
                        root.keybind-captured(key, text, ctrl, alt, shift, meta);
                    }
                    browse-folder-setting(key) => { root.browse-folder-setting(key); }
                    anki-field-autocomplete-query(key, text, pos) => {
                        root.anki-field-autocomplete-query(key, text, pos);
                    }
                    anki-field-autocomplete-accepted(key, insert-text) => {
                        root.anki-field-autocomplete-accepted(key, insert-text);
                    }
                    anki-field-autocomplete-dismissed => { root.anki-field-autocomplete-dismissed(); }
                }
            }

            // Excluded Glossary Dictionaries (`ex-glos`) checklist inside Anki Advanced section
            if root.group.category == 0 && root.group.title == "Advanced" && root.anki-excluded-dicts.length > 0 : VerticalLayout {
                spacing: 0px;
                Rectangle { height: 1px; background: SubomiPalette.border; }
                VerticalLayout {
                    padding-top: 11px;
                    padding-bottom: 11px;
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Excluded Glossary Dictionaries";
                            font-size: 13px;
                            font-weight: 600;
                            color: SubomiPalette.text;
                        }
                        Text {
                            text: "Checked dictionaries are excluded from {glossary} exports for this Anki profile";
                            font-size: 11px;
                            color: SubomiPalette.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        border-radius: 7px;
                        background: SubomiPalette.card-inset;
                        border-width: 1px;
                        border-color: SubomiPalette.border;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            for item in root.anki-excluded-dicts : HorizontalLayout {
                                spacing: 8px;
                                alignment: space-between;

                                SubomiCheckBox {
                                    label: item.name;
                                    checked: item.excluded;
                                    toggled(val) => { root.anki-excluded-dict-toggled(item.name, val); }
                                }

                                VerticalLayout {
                                    visible: !item.installed;
                                    width: !item.installed ? self.preferred-width : 0px;
                                    alignment: center;
                                    Rectangle {
                                        height: 18px;
                                        width: uninst-lbl.preferred-width + 10px;
                                        border-radius: 4px;
                                        background: SubomiPalette.warning-bg;
                                        border-width: 1px;
                                        border-color: SubomiPalette.warning-border;
                                        uninst-lbl := Text {
                                            text: "Not installed";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: SubomiPalette.warning-text;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // One-click presets (stacked header + wrapping FlexboxLayout chips — never overflows at 820px)
            if root.group.category == 0 && root.group.title == "Term Notes" : VerticalLayout {
                spacing: 0px;
                Rectangle { height: 1px; background: SubomiPalette.border; }
                VerticalLayout {
                    padding-top: 11px;
                    padding-bottom: 11px;
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "One-click presets";
                            font-size: 13px;
                            font-weight: 600;
                            color: SubomiPalette.text;
                        }
                        Text {
                            text: "Pre-fill field markers for popular Anki note types";
                            font-size: 11px;
                            color: SubomiPalette.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        for preset in ["Lapis", "Kiku", "Senren", "Animecards", "JPMN"] : FilterChip {
                            label: preset;
                            clicked => { root.apply-anki-preset(preset); }
                        }
                    }
                }
            }

            if root.group.category == 0 && (root.group.title == "Term Notes" || root.group.title == "Kanji Notes" || root.group.title == "AnkiConnect") : VerticalLayout {
                property <bool> is-anki-connect: root.group.title == "AnkiConnect";
                spacing: 0px;
                Rectangle { height: 1px; background: SubomiPalette.border; }
                HorizontalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 12px;
                    alignment: space-between;
                    Text {
                        text: is-anki-connect
                            ? "Verify AnkiConnect endpoint and load decks & note models"
                            : (root.group.fields.length <= 2
                                ? "No model fields loaded yet — connect to Anki or load fields to map them."
                                : "Refresh fields from the selected Anki note model");
                        color: SubomiPalette.text-muted;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: 12px;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        ActionButton {
                            text: is-anki-connect
                                ? (root.testing-anki ? "Testing…" : "Test Connection")
                                : "Load Model Fields";
                            loading: is-anki-connect && root.testing-anki;
                            enabled: !is-anki-connect || !root.testing-anki;
                            clicked => {
                                if is-anki-connect {
                                    root.test-anki-connection();
                                } else {
                                    root.load-anki-fields(root.group.title == "Term Notes" ? "term" : "kanji");
                                }
                            }
                        }
                    }
                }
            }

            if root.group.category == 0 && root.group.title == "General" : VerticalLayout {
                spacing: 0px;
                Rectangle { height: 1px; background: SubomiPalette.border; }
                HorizontalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 12px;
                    alignment: space-between;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 1px;
                        Text {
                            text: "Show advanced settings";
                            font-size: 13px;
                            font-weight: 500;
                            color: SubomiPalette.text;
                        }
                        Text {
                            text: "Reveal duplicate-check, audio normalization, and media quality options";
                            font-size: 11px;
                            color: SubomiPalette.text-muted;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        SubomiSwitch {
                            checked: root.show-advanced;
                            toggled(value) => {
                                root.show-advanced = value;
                                root.advanced-changed(value);
                            }
                        }
                    }
                }
            }
        }
    }
}
