import { TextEdit } from "std-widgets.slint";
import { SubomiPalette } from "../palette.slint";
import { ActionButton, TabPill } from "../components/buttons.slint";
import { SectionHeader } from "../components/controls.slint";

export component CustomPopupCssPanel inherits VerticalLayout {
    in-out property <int> custom-css-tab: 0;
    in-out property <string> custom-popup-css: "";
    in property <string> custom-popup-css-path: "";
    in-out property <string> custom-popup-outer-css: "";
    in property <string> custom-popup-outer-css-path: "";
    callback save-custom-popup-css(string, string);
    callback open-custom-popup-css(int);
    callback insert-custom-popup-css-template(int);

    private property <string> active-path: root.custom-css-tab == 0
        ? root.custom-popup-css-path
        : root.custom-popup-outer-css-path;

    spacing: 8px;

    SectionHeader {
        title: "Custom Popup CSS";

        if root.active-path != "" : Rectangle {
            height: 22px;
            width: min(css-path-lbl.preferred-width + 16px, 340px);
            border-radius: 5px;
            background: SubomiPalette.surface-bg;
            border-width: 1px;
            border-color: SubomiPalette.border;
            css-path-lbl := Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.active-path;
                color: SubomiPalette.text-muted;
                font-family: "monospace";
                font-size: 10.5px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    Rectangle {
        background: SubomiPalette.card-bg;
        border-width: 1px;
        border-color: SubomiPalette.card-border;
        border-radius: 10px;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                TabPill {
                    label: "Popup CSS";
                    compact: true;
                    active: root.custom-css-tab == 0;
                    clicked => { root.custom-css-tab = 0; }
                }
                TabPill {
                    label: "Popup Outer CSS";
                    compact: true;
                    active: root.custom-css-tab == 1;
                    clicked => { root.custom-css-tab = 1; }
                }
            }

            Text {
                text: root.custom-css-tab == 0
                    ? "Inner popup styling (popup.css): fonts, text/pitch headword colors, 2-column card grid (--definition-columns: 2), per-dictionary badge/tint colors & hover-to-reveal ([data-dictionary^=\"...\"]), frequency colors ([data-frequency^=\"...\"]), and glossary rules. External edits hot-reload automatically."
                    : "Outer popup frame styling (popup-outer.css): translucent background (rgba), border, radius, drop shadow, padding, and popup width/height (--popup-width / width). External edits hot-reload automatically.";
                color: SubomiPalette.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
            }

            TextEdit {
                height: 240px;
                text: root.custom-css-tab == 0 ? root.custom-popup-css : root.custom-popup-outer-css;
                font-family: "monospace";
                font-size: 12px;
                wrap: word-wrap;
                placeholder-text: root.custom-css-tab == 0
                    ? "/* Add inner Popup CSS or click Insert Starter Template… */"
                    : "/* Add Popup Outer CSS (background, border, radius, shadow, width) or click Insert Starter Template… */";
                edited(value) => {
                    if root.custom-css-tab == 0 {
                        root.custom-popup-css = value;
                    } else {
                        root.custom-popup-outer-css = value;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                Text {
                    text: "Also saved automatically when clicking Apply";
                    color: SubomiPalette.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        ActionButton {
                            text: "Insert Template";
                            compact: true;
                            clicked => { root.insert-custom-popup-css-template(root.custom-css-tab); }
                        }
                        ActionButton {
                            text: "Open File";
                            compact: true;
                            clicked => { root.open-custom-popup-css(root.custom-css-tab); }
                        }
                        ActionButton {
                            text: "Save & Reload CSS";
                            primary: true;
                            compact: true;
                            clicked => { root.save-custom-popup-css(root.custom-popup-css, root.custom-popup-outer-css); }
                        }
                    }
                }
            }
        }
    }
}
