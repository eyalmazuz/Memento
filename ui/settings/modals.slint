import { LineEdit } from "std-widgets.slint";
import { SubomiPalette } from "../palette.slint";
import { SubomiCheckBox, SubomiSlider } from "../components/controls.slint";
import { ModalDialog } from "../components/modal.slint";

component CheckerboardBackdrop inherits Rectangle {
    background: SubomiPalette.checker-dark;
    clip: true;

    for row in [0, 1, 2, 3, 4, 5] : Rectangle {
        x: 0px;
        y: row * 8px;
        width: parent.width;
        height: 8px;
        background: transparent;
        for col in [0, 1, 2, 3, 4, 5, 6, 7, 8] : Rectangle {
            x: col * 8px;
            y: 0px;
            width: 8px;
            height: 8px;
            background: mod(row + col, 2) == 0 ? SubomiPalette.checker-light : transparent;
        }
    }
}

component ColorChannelRow inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    in property <color> label-color: root.accent;
    in property <int> channel-value;
    callback channel-changed(int);

    height: max(24px, row-layout.preferred-height);
    background: transparent;

    row-layout := HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 10px;
        Text { width: 48px; text: root.label; color: root.label-color; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        SubomiSlider {
            horizontal-stretch: 1;
            minimum: 0;
            maximum: 255;
            accent: root.accent;
            value: root.channel-value;
            changed(val) => { root.channel-changed(Math.round(val)); }
        }
        Text { width: 32px; text: root.channel-value + ""; color: SubomiPalette.text; font-family: "monospace"; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

export component ColorPickerModal inherits ModalDialog {
    in property <string> color-key;
    in property <string> color-label;
    in-out property <int> color-a: 255;
    in-out property <int> color-r: 255;
    in-out property <int> color-g: 255;
    in-out property <int> color-b: 255;
    in-out property <string> color-hex: "#FFFFFFFF";
    callback apply-color(string, int, int, int, int);
    callback hex-input-edited(string);

    pure function hex-digit(n: int) -> string {
        n == 0 ? "0" : n == 1 ? "1" : n == 2 ? "2" : n == 3 ? "3"
        : n == 4 ? "4" : n == 5 ? "5" : n == 6 ? "6" : n == 7 ? "7"
        : n == 8 ? "8" : n == 9 ? "9" : n == 10 ? "A" : n == 11 ? "B"
        : n == 12 ? "C" : n == 13 ? "D" : n == 14 ? "E" : "F"
    }

    pure function hex-byte(v: int) -> string {
        let c = clamp(v, 0, 255);
        hex-digit(floor(c / 16)) + hex-digit(mod(c, 16))
    }

    pure function format-argb(a: int, r: int, g: int, b: int) -> string {
        "#" + hex-byte(a) + hex-byte(r) + hex-byte(g) + hex-byte(b)
    }

    title: "Pick Color · " + root.color-label;
    dialog-width: 452px;
    cancel-text: "Cancel";
    primary-text: "Apply Color";
    primary-clicked => {
        root.apply-color(
            root.color-key,
            root.color-a,
            root.color-r,
            root.color-g,
            root.color-b,
        );
    }

    // Live Preview + Editable Hex (#AARRGGBB)
    HorizontalLayout {
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 68px;
                height: 46px;
                border-radius: 8px;
                border-width: 1px;
                border-color: SubomiPalette.border-light;
                clip: true;

                CheckerboardBackdrop {
                    width: parent.width;
                    height: parent.height;
                }

                Rectangle {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    border-radius: 7px;
                    background: Colors.rgba(
                        root.color-r / 255.0,
                        root.color-g / 255.0,
                        root.color-b / 255.0,
                        root.color-a / 255.0,
                    );
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Hex";
                    color: SubomiPalette.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                LineEdit {
                    width: 132px;
                    text <=> root.color-hex;
                    placeholder-text: "#AARRGGBB";
                    edited(val) => { root.hex-input-edited(val); }
                    accepted(val) => { root.hex-input-edited(val); }
                }
            }

            Text {
                text: "RGBA (" + root.color-r + ", " + root.color-g + ", " + root.color-b + ", " + root.color-a + ")";
                color: SubomiPalette.text-muted;
                font-family: "monospace";
                font-size: 11.5px;
            }
        }
    }

    // Channel Sliders
    VerticalLayout {
        spacing: 8px;

        ColorChannelRow {
            label: "Red";
            accent: #F87171;
            channel-value: root.color-r;
            channel-changed(val) => {
                root.color-r = val;
                root.color-hex = root.format-argb(root.color-a, root.color-r, root.color-g, root.color-b);
            }
        }

        ColorChannelRow {
            label: "Green";
            accent: #4ADE80;
            channel-value: root.color-g;
            channel-changed(val) => {
                root.color-g = val;
                root.color-hex = root.format-argb(root.color-a, root.color-r, root.color-g, root.color-b);
            }
        }

        ColorChannelRow {
            label: "Blue";
            accent: #60A5FA;
            channel-value: root.color-b;
            channel-changed(val) => {
                root.color-b = val;
                root.color-hex = root.format-argb(root.color-a, root.color-r, root.color-g, root.color-b);
            }
        }

        ColorChannelRow {
            label: "Alpha";
            accent: SubomiPalette.cyan-accent;
            label-color: SubomiPalette.text-secondary;
            channel-value: root.color-a;
            channel-changed(val) => {
                root.color-a = val;
                root.color-hex = root.format-argb(root.color-a, root.color-r, root.color-g, root.color-b);
            }
        }
    }

    // Preset Swatches with checkerboard backdrop, hover ring, and selected ring
    VerticalLayout {
        spacing: 6px;
        Text {
            text: "Presets";
            color: SubomiPalette.text-muted;
            font-size: 11px;
            font-weight: 600;
        }
        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            for swatch in [
                { a: 255, r: 255, g: 255, b: 255, c: #FFFFFFFF },
                { a: 255, r: 0,   g: 0,   b: 0,   c: #000000FF },
                { a: 0,   r: 0,   g: 0,   b: 0,   c: #00000000 },
                { a: 160, r: 0,   g: 0,   b: 0,   c: #000000A0 },
                { a: 255, r: 255, g: 224, b: 102, c: #FFE066FF },
                { a: 255, r: 56,  g: 189, b: 248, c: #38BDF8FF },
                { a: 255, r: 26,  g: 59,  b: 92,  c: #1A3B5CFF },
                { a: 255, r: 41,  g: 90,  b: 138, c: #295A8AFF },
                { a: 255, r: 237, g: 107, b: 114, c: #ED6B72FF },
            ] : Rectangle {
                property <bool> is-selected: root.color-a == swatch.a
                    && root.color-r == swatch.r
                    && root.color-g == swatch.g
                    && root.color-b == swatch.b;

                width: 34px;
                height: 26px;
                border-radius: 6px;
                border-width: is-selected ? 2px : 1px;
                border-color: is-selected
                    ? SubomiPalette.cyan-accent
                    : (sw-touch.has-hover ? SubomiPalette.cyan-hover : SubomiPalette.border-light);
                background: transparent;
                clip: true;

                CheckerboardBackdrop {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                }

                Rectangle {
                    x: is-selected ? 2px : 1px;
                    y: is-selected ? 2px : 1px;
                    width: parent.width - (is-selected ? 4px : 2px);
                    height: parent.height - (is-selected ? 4px : 2px);
                    border-radius: 4px;
                    background: swatch.c;
                }

                sw-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.color-a = swatch.a;
                        root.color-r = swatch.r;
                        root.color-g = swatch.g;
                        root.color-b = swatch.b;
                        root.color-hex = root.format-argb(swatch.a, swatch.r, swatch.g, swatch.b);
                    }
                }
            }
        }
    }
}

export component ProfileModal inherits ModalDialog {
    in property <bool> is-rename: false;
    in property <string> kind-label: "Anki";
    in-out property <string> profile-name: "";
    in-out property <bool> copy-current-profile: true;
    in property <string> profile-name-error: "";
    callback name-changed(string);
    callback submitted(string, bool);

    public function focus-input() {
        name-edit.focus();
        name-edit.select-all();
    }

    private property <bool> can-submit: root.profile-name != "" && root.profile-name-error == "";

    title: root.is-rename
        ? ("Rename " + root.kind-label + " Profile")
        : ("Add " + root.kind-label + " Profile");
    dialog-width: 420px;
    cancel-text: "Cancel";
    primary-text: root.is-rename ? "Rename" : "Add Profile";
    primary-enabled: root.can-submit;
    primary-clicked => {
        if root.can-submit {
            root.submitted(root.profile-name, root.copy-current-profile);
        }
    }

    VerticalLayout {
        spacing: 0px;

        Text {
            text: root.is-rename
                ? "Enter a new name for the active profile:"
                : "Enter a name for the new profile:";
            color: SubomiPalette.text-secondary;
            font-size: 12.5px;
            wrap: word-wrap;
        }

        Rectangle { height: 10px; background: transparent; }

        name-edit := LineEdit {
            text <=> root.profile-name;
            placeholder-text: "Profile name…";
            init => {
                self.focus();
                self.select-all();
            }
            edited(val) => { root.name-changed(val); }
            accepted(val) => {
                if root.can-submit {
                    root.submitted(val, root.copy-current-profile);
                }
            }
        }

        Rectangle {
            visible: root.profile-name-error != "";
            height: root.profile-name-error != "" ? (err-box.height + 10px) : 0px;
            background: transparent;

            err-box := Rectangle {
                y: 10px;
                width: parent.width;
                height: err-lbl.preferred-height + 12px;
                border-radius: 6px;
                background: SubomiPalette.danger-bg;
                border-width: 1px;
                border-color: SubomiPalette.danger;
                err-lbl := Text {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    text: "⚠ " + root.profile-name-error;
                    color: SubomiPalette.danger-text;
                    font-size: 12px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            visible: !root.is-rename;
            height: !root.is-rename ? (copy-chk.preferred-height + 10px) : 0px;
            background: transparent;

            copy-chk := SubomiCheckBox {
                y: 10px;
                label: "Copy current profile";
                checked <=> root.copy-current-profile;
            }
        }
    }
}
