import { SubomiPalette } from "../palette.slint";
import { ActionButton, IconButton } from "../components/buttons.slint";
import { SubomiSwitch, SectionHeader } from "../components/controls.slint";
import { InstalledDictionaryRow } from "types.slint";

export component DictionariesPanel inherits VerticalLayout {
    in property <[InstalledDictionaryRow]> installed-dictionaries;
    in property <bool> dictionary-busy: false;
    in property <string> dictionary-progress-text: "";
    in property <bool> drop-hover-active: false;
    callback add-dictionary-archive();
    callback dictionary-enabled-changed(int, bool);
    callback move-dictionary-up(int);
    callback move-dictionary-down(int);
    callback request-delete-dictionary(int, string);

    spacing: 12px;

    SectionHeader {
        title: "Installed Dictionaries (" + root.installed-dictionaries.length + ")";

        // Non-shifting inline busy pill inside the section header (eliminates 72px banner jump)
        if root.dictionary-busy : Rectangle {
            height: 28px;
            width: min(busy-row.preferred-width, 260px);
            border-radius: 7px;
            background: SubomiPalette.teal-muted;
            border-width: 1px;
            border-color: SubomiPalette.teal-border;
            clip: true;

            busy-row := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 6px;
                        border-radius: 3px;
                        background: SubomiPalette.border;
                        clip: true;
                        Rectangle {
                            x: (parent.width - self.width) * abs(sin(animation-tick() / 800ms * 180deg));
                            width: 8px;
                            height: parent.height;
                            border-radius: 3px;
                            background: SubomiPalette.teal-border;
                        }
                    }
                }

                Text {
                    text: root.dictionary-progress-text != ""
                        ? root.dictionary-progress-text
                        : "Updating…";
                    color: SubomiPalette.teal-text;
                    font-size: 11.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        ActionButton {
            text: "+ Import ZIP…";
            primary: true;
            compact: true;
            enabled: !root.dictionary-busy;
            clicked => { root.add-dictionary-archive(); }
        }
    }

    if root.drop-hover-active : Rectangle {
        height: 48px;
        border-radius: 10px;
        background: SubomiPalette.accent-subtle;
        border-width: 2px;
        border-color: SubomiPalette.cyan-accent;
        Text {
            text: "Drop Yomitan .zip dictionary archive(s) here to import";
            color: SubomiPalette.cyan-text;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.installed-dictionaries.length == 0 : Rectangle {
        height: 92px;
        border-radius: 10px;
        background: SubomiPalette.card-bg;
        border-width: root.drop-hover-active ? 2px : 1px;
        border-color: root.drop-hover-active ? SubomiPalette.cyan-accent : SubomiPalette.card-border;
        clip: true;

        if root.dictionary-busy : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 2px;
            background: SubomiPalette.border;
            Rectangle {
                x: (parent.width * 0.72) * abs(sin(animation-tick() / 900ms * 180deg));
                width: parent.width * 0.28;
                height: parent.height;
                background: SubomiPalette.teal-border;
            }
        }

        Text {
            text: "No dictionaries installed yet. Click \"+ Import ZIP…\" to add Yomitan dictionaries.";
            color: SubomiPalette.text-muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.installed-dictionaries.length > 0 : Rectangle {
        background: SubomiPalette.card-bg;
        border-width: 1px;
        border-color: SubomiPalette.card-border;
        border-radius: 10px;
        clip: true;

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 0px;

            for dictionary[index] in root.installed-dictionaries : VerticalLayout {
                spacing: 0px;
                Rectangle {
                    visible: index > 0;
                    height: index > 0 ? 1px : 0px;
                    background: SubomiPalette.border;
                }
                HorizontalLayout {
                    height: 48px;
                    spacing: 14px;

                    VerticalLayout {
                        alignment: center;
                        SubomiSwitch {
                            checked: !dictionary.disabled;
                            enabled: !root.dictionary-busy;
                            toggled(val) => {
                                root.dictionary-enabled-changed(dictionary.id, val);
                            }
                        }
                    }

                    Text {
                        text: dictionary.title;
                        color: dictionary.disabled ? SubomiPalette.text-muted : SubomiPalette.text;
                        font-size: 13px;
                        font-weight: 500;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 20px;
                            width: id-lbl.preferred-width + 14px;
                            border-radius: 5px;
                            background: SubomiPalette.surface-bg;
                            border-width: 1px;
                            border-color: SubomiPalette.border;
                            id-lbl := Text {
                                text: "ID " + dictionary.id;
                                color: SubomiPalette.text-muted;
                                font-family: "monospace";
                                font-size: 10.5px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: end;
                            IconButton {
                                icon: @image-url("../icons/arrow-up.svg");
                                enabled: !root.dictionary-busy && index > 0;
                                tooltip: "Move up";
                                clicked => { root.move-dictionary-up(dictionary.id); }
                            }
                            IconButton {
                                icon: @image-url("../icons/arrow-down.svg");
                                enabled: !root.dictionary-busy && index < root.installed-dictionaries.length - 1;
                                tooltip: "Move down";
                                clicked => { root.move-dictionary-down(dictionary.id); }
                            }
                            IconButton {
                                icon: @image-url("../icons/delete.svg");
                                danger: true;
                                enabled: !root.dictionary-busy;
                                tooltip: "Delete dictionary";
                                tooltip-align-right: true;
                                clicked => { root.request-delete-dictionary(dictionary.id, dictionary.title); }
                            }
                        }
                    }
                }
            }
        }

        // Non-shifting 2px progress accent flush on top edge of card while busy
        if root.dictionary-busy : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 2px;
            background: SubomiPalette.border;
            Rectangle {
                x: (parent.width * 0.72) * abs(sin(animation-tick() / 900ms * 180deg));
                width: parent.width * 0.28;
                height: parent.height;
                background: SubomiPalette.teal-border;
            }
        }
    }
}
