import { SubomiPalette } from "../palette.slint";
import { ActionButton } from "../components/buttons.slint";
import { SectionHeader } from "../components/controls.slint";
import { AsrModelStatusRow } from "types.slint";

export component AsrModelsPanel inherits VerticalLayout {
    in property <[AsrModelStatusRow]> asr-model-rows;
    in property <string> asr-models-dir: "";
    in property <bool> asr-download-active: false;
    in property <float> asr-download-progress: 0.0;
    in property <string> asr-download-text: "";
    callback download-asr-model(string, string);
    callback cancel-asr-download();
    callback refresh-asr-models();

    spacing: 8px;

    SectionHeader {
        title: "Local ASR Models";

        if root.asr-models-dir != "" : Rectangle {
            height: 24px;
            width: min(dir-lbl.preferred-width + 14px, 240px);
            border-radius: 5px;
            background: SubomiPalette.surface-bg;
            border-width: 1px;
            border-color: SubomiPalette.border;
            dir-lbl := Text {
                x: 7px;
                width: parent.width - 14px;
                height: parent.height;
                text: root.asr-models-dir;
                color: SubomiPalette.text-muted;
                font-family: "monospace";
                font-size: 10.5px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        ActionButton {
            text: "Refresh";
            compact: true;
            clicked => { root.refresh-asr-models(); }
        }
    }

    if root.asr-download-active : Rectangle {
        background: SubomiPalette.teal-muted;
        border-width: 1px;
        border-color: SubomiPalette.teal-border;
        border-radius: 8px;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 10px;
                alignment: space-between;
                Text {
                    text: root.asr-download-text;
                    color: SubomiPalette.text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: "Cancel";
                        compact: true;
                        clicked => { root.cancel-asr-download(); }
                    }
                }
            }

            Rectangle {
                height: 7px;
                border-radius: 4px;
                background: SubomiPalette.border;
                clip: true;
                Rectangle {
                    x: root.asr-download-progress >= 0.0
                        ? 0px
                        : (parent.width * 0.72) * abs(sin(animation-tick() / 900ms * 180deg));
                    width: root.asr-download-progress >= 0.0
                        ? parent.width * max(0.02, min(1.0, root.asr-download-progress))
                        : parent.width * 0.28;
                    height: parent.height;
                    border-radius: 4px;
                    background: SubomiPalette.teal-border;
                }
            }
        }
    }

    Rectangle {
        background: SubomiPalette.card-bg;
        border-width: 1px;
        border-color: SubomiPalette.card-border;
        border-radius: 10px;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 0px;

            for model[index] in root.asr-model-rows : VerticalLayout {
                spacing: 0px;
                if index > 0 : Rectangle { height: 1px; background: SubomiPalette.border; }
                HorizontalLayout {
                    min-height: 48px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: (model.backend == "whisper"
                                    ? "Whisper · "
                                    : (model.backend == "whisper-vad"
                                        ? "Whisper VAD · "
                                        : "ONNX · ")) + model.name;
                                color: SubomiPalette.text;
                                font-size: 13px;
                                font-weight: model.selected ? 700 : 500;
                                vertical-alignment: center;
                            }
                            if model.selected : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 18px;
                                    width: act-lbl.preferred-width + 12px;
                                    border-radius: 9px;
                                    background: SubomiPalette.success-bg;
                                    border-width: 1px;
                                    border-color: SubomiPalette.success;
                                    act-lbl := Text {
                                        text: "Active";
                                        color: SubomiPalette.success-text;
                                        font-size: 10px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            text: model.path;
                            color: SubomiPalette.text-muted;
                            font-family: "monospace";
                            font-size: 10.5px;
                            overflow: elide;
                        }
                    }

                    Text {
                        text: model.status-text;
                        color: model.installed ? SubomiPalette.success-text : SubomiPalette.warning-text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    if !model.installed : VerticalLayout {
                        alignment: center;
                        ActionButton {
                            text: "Download";
                            compact: true;
                            enabled: !root.asr-download-active;
                            clicked => { root.download-asr-model(model.backend, model.name); }
                        }
                    }
                }
            }
        }
    }
}
