import { ComboBox, LineEdit } from "std-widgets.slint";
import { MementoPalette } from "../palette.slint";
import { ActionButton, ToggleChip } from "../components/buttons.slint";
import { MementoSwitch } from "../components/controls.slint";
import { SettingsField } from "types.slint";

export component FontPickerControl inherits VerticalLayout {
    in property <SettingsField> field;
    in property <[string]> font-families;
    property <bool> custom-family: false;
    property <string> custom-family-text: root.field.font-family;
    property <string> synced-family: root.field.font-family;
    callback font-edited(string, string, string, bool, bool);
    callback font-size-typed(string, string, string, bool, bool);

    width: 260px;
    spacing: 6px;

    changed synced-family => {
        root.custom-family-text = root.synced-family;
    }

    // Row 1: Font family selector + custom-font toggle (224 + 6 + 30 = 260px)
    HorizontalLayout {
        spacing: 6px;
        alignment: end;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            if !root.custom-family : ComboBox {
                width: 224px;
                enabled: root.field.enabled;
                model: root.font-families;
                current-value: root.field.font-family;
                selected(value) => {
                    root.custom-family-text = value;
                    root.font-edited(
                        root.field.key,
                        value,
                        size-edit.text,
                        root.field.font-bold,
                        root.field.font-italic,
                    );
                }
            }
            if root.custom-family : LineEdit {
                width: 224px;
                enabled: root.field.enabled;
                text: root.custom-family-text;
                placeholder-text: "Type font family…";
                edited(value) => {
                    root.custom-family-text = value;
                    root.font-size-typed(
                        root.field.key,
                        value,
                        size-edit.text,
                        root.field.font-bold,
                        root.field.font-italic,
                    );
                }
            }
        }

        VerticalLayout {
            alignment: center;
            ToggleChip {
                text: "✎";
                active: root.custom-family;
                enabled: root.field.enabled;
                tooltip: root.custom-family ? "Choose from installed fonts" : "Type custom font family";
                clicked => {
                    root.custom-family = !root.custom-family;
                    if root.custom-family {
                        root.custom-family-text = root.field.font-family;
                    }
                }
            }
        }
    }

    // Row 2: Size stepper + Bold / Italic toggles (fits cleanly inside 260px)
    HorizontalLayout {
        spacing: 6px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 5px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                ActionButton {
                    text: "−";
                    compact: true;
                    enabled: root.field.enabled;
                    tooltip: "Decrease size";
                    clicked => {
                        let next = max(1, Math.round(size-edit.text.to-float()) - 1);
                        root.font-edited(
                            root.field.key,
                            root.custom-family ? root.custom-family-text : root.field.font-family,
                            next + "",
                            root.field.font-bold,
                            root.field.font-italic,
                        );
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                size-edit := LineEdit {
                    width: 56px;
                    enabled: root.field.enabled;
                    text: root.field.font-size;
                    edited(value) => {
                        root.font-size-typed(
                            root.field.key,
                            root.custom-family ? root.custom-family-text : root.field.font-family,
                            value,
                            root.field.font-bold,
                            root.field.font-italic,
                        );
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                ActionButton {
                    text: "+";
                    compact: true;
                    enabled: root.field.enabled;
                    tooltip: "Increase size";
                    clicked => {
                        let next = min(500, max(1, Math.round(size-edit.text.to-float()) + 1));
                        root.font-edited(
                            root.field.key,
                            root.custom-family ? root.custom-family-text : root.field.font-family,
                            next + "",
                            root.field.font-bold,
                            root.field.font-italic,
                        );
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 5px;
            alignment: end;

            VerticalLayout {
                alignment: center;
                ToggleChip {
                    text: "B";
                    bold-text: true;
                    active: root.field.font-bold;
                    enabled: root.field.enabled;
                    tooltip: "Bold";
                    clicked => {
                        root.font-edited(
                            root.field.key,
                            root.custom-family ? root.custom-family-text : root.field.font-family,
                            size-edit.text,
                            !root.field.font-bold,
                            root.field.font-italic,
                        );
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                ToggleChip {
                    text: "I";
                    italic-text: true;
                    active: root.field.font-italic;
                    enabled: root.field.enabled;
                    tooltip: "Italic";
                    clicked => {
                        root.font-edited(
                            root.field.key,
                            root.custom-family ? root.custom-family-text : root.field.font-family,
                            size-edit.text,
                            root.field.font-bold,
                            !root.field.font-italic,
                        );
                    }
                }
            }
        }
    }
}

export component ColorSwatchControl inherits HorizontalLayout {
    in property <SettingsField> field;
    callback edited(string, string);
    callback color-hex-committed(string, string);
    callback open-color-picker(SettingsField);

    width: 260px;
    spacing: 6px;
    alignment: end;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 38px;
            height: 28px;
            border-radius: 6px;
            border-width: 1px;
            border-color: swatch-touch.has-hover ? MementoPalette.cyan-accent : MementoPalette.border-light;
            background: MementoPalette.checker-dark;
            clip: true;

            Rectangle { x: 0px;  y: 0px;  width: 10px; height: 10px; background: MementoPalette.checker-light; }
            Rectangle { x: 20px; y: 0px;  width: 10px; height: 10px; background: MementoPalette.checker-light; }
            Rectangle { x: 10px; y: 10px; width: 10px; height: 10px; background: MementoPalette.checker-light; }
            Rectangle { x: 30px; y: 10px; width: 10px; height: 10px; background: MementoPalette.checker-light; }
            Rectangle { x: 0px;  y: 20px; width: 10px; height: 10px; background: MementoPalette.checker-light; }
            Rectangle { x: 20px; y: 20px; width: 10px; height: 10px; background: MementoPalette.checker-light; }

            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: 5px;
                background: root.field.color-swatch;
            }

            swatch-touch := TouchArea {
                enabled: root.field.enabled;
                mouse-cursor: root.field.enabled ? pointer : default;
                clicked => { root.open-color-picker(root.field); }
            }
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        LineEdit {
            width: 146px;
            enabled: root.field.enabled;
            text: root.field.value;
            edited(value) => { root.edited(root.field.key, value); }
            accepted(value) => { root.color-hex-committed(root.field.key, value); }
        }
    }

    VerticalLayout {
        alignment: center;
        ActionButton {
            text: "Pick…";
            compact: true;
            enabled: root.field.enabled;
            clicked => { root.open-color-picker(root.field); }
        }
    }
}

export component KeybindCaptureControl inherits VerticalLayout {
    in property <SettingsField> field;
    property <bool> recording: false;
    callback edited(string, string);
    callback keybind-captured(string, string, bool, bool, bool, bool);

    width: 260px;
    spacing: 4px;

    HorizontalLayout {
        spacing: 6px;
        alignment: end;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            capture-focus := FocusScope {
                width: 224px;
                height: 30px;
                enabled: root.field.enabled;
                changed has-focus => {
                    if !self.has-focus {
                        root.recording = false;
                    }
                }
                key-pressed(event) => {
                    if !root.recording {
                        return reject;
                    }
                    if event.text == ""
                        || event.text == Key.Shift
                        || event.text == Key.Control
                        || event.text == Key.Alt
                        || event.text == Key.Meta
                        || event.text == Key.AltGr
                        || event.text == Key.CapsLock
                        || event.text == "\u{0015}"
                        || event.text == "\u{0016}"
                        || event.text == "\u{0018}" {
                        return accept;
                    }
                    if event.text == Key.Escape
                        && !event.modifiers.control
                        && !event.modifiers.alt
                        && !event.modifiers.shift
                        && !event.modifiers.meta {
                        root.recording = false;
                        return accept;
                    }
                    root.recording = false;
                    root.keybind-captured(
                        root.field.key,
                        event.text,
                        event.modifiers.control,
                        event.modifiers.alt,
                        event.modifiers.shift,
                        event.modifiers.meta,
                    );
                    return accept;
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 6px;
                    border-width: root.recording || root.field.conflict != "" ? 1.5px : 1px;
                    border-color: root.recording
                        ? MementoPalette.cyan-accent
                        : (root.field.conflict != ""
                            ? MementoPalette.warning
                            : (cap-touch.has-hover ? MementoPalette.cyan-accent : MementoPalette.border-light));
                    background: root.recording
                        ? MementoPalette.accent-muted
                        : (cap-touch.has-hover ? MementoPalette.button-hover : MementoPalette.surface-bg);

                    animate background { duration: 100ms; }
                    animate border-color { duration: 100ms; }

                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: root.recording
                            ? "Press shortcut… (Esc)"
                            : (root.field.value == "" ? "Unassigned" : root.field.value);
                        color: root.recording
                            ? MementoPalette.cyan-text
                            : (root.field.value == "" ? MementoPalette.text-muted : MementoPalette.text);
                        font-family: root.recording || root.field.value == "" ? "Noto Sans, sans-serif" : "monospace";
                        font-size: 12px;
                        font-weight: root.recording ? 700 : 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    cap-touch := TouchArea {
                        enabled: root.field.enabled;
                        mouse-cursor: root.field.enabled ? pointer : default;
                        clicked => {
                            root.recording = true;
                            capture-focus.focus();
                        }
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            ToggleChip {
                text: "×";
                active: false;
                enabled: root.field.enabled && root.field.value != "";
                tooltip: "Clear shortcut";
                clicked => {
                    root.recording = false;
                    root.edited(root.field.key, "");
                }
            }
        }
    }

    if root.field.conflict != "" : Text {
        text: "⚠ " + root.field.conflict;
        color: MementoPalette.warning-text;
        font-size: 11px;
        horizontal-alignment: right;
        overflow: elide;
    }
}

export component FieldRow inherits Rectangle {
    in property <SettingsField> field;
    in property <[string]> anki-decks;
    in property <[string]> anki-models;
    in property <[string]> font-families;
    property <bool> use-anki-decks: (root.field.key == "anki/profile/term/deck" || root.field.key == "anki/profile/kanji/deck") && root.anki-decks.length > 0;
    property <bool> use-anki-models: (root.field.key == "anki/profile/term/model" || root.field.key == "anki/profile/kanji/model") && root.anki-models.length > 0;
    callback edited(string, string);
    callback color-hex-committed(string, string);
    callback font-edited(string, string, string, bool, bool);
    callback font-size-typed(string, string, string, bool, bool);
    callback open-color-picker(SettingsField);
    callback keybind-captured(string, string, bool, bool, bool, bool);

    visible: root.field.visible;
    property <length> label-col-width: max(120px, root.width - ctrl-box.preferred-width - 16px);
    height: root.field.visible ? max(44px, max(label-col.preferred-height, ctrl-box.preferred-height) + 18px) : 0px;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 16px;

        label-col := VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            field-label := Text {
                width: root.label-col-width;
                text: root.field.label;
                font-size: 13px;
                font-weight: 500;
                color: root.field.enabled ? MementoPalette.text : MementoPalette.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.field.description != "" : field-desc := Text {
                width: root.label-col-width;
                text: root.field.description;
                font-size: 11px;
                color: MementoPalette.text-muted;
                wrap: word-wrap;
            }
        }

        ctrl-box := VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;

            if root.field.kind == "switch" : MementoSwitch {
                checked: root.field.value == "true";
                enabled: root.field.enabled;
                toggled(value) => { root.edited(root.field.key, value ? "true" : "false"); }
            }
            if root.field.kind == "choice" : ComboBox {
                width: 260px;
                enabled: root.field.enabled;
                model: root.field.choices;
                current-value: root.field.value;
                selected(value) => { root.edited(root.field.key, value); }
            }
            if root.field.kind == "font" : FontPickerControl {
                field: root.field;
                font-families: root.font-families;
                font-edited(key, family, size, bold, italic) => {
                    root.font-edited(key, family, size, bold, italic);
                }
                font-size-typed(key, family, size, bold, italic) => {
                    root.font-size-typed(key, family, size, bold, italic);
                }
            }
            if root.field.kind == "color" : ColorSwatchControl {
                field: root.field;
                edited(key, value) => { root.edited(key, value); }
                color-hex-committed(key, value) => { root.color-hex-committed(key, value); }
                open-color-picker(f) => { root.open-color-picker(f); }
            }
            if root.field.kind == "keybind" : KeybindCaptureControl {
                field: root.field;
                edited(key, value) => { root.edited(key, value); }
                keybind-captured(key, text, ctrl, alt, shift, meta) => {
                    root.keybind-captured(key, text, ctrl, alt, shift, meta);
                }
            }
            if root.field.kind == "text" && (root.use-anki-decks || root.use-anki-models) : ComboBox {
                width: 260px;
                enabled: root.field.enabled;
                model: root.use-anki-decks ? root.anki-decks : root.anki-models;
                current-value: root.field.value;
                selected(value) => { root.edited(root.field.key, value); }
            }
            if root.field.kind == "text" && !root.use-anki-decks && !root.use-anki-models : LineEdit {
                width: 260px;
                enabled: root.field.enabled;
                text: root.field.value;
                edited(value) => { root.edited(root.field.key, value); }
            }
        }
    }
}
