import { ScrollView } from "std-widgets.slint";
import { SubomiPalette } from "../palette.slint";
import {
    CompactFrequencyItem,
    DictResult,
    PitchGraph,
    PopupAudioSource,
    PopupFreqStyle,
    RichDerivationStep,
    RichHeadwordChar,
    RichKanjiDetail,
    RichPitchEntry,
    RichPitchGraph,
    RichTagPill,
    DictionaryText,
    PopupBridge,
    PopupLayout,
} from "types.slint";

// ── Shared Keyboard Focus Handler ───────────────────────────────────────────
export component PopupKeyHandler inherits FocusScope {
    callback close-requested();

    width: 0px;
    height: 0px;
    enabled: PopupBridge.rich-enabled;
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            if (PopupBridge.nested-depth > 0) {
                PopupBridge.pop-nested-popup();
                return accept;
            }
            root.close-requested();
            return accept;
        }
        if ((event.modifiers.control || event.modifiers.meta)
            && !event.modifiers.alt
            && (event.text == "c" || event.text == "C")
            && PopupBridge.selected-glossary-text != "")
        {
            PopupBridge.copy-selected-glossary();
            return accept;
        }
        if (PopupBridge.popup-key-pressed(
            event.text,
            event.modifiers.control,
            event.modifiers.shift,
            event.modifiers.alt,
            event.modifiers.meta
        )) {
            return accept;
        }
        reject
    }
    key-released(event) => {
        PopupBridge.popup-key-released(
            event.modifiers.control,
            event.modifiers.shift,
            event.modifiers.alt,
            event.modifiers.meta
        );
        reject
    }
}

// ── Shared Action Pill Button for Popup Headers ─────────────────────────────
export component PopupActionButton inherits Rectangle {
    in property <length> btn-width: 28px;
    in property <length> btn-height: 28px;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <length> icon-size: 16px;
    in property <string> label: "";
    in property <length> label-font-size: 14px;
    in property <int> label-font-weight: 700;
    in property <color> bg-normal: SubomiPalette.button-bg;
    in property <color> bg-hover: SubomiPalette.button-hover;
    in property <color> bg-pressed: SubomiPalette.button-pressed;
    in property <color> border-normal: SubomiPalette.border;
    in property <color> border-hover: SubomiPalette.border-light;
    in property <color> fg-color: SubomiPalette.icon;
    in property <color> fg-hover-color: SubomiPalette.text;
    in property <bool> enabled: true;
    in property <string> tooltip: "";
    in property <bool> tooltip-delayed: true;
    callback clicked();
    callback right-clicked();
    callback request-tooltip(string);

    width: root.btn-width;
    height: root.btn-height;
    border-radius: 5px;
    border-width: 1px;
    opacity: root.enabled ? 1.0 : 0.45;
    border-color: !root.enabled
        ? root.border-normal
        : (btn-touch.has-hover ? root.border-hover : root.border-normal);
    background: !root.enabled
        ? root.bg-normal
        : (btn-touch.pressed
            ? root.bg-pressed
            : (btn-touch.has-hover ? root.bg-hover : root.bg-normal));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    if root.has-icon : Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: btn-touch.has-hover && root.enabled ? root.fg-hover-color : root.fg-color;
    }

    if !root.has-icon && root.label != "" : DictionaryText {
        text: root.label;
        color: btn-touch.has-hover && root.enabled ? root.fg-hover-color : root.fg-color;
        font-size: root.label-font-size;
        font-weight: root.label-font-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    btn-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            PopupBridge.cancel-pending-tooltip();
            if root.enabled {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if (root.enabled && event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                PopupBridge.cancel-pending-tooltip();
                root.right-clicked();
            }
        }
        changed has-hover => {
            if self.has-hover && root.tooltip != "" && PopupBridge.rich-enabled {
                PopupBridge.tooltip-next-immediate = !root.tooltip-delayed;
                root.request-tooltip(root.tooltip);
            } else if !self.has-hover && root.tooltip != "" && PopupBridge.rich-enabled {
                PopupBridge.cancel-pending-tooltip();
                PopupBridge.hide-tooltip();
            }
        }
    }
}

// ── Category-Colored Tag Pill Badge (500ms hover delay + immediate click-to-show) ──
export component RichTagPillBadge inherits Rectangle {
    in property <RichTagPill> pill;
    callback request-tooltip(string);
    private property <bool> tooltip-pinned: false;

    height: max(18px, PopupBridge.css-tag-font-size + 7px);
    width: label.preferred-width + 12px;
    background: root.pill.bg-color;
    border-radius: 3px;

    label := DictionaryText {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.pill.name;
        font-family: PopupBridge.css-tag-font-family;
        font-size: PopupBridge.css-tag-font-size;
        font-weight: 700;
        color: #FFFFFF;
        vertical-alignment: center;
    }

    if root.pill.notes != "" : pill-touch := TouchArea {
        mouse-cursor: help;
        clicked => {
            if root.tooltip-pinned && PopupBridge.tooltip-visible && PopupBridge.tooltip-text == root.pill.notes {
                root.tooltip-pinned = false;
                PopupBridge.cancel-pending-tooltip();
                PopupBridge.hide-tooltip();
            } else {
                root.tooltip-pinned = true;
                PopupBridge.tooltip-next-immediate = true;
                root.request-tooltip(root.pill.notes);
            }
        }
        changed has-hover => {
            if self.has-hover {
                PopupBridge.tooltip-next-immediate = false;
                root.request-tooltip(root.pill.notes);
            } else {
                PopupBridge.cancel-pending-tooltip();
                if !root.tooltip-pinned {
                    PopupBridge.hide-tooltip();
                }
                root.tooltip-pinned = false;
            }
        }
    }
}

// ── Term-Level Deduplicated Tag Pill Row (#220) ─────────────────────────────
export component TermTagPillRow inherits HorizontalLayout {
    in property <int> res-index;
    in property <int> scan-depth: 0;
    in property <int> bridge-rev: 0;
    in property <bool> compact-tags: PopupBridge.compact-tags;
    callback request-tooltip(string);

    spacing: root.compact-tags ? 3px : 4px;
    alignment: start;

    for pill in (root.scan-depth < 0
        ? PopupBridge.panel-term-tag-pills(root.res-index, root.bridge-rev)
        : (root.scan-depth == 0
            ? PopupBridge.term-tag-pills(root.res-index, root.bridge-rev)
            : PopupBridge.nested-term-tag-pills(root.scan-depth, root.res-index, root.bridge-rev))) : RichTagPillBadge {
        pill: pill;
        request-tooltip(notes) => { root.request-tooltip(notes); }
    }
}

// ── Shared Term Header Leading Actions (Audio, `漢/か`, Browse Anki) ────────
export component TermLeadingActions inherits HorizontalLayout {
    in property <DictResult> res;
    in property <bool> show-reading-as-expr: false;
    in property <bool> reading-as-expression: false;
    in property <bool> show-browse: false;
    in property <length> btn-size: 28px;
    in property <length> icon-size: 16px;
    callback reading-as-expression-clicked();
    callback audio-clicked();
    callback audio-right-clicked(length);
    callback browse-clicked();
    callback request-tooltip(string, length);

    horizontal-stretch: 0;
    alignment: end;

    // Audio play + right-click audio source menu
    if !root.res.is-kanji : PopupActionButton {
        btn-width: root.btn-size;
        btn-height: root.btn-size;
        has-icon: true;
        icon: @image-url("../icons/volume-on.svg");
        icon-size: root.icon-size;
        tooltip: "Play audio (right-click for sources)";
        clicked => { root.audio-clicked(); }
        right-clicked => { root.audio-right-clicked(self.x); }
        request-tooltip(tip) => { root.request-tooltip(tip, 220px); }
    }

    // `漢`/`か` readingAsExpression toggle (flip expression ↔ kana reading for Anki export & dedup)
    if root.show-reading-as-expr : PopupActionButton {
        btn-width: root.btn-size;
        btn-height: root.btn-size;
        label: root.reading-as-expression ? "か" : "漢";
        label-font-size: 13px;
        label-font-weight: 700;
        bg-normal: root.reading-as-expression ? SubomiPalette.teal-accent : SubomiPalette.button-bg;
        bg-hover: root.reading-as-expression ? SubomiPalette.teal-hover : SubomiPalette.button-hover;
        bg-pressed: root.reading-as-expression ? SubomiPalette.teal-pressed : SubomiPalette.button-pressed;
        border-normal: root.reading-as-expression ? SubomiPalette.teal-border : SubomiPalette.border;
        border-hover: root.reading-as-expression ? SubomiPalette.teal-border : SubomiPalette.border-light;
        fg-color: root.reading-as-expression ? #FFFFFF : SubomiPalette.icon;
        fg-hover-color: root.reading-as-expression ? #FFFFFF : SubomiPalette.text;
        tooltip: root.reading-as-expression
            ? "Using kana reading as Anki expression (click for kanji)"
            : "Use kana reading as Anki expression";
        clicked => { root.reading-as-expression-clicked(); }
        request-tooltip(tip) => { root.request-tooltip(tip, 220px); }
    }

    // Browse in Anki
    if root.show-browse : PopupActionButton {
        btn-width: root.btn-size;
        btn-height: root.btn-size;
        has-icon: true;
        icon: @image-url("../icons/note-stack.svg");
        icon-size: root.icon-size;
        bg-normal: SubomiPalette.accent-muted;
        bg-hover: SubomiPalette.accent-muted-hover;
        bg-pressed: SubomiPalette.accent-muted;
        border-normal: SubomiPalette.accent-border-subtle;
        border-hover: SubomiPalette.cyan-accent;
        fg-color: SubomiPalette.cyan-text;
        fg-hover-color: SubomiPalette.cyan-hover;
        tooltip: "Browse in Anki";
        clicked => { root.browse-clicked(); }
        request-tooltip(tip) => { root.request-tooltip(tip, 140px); }
    }
}

// ── Shared Emerald Add-to-Anki Button (Left-click add, Right-click audio source picker) ──
export component AnkiAddButton inherits Rectangle {
    in property <length> btn-size: 28px;
    callback clicked();
    callback right-clicked(length);
    callback request-tooltip(string);

    width: root.btn-size;
    height: root.btn-size;
    background: transparent;

    PopupActionButton {
        btn-width: root.btn-size;
        btn-height: root.btn-size;
        has-icon: true;
        icon: @image-url("../icons/add.svg");
        icon-size: 16px;
        bg-normal: SubomiPalette.success-bg;
        bg-hover: SubomiPalette.teal-accent;
        bg-pressed: SubomiPalette.teal-pressed;
        border-normal: SubomiPalette.success-border;
        border-hover: SubomiPalette.teal-border;
        fg-color: SubomiPalette.success-text;
        fg-hover-color: #FFFFFF;
        tooltip: "Add to Anki (right-click to choose audio source)";
        clicked => { root.clicked(); }
        right-clicked => { root.right-clicked(0px); }
        request-tooltip(tip) => { root.request-tooltip(tip); }
    }
}

// ── Existing Anki Note Tag Row (#346) ───────────────────────────────────────
export component AnkiTagRow inherits HorizontalLayout {
    in property <string> raw-tags;
    callback request-tooltip(string);

    property <[string]> split-tags: PopupBridge.split-anki-tags(root.raw-tags);
    property <[string]> effective-tags: self.split-tags.length > 0 ? self.split-tags : [root.raw-tags];

    spacing: 4px;
    alignment: start;

    for anki-tag in root.effective-tags : Rectangle {
        property <bool> pinned: false;
        property <string> tip-str: "Anki tag: " + anki-tag;
        height: 18px;
        width: anki-tag-lbl.preferred-width + 12px;
        background: PopupBridge.css-anki-tag-bg;
        border-width: 1px;
        border-color: PopupBridge.css-anki-tag-border;
        border-radius: 3px;

        anki-tag-lbl := DictionaryText {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text: anki-tag;
            font-size: 10px;
            font-weight: 700;
            color: PopupBridge.css-anki-tag-color;
            vertical-alignment: center;
        }

        if PopupBridge.rich-enabled : TouchArea {
            mouse-cursor: help;
            clicked => {
                if parent.pinned && PopupBridge.tooltip-visible && PopupBridge.tooltip-text == parent.tip-str {
                    parent.pinned = false;
                    PopupBridge.cancel-pending-tooltip();
                    PopupBridge.hide-tooltip();
                } else {
                    parent.pinned = true;
                    PopupBridge.tooltip-next-immediate = true;
                    root.request-tooltip(parent.tip-str);
                }
            }
            changed has-hover => {
                if self.has-hover {
                    PopupBridge.tooltip-next-immediate = false;
                    root.request-tooltip(parent.tip-str);
                } else {
                    PopupBridge.cancel-pending-tooltip();
                    if !parent.pinned {
                        PopupBridge.hide-tooltip();
                    }
                    parent.pinned = false;
                }
            }
        }
    }
}

// ── Per-Character Headword Cell (TouchArea mounted ONLY on kanji) ───────────
component HeadwordCharCell inherits Rectangle {
    in property <RichHeadwordChar> ch;
    in property <string> font-family: PopupBridge.css-headword-font-family;
    in property <length> font-size;
    in property <int> font-weight: 700;
    in property <color> text-color;
    callback kanji-clicked(string);
    callback request-tooltip(string, length);

    private property <bool> hovered: false;

    width: ch-text.preferred-width;
    height: ch-text.preferred-height;
    background: root.hovered ? SubomiPalette.hover-bg : transparent;
    border-radius: 3px;

    ch-text := DictionaryText {
        text: root.ch.text;
        font-family: root.font-family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.hovered ? PopupBridge.css-link-color : root.text-color;
    }

    if root.ch.is-kanji : TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            root.hovered = self.has-hover;
            if self.has-hover && PopupBridge.rich-enabled {
                PopupBridge.tooltip-next-immediate = false;
                root.request-tooltip("Kanji info: " + root.ch.text, 0px);
            } else if !self.has-hover && PopupBridge.rich-enabled {
                PopupBridge.cancel-pending-tooltip();
                PopupBridge.hide-tooltip();
            }
        }
        clicked => {
            if PopupBridge.rich-enabled {
                PopupBridge.cancel-pending-tooltip();
                PopupBridge.hide-tooltip();
            }
            root.kanji-clicked(root.ch.text);
        }
    }
}

export component HeadwordCharRow inherits VerticalLayout {
    in property <string> expression;
    in property <length> avail-width: 240px;
    in property <string> font-family: PopupBridge.css-headword-font-family;
    in property <length> font-size: PopupBridge.css-headword-size;
    in property <int> font-weight: 700;
    in property <color> text-color: PopupBridge.css-headword-color;
    callback kanji-clicked(string);
    callback request-tooltip(string, length);

    spacing: 1px;

    for hw-line in PopupBridge.headword-lines(root.expression, root.avail-width / 1px) : HorizontalLayout {
        alignment: start;
        spacing: 0px;
        for ch in hw-line.chars : cell := HeadwordCharCell {
            ch: ch;
            font-family: root.font-family;
            font-size: root.font-size;
            font-weight: root.font-weight;
            text-color: root.text-color;
            kanji-clicked(c) => { root.kanji-clicked(c); }
            request-tooltip(tip, x-off) => { root.request-tooltip(tip, cell.x + x-off); }
        }
    }
}

// ── Clickable Kana Reading Text (triggers kana-reading homophone search) ────
component ClickableReadingText inherits HorizontalLayout {
    in property <string> text;
    in property <string> font-family: PopupBridge.css-reading-font-family;
    in property <length> font-size: PopupBridge.css-reading-size;
    in property <int> font-weight: 400;
    in property <color> text-color: PopupBridge.css-reading-color;
    in property <length> avail-width: 240px;
    in property <bool> clickable: false;
    in property <bool> active: false;
    callback clicked();
    callback request-tooltip(string, length);

    alignment: start;

    pill := Rectangle {
        private property <bool> hovered: false;
        private property <string> tip-text: root.active
            ? "Back to previous lookup"
            : "Search by kana reading";
        width: min(root.avail-width, reading-label.preferred-width + (root.clickable ? 4px : 0px));
        height: reading-label.preferred-height;
        border-radius: 3px;
        background: root.clickable && self.hovered
            ? SubomiPalette.hover-bg
            : (root.clickable && root.active ? SubomiPalette.accent-muted : transparent);

        reading-label := DictionaryText {
            x: root.clickable ? 2px : 0px;
            width: parent.width - (root.clickable ? 4px : 0px);
            text: root.text;
            height: self.preferred-height;
            wrap: word-wrap;
            font-family: root.font-family;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: root.clickable && pill.hovered
                ? PopupBridge.css-link-color
                : (root.clickable && root.active ? SubomiPalette.teal-accent : root.text-color);
        }

        if root.clickable : TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                pill.hovered = self.has-hover;
                if self.has-hover && PopupBridge.rich-enabled {
                    PopupBridge.tooltip-next-immediate = false;
                    root.request-tooltip(pill.tip-text, 0px);
                } else if !self.has-hover && PopupBridge.rich-enabled {
                    PopupBridge.cancel-pending-tooltip();
                    PopupBridge.hide-tooltip();
                }
            }
            clicked => {
                if PopupBridge.rich-enabled {
                    PopupBridge.cancel-pending-tooltip();
                    PopupBridge.hide-tooltip();
                }
                root.clicked();
            }
        }
    }
}

// ── Term Headword + Reading Block ───────────────────────────────────────────
export component TermHeadwordBlock inherits VerticalLayout {
    in property <DictResult> res;
    in property <bool> nested: false;
    in property <bool> compact: false;
    in property <bool> reading-as-expression: false;
    in property <bool> kana-clickable: false;
    in property <bool> kana-active: false;
    in property <int> scan-depth: 0;
    in property <int> bridge-rev: 0;
    in property <length> avail-width: 240px;
    in property <color> headword-color: PopupBridge.css-headword-color;
    callback kanji-clicked(string);
    callback kana-clicked();
    callback request-tooltip(string, length);

    property <bool> flip-to-kana: root.reading-as-expression && !root.res.is-kanji && root.res.reading != "" && root.res.reading != root.res.expression;
    property <bool> can-search-kana: root.kana-clickable && !root.res.is-kanji && root.res.reading != "" && root.res.reading != root.res.expression;
    property <string> display-main: self.flip-to-kana ? root.res.reading : root.res.expression;
    property <string> display-sub: self.flip-to-kana ? root.res.expression : root.res.reading;

    property <length> hw-font-size: root.compact
        ? max(16px, PopupBridge.css-headword-size - 2px)
        : PopupBridge.css-headword-size;
    property <length> kanji-font-size: PopupBridge.css-kanji-font-size > 0px
        ? PopupBridge.css-kanji-font-size
        : PopupBridge.css-headword-size * (root.nested ? 1.4 : 1.56);

    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    spacing: 2px;

    // Sub-line: kana reading (normal mode) — clickable to search homophones by reading
    if !root.res.is-kanji && !root.flip-to-kana && root.display-sub != "" && root.display-sub != root.display-main : ClickableReadingText {
        text: root.display-sub;
        avail-width: root.avail-width;
        font-family: PopupBridge.css-reading-font-family;
        font-size: PopupBridge.css-reading-size;
        font-weight: 400;
        text-color: PopupBridge.css-reading-color;
        clickable: root.can-search-kana;
        active: root.kana-active;
        clicked => { root.kana-clicked(); }
        request-tooltip(tip, x-off) => { root.request-tooltip(tip, x-off); }
    }

    // Sub-line: kanji expression (when flipped via `か` mode) — keep kanji individually clickable
    if !root.res.is-kanji && root.flip-to-kana && PopupBridge.rich-enabled && root.display-sub != "" && root.display-sub != root.display-main : HeadwordCharRow {
        expression: root.display-sub;
        avail-width: root.avail-width;
        font-family: PopupBridge.css-reading-font-family;
        font-size: PopupBridge.css-reading-size;
        font-weight: 400;
        text-color: PopupBridge.css-reading-color;
        kanji-clicked(c) => { root.kanji-clicked(c); }
        request-tooltip(tip, x-off) => { root.request-tooltip(tip, x-off); }
    }

    if !root.res.is-kanji && root.flip-to-kana && !PopupBridge.rich-enabled && root.display-sub != "" && root.display-sub != root.display-main : DictionaryText {
        text: root.display-sub;
        height: self.preferred-height;
        wrap: word-wrap;
        font-family: PopupBridge.css-reading-font-family;
        font-size: PopupBridge.css-reading-size;
        color: PopupBridge.css-reading-color;
    }

    // Main line: kanji expression (normal rich mode) — each kanji clickable with tooltip
    if PopupBridge.rich-enabled && !root.res.is-kanji && !root.flip-to-kana : HeadwordCharRow {
        expression: root.display-main;
        avail-width: root.avail-width;
        font-family: PopupBridge.css-headword-font-family;
        font-size: root.hw-font-size;
        font-weight: 700;
        text-color: root.headword-color;
        kanji-clicked(c) => { root.kanji-clicked(c); }
        request-tooltip(tip, x-off) => { root.request-tooltip(tip, x-off); }
    }

    // Main line: kana reading (flipped via `か` mode) — stays clickable for kana reading search
    if !root.res.is-kanji && root.flip-to-kana : ClickableReadingText {
        text: root.display-main;
        avail-width: root.avail-width;
        font-family: PopupBridge.css-headword-font-family;
        font-size: root.hw-font-size;
        font-weight: 700;
        text-color: root.headword-color;
        clickable: root.can-search-kana;
        active: root.kana-active;
        clicked => { root.kana-clicked(); }
        request-tooltip(tip, x-off) => { root.request-tooltip(tip, x-off); }
    }

    // Main line fallback (kanji entry or non-rich term)
    if root.res.is-kanji || (!PopupBridge.rich-enabled && !root.flip-to-kana) : DictionaryText {
        text: root.display-main;
        height: self.preferred-height;
        wrap: word-wrap;
        font-family: root.res.is-kanji ? PopupBridge.css-kanji-font-family : PopupBridge.css-headword-font-family;
        font-size: root.res.is-kanji ? root.kanji-font-size : root.hw-font-size;
        font-weight: 700;
        color: root.headword-color;
    }
}

// ── Conjugation Derivation Chain (unified soft theme-reactive capsule) ──────
export component TermDerivationRow inherits HorizontalLayout {
    in property <[RichDerivationStep]> steps;
    in property <string> compact-summary: "";
    callback request-tooltip(string);

    alignment: start;

    if root.steps.length > 0 : Rectangle {
        width: deriv-inner.preferred-width;
        height: max(20px, PopupBridge.css-conj-font-size + 8px);
        border-radius: 5px;
        border-width: 1px;
        border-color: SubomiPalette.pill-border;
        background: SubomiPalette.pill-surface;

        deriv-inner := HorizontalLayout {
            padding-left: 7px;
            padding-right: 7px;
            spacing: 2px;
            alignment: start;

            DictionaryText {
                text: "«";
                font-family: PopupBridge.css-conj-font-family;
                font-size: PopupBridge.css-conj-font-size;
                color: SubomiPalette.pill-arrow;
                vertical-alignment: center;
            }

            for step[step-idx] in root.steps : HorizontalLayout {
                spacing: 2px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        property <bool> pinned: false;
                        property <string> step-tip: step.label + ": " + step.description;
                        width: step-lbl.preferred-width + 8px;
                        height: max(16px, PopupBridge.css-conj-font-size + 4px);
                        border-radius: 3px;
                        background: step-touch.has-hover ? SubomiPalette.pill-surface-hover : transparent;
                        animate background { duration: 100ms; }

                        step-lbl := DictionaryText {
                            x: 4px;
                            height: parent.height;
                            text: step.label;
                            font-family: PopupBridge.css-conj-font-family;
                            font-size: PopupBridge.css-conj-font-size;
                            color: step-touch.has-hover ? SubomiPalette.pill-text-hover : SubomiPalette.pill-text;
                            vertical-alignment: center;
                        }
                        step-touch := TouchArea {
                            mouse-cursor: step.description != "" ? help : default;
                            clicked => {
                                if step.description != "" {
                                    if parent.pinned && PopupBridge.tooltip-visible && PopupBridge.tooltip-text == parent.step-tip {
                                        parent.pinned = false;
                                        PopupBridge.cancel-pending-tooltip();
                                        PopupBridge.hide-tooltip();
                                    } else {
                                        parent.pinned = true;
                                        PopupBridge.tooltip-next-immediate = true;
                                        root.request-tooltip(parent.step-tip);
                                    }
                                }
                            }
                            changed has-hover => {
                                if self.has-hover && step.description != "" {
                                    PopupBridge.tooltip-next-immediate = false;
                                    root.request-tooltip(parent.step-tip);
                                } else if !self.has-hover {
                                    PopupBridge.cancel-pending-tooltip();
                                    if !parent.pinned {
                                        PopupBridge.hide-tooltip();
                                    }
                                    parent.pinned = false;
                                }
                            }
                        }
                    }
                }

                if step.has-arrow : DictionaryText {
                    text: "←";
                    font-family: PopupBridge.css-conj-font-family;
                    font-size: PopupBridge.css-conj-font-size;
                    color: SubomiPalette.pill-arrow;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.steps.length == 0 && root.compact-summary != "" : Rectangle {
        property <bool> pinned: false;
        width: 22px;
        height: 18px;
        border-radius: 4px;
        background: compact-deriv-touch.has-hover ? SubomiPalette.pill-surface-hover : SubomiPalette.pill-surface;
        border-width: 1px;
        border-color: SubomiPalette.pill-border;

        DictionaryText {
            text: "ⓘ";
            font-size: 12px;
            color: PopupBridge.css-muted-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        compact-deriv-touch := TouchArea {
            mouse-cursor: help;
            clicked => {
                if parent.pinned && PopupBridge.tooltip-visible && PopupBridge.tooltip-text == root.compact-summary {
                    parent.pinned = false;
                    PopupBridge.cancel-pending-tooltip();
                    PopupBridge.hide-tooltip();
                } else {
                    parent.pinned = true;
                    PopupBridge.tooltip-next-immediate = true;
                    root.request-tooltip(root.compact-summary);
                }
            }
            changed has-hover => {
                if self.has-hover {
                    PopupBridge.tooltip-next-immediate = false;
                    root.request-tooltip(root.compact-summary);
                } else {
                    PopupBridge.cancel-pending-tooltip();
                    if !parent.pinned {
                        PopupBridge.hide-tooltip();
                    }
                    parent.pinned = false;
                }
            }
        }
    }
}

// ── Wrapping Frequency Badge List (supports compact omit-dict-name badges) ──
export component FrequencyBadgeList inherits VerticalLayout {
    in property <DictResult> res;
    in property <int> scan-depth: 0;
    in property <int> bridge-rev: 0;
    in property <bool> compact-dict-header: PopupBridge.compact-freq-badges;
    in property <bool> show-legacy-meta: false;
    in property <string> jpdb-rank: "";
    in property <string> freq-rank: "";
    in property <string> pitch-accent: "";

    property <[CompactFrequencyItem]> compact-items: PopupBridge.rich-enabled
        ? PopupBridge.row-compact-frequencies(root.scan-depth, root.res.index, root.bridge-rev)
        : [];
    property <bool> use-compact-bridge: PopupBridge.rich-enabled && self.compact-items.length > 0;

    spacing: 3px;

    if root.show-legacy-meta && root.res.index == 1 && root.res.frequencies.length == 0 && !root.use-compact-bridge
        && (root.jpdb-rank != "" || root.freq-rank != "" || root.pitch-accent != "") : HorizontalLayout {
        width: parent.width;
        spacing: 6px;
        alignment: start;
        if root.jpdb-rank != "" : DictionaryText { text: "JPDB " + root.jpdb-rank; color: SubomiPalette.success-text; font-size: 11px; }
        if root.freq-rank != "" : DictionaryText { text: root.freq-rank; color: SubomiPalette.success-text; font-size: 11px; }
        if root.pitch-accent != "" : DictionaryText { text: root.pitch-accent; color: SubomiPalette.badge-purple-text; font-size: 11px; }
    }

    // Bridge-provided compact frequency items (explicit omit-dict-name per badge)
    if root.use-compact-bridge : VerticalLayout {
        width: root.width;
        spacing: 3px;
        for line in PopupLayout.compact-frequency-lines(root.compact-items, root.width / 1px) : HorizontalLayout {
            width: root.width;
            alignment: start;
            spacing: 4px;
            for frequency in line.entries : Rectangle {
                property <PopupFreqStyle> fstyle: PopupBridge.freq-badge-style(frequency.dictionary, PopupBridge.rich-revision);
                property <string> badge-text: (frequency.omit-dict-name || frequency.dictionary == "")
                    ? frequency.value
                    : (frequency.dictionary + " " + frequency.value);
                width: min(cfreq-label.preferred-width + 10px, parent.width);
                height: max(18px, cfreq-label.preferred-height + 2px);
                background: self.fstyle.bg;
                border-radius: 3px;
                cfreq-label := DictionaryText {
                    x: 5px;
                    width: parent.width - 10px;
                    height: parent.height;
                    text: parent.badge-text;
                    font-size: PopupBridge.css-freq-font-size;
                    color: parent.fstyle.color;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Standard frequency list (also omits repeated consecutive dict names when compact-dict-header is active)
    if !root.use-compact-bridge && root.res.frequencies.length > 0 : VerticalLayout {
        width: root.width;
        spacing: 3px;
        for line in PopupLayout.frequency-lines(root.res.frequencies, root.width / 1px) : HorizontalLayout {
            width: root.width;
            alignment: start;
            spacing: 4px;
            for frequency[f-idx] in line.entries : Rectangle {
                property <PopupFreqStyle> fstyle: PopupBridge.rich-enabled
                    ? PopupBridge.freq-badge-style(frequency.dictionary, PopupBridge.rich-revision)
                    : { bg: PopupBridge.css-freq-bg, color: PopupBridge.css-freq-color };
                property <bool> omit-dict: frequency.dictionary == ""
                    || (root.compact-dict-header && f-idx > 0 && line.entries[f-idx - 1].dictionary == frequency.dictionary);
                width: min(frequency-label.preferred-width + 10px, parent.width);
                height: max(18px, frequency-label.preferred-height + 2px);
                background: self.fstyle.bg;
                border-radius: 3px;
                frequency-label := DictionaryText {
                    x: 5px;
                    width: parent.width - 10px;
                    height: parent.height;
                    text: parent.omit-dict ? frequency.value : (frequency.dictionary + " " + frequency.value);
                    font-size: PopupBridge.css-freq-font-size;
                    color: parent.fstyle.color;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ── Pitch Accent Graph List (Decoupled `[position]` / `[pattern]` badge outside `.pitch-dict`) ─
export component PitchGraphList inherits VerticalLayout {
    in property <[RichPitchEntry]> rich-pitch-entries: [];
    in property <[RichPitchGraph]> rich-pitches;
    in property <[PitchGraph]> fallback-pitches;
    in property <int> scan-depth: 0;
    in property <int> row-index: 0;
    in property <int> bridge-rev: 0;
    in property <bool> hide-dict-name: false;
    in property <bool> allow-fallback: true;
    in property <bool> compact: false;
    callback request-tooltip(string);

    property <length> row-h: root.compact ? 28px : 30px;
    property <length> badge-h: root.compact ? 18px : 20px;
    property <bool> use-entries: PopupBridge.rich-enabled && root.rich-pitch-entries.length > 0;
    property <bool> show-dict-pill-global: PopupBridge.css-show-pitch-dict && !PopupBridge.hide-pitch-dict-name && !root.hide-dict-name;

    spacing: root.compact ? 3px : 4px;

    // 1. Extended rich pitch entries with exact string `pattern-text` (e.g. "LHH", "HLL") and `hide-dict-name`
    if root.use-entries : VerticalLayout {
        width: parent.width;
        spacing: root.compact ? 3px : 4px;
        for pitch in root.rich-pitch-entries : Rectangle {
            width: parent.width;
            height: root.row-h;
            background: transparent;
            HorizontalLayout {
                width: parent.width;
                height: root.row-h;
                spacing: root.compact ? 5px : 6px;
                alignment: start;

                // Dictionary name pill (`.pitch-dict`) — cleanly decoupled from `[position]` / `[pattern]`
                if root.show-dict-pill-global && !pitch.hide-dict-name && pitch.dictionary != "" : Rectangle {
                    height: root.badge-h;
                    y: (root.row-h - self.height) / 2;
                    width: min(entry-dict-lbl.preferred-width + 10px, parent.width * 0.36);
                    background: PopupBridge.pitch-dict-bg(pitch.dictionary, PopupBridge.rich-revision);
                    border-radius: 3px;
                    entry-dict-lbl := DictionaryText {
                        x: 5px;
                        width: parent.width - 10px;
                        height: parent.height;
                        text: pitch.dictionary;
                        font-size: 10px;
                        font-weight: 700;
                        color: #FFFFFF;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Separate `[position]` or exact `[pattern-text]` badge (ALWAYS visible even when dict pill is hidden)
                Rectangle {
                    height: root.badge-h;
                    y: (root.row-h - self.height) / 2;
                    width: entry-pos-lbl.preferred-width + 10px;
                    background: SubomiPalette.badge-purple;
                    border-radius: 3px;
                    entry-pos-lbl := DictionaryText {
                        x: 5px;
                        width: parent.width - 10px;
                        height: parent.height;
                        text: "[" + (pitch.pattern-text != "" ? pitch.pattern-text : (pitch.position + "")) + "]";
                        font-size: 10px;
                        font-weight: 700;
                        color: SubomiPalette.badge-purple-text;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    width: self.preferred-width;
                    height: root.row-h;
                    horizontal-stretch: 0;
                    spacing: 0px;
                    for mora in pitch.mora : Rectangle {
                        width: max(root.compact ? 18px : 20px, entry-mora-lbl.preferred-width + (root.compact ? 5px : 6px));
                        height: root.row-h;
                        Rectangle {
                            x: 0px;
                            y: mora.high ? 3px : 11px;
                            width: parent.width;
                            height: 1.5px;
                            background: PopupBridge.css-pitch-color;
                        }
                        if mora.rises-after || mora.falls-after : Rectangle {
                            x: parent.width - 1.5px;
                            y: 3px;
                            width: 1.5px;
                            height: 9.5px;
                            background: PopupBridge.css-pitch-color;
                        }
                        if mora.devoice : Image {
                            x: (parent.width - 18px) / 2;
                            y: root.compact ? 10px : 11px;
                            width: 18px;
                            height: 18px;
                            source: PopupBridge.devoice-circle-image();
                        }
                        entry-mora-lbl := DictionaryText {
                            text: mora.text;
                            y: root.compact ? 12px : 13px;
                            horizontal-alignment: center;
                            width: parent.width;
                            font-size: 11px;
                            color: mora.devoice ? SubomiPalette.danger-text : PopupBridge.css-text-color;
                        }
                        if mora.nasal : Rectangle {
                            x: parent.width - 6px;
                            y: root.compact ? 10px : 11px;
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            border-width: 1.2px;
                            border-color: SubomiPalette.nasal-ring;
                            background: PopupBridge.css-popup-bg;
                        }
                        if mora.nasal || mora.devoice : TouchArea {
                            mouse-cursor: help;
                            changed has-hover => {
                                if self.has-hover {
                                    PopupBridge.tooltip-next-immediate = false;
                                    root.request-tooltip(
                                        mora.nasal && mora.devoice
                                            ? "Nasalized & devoiced mora (鼻濁音・母音無声化)"
                                            : (mora.nasal ? "Nasalized mora (鼻濁音 ゜)" : "Devoiced mora (母音無声化)")
                                    );
                                } else {
                                    PopupBridge.cancel-pending-tooltip();
                                    PopupBridge.hide-tooltip();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 2. Existing RichPitchGraph list (also decoupled `[position]` / `pitch-pattern-text` badge outside `.pitch-dict`)
    if !root.use-entries && PopupBridge.rich-enabled && root.rich-pitches.length > 0 : VerticalLayout {
        width: parent.width;
        spacing: root.compact ? 3px : 4px;
        for pitch[p-idx] in root.rich-pitches : Rectangle {
            property <string> exact-pat: PopupBridge.pitch-pattern-text(root.scan-depth, root.row-index, p-idx, root.bridge-rev);
            width: parent.width;
            height: root.row-h;
            background: transparent;
            HorizontalLayout {
                width: parent.width;
                height: root.row-h;
                spacing: root.compact ? 5px : 6px;
                alignment: start;

                // Dictionary name pill (`.pitch-dict`) ONLY — never swallows `[position]`
                if root.show-dict-pill-global && pitch.dictionary != "" : Rectangle {
                    height: root.badge-h;
                    y: (root.row-h - self.height) / 2;
                    width: min(pitch-dict-lbl.preferred-width + 10px, parent.width * 0.36);
                    background: PopupBridge.pitch-dict-bg(pitch.dictionary, PopupBridge.rich-revision);
                    border-radius: 3px;
                    pitch-dict-lbl := DictionaryText {
                        x: 5px;
                        width: parent.width - 10px;
                        height: parent.height;
                        text: pitch.dictionary;
                        font-size: 10px;
                        font-weight: 700;
                        color: #FFFFFF;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Decoupled `[position]` or `[LHH]` pattern badge OUTSIDE `.pitch-dict`
                Rectangle {
                    height: root.badge-h;
                    y: (root.row-h - self.height) / 2;
                    width: pitch-pos-lbl.preferred-width + 10px;
                    background: SubomiPalette.badge-purple;
                    border-radius: 3px;
                    pitch-pos-lbl := DictionaryText {
                        x: 5px;
                        width: parent.width - 10px;
                        height: parent.height;
                        text: "[" + (exact-pat != "" ? exact-pat : (pitch.position + "")) + "]";
                        font-size: 10px;
                        font-weight: 700;
                        color: SubomiPalette.badge-purple-text;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    width: self.preferred-width;
                    height: root.row-h;
                    horizontal-stretch: 0;
                    spacing: 0px;
                    for mora in pitch.mora : Rectangle {
                        width: max(root.compact ? 18px : 20px, rich-mora-lbl.preferred-width + (root.compact ? 5px : 6px));
                        height: root.row-h;
                        Rectangle {
                            x: 0px;
                            y: mora.high ? 3px : 11px;
                            width: parent.width;
                            height: 1.5px;
                            background: PopupBridge.css-pitch-color;
                        }
                        if mora.rises-after || mora.falls-after : Rectangle {
                            x: parent.width - 1.5px;
                            y: 3px;
                            width: 1.5px;
                            height: 9.5px;
                            background: PopupBridge.css-pitch-color;
                        }
                        if mora.devoice : Image {
                            x: (parent.width - 18px) / 2;
                            y: root.compact ? 10px : 11px;
                            width: 18px;
                            height: 18px;
                            source: PopupBridge.devoice-circle-image();
                        }
                        rich-mora-lbl := DictionaryText {
                            text: mora.text;
                            y: root.compact ? 12px : 13px;
                            horizontal-alignment: center;
                            width: parent.width;
                            font-size: 11px;
                            color: mora.devoice ? SubomiPalette.danger-text : PopupBridge.css-text-color;
                        }
                        if mora.nasal : Rectangle {
                            x: parent.width - 6px;
                            y: root.compact ? 10px : 11px;
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            border-width: 1.2px;
                            border-color: SubomiPalette.nasal-ring;
                            background: PopupBridge.css-popup-bg;
                        }
                        if mora.nasal || mora.devoice : TouchArea {
                            mouse-cursor: help;
                            changed has-hover => {
                                if self.has-hover {
                                    PopupBridge.tooltip-next-immediate = false;
                                    root.request-tooltip(
                                        mora.nasal && mora.devoice
                                            ? "Nasalized & devoiced mora (鼻濁音・母音無声化)"
                                            : (mora.nasal ? "Nasalized mora (鼻濁音 ゜)" : "Devoiced mora (母音無声化)")
                                    );
                                } else {
                                    PopupBridge.cancel-pending-tooltip();
                                    PopupBridge.hide-tooltip();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 3. Fallback pitch graphs when rich bridge has none or is disabled
    if root.allow-fallback && !root.use-entries && (!PopupBridge.rich-enabled || root.rich-pitches.length == 0) && root.fallback-pitches.length > 0 : VerticalLayout {
        width: parent.width;
        spacing: 4px;
        for pitch in root.fallback-pitches : Rectangle {
            width: parent.width;
            height: 28px;
            background: transparent;
            HorizontalLayout {
                width: parent.width;
                height: 28px;
                spacing: 6px;
                alignment: start;
                if root.show-dict-pill-global && pitch.dictionary != "" : DictionaryText {
                    text: pitch.dictionary;
                    width: min(self.preferred-width, parent.width * 0.34);
                    horizontal-stretch: 0;
                    font-size: 11px;
                    color: SubomiPalette.badge-purple-text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    height: 18px;
                    y: 5px;
                    width: fb-pos-lbl.preferred-width + 8px;
                    background: SubomiPalette.badge-purple;
                    border-radius: 3px;
                    fb-pos-lbl := DictionaryText {
                        x: 4px;
                        width: parent.width - 8px;
                        height: parent.height;
                        text: "[" + pitch.position + "]";
                        font-size: 10px;
                        font-weight: 700;
                        color: SubomiPalette.badge-purple-text;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    width: self.preferred-width;
                    height: 28px;
                    horizontal-stretch: 0;
                    spacing: 0px;
                    for mora in pitch.mora : Rectangle {
                        width: max(18px, mora-label.preferred-width + 3px);
                        height: 28px;
                        Rectangle { x: 0px; y: mora.high ? 3px : 11px; width: parent.width; height: 1px; background: PopupBridge.css-pitch-color; }
                        if mora.rises-after || mora.falls-after : Rectangle { x: parent.width - 1px; y: 3px; width: 1px; height: 9px; background: PopupBridge.css-pitch-color; }
                        mora-label := DictionaryText {
                            text: mora.text;
                            y: 13px;
                            horizontal-alignment: center;
                            width: parent.width;
                            font-size: 10px;
                            color: PopupBridge.css-text-color;
                        }
                    }
                }
            }
        }
    }
}

// ── 3-Column Kanji Detail Card ──────────────────────────────────────────────
export component KanjiDetailCard inherits VerticalLayout {
    in property <RichKanjiDetail> detail;
    in property <bool> selected: true;

    spacing: 6px;

    Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }

    HorizontalLayout {
        width: parent.width;
        spacing: 8px;
        DictionaryText { horizontal-stretch: 1; width: 0px; text: "Glossary"; font-size: 12px; font-weight: 700; color: PopupBridge.css-text-color; }
        DictionaryText { horizontal-stretch: 1; width: 0px; text: "Reading"; font-size: 12px; font-weight: 700; color: PopupBridge.css-text-color; }
        DictionaryText { horizontal-stretch: 1; width: 0px; text: "Statistics"; font-size: 12px; font-weight: 700; color: PopupBridge.css-text-color; }
    }

    Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }

    HorizontalLayout {
        width: parent.width;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            width: 0px;
            spacing: 2px;
            alignment: start;
            for meaning[m-idx] in root.detail.meanings : DictionaryText {
                width: parent.width;
                text: (m-idx + 1) + ". " + meaning;
                font-size: 13px;
                color: root.selected ? PopupBridge.css-text-color : PopupBridge.css-muted-color;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            width: 0px;
            spacing: 2px;
            alignment: start;
            for r-line in root.detail.readings : DictionaryText {
                width: parent.width;
                text: r-line;
                font-size: 13px;
                color: PopupBridge.css-text-color;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            width: 0px;
            spacing: 3px;
            alignment: start;
            for stat in root.detail.stats : HorizontalLayout {
                width: parent.width;
                spacing: 4px;
                DictionaryText {
                    horizontal-stretch: 1;
                    text: stat.label;
                    font-size: 11px;
                    font-weight: 700;
                    color: PopupBridge.css-muted-color;
                    wrap: word-wrap;
                }
                DictionaryText {
                    text: stat.value;
                    font-size: 11px;
                    color: PopupBridge.css-freq-color;
                }
            }
        }
    }

    if PopupBridge.css-show-kanji-extra && root.detail.classifications.length > 0 : VerticalLayout {
        spacing: 3px;
        Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }
        DictionaryText { text: "Classifications"; font-size: 11px; font-weight: 700; color: PopupBridge.css-text-color; }
        for item in root.detail.classifications : HorizontalLayout {
            spacing: 6px;
            DictionaryText { horizontal-stretch: 1; text: item.label; font-size: 11px; font-weight: 600; color: PopupBridge.css-muted-color; wrap: word-wrap; }
            DictionaryText { text: item.value; font-size: 11px; color: PopupBridge.css-text-color; }
        }
    }

    if PopupBridge.css-show-kanji-extra && root.detail.codepoints.length > 0 : VerticalLayout {
        spacing: 3px;
        Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }
        DictionaryText { text: "Codepoints"; font-size: 11px; font-weight: 700; color: PopupBridge.css-text-color; }
        for item in root.detail.codepoints : HorizontalLayout {
            spacing: 6px;
            DictionaryText { horizontal-stretch: 1; text: item.label; font-size: 11px; font-weight: 600; color: PopupBridge.css-muted-color; wrap: word-wrap; }
            DictionaryText { text: item.value; font-size: 11px; color: PopupBridge.css-text-color; }
        }
    }

    if PopupBridge.css-show-kanji-extra && root.detail.indices.length > 0 : VerticalLayout {
        spacing: 3px;
        Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }
        DictionaryText { text: "Dictionary Indices"; font-size: 11px; font-weight: 700; color: PopupBridge.css-text-color; }
        for item in root.detail.indices : HorizontalLayout {
            spacing: 6px;
            DictionaryText { horizontal-stretch: 1; text: item.label; font-size: 11px; font-weight: 600; color: PopupBridge.css-muted-color; wrap: word-wrap; }
            DictionaryText { text: item.value; font-size: 11px; color: PopupBridge.css-text-color; }
        }
    }
}

// ── Floating Tooltip Overlay ────────────────────────────────────────────────
export component FloatingTooltip inherits Rectangle {
    in property <length> container-width: 480px;
    in property <length> container-height: 500px;
    in property <length> offset-x: 0px;
    in property <length> offset-y: 0px;

    property <length> tip-w: min(max(24px, root.container-width - 16px), tip-label.preferred-width + 16px);
    property <length> tip-h: tip-label.preferred-height + 10px;
    property <length> local-tip-x: PopupBridge.tooltip-x * 1px - root.offset-x;
    property <length> local-tip-y: PopupBridge.tooltip-y * 1px - root.offset-y;

    x: max(8px, min(root.container-width - self.tip-w - 8px, self.local-tip-x));
    y: max(8px, min(root.container-height - self.tip-h - 8px, self.local-tip-y - self.tip-h - 6px));
    width: self.tip-w;
    height: self.tip-h;
    background: SubomiPalette.tooltip-bg;
    border-width: 1px;
    border-color: SubomiPalette.border-light;
    border-radius: 5px;
    drop-shadow-blur: 12px;
    drop-shadow-color: SubomiPalette.shadow;

    tip-label := DictionaryText {
        x: 8px;
        y: 5px;
        width: parent.width - 16px;
        text: PopupBridge.tooltip-text;
        font-size: 12px;
        color: SubomiPalette.tooltip-text;
        wrap: word-wrap;
    }
}

// ── Floating Audio Source Picker Menu (with per-source availability status) ─
export component AudioSourceMenu inherits Rectangle {
    in property <length> menu-x: 210px;
    in property <length> menu-y: 62px;
    in property <[PopupAudioSource]> audio-sources;
    // Parallel status codes: 0 = unknown, 1 = available, 2 = failed/unavailable, 3 = checking
    in property <[int]> audio-source-statuses: PopupBridge.audio-source-statuses;
    in property <bool> loading: false;
    in property <int> selected-source: -1;
    in property <string> header-title: "";
    in property <bool> allow-no-audio: false;
    callback dismissed();
    callback source-picked(int);

    background: transparent;

    // Scrim catches outside clicks to close menu
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.dismissed(); }
    }

    Rectangle {
        x: max(8px, min(parent.width - self.width - 8px, root.menu-x));
        y: max(36px, min(parent.height - self.height - 8px, root.menu-y));
        width: min(252px, max(172px, parent.width - 16px));
        height: min(source-items.preferred-height + 12px, max(60px, parent.height - 75px));
        background: SubomiPalette.surface-elevated;
        border-width: 1px;
        border-color: SubomiPalette.border-light;
        border-radius: 7px;
        drop-shadow-blur: 16px;
        drop-shadow-color: SubomiPalette.shadow;
        clip: true;

        ScrollView {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;

            source-items := VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width - 6px;
                height: self.preferred-height;
                alignment: start;
                spacing: 2px;

                if root.header-title != "" : VerticalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: parent.width;
                        height: 22px;
                        DictionaryText {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: root.header-title;
                            font-size: 11px;
                            font-weight: 700;
                            color: SubomiPalette.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Rectangle { height: 1px; background: SubomiPalette.border; }
                }

                if root.loading : Rectangle {
                    width: parent.width;
                    height: 28px;
                    DictionaryText {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: "Loading recordings…";
                        font-size: 12px;
                        color: SubomiPalette.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if !root.loading && root.audio-sources.length == 0 : Rectangle {
                    width: parent.width;
                    height: 30px;
                    DictionaryText {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: "No audio sources available";
                        font-size: 12px;
                        color: SubomiPalette.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                for source[s-idx] in root.audio-sources : src-row := Rectangle {
                    property <int> status: s-idx < root.audio-source-statuses.length
                        ? root.audio-source-statuses[s-idx]
                        : 0;
                    property <bool> is-failed: self.status == 2;
                    property <bool> is-available: self.status == 1;
                    width: parent.width;
                    height: 30px;
                    border-radius: 4px;
                    opacity: self.is-failed ? 0.6 : 1.0;
                    background: source-touch.has-hover
                        ? SubomiPalette.hover-bg
                        : (root.selected-source == source.index ? SubomiPalette.accent-subtle : transparent);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: start;

                        DictionaryText {
                            width: 12px;
                            text: root.selected-source == source.index ? "✓" : "";
                            font-size: 11px;
                            font-weight: 700;
                            color: SubomiPalette.cyan-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 14px;
                                height: 14px;
                                source: src-row.is-failed
                                    ? @image-url("../icons/volume-off.svg")
                                    : @image-url("../icons/volume-on.svg");
                                colorize: src-row.is-failed
                                    ? SubomiPalette.danger-text
                                    : (src-row.is-available
                                        ? SubomiPalette.success
                                        : SubomiPalette.icon-muted);
                            }
                        }

                        DictionaryText {
                            horizontal-stretch: 1;
                            text: source.name;
                            font-size: 12px;
                            font-weight: root.selected-source == source.index ? 700 : 400;
                            color: src-row.is-failed
                                ? SubomiPalette.text-muted
                                : (root.selected-source == source.index ? SubomiPalette.cyan-text : SubomiPalette.text);
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if src-row.status == 3 : DictionaryText {
                            text: "…";
                            font-size: 11px;
                            color: SubomiPalette.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    source-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.source-picked(source.index); }
                    }
                }

                if root.allow-no-audio : VerticalLayout {
                    spacing: 2px;
                    Rectangle { height: 1px; background: SubomiPalette.border; }
                    Rectangle {
                        width: parent.width;
                        height: 28px;
                        border-radius: 4px;
                        background: no-aud-touch.has-hover ? SubomiPalette.hover-bg : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: start;
                            Rectangle { width: 12px; background: transparent; }
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 14px;
                                    height: 14px;
                                    source: @image-url("../icons/volume-off.svg");
                                    colorize: SubomiPalette.icon-muted;
                                }
                            }
                            DictionaryText {
                                horizontal-stretch: 1;
                                text: "Add without audio";
                                font-size: 12px;
                                color: SubomiPalette.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        no-aud-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.source-picked(-2); }
                        }
                    }
                }
            }
        }
    }
}
