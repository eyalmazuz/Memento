import { ScrollView } from "std-widgets.slint";
import { MementoPalette } from "../palette.slint";
import {
    DictResult,
    PopupAudioSource,
    RichDerivationStep,
    RichPitchGraph,
    DictionaryText,
    PopupBridge,
} from "types.slint";
import {
    AnkiAddButton,
    AnkiTagRow,
    AudioSourceMenu,
    FloatingTooltip,
    FrequencyBadgeList,
    PitchGraphList,
    PopupActionButton,
    PopupKeyHandler,
    TermDerivationRow,
    TermHeadwordBlock,
    TermLeadingActions,
    TermTagPillRow,
} from "term_widgets.slint";
import { DefinitionCardGrid, DefinitionEntryBody } from "definition_body.slint";

component LeadingActionsBox inherits Rectangle {
    in property <DictResult> res;
    in property <length> spacing: 6px;
    in property <bool> show-kana: false;
    in property <bool> show-browse: false;
    in property <length> btn-size: 28px;
    in property <length> icon-size: 16px;
    callback kana-clicked();
    callback kanji-clicked();
    callback audio-clicked();
    callback audio-right-clicked(length);
    callback browse-clicked();
    callback request-tooltip(string, length);

    horizontal-stretch: 0;
    width: inner.preferred-width;
    height: inner.preferred-height;
    background: transparent;

    inner := TermLeadingActions {
        width: parent.width;
        height: parent.height;
        res: root.res;
        spacing: root.spacing;
        btn-size: root.btn-size;
        icon-size: root.icon-size;
        show-kana: root.show-kana;
        show-browse: root.show-browse;
        kana-clicked => { root.kana-clicked(); }
        kanji-clicked => { root.kanji-clicked(); }
        audio-clicked => { root.audio-clicked(); }
        audio-right-clicked(x) => { root.audio-right-clicked(x); }
        browse-clicked => { root.browse-clicked(); }
        request-tooltip(tip, off) => { root.request-tooltip(tip, off); }
    }
}

// ── Yomitan-Style Floating Recursive Child Popup (depth 1..=N) ───────────────
// Mounted directly in the player viewport right after `YomitanPopup` so child popups
// float freely at full popup size, overlapping or extending beyond the parent card.
export component NestedYomitanPopup inherits Rectangle {
    in property <bool> is-open: false;
    in property <length> viewport-width: 1280px;
    in property <length> viewport-height: 720px;
    in property <length> parent-x: 0px;
    in property <length> parent-y: 0px;
    in property <length> configured-width: 480px;
    in property <length> configured-height: 500px;
    in property <bool> anki-enabled: false;
    in property <bool> show-anki-checkbox: true;
    in property <string> added-note-id: "";
    in property <int> added-result-index: -1;
    in property <[PopupAudioSource]> audio-sources;
    in property <bool> audio-sources-loading: false;
    in-out property <int> selected-audio-source: -1;
    in-out property <bool> audio-menu-open: false;
    in-out property <string> audio-menu-expression: "";
    in-out property <string> audio-menu-reading: "";
    in-out property <length> audio-menu-x: 210px;
    in-out property <length> audio-menu-y: 62px;
    callback browse-anki-note(string);
    callback play-audio(string, string);
    callback request-audio-sources(string, string);
    callback select-audio-source(int);
    callback open-rich-link(string);
    callback close-parent-requested();

    property <length> desired-w: PopupBridge.css-popup-width > 0px
        ? PopupBridge.css-popup-width
        : root.configured-width;
    property <length> desired-h: PopupBridge.css-popup-height > 0px
        ? PopupBridge.css-popup-height
        : root.configured-height;
    property <length> anchor-vx: root.parent-x + PopupBridge.nested-anchor-x * 1px;
    property <length> anchor-vy: root.parent-y + PopupBridge.nested-anchor-y * 1px;

    // Viewport-floating geometry (full configured width/height, flipped above/below the scanned line
    // so the highlighted word in the parent popup remains visible).
    property <length> float-w: max(240px, min(self.desired-w, max(240px, root.viewport-width - 24px)));
    property <length> float-max-h: max(180px, min(self.desired-h, max(180px, root.viewport-height - 24px)));
    property <length> space-below: max(0px, root.viewport-height - (self.anchor-vy + 22px) - 12px);
    property <length> space-above: max(0px, (self.anchor-vy - 18px) - 12px);
    property <bool> float-place-above: self.space-below < self.float-max-h && self.space-above > self.space-below;
    property <length> float-h: min(
        self.float-max-h,
        max(160px, self.float-place-above ? self.space-above : self.space-below)
    );

    property <length> card-w: round(self.float-w / 1px) * 1px;
    property <length> card-h: round(self.float-h / 1px) * 1px;
    property <bool> use-two-columns: PopupBridge.rich-enabled
        && PopupBridge.css-definition-columns >= 2
        && self.width >= PopupBridge.css-definition-columns-min-width;
    property <length> card-pad: PopupBridge.css-popup-padding;
    property <length> action-btn-size: 28px;
    property <int> nav-rev: PopupBridge.nested-nav-revision;

    visible: root.is-open
        && PopupBridge.rich-enabled
        && PopupBridge.nested-depth > 0
        && PopupBridge.nested-results.length > 0;
    x: round(max(12px, min(root.viewport-width - self.card-w - 12px, self.anchor-vx - self.card-w * 0.25)) / 1px) * 1px;
    y: round((self.float-place-above
        ? max(12px, self.anchor-vy - self.card-h - 18px)
        : max(12px, min(root.viewport-height - self.card-h - 12px, self.anchor-vy + 22px))) / 1px) * 1px;
    width: self.card-w;
    height: self.card-h;
    background: PopupBridge.css-popup-bg;
    border-width: max(1.5px, PopupBridge.css-popup-border-width);
    border-color: PopupBridge.nested-locked ? MementoPalette.cyan-accent : MementoPalette.text-muted;
    border-radius: PopupBridge.css-popup-radius;
    drop-shadow-blur: max(18px, PopupBridge.css-popup-shadow-blur);
    drop-shadow-color: PopupBridge.css-popup-shadow-color;
    clip: true;

    changed nav-rev => {
        nested-definition-list.viewport-y = 0px;
        root.audio-menu-open = false;
    }
    changed is-open => {
        if !root.is-open {
            root.audio-menu-open = false;
        }
    }

    nested-focus := PopupKeyHandler {
        close-requested => { root.close-parent-requested(); }
    }

    // Catch clicks & track hover on nested card surface
    nested-card-touch := TouchArea {
        width: 100%;
        height: 100%;
        changed has-hover => {
            PopupBridge.nested-popup-hover-changed(self.has-hover);
            if self.has-hover && !nested-focus.has-focus {
                nested-focus.focus();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if !nested-focus.has-focus {
                    nested-focus.focus();
                }
                PopupBridge.lock-nested-popup();
            }
        }
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding: root.card-pad;
        spacing: 4px;

        // Nested popup header: Back button, depth indicator, breadcrumb, Close-All button
        HorizontalLayout {
            height: 26px;
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: nested-back-row.preferred-width;
                    height: 24px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: nested-back-touch.has-hover ? MementoPalette.border-light : MementoPalette.border;
                    background: nested-back-touch.pressed
                        ? MementoPalette.button-pressed
                        : (nested-back-touch.has-hover ? MementoPalette.button-hover : MementoPalette.button-bg);
                    animate background { duration: 100ms; }
                    animate border-color { duration: 100ms; }

                    nested-back-row := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 13px;
                                height: 13px;
                                source: @image-url("../icons/arrow-back.svg");
                                colorize: MementoPalette.icon;
                            }
                        }

                        DictionaryText {
                            text: "Back";
                            font-size: 11px;
                            font-weight: 700;
                            color: MementoPalette.text;
                            vertical-alignment: center;
                        }
                    }

                    nested-back-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { PopupBridge.pop-nested-popup(); }
                        changed has-hover => {
                            if self.has-hover {
                                PopupBridge.show-tooltip(
                                    "Back to previous level (Esc)",
                                    (root.x - root.parent-x + root.card-pad) / 1px,
                                    (root.y - root.parent-y + root.card-pad + 60px) / 1px
                                );
                            } else {
                                PopupBridge.hide-tooltip();
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: depth-badge-lbl.preferred-width + 10px;
                    height: 20px;
                    border-radius: 4px;
                    background: PopupBridge.nested-locked ? MementoPalette.accent-muted : MementoPalette.card-bg;
                    border-width: 1px;
                    border-color: PopupBridge.nested-locked ? MementoPalette.cyan-accent : MementoPalette.border-light;
                    depth-badge-lbl := DictionaryText {
                        x: 5px;
                        height: parent.height;
                        text: PopupBridge.nested-depth + "/" + PopupBridge.nested-max-depth;
                        font-size: 10px;
                        font-weight: 700;
                        color: PopupBridge.nested-locked ? MementoPalette.cyan-text : MementoPalette.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

            DictionaryText {
                text: PopupBridge.nested-breadcrumb;
                font-size: 11px;
                color: PopupBridge.css-muted-color;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                PopupActionButton {
                    btn-width: 24px;
                    btn-height: 24px;
                    has-icon: true;
                    icon: @image-url("../icons/close.svg");
                    icon-size: 13px;
                    bg-normal: MementoPalette.button-bg;
                    bg-hover: MementoPalette.danger-bg;
                    bg-pressed: MementoPalette.danger-pressed;
                    border-normal: MementoPalette.border;
                    border-hover: MementoPalette.danger;
                    fg-color: MementoPalette.icon-muted;
                    fg-hover-color: MementoPalette.danger-text;
                    tooltip: "Close all nested popups";
                    clicked => { PopupBridge.dismiss-all-nested-popups(); }
                    request-tooltip(tip) => {
                        PopupBridge.show-tooltip(
                            tip,
                            (root.x - root.parent-x + root.width - 170px) / 1px,
                            (root.y - root.parent-y + root.card-pad + 60px) / 1px
                        );
                    }
                }
            }
        }

        Rectangle {
            width: parent.width;
            height: 1px;
            background: PopupBridge.css-divider-color;
        }

        nested-definition-list := ScrollView {
            vertical-stretch: 1;
            changed viewport-y => {
                PopupBridge.hide-tooltip();
                if self.viewport-y < -1px {
                    PopupBridge.lock-nested-popup();
                }
            }
            nested-definition-content := VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                spacing: 0px;

                for nres[nidx] in PopupBridge.nested-results : nested-row-wrapper := Rectangle {
                    property <bool> nhidden-by-grid: root.use-two-columns && !nres.term-start;
                    property <bool> nrow-hidden: self.nhidden-by-grid || (nres.collapsed && !nres.term-start);
                    width: parent.width - 6px;
                    height: self.nrow-hidden ? 0px : nested-term-segment.height + ((nres.term-end || root.use-two-columns || (nres.collapsed && nres.term-start)) ? 8px : 0px);
                    visible: !self.nrow-hidden;
                    background: transparent;

                    nested-term-segment := Rectangle {
                        property <int> nrow-zero-idx: nres.index - 1;
                        property <bool> nadded-this-row: PopupBridge.last-added-was-nested && root.added-note-id != "" && root.added-result-index == self.nrow-zero-idx;
                        property <bool> nrow-is-duplicate:
                            (PopupBridge.nested-revision >= 0)
                            && self.nrow-zero-idx >= 0
                            && self.nrow-zero-idx < PopupBridge.nested-row-anki-duplicates.length
                            && PopupBridge.nested-row-anki-duplicates[self.nrow-zero-idx];
                        property <int> nrow-anki-note-id:
                            (PopupBridge.nested-revision >= 0)
                            && self.nrow-zero-idx >= 0
                            && self.nrow-zero-idx < PopupBridge.nested-row-anki-note-ids.length
                                ? PopupBridge.nested-row-anki-note-ids[self.nrow-zero-idx]
                                : 0;
                        property <string> nrow-browse-query:
                            self.nadded-this-row
                                ? root.added-note-id
                                : ((self.nrow-zero-idx >= 0 && self.nrow-zero-idx < PopupBridge.nested-row-anki-browse-queries.length)
                                    ? PopupBridge.nested-row-anki-browse-queries[self.nrow-zero-idx]
                                    : "");
                        property <string> nrow-raw-anki-tags:
                            (PopupBridge.nested-revision >= 0)
                            && self.nrow-zero-idx >= 0
                            && self.nrow-zero-idx < PopupBridge.nested-row-anki-tags.length
                                ? PopupBridge.nested-row-anki-tags[self.nrow-zero-idx]
                                : "";
                        property <bool> nshow-browse-btn: self.nadded-this-row || (root.anki-enabled && self.nrow-is-duplicate);
                        property <bool> nshow-update-btn: root.anki-enabled && self.nrow-is-duplicate && self.nrow-anki-note-id > 0;
                        property <color> nterm-headword-color: PopupBridge.nested-headword-pitch-color(
                            PopupBridge.nested-depth,
                            nres.index,
                            PopupBridge.nested-revision
                        );
                        property <[RichPitchGraph]> cached-rich-pitches: (!nres.collapsed && nres.term-start)
                            ? PopupBridge.nested-rich-pitch-graphs(PopupBridge.nested-depth, nres.index, PopupBridge.nested-revision)
                            : [];
                        property <[RichDerivationStep]> cached-deriv-steps: (nres.term-start && !nres.is-kanji && PopupBridge.rich-enabled && !PopupBridge.css-compact-derivations)
                            ? PopupBridge.nested-derivation-steps(PopupBridge.nested-depth, nres.index, PopupBridge.nested-revision)
                            : [];
                        property <string> cached-deriv-summary: (nres.term-start && !nres.is-kanji && PopupBridge.rich-enabled && PopupBridge.css-compact-derivations)
                            ? PopupBridge.nested-derivation-summary(PopupBridge.nested-depth, nres.index, PopupBridge.nested-revision)
                            : "";

                        width: parent.width;
                        height: nested-row-wrapper.nrow-hidden ? 0px : nested-card-content.preferred-height + 8px;
                        background: transparent;
                        Rectangle {
                            visible: !nested-row-wrapper.nrow-hidden && nres.term-start && nres.index > 1;
                            y: 0px;
                            height: 2px;
                            width: parent.width;
                            background: PopupBridge.css-term-divider-color;
                        }
                        Rectangle {
                            visible: !nested-row-wrapper.nrow-hidden && !nres.term-end && !nres.collapsed && !root.use-two-columns;
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: PopupBridge.css-divider-color;
                        }

                        nested-card-content := VerticalLayout {
                            x: 0px;
                            y: 4px;
                            width: parent.width;
                            height: self.preferred-height;
                            spacing: 4px;

                            if nres.term-start : nterm-header := HorizontalLayout {
                                width: parent.width;
                                spacing: 5px;
                                min-height: root.action-btn-size + 4px;
                                property <length> nbuttons-w:
                                    (!nres.is-kanji && nres.reading != "" && nres.reading != nres.expression ? 39px : 0px)
                                    + (!nres.is-kanji && nres.has-kanji ? (root.action-btn-size + 5px) : 0px)
                                    + (!nres.is-kanji ? (root.action-btn-size + 5px) : 0px)
                                    + (nested-term-segment.nshow-browse-btn || root.anki-enabled ? (root.action-btn-size + 5px) : 0px)
                                    + (nested-term-segment.nshow-update-btn ? (root.action-btn-size + 5px) : 0px)
                                    + (root.action-btn-size + 5px);
                                property <length> navail-title-w: max(84px, nested-card-content.width - self.nbuttons-w);

                                TermHeadwordBlock {
                                    res: nres;
                                    nested: true;
                                    compact: false;
                                    scan-depth: PopupBridge.nested-depth;
                                    bridge-rev: PopupBridge.nested-revision;
                                    avail-width: nterm-header.navail-title-w;
                                    headword-color: nested-term-segment.nterm-headword-color;
                                    kanji-clicked(ch) => {
                                        PopupBridge.lock-nested-popup();
                                        PopupBridge.nested-lookup-kanji-char(PopupBridge.nested-depth, nres.expression, ch);
                                    }
                                }

                                nheader-actions := VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 5px;
                                        alignment: end;

                                        if !nres.is-kanji || nested-term-segment.nshow-browse-btn : nleading-actions := LeadingActionsBox {
                                            res: nres;
                                            spacing: 5px;
                                            btn-size: root.action-btn-size;
                                            icon-size: 15px;
                                            show-kana: !nres.is-kanji && nres.reading != "" && nres.reading != nres.expression;
                                            show-browse: nested-term-segment.nshow-browse-btn;
                                            kana-clicked => {
                                                PopupBridge.toggle-kana-reading-search(nres.expression, nres.reading);
                                            }
                                            kanji-clicked => {
                                                PopupBridge.lock-nested-popup();
                                                PopupBridge.nested-lookup-kanji-char(PopupBridge.nested-depth, nres.expression, "");
                                            }
                                            audio-clicked => {
                                                PopupBridge.lock-nested-popup();
                                                if (!root.audio-menu-open) { root.play-audio(nres.expression, nres.reading); }
                                            }
                                            audio-right-clicked(offset-x) => {
                                                PopupBridge.lock-nested-popup();
                                                root.audio-menu-expression = nres.expression;
                                                root.audio-menu-reading = nres.reading;
                                                root.audio-menu-x = max(8px, min(root.width - 244px, root.card-pad + nheader-actions.x + nleading-actions.x + offset-x - 190px));
                                                root.audio-menu-y = max(36px, min(root.height - 140px, nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 38px));
                                                root.audio-menu-open = true;
                                                root.request-audio-sources(nres.expression, nres.reading);
                                            }
                                            browse-clicked => {
                                                PopupBridge.lock-nested-popup();
                                                if (nested-term-segment.nrow-browse-query != "") {
                                                    root.browse-anki-note(nested-term-segment.nrow-browse-query);
                                                }
                                            }
                                            request-tooltip(tip, right-offset) => {
                                                PopupBridge.show-tooltip(
                                                    tip,
                                                    (root.x - root.parent-x + root.width - right-offset) / 1px,
                                                    (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 38px) / 1px
                                                );
                                            }
                                        }

                                        if nested-term-segment.nshow-update-btn : PopupActionButton {
                                            btn-width: root.action-btn-size;
                                            btn-height: root.action-btn-size;
                                            label: "↻";
                                            label-font-size: 15px;
                                            bg-normal: MementoPalette.warning-bg;
                                            bg-hover: #644010;
                                            bg-pressed: MementoPalette.warning-bg;
                                            border-normal: MementoPalette.warning-border;
                                            border-hover: MementoPalette.warning;
                                            fg-color: MementoPalette.warning-text;
                                            fg-hover-color: #FEF3C7;
                                            tooltip: "Update existing Anki note";
                                            clicked => {
                                                PopupBridge.lock-nested-popup();
                                                PopupBridge.update-anki-note-requested(
                                                    nested-term-segment.nrow-zero-idx,
                                                    nested-term-segment.nrow-anki-note-id,
                                                    nres.expression,
                                                    nres.reading,
                                                    nres.glossary
                                                );
                                            }
                                            request-tooltip(tip) => {
                                                PopupBridge.show-tooltip(
                                                    tip,
                                                    (root.x - root.parent-x + root.width - 180px) / 1px,
                                                    (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 38px) / 1px
                                                );
                                            }
                                        }

                                        if root.anki-enabled && !nested-term-segment.nshow-browse-btn : AnkiAddButton {
                                            btn-size: root.action-btn-size;
                                            clicked => {
                                                PopupBridge.lock-nested-popup();
                                                PopupBridge.nested-add-anki-note(nres.index - 1);
                                            }
                                            request-tooltip(tip) => {
                                                PopupBridge.show-tooltip(
                                                    tip,
                                                    (root.x - root.parent-x + root.width - 120px) / 1px,
                                                    (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 38px) / 1px
                                                );
                                            }
                                        }

                                        PopupActionButton {
                                            btn-width: root.action-btn-size;
                                            btn-height: root.action-btn-size;
                                            has-icon: true;
                                            icon: nres.collapsed
                                                ? @image-url("../icons/arrow-drop-down.svg")
                                                : @image-url("../icons/arrow-drop-up.svg");
                                            icon-size: 18px;
                                            tooltip: nres.collapsed ? "Expand term" : "Collapse term";
                                            clicked => {
                                                PopupBridge.lock-nested-popup();
                                                PopupBridge.nested-toggle-term-collapse(PopupBridge.nested-depth, nres.index - 1);
                                            }
                                            request-tooltip(tip) => {
                                                PopupBridge.show-tooltip(
                                                    tip,
                                                    (root.x - root.parent-x + root.width - 120px) / 1px,
                                                    (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 38px) / 1px
                                                );
                                            }
                                        }
                                    }
                                }
                            }

                            if nres.term-start && (nested-term-segment.cached-deriv-steps.length > 0 || nested-term-segment.cached-deriv-summary != "") : TermDerivationRow {
                                steps: nested-term-segment.cached-deriv-steps;
                                compact-summary: nested-term-segment.cached-deriv-summary;
                                request-tooltip(tip) => {
                                    PopupBridge.show-tooltip(
                                        tip,
                                        (root.x - root.parent-x + 20px) / 1px,
                                        (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 44px) / 1px
                                    );
                                }
                            }

                            if !nres.collapsed && nres.term-start && PopupBridge.css-show-term-tags : TermTagPillRow {
                                res-index: nres.index;
                                scan-depth: PopupBridge.nested-depth;
                                bridge-rev: PopupBridge.nested-revision;
                                request-tooltip(notes) => {
                                    PopupBridge.show-tooltip(
                                        notes,
                                        (root.x - root.parent-x + 16px) / 1px,
                                        (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 44px) / 1px
                                    );
                                }
                            }

                            if !nres.collapsed && nres.term-start && PopupBridge.anki-show-tags && nested-term-segment.nrow-raw-anki-tags != "" : AnkiTagRow {
                                raw-tags: nested-term-segment.nrow-raw-anki-tags;
                                request-tooltip(tip) => {
                                    PopupBridge.show-tooltip(
                                        tip,
                                        (root.x - root.parent-x + 16px) / 1px,
                                        (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 44px) / 1px
                                    );
                                }
                            }

                            if !nres.collapsed && nres.term-start && nres.frequencies.length > 0 : FrequencyBadgeList {
                                width: parent.width;
                                res: nres;
                            }

                            if !nres.collapsed && nres.term-start && nested-term-segment.cached-rich-pitches.length > 0 : PitchGraphList {
                                width: parent.width;
                                rich-pitches: nested-term-segment.cached-rich-pitches;
                                fallback-pitches: [];
                                allow-fallback: false;
                                compact: true;
                                request-tooltip(tip) => {
                                    PopupBridge.show-tooltip(
                                        tip,
                                        (root.x - root.parent-x + 24px) / 1px,
                                        (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 64px) / 1px
                                    );
                                }
                            }

                            // Single-column definition body inside nested popup
                            if !nres.collapsed && !root.use-two-columns : DefinitionEntryBody {
                                width: parent.width;
                                res: nres;
                                scan-depth: PopupBridge.nested-depth;
                                bridge-rev: PopupBridge.nested-revision;
                                is-solo: nres.term-start && nres.term-end;
                                show-anki-checkbox: root.show-anki-checkbox;
                                tooltip-base-x: round(root.card-pad / 1px) * 1px;
                                content-base-y: nested-row-wrapper.y + 4px + self.y;
                                scan-offset-x: root.x - root.parent-x;
                                scan-offset-y: root.y - root.parent-y;
                                read-scroll-y => { nested-definition-list.y + nested-definition-list.viewport-y }
                                toggle-select-definition(i) => { PopupBridge.nested-toggle-select-definition(PopupBridge.nested-depth, i); }
                                open-rich-link(href) => { root.open-rich-link(href); }
                                focus-glossary => {
                                    if !nested-focus.has-focus {
                                        nested-focus.focus();
                                    }
                                }
                            }

                            // 2-column card grid inside full-size Yomitan-style nested popup
                            if !nres.collapsed && nres.term-start && root.use-two-columns : DefinitionCardGrid {
                                width: parent.width;
                                all-results: PopupBridge.nested-results;
                                term-start-index: nres.index;
                                scan-depth: PopupBridge.nested-depth;
                                bridge-rev: PopupBridge.nested-revision;
                                show-anki-checkbox: root.show-anki-checkbox;
                                base-x: root.card-pad;
                                content-base-y: nested-row-wrapper.y + 4px + self.y;
                                scan-offset-x: root.x - root.parent-x;
                                scan-offset-y: root.y - root.parent-y;
                                read-scroll-y => { nested-definition-list.y + nested-definition-list.viewport-y }
                                toggle-select-definition(i) => { PopupBridge.nested-toggle-select-definition(PopupBridge.nested-depth, i); }
                                open-rich-link(href) => { root.open-rich-link(href); }
                                focus-glossary => {
                                    if !nested-focus.has-focus {
                                        nested-focus.focus();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Floating Tooltip Overlay inside NestedYomitanPopup
    if PopupBridge.tooltip-visible && PopupBridge.tooltip-text != "" && PopupBridge.nested-depth > 0 : FloatingTooltip {
        container-width: root.width;
        container-height: root.height;
        offset-x: root.x - root.parent-x;
        offset-y: root.y - root.parent-y;
    }

    if root.audio-menu-open : AudioSourceMenu {
        width: parent.width;
        height: parent.height;
        menu-x: root.audio-menu-x;
        menu-y: root.audio-menu-y;
        audio-sources: root.audio-sources;
        loading: root.audio-sources-loading;
        selected-source: root.selected-audio-source;
        dismissed => { root.audio-menu-open = false; }
        source-picked(idx) => {
            root.select-audio-source(idx);
            root.audio-menu-open = false;
            root.play-audio(root.audio-menu-expression, root.audio-menu-reading);
        }
    }
}

// ── Root Floating Yomitan Dictionary Card ───────────────────────────────────
// Note: Root YomitanPopup intentionally has NO X close button (Escape / outside click dismiss).
export component YomitanPopup inherits Rectangle {
    in property <string> headword: "";
    in property <string> reading: "";
    in property <string> pitch-accent: "";
    in property <string> freq-rank: "";
    in property <string> jpdb-rank: "";
    in property <[DictResult]> results;
    in property <bool> has-more-results: false;
    in property <[PopupAudioSource]> audio-sources;
    in property <bool> audio-sources-loading: false;
    in-out property <int> selected-audio-source: -1;
    in-out property <bool> audio-menu-open: false;
    in-out property <string> audio-menu-expression: "";
    in-out property <string> audio-menu-reading: "";
    in-out property <length> audio-menu-x: 210px;
    in-out property <length> audio-menu-y: 62px;
    in property <bool> is-open: false;
    in property <bool> anki-enabled: false;
    in property <bool> show-anki-checkbox: true;
    in property <string> added-note-id: "";
    in property <int> added-result-index: -1;
    in property <bool> render-nested-inline: false;
    callback close-requested();
    callback add-anki-note(int);
    callback browse-anki-note(string);
    callback play-audio(string, string);
    callback request-audio-sources(string, string);
    callback kanji-info(string);
    callback toggle-select-definition(int);
    callback toggle-term-collapse(int);
    callback select-audio-source(int);
    callback open-rich-link(string);
    callback reset-scroll();
    callback load-more-results(bool);
    out property <bool> needs-more: root.is-open && root.has-more-results
        && definition-list.height > 0px
        && definition-list.viewport-height + definition-list.viewport-y <= definition-list.height + 180px;
    property <bool> use-two-columns: PopupBridge.rich-enabled
        && PopupBridge.css-definition-columns >= 2
        && root.width >= PopupBridge.css-definition-columns-min-width;
    property <int> watched-nested-depth: PopupBridge.nested-depth;

    visible: root.is-open && root.results.length > 0;
    width: 480px;
    height: 500px;
    background: PopupBridge.css-popup-bg;
    border-width: PopupBridge.css-popup-border-width;
    border-color: PopupBridge.css-popup-border;
    border-radius: PopupBridge.css-popup-radius;
    drop-shadow-blur: PopupBridge.css-popup-shadow-blur;
    drop-shadow-color: PopupBridge.css-popup-shadow-color;

    changed watched-nested-depth => {
        if root.is-open && !glossary-focus.has-focus {
            glossary-focus.focus();
        }
    }
    changed is-open => {
        root.audio-menu-open = false;
        PopupBridge.hide-tooltip();
        if root.is-open {
            definition-list.viewport-y = 0px;
            definition-list.fill-viewport();
        } else {
            PopupBridge.dismiss-all-nested-popups();
        }
    }
    reset-scroll => {
        definition-list.viewport-y = 0px;
        root.audio-menu-open = false;
        PopupBridge.hide-tooltip();
    }

    // Keep clicks on the card's padding from reaching the video underneath.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && PopupBridge.nested-depth > 0) {
                PopupBridge.dismiss-all-nested-popups();
            }
        }
    }

    glossary-focus := PopupKeyHandler {
        close-requested => { root.close-requested(); }
    }

    popup-content := VerticalLayout {
        padding: PopupBridge.css-popup-padding;
        spacing: 4px;

        // Back / Forward Navigation History Bar (shown when internal navigation occurred)
        if PopupBridge.rich-enabled && (PopupBridge.can-go-back || PopupBridge.can-go-forward) : HorizontalLayout {
            height: 26px;
            spacing: 4px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                PopupActionButton {
                    btn-width: 26px;
                    btn-height: 24px;
                    has-icon: true;
                    icon: @image-url("../icons/arrow-back.svg");
                    icon-size: 14px;
                    enabled: PopupBridge.can-go-back;
                    tooltip: "Back";
                    clicked => { PopupBridge.nav-back(); }
                    request-tooltip(tip) => {
                        PopupBridge.show-tooltip(
                            tip,
                            (PopupBridge.css-popup-padding) / 1px,
                            (PopupBridge.css-popup-padding + 58px) / 1px
                        );
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 24px;
                    border-radius: 5px;
                    border-width: 1px;
                    opacity: PopupBridge.can-go-forward ? 1.0 : 0.45;
                    border-color: PopupBridge.can-go-forward && nav-fwd-touch.has-hover
                        ? MementoPalette.border-light
                        : MementoPalette.border;
                    background: !PopupBridge.can-go-forward
                        ? MementoPalette.button-bg
                        : (nav-fwd-touch.pressed
                            ? MementoPalette.button-pressed
                            : (nav-fwd-touch.has-hover ? MementoPalette.button-hover : MementoPalette.button-bg));
                    animate background { duration: 100ms; }
                    animate border-color { duration: 100ms; }

                    Path {
                        width: 12px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 14;
                        viewbox-height: 14;
                        stroke: PopupBridge.can-go-forward ? MementoPalette.icon : MementoPalette.text-muted;
                        stroke-width: 1.7px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        MoveTo { x: 2; y: 7; }
                        LineTo { x: 11.5; y: 7; }
                        MoveTo { x: 7.5; y: 3; }
                        LineTo { x: 11.5; y: 7; }
                        LineTo { x: 7.5; y: 11; }
                    }

                    nav-fwd-touch := TouchArea {
                        enabled: PopupBridge.can-go-forward;
                        mouse-cursor: PopupBridge.can-go-forward ? pointer : default;
                        clicked => { PopupBridge.nav-forward(); }
                        changed has-hover => {
                            if self.has-hover && PopupBridge.can-go-forward {
                                PopupBridge.show-tooltip(
                                    "Forward",
                                    (PopupBridge.css-popup-padding + 30px) / 1px,
                                    (PopupBridge.css-popup-padding + 58px) / 1px
                                );
                            } else if !self.has-hover {
                                PopupBridge.hide-tooltip();
                            }
                        }
                    }
                }
            }

            DictionaryText {
                text: PopupBridge.nav-breadcrumb;
                font-size: 11px;
                color: MementoPalette.text-secondary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // Definitions List
        definition-list := ScrollView {
            vertical-stretch: 1;
            callback fill-viewport();
            fill-viewport => {
                if root.needs-more {
                    root.load-more-results(false);
                }
            }
            changed viewport-y => { self.fill-viewport(); PopupBridge.hide-tooltip(); }
            changed viewport-height => { self.fill-viewport(); }
            changed height => { self.fill-viewport(); }
            definition-content := VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                spacing: 0px;

                for res[idx] in root.results : row-wrapper := Rectangle {
                    property <bool> hidden-by-grid: root.use-two-columns && !res.term-start;
                    property <bool> row-hidden: self.hidden-by-grid || (res.collapsed && !res.term-start);
                    width: parent.width - 6px;
                    height: self.row-hidden ? 0px : term-segment.height + ((res.term-end || root.use-two-columns || (res.collapsed && res.term-start)) ? 10px : 0px);
                    visible: !self.row-hidden;
                    background: transparent;

                    term-segment := Rectangle {
                        property <int> row-zero-idx: res.index - 1;
                        property <bool> added-this-row: !PopupBridge.last-added-was-nested && root.added-note-id != "" && root.added-result-index == self.row-zero-idx;
                        property <bool> row-is-duplicate:
                            (PopupBridge.popup-revision >= 0)
                            && self.row-zero-idx >= 0
                            && self.row-zero-idx < PopupBridge.row-anki-duplicates.length
                            && PopupBridge.row-anki-duplicates[self.row-zero-idx];
                        property <int> row-anki-note-id:
                            (PopupBridge.popup-revision >= 0)
                            && self.row-zero-idx >= 0
                            && self.row-zero-idx < PopupBridge.row-anki-note-ids.length
                                ? PopupBridge.row-anki-note-ids[self.row-zero-idx]
                                : 0;
                        property <string> row-browse-query:
                            self.added-this-row
                                ? root.added-note-id
                                : ((self.row-zero-idx >= 0 && self.row-zero-idx < PopupBridge.row-anki-browse-queries.length)
                                    ? PopupBridge.row-anki-browse-queries[self.row-zero-idx]
                                    : "");
                        property <string> row-raw-anki-tags:
                            (PopupBridge.popup-revision >= 0)
                            && self.row-zero-idx >= 0
                            && self.row-zero-idx < PopupBridge.row-anki-tags.length
                                ? PopupBridge.row-anki-tags[self.row-zero-idx]
                                : "";
                        property <bool> show-browse-btn: self.added-this-row || (root.anki-enabled && self.row-is-duplicate);
                        property <bool> show-update-btn: root.anki-enabled && self.row-is-duplicate && self.row-anki-note-id > 0;
                        property <color> term-headword-color: PopupBridge.rich-enabled
                            ? PopupBridge.headword-pitch-color(res.index, PopupBridge.rich-revision)
                            : PopupBridge.css-headword-color;
                        property <[RichPitchGraph]> cached-rich-pitches: (!res.collapsed && res.term-start && PopupBridge.rich-enabled)
                            ? PopupBridge.rich-pitch-graphs(res.index, PopupBridge.rich-revision)
                            : [];
                        property <[RichDerivationStep]> cached-deriv-steps: (res.term-start && !res.is-kanji && PopupBridge.rich-enabled && !PopupBridge.css-compact-derivations)
                            ? PopupBridge.derivation-steps(res.index, PopupBridge.rich-revision)
                            : [];
                        property <string> cached-deriv-summary: (res.term-start && !res.is-kanji && PopupBridge.rich-enabled && PopupBridge.css-compact-derivations)
                            ? PopupBridge.derivation-summary(res.index, PopupBridge.rich-revision)
                            : "";

                        width: parent.width;
                        height: row-wrapper.row-hidden ? 0px : card-content.preferred-height + 10px;
                        background: transparent;
                        Rectangle {
                            visible: !row-wrapper.row-hidden && res.term-start && res.index > 1;
                            y: 0px;
                            height: 2px;
                            width: parent.width;
                            background: PopupBridge.css-term-divider-color;
                        }
                        Rectangle {
                            visible: !row-wrapper.row-hidden && !res.term-end && !res.collapsed && !root.use-two-columns;
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: PopupBridge.css-divider-color;
                        }

                        card-content := VerticalLayout {
                            x: 0px;
                            y: 4px;
                            width: parent.width;
                            height: self.preferred-height;
                            spacing: 4px;

                            if res.term-start : term-header := HorizontalLayout {
                                width: parent.width;
                                spacing: 6px;
                                min-height: 34px;
                                property <length> buttons-reserved-w:
                                    (PopupBridge.rich-enabled && !res.is-kanji && res.reading != "" && res.reading != res.expression ? 40px : 0px)
                                    + (!res.is-kanji && res.has-kanji ? 34px : 0px)
                                    + (!res.is-kanji ? 34px : 0px)
                                    + (term-segment.show-browse-btn || root.anki-enabled ? 34px : 0px)
                                    + (term-segment.show-update-btn ? 34px : 0px)
                                    + 34px;
                                property <length> avail-title-w: max(96px, card-content.width - self.buttons-reserved-w);

                                term-title := TermHeadwordBlock {
                                    res: res;
                                    nested: false;
                                    compact: false;
                                    scan-depth: 0;
                                    bridge-rev: PopupBridge.rich-revision;
                                    avail-width: term-header.avail-title-w;
                                    headword-color: term-segment.term-headword-color;
                                    kanji-clicked(ch) => {
                                        PopupBridge.lookup-kanji-char(res.expression, ch);
                                    }
                                }

                                header-actions := VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: end;

                                        if !res.is-kanji || term-segment.show-browse-btn : leading-actions := LeadingActionsBox {
                                            res: res;
                                            spacing: 6px;
                                            btn-size: 28px;
                                            icon-size: 16px;
                                            show-kana: PopupBridge.rich-enabled && !res.is-kanji && res.reading != "" && res.reading != res.expression;
                                            show-browse: term-segment.show-browse-btn;
                                            kana-clicked => {
                                                PopupBridge.toggle-kana-reading-search(res.expression, res.reading);
                                            }
                                            kanji-clicked => {
                                                if PopupBridge.rich-enabled {
                                                    PopupBridge.lookup-kanji-char(res.expression, "");
                                                } else {
                                                    root.kanji-info(res.expression);
                                                }
                                            }
                                            audio-clicked => {
                                                if (!root.audio-menu-open) { root.play-audio(res.expression, res.reading); }
                                            }
                                            audio-right-clicked(offset-x) => {
                                                root.audio-menu-expression = res.expression;
                                                root.audio-menu-reading = res.reading;
                                                root.audio-menu-x = max(8px, min(root.width - 244px, PopupBridge.css-popup-padding + header-actions.x + leading-actions.x + offset-x - 190px));
                                                root.audio-menu-y = max(36px, min(root.height - 140px, 12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 38px));
                                                root.audio-menu-open = true;
                                                root.request-audio-sources(res.expression, res.reading);
                                            }
                                            browse-clicked => {
                                                if (term-segment.row-browse-query != "") {
                                                    root.browse-anki-note(term-segment.row-browse-query);
                                                }
                                            }
                                            request-tooltip(tip, right-offset) => {
                                                PopupBridge.show-tooltip(
                                                    tip,
                                                    (root.width - right-offset) / 1px,
                                                    (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 38px) / 1px
                                                );
                                            }
                                        }

                                        // Update existing Anki note (kept directly in YomitanPopup for `YomitanPopup::update-anki-touch`)
                                        if term-segment.show-update-btn : update-anki-btn-box := Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            border-radius: 5px;
                                            border-width: 1px;
                                            border-color: update-anki-touch.has-hover ? MementoPalette.warning : MementoPalette.warning-border;
                                            background: update-anki-touch.pressed
                                                ? MementoPalette.warning-bg
                                                : (update-anki-touch.has-hover ? #644010 : MementoPalette.warning-bg);
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            DictionaryText {
                                                text: "↻";
                                                color: update-anki-touch.has-hover ? #FEF3C7 : MementoPalette.warning-text;
                                                font-size: 15px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            update-anki-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if PopupBridge.nested-depth > 0 {
                                                        PopupBridge.dismiss-all-nested-popups();
                                                    }
                                                    PopupBridge.update-anki-note-requested(
                                                        term-segment.row-zero-idx,
                                                        term-segment.row-anki-note-id,
                                                        res.expression,
                                                        res.reading,
                                                        res.glossary
                                                    );
                                                }
                                                changed has-hover => {
                                                    if self.has-hover && PopupBridge.rich-enabled {
                                                        PopupBridge.show-tooltip(
                                                            "Update existing Anki note",
                                                            (root.width - 170px) / 1px,
                                                            (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 38px) / 1px
                                                        );
                                                    } else if !self.has-hover && PopupBridge.rich-enabled {
                                                        PopupBridge.hide-tooltip();
                                                    }
                                                }
                                            }
                                        }

                                        if root.anki-enabled && !term-segment.show-browse-btn : AnkiAddButton {
                                            btn-size: 28px;
                                            clicked => { root.add-anki-note(res.index - 1); }
                                            request-tooltip(tip) => {
                                                PopupBridge.show-tooltip(
                                                    tip,
                                                    (root.width - 120px) / 1px,
                                                    (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 38px) / 1px
                                                );
                                            }
                                        }

                                        // Collapse / expand term (kept directly in YomitanPopup for `YomitanPopup::collapse-touch`)
                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            border-radius: 5px;
                                            border-width: 1px;
                                            border-color: collapse-touch.has-hover ? MementoPalette.border-light : MementoPalette.border;
                                            background: collapse-touch.pressed
                                                ? MementoPalette.button-pressed
                                                : (collapse-touch.has-hover ? MementoPalette.button-hover : MementoPalette.button-bg);
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            Image {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                width: 18px;
                                                height: 18px;
                                                source: res.collapsed
                                                    ? @image-url("../icons/arrow-drop-down.svg")
                                                    : @image-url("../icons/arrow-drop-up.svg");
                                                colorize: collapse-touch.has-hover ? MementoPalette.text : MementoPalette.icon;
                                            }

                                            collapse-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.toggle-term-collapse(res.index - 1); }
                                                changed has-hover => {
                                                    if self.has-hover && PopupBridge.rich-enabled {
                                                        PopupBridge.show-tooltip(
                                                            res.collapsed ? "Expand term" : "Collapse term",
                                                            (root.width - 120px) / 1px,
                                                            (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 38px) / 1px
                                                        );
                                                    } else if !self.has-hover && PopupBridge.rich-enabled {
                                                        PopupBridge.hide-tooltip();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if res.term-start && (term-segment.cached-deriv-steps.length > 0 || term-segment.cached-deriv-summary != "") : TermDerivationRow {
                                steps: term-segment.cached-deriv-steps;
                                compact-summary: term-segment.cached-deriv-summary;
                                request-tooltip(tip) => {
                                    PopupBridge.show-tooltip(
                                        tip,
                                        24.0,
                                        (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 48px) / 1px
                                    );
                                }
                            }

                            // Term-level deduplicated category-colored tag pills (#220)
                            if !res.collapsed && res.term-start && PopupBridge.rich-enabled && PopupBridge.css-show-term-tags : TermTagPillRow {
                                res-index: res.index;
                                scan-depth: 0;
                                bridge-rev: PopupBridge.rich-revision;
                                request-tooltip(notes) => {
                                    PopupBridge.show-tooltip(
                                        notes,
                                        20.0,
                                        (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 44px) / 1px
                                    );
                                }
                            }

                            // Existing Anki card tag pills when `show-tag` is enabled (#346)
                            if !res.collapsed && res.term-start && PopupBridge.anki-show-tags && term-segment.row-raw-anki-tags != "" : AnkiTagRow {
                                raw-tags: term-segment.row-raw-anki-tags;
                                request-tooltip(tip) => {
                                    PopupBridge.show-tooltip(
                                        tip,
                                        20.0,
                                        (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 44px) / 1px
                                    );
                                }
                            }

                            // Frequency badges & legacy meta row
                            if !res.collapsed && ((res.term-start && res.frequencies.length > 0)
                                || (res.index == 1 && res.frequencies.length == 0
                                    && (root.jpdb-rank != "" || root.freq-rank != "" || root.pitch-accent != ""))) : FrequencyBadgeList {
                                width: parent.width;
                                res: res;
                                show-legacy-meta: true;
                                jpdb-rank: root.jpdb-rank;
                                freq-rank: root.freq-rank;
                                pitch-accent: root.pitch-accent;
                            }

                            // Pitch accent graphs (single cached rich-pitch-graphs call + fallback)
                            if !res.collapsed && res.term-start && (term-segment.cached-rich-pitches.length > 0 || res.pitch-graphs.length > 0) : PitchGraphList {
                                width: parent.width;
                                rich-pitches: term-segment.cached-rich-pitches;
                                fallback-pitches: res.pitch-graphs;
                                allow-fallback: true;
                                compact: false;
                                request-tooltip(tip) => {
                                    PopupBridge.show-tooltip(
                                        tip,
                                        30.0,
                                        (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 64px) / 1px
                                    );
                                }
                            }

                            // Single-column definition body (default)
                            if !res.collapsed && !root.use-two-columns : DefinitionEntryBody {
                                width: parent.width;
                                res: res;
                                scan-depth: 0;
                                bridge-rev: PopupBridge.rich-revision;
                                is-solo: res.term-start && res.term-end;
                                show-anki-checkbox: root.show-anki-checkbox;
                                tooltip-base-x: round(PopupBridge.css-popup-padding / 1px) * 1px;
                                content-base-y: row-wrapper.y + 4px + self.y;
                                read-scroll-y => { definition-list.y + definition-list.viewport-y }
                                toggle-select-definition(i) => { root.toggle-select-definition(i); }
                                open-rich-link(href) => { root.open-rich-link(href); }
                                focus-glossary => {
                                    if !glossary-focus.has-focus {
                                        glossary-focus.focus();
                                    }
                                }
                            }

                            // Responsive 2-column card grid (enabled by `--definition-columns: 2` when width >= min-width)
                            if !res.collapsed && res.term-start && root.use-two-columns : DefinitionCardGrid {
                                width: parent.width;
                                all-results: root.results;
                                term-start-index: res.index;
                                scan-depth: 0;
                                bridge-rev: PopupBridge.rich-revision;
                                show-anki-checkbox: root.show-anki-checkbox;
                                base-x: PopupBridge.css-popup-padding;
                                content-base-y: row-wrapper.y + 4px + self.y;
                                read-scroll-y => { definition-list.y + definition-list.viewport-y }
                                toggle-select-definition(i) => { root.toggle-select-definition(i); }
                                open-rich-link(href) => { root.open-rich-link(href); }
                                focus-glossary => {
                                    if !glossary-focus.has-focus {
                                        glossary-focus.focus();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Floating Tooltip Overlay (for title attributes, <ruby> readings, tag notes, conjugation derivations #279)
    if PopupBridge.tooltip-visible && PopupBridge.tooltip-text != "" && PopupBridge.nested-depth == 0 : FloatingTooltip {
        container-width: root.width;
        container-height: root.height;
    }

    if root.audio-menu-open : AudioSourceMenu {
        width: parent.width;
        height: parent.height;
        menu-x: root.audio-menu-x;
        menu-y: root.audio-menu-y;
        audio-sources: root.audio-sources;
        loading: root.audio-sources-loading;
        selected-source: root.selected-audio-source;
        dismissed => { root.audio-menu-open = false; }
        source-picked(idx) => {
            root.select-audio-source(idx);
            root.audio-menu-open = false;
            root.play-audio(root.audio-menu-expression, root.audio-menu-reading);
        }
    }
}
