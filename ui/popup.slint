import { MementoPalette } from "palette.slint";
import { ListView, LineEdit, Button, ScrollView } from "std-widgets.slint";

export struct PitchMora { text: string, high: bool, rises_after: bool, falls_after: bool }
export struct PitchGraph { dictionary: string, position: int, mora: [PitchMora] }
export struct PopupFrequency { dictionary: string, value: string }
export struct PopupFrequencyLine { entries: [PopupFrequency] }
export struct PopupGlossaryBlock { text: string, kind: int, href: string }
export struct PopupAudioSource { name: string, index: int }

export struct DictResult {
    index: int,
    expression: string,
    reading: string,
    pos_tags: string,
    dict_name: string,
    glossary: string,
    glossary-blocks: [PopupGlossaryBlock],
    notes: string,
    example_ja: string,
    example_en: string,
    selected: bool,
    score: int,
    is_kanji: bool,
    has_kanji: bool,
    term_start: bool,
    term_end: bool,
    collapsed: bool,
    pitch_graphs: [PitchGraph],
    frequencies: [PopupFrequency],
}

export struct RichHeadwordChar {
    text: string,
    is_kanji: bool,
    char_index: int,
}

export struct RichHeadwordLine {
    chars: [RichHeadwordChar],
}

export struct RichTagPill {
    name: string,
    category: string,
    notes: string,
    bg_color: brush,
}

export struct RichDerivationStep {
    label: string,
    description: string,
    has_arrow: bool,
}

export struct RichPitchMora {
    text: string,
    high: bool,
    rises_after: bool,
    falls_after: bool,
    nasal: bool,
    devoice: bool,
}

export struct RichPitchGraph {
    dictionary: string,
    position: int,
    mora: [RichPitchMora],
    tags: string,
}

export struct RichKanjiStat {
    label: string,
    value: string,
}

export struct RichKanjiDetail {
    valid: bool,
    character: string,
    meanings: [string],
    readings: [string],
    stats: [RichKanjiStat],
    classifications: [RichKanjiStat],
    codepoints: [RichKanjiStat],
    indices: [RichKanjiStat],
}

export struct RichSelectionRect {
    x_px: float,
    y_px: float,
    w_px: float,
    h_px: float,
}

export struct RichGlossaryRender {
    has_rich: bool,
    width_px: float,
    height_px: float,
    rendered: image,
    selection_rects: [RichSelectionRect],
    scan_highlight_rects: [RichSelectionRect],
    collapsible: bool,
    collapsed_height: length,
    total_lines: int,
    expanded: bool,
}

export struct PopupDictStyle {
    badge_bg: color,
    badge_color: color,
    card_bg: color,
    card_border: color,
    card_border_width: length,
    card_radius: length,
    card_padding: length,
    glossary_opacity: float,
    glossary_hover_opacity: float,
    glossary_solo_opacity: float,
}

export struct PopupFreqStyle {
    bg: color,
    color: color,
}

export struct DefinitionGridRow {
    left: DictResult,
    right: DictResult,
    has_right: bool,
    is_solo: bool,
}

// ── Floating Yomitan Dictionary Card ────────────────────────────────────
// Japanese text uses one family; Slint accepts a single name, not a CSS list.
export component DictionaryText inherits Text {
    font-family: PopupBridge.css-font-family;
}

export global PopupLayout {
    pure callback frequency-lines([PopupFrequency], float) -> [PopupFrequencyLine];
}

export global PopupBridge {
    in-out property <int> bridge-instance-id: 0;
    in-out property <string> selected-glossary-text: "";
    in-out property <string> last-copied-glossary-text: "";
    in-out property <bool> rich-enabled: false;
    in-out property <int> rich-revision: 0;
    in-out property <int> selection-revision: 0;

    // Custom Popup Outer CSS properties (~/.config/memento/popup-outer.css)
    in-out property <color> css-popup-bg: #1C2024;
    in-out property <color> css-popup-border: #384046;
    in-out property <length> css-popup-border-width: 1px;
    in-out property <length> css-popup-radius: 8px;
    in-out property <length> css-popup-padding: 12px;
    in-out property <length> css-popup-shadow-blur: 24px;
    in-out property <color> css-popup-shadow-color: #000000DD;
    in-out property <length> css-popup-width: 0px;
    in-out property <length> css-popup-height: 0px;

    // Custom Popup Inner CSS properties (~/.config/memento/popup.css)
    in-out property <color> css-text-color: #F8FAFC;
    in-out property <color> css-muted-color: #94A3B8;
    in-out property <color> css-headword-color: #FFFFFF;
    in-out property <length> css-headword-size: 23px;
    in-out property <color> css-reading-color: #94A3B8;
    in-out property <length> css-reading-size: 12px;
    in-out property <string> css-font-family: "Noto Sans CJK JP";
    in-out property <string> css-headword-font-family: "Noto Sans CJK JP";
    in-out property <string> css-reading-font-family: "Noto Sans CJK JP";
    in-out property <string> css-conj-font-family: "Noto Sans CJK JP";
    in-out property <length> css-conj-font-size: 11px;
    in-out property <string> css-tag-font-family: "Noto Sans CJK JP";
    in-out property <length> css-tag-font-size: 11px;
    in-out property <string> css-kanji-font-family: "Noto Sans CJK JP";
    in-out property <length> css-kanji-font-size: 0px;
    in-out property <length> css-glossary-font-size: 14.5px;
    in-out property <color> css-link-color: #93C5FD;
    in-out property <color> css-divider-color: #30373D;
    in-out property <color> css-term-divider-color: #52616B;
    in-out property <color> css-freq-bg: #07513E;
    in-out property <color> css-freq-color: #9CE5C7;
    in-out property <length> css-freq-font-size: 10px;
    in-out property <color> css-pitch-color: #B9A1E8;
    in-out property <color> css-pitch-dict-bg: #6640BE;
    in-out property <color> css-dict-badge-bg: #6D28D9;
    in-out property <color> css-dict-badge-color: #EDE9FE;
    in-out property <color> css-anki-tag-bg: #162B3D;
    in-out property <color> css-anki-tag-border: #38BDF888;
    in-out property <color> css-anki-tag-color: #BAE6FD;
    in-out property <int> css-definition-columns: 1;
    in-out property <length> css-definition-columns-min-width: 560px;
    in-out property <length> css-definition-gap: 8px;
    in-out property <bool> css-show-term-tags: true;
    in-out property <bool> css-show-pitch-dict: true;
    in-out property <bool> css-show-kanji-extra: true;
    in-out property <bool> css-compact-derivations: false;

    // Navigation history stack (Back / Forward)
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <string> nav-breadcrumb: "";
    in-out property <bool> kana-reading-active: false;
    in-out property <string> active-kana-reading: "";

    // Floating tooltip overlay state
    in-out property <bool> tooltip-visible: false;
    in-out property <string> tooltip-text: "";
    in-out property <float> tooltip-x: 0.0;
    in-out property <float> tooltip-y: 0.0;

    // Independent DictionarySearchPanel state
    in-out property <string> panel-query: "";
    in-out property <[DictResult]> panel-results: [];
    in-out property <bool> panel-kana-only: false;
    in-out property <bool> panel-searching: false;

    // Background Anki duplicate & show-tag state (#340, #346)
    in-out property <int> popup-revision: 0;
    in-out property <bool> anki-show-tags: false;
    in-out property <bool> anki-checking: false;
    in-out property <[bool]> row-anki-duplicates: [];
    in-out property <[int]> row-anki-note-ids: [];
    in-out property <[string]> row-anki-note-id-strings: [];
    in-out property <[string]> row-anki-browse-queries: [];
    in-out property <[string]> row-anki-tags: [];

    // Recursive nested child popup state (depth 1..=4)
    in-out property <int> nested-depth: 0;
    in-out property <int> nested-max-depth: 4;
    in-out property <int> nested-revision: 0;
    in-out property <int> nested-nav-revision: 0;
    in-out property <bool> nested-locked: false;
    in-out property <bool> nested-searching: false;
    in-out property <string> nested-breadcrumb: "";
    in-out property <string> nested-headword: "";
    in-out property <string> nested-reading: "";
    in-out property <float> nested-anchor-x: 0.0;
    in-out property <float> nested-anchor-y: 0.0;
    in-out property <[DictResult]> nested-results: [];
    in-out property <[bool]> nested-row-anki-duplicates: [];
    in-out property <[int]> nested-row-anki-note-ids: [];
    in-out property <[string]> nested-row-anki-browse-queries: [];
    in-out property <[string]> nested-row-anki-tags: [];
    in-out property <bool> last-added-was-nested: false;

    // Rich query callbacks
    pure callback headword-chars(string) -> [RichHeadwordChar];
    pure callback headword-lines(string, float) -> [RichHeadwordLine];
    pure callback headword-pitch-color(int, int) -> color;
    pure callback dict-entry-style(string, bool, int) -> PopupDictStyle;
    pure callback freq-badge-style(string, int) -> PopupFreqStyle;
    pure callback pitch-dict-bg(string, int) -> color;
    pure callback definition-grid-rows([DictResult], int) -> [DefinitionGridRow];
    pure callback split-anki-tags(string) -> [string];
    pure callback term-tag-pills(int, int) -> [RichTagPill];
    pure callback def-tag-pills(int, int) -> [RichTagPill];
    pure callback derivation-steps(int, int) -> [RichDerivationStep];
    pure callback derivation-summary(int, int) -> string;
    pure callback rich-pitch-graphs(int, int) -> [RichPitchGraph];
    pure callback devoice-circle-image() -> image;
    pure callback kanji-detail(int, int) -> RichKanjiDetail;
    pure callback render-glossary(int, float, bool, int, int) -> RichGlossaryRender;
    pure callback glossary-cursor-is-pointer(int, float, float) -> bool;

    // Nested child popup rich query callbacks (depth >= 1)
    pure callback nested-headword-pitch-color(int, int, int) -> color;
    pure callback nested-term-tag-pills(int, int, int) -> [RichTagPill];
    pure callback nested-def-tag-pills(int, int, int) -> [RichTagPill];
    pure callback nested-derivation-steps(int, int, int) -> [RichDerivationStep];
    pure callback nested-derivation-summary(int, int, int) -> string;
    pure callback nested-rich-pitch-graphs(int, int, int) -> [RichPitchGraph];
    pure callback nested-kanji-detail(int, int, int) -> RichKanjiDetail;
    pure callback nested-render-glossary(int, int, float, bool, int, int) -> RichGlossaryRender;
    pure callback nested-glossary-cursor-is-pointer(int, int, float, float) -> bool;

    // Interactive actions
    callback nav-back();
    callback nav-forward();
    callback lookup-kanji-char(string, string);
    callback toggle-kana-reading-search(string, string);
    callback activate-glossary-link(string) -> bool;
    callback toggle-glossary-details(int, string);
    callback toggle-definition-expanded(int, int);
    callback show-tooltip(string, float, float);
    callback hide-tooltip();
    callback glossary-pointer-down(int, float, float);
    callback glossary-pointer-drag(int, float, float);
    callback glossary-pointer-up(int, float, float);
    callback glossary-pointer-hover(int, float, float, float, float);
    callback glossary-double-clicked(int, float, float);
    callback glossary-scan-hover(int, int, float, float, float, float, bool, bool, bool, bool);
    callback glossary-scan-middle-click(int, int, float, float, float, float);
    callback glossary-scan-leave(int, int);
    callback nested-glossary-pointer-down(int, int, float, float);
    callback nested-glossary-pointer-drag(int, int, float, float);
    callback nested-glossary-pointer-up(int, int, float, float);
    callback nested-glossary-double-clicked(int, int, float, float);
    callback nested-lookup-kanji-char(int, string, string);
    callback nested-toggle-select-definition(int, int);
    callback nested-toggle-term-collapse(int, int);
    callback nested-add-anki-note(int);
    callback nested-popup-hover-changed(bool);
    callback nested-body-hover-changed(bool);
    callback lock-nested-popup();
    callback pop-nested-popup();
    callback dismiss-all-nested-popups();
    callback copy-selected-glossary();
    callback popup-key-pressed(string, bool, bool, bool, bool) -> bool;
    callback popup-key-released(bool, bool, bool, bool);

    // Sibling track hooks (default no-op until connected in main.rs)
    callback update-anki-note-requested(int, int, string, string, string);
    callback first-term-ready(string, string);

    // Independent search panel actions
    callback panel-search-requested(string);
    callback panel-toggle-kana-only();
    callback panel-lookup-requested(string);
}

component RichTagPillBadge inherits Rectangle {
    in property <RichTagPill> pill;
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    height: max(18px, PopupBridge.css-tag-font-size + 7px);
    width: label.preferred-width + 12px;
    background: root.pill.bg-color;
    border-radius: 3px;
    label := DictionaryText {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.pill.name;
        font-family: PopupBridge.css-tag-font-family;
        font-size: PopupBridge.css-tag-font-size;
        font-weight: 700;
        color: #FFFFFF;
        vertical-alignment: center;
    }
    pill-touch := TouchArea {
        mouse-cursor: root.pill.notes != "" ? help : default;
        changed has-hover => {
            if self.has-hover && root.pill.notes != "" {
                PopupBridge.show-tooltip(root.pill.notes, root.anchor-x / 1px, root.anchor-y / 1px);
            } else if !self.has-hover {
                PopupBridge.hide-tooltip();
            }
        }
    }
}

component DefinitionEntryBody inherits Rectangle {
    in property <DictResult> res;
    in property <int> scan-depth: 0;
    in property <int> bridge-rev: PopupBridge.rich-revision;
    in property <bool> is-solo: false;
    in property <bool> show-anki-checkbox: true;
    in property <length> tooltip-base-x: 12px;
    in property <length> tooltip-base-y: 0px;
    in property <length> scan-offset-x: 0px;
    in property <length> scan-offset-y: 0px;
    out property <bool> collapsible: gloss-wrap.cached-rich-doc.collapsible;
    out property <length> collapsed-height: gloss-wrap.cached-rich-doc.collapsed-height;
    out property <int> total-lines: gloss-wrap.cached-rich-doc.total-lines;
    callback toggle-select-definition(int);
    callback open-rich-link(string);
    callback focus-glossary();

    property <PopupDictStyle> dstyle: PopupBridge.rich-enabled
        ? PopupBridge.dict-entry-style(root.res.dict-name, root.is-solo, PopupBridge.rich-revision)
        : {
            badge-bg: PopupBridge.css-dict-badge-bg,
            badge-color: PopupBridge.css-dict-badge-color,
            card-bg: #00000000,
            card-border: #00000000,
            card-border-width: 0px,
            card-radius: 0px,
            card-padding: 0px,
            glossary-opacity: 1.0,
            glossary-hover-opacity: 1.0,
            glossary-solo-opacity: 1.0,
        };
    property <bool> rich-hovered: false;
    property <bool> select-hovered: false;
    property <bool> expand-hovered: false;
    property <bool> card-hovered: card-hover.has-hover || root.rich-hovered || root.select-hovered || root.expand-hovered;
    property <float> active-glossary-opacity: root.is-solo
        ? root.dstyle.glossary-solo-opacity
        : (root.card-hovered ? root.dstyle.glossary-hover-opacity : root.dstyle.glossary-opacity);
    property <length> pad: root.dstyle.card-padding;

    changed card-hovered => {
        if root.scan-depth > 0 {
            PopupBridge.nested-body-hover-changed(self.card-hovered);
        }
    }

    background: root.dstyle.card-bg;
    border-color: root.dstyle.card-border;
    border-width: root.dstyle.card-border-width;
    border-radius: root.dstyle.card-radius;
    preferred-height: entry-inner.preferred-height + root.pad * 2;
    min-height: entry-inner.preferred-height + root.pad * 2;

    // Background hover sensor so hovering card padding/header also triggers hover-to-reveal.
    card-hover := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (root.scan-depth > 0) {
                    root.focus-glossary();
                    PopupBridge.lock-nested-popup();
                } else if (PopupBridge.nested-depth > 0) {
                    PopupBridge.dismiss-all-nested-popups();
                }
            }
        }
    }

    entry-inner := VerticalLayout {
        x: root.pad;
        y: root.pad;
        width: parent.width - root.pad * 2;
        height: self.preferred-height;
        spacing: 4px;

        // Header row: Checkbox, Category-colored POS tags (#220), Dictionary tag
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            if root.show-anki-checkbox : Rectangle {
                width: 17px;
                height: 17px;
                border-width: 1px;
                border-color: root.res.selected ? #34D399 : #94A3B8;
                border-radius: 3px;
                background: root.res.selected ? #047857 : transparent;
                DictionaryText {
                    text: root.res.selected ? "✓" : "";
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 13px;
                }
                select-touch := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => { root.select-hovered = self.has-hover; }
                    clicked => {
                        if root.scan-depth > 0 {
                            PopupBridge.lock-nested-popup();
                        }
                        root.toggle-select-definition(root.res.index - 1);
                    }
                }
            }

            if PopupBridge.rich-enabled : HorizontalLayout {
                spacing: 4px;
                for pill in (root.scan-depth == 0
                    ? PopupBridge.def-tag-pills(root.res.index, root.bridge-rev)
                    : PopupBridge.nested-def-tag-pills(root.scan-depth, root.res.index, root.bridge-rev)) : RichTagPillBadge {
                    pill: pill;
                    anchor-x: root.tooltip-base-x + 12px;
                    anchor-y: root.tooltip-base-y + 24px;
                }
            }

            // Fallback Part of Speech badge(s) when rich bridge is not active
            if !PopupBridge.rich-enabled && root.res.pos-tags != "" : Rectangle {
                height: max(18px, PopupBridge.css-tag-font-size + 7px);
                background: #2b3238;
                border-radius: 3px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    DictionaryText {
                        text: root.res.pos-tags;
                        font-family: PopupBridge.css-tag-font-family;
                        font-size: PopupBridge.css-tag-font-size;
                        font-weight: 600;
                        color: #cbd5e1;
                        vertical-alignment: center;
                    }
                }
            }

            // Dictionary Source Badge
            if root.res.dict-name != "" : Rectangle {
                height: max(18px, PopupBridge.css-tag-font-size + 7px);
                background: root.dstyle.badge-bg;
                border-radius: 3px;
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    DictionaryText {
                        text: root.res.dict-name;
                        font-family: PopupBridge.css-tag-font-family;
                        font-size: PopupBridge.css-tag-font-size;
                        font-weight: 700;
                        color: root.dstyle.badge-color;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Glossary body (respects per-dictionary opacity / hover-to-reveal)
        gloss-wrap := VerticalLayout {
            property <RichKanjiDetail> cached-kanji-detail: root.res.is-kanji && PopupBridge.rich-enabled
                ? (root.scan-depth == 0
                    ? PopupBridge.kanji-detail(root.res.index, root.bridge-rev)
                    : PopupBridge.nested-kanji-detail(root.scan-depth, root.res.index, root.bridge-rev))
                : { valid: false };
            property <bool> has-rich-kanji: root.res.is-kanji && PopupBridge.rich-enabled && self.cached-kanji-detail.valid;
            property <RichGlossaryRender> cached-rich-doc: !root.res.is-kanji && PopupBridge.rich-enabled
                ? (root.scan-depth == 0
                    ? PopupBridge.render-glossary(
                        root.res.index,
                        self.width / 1px,
                        root.res.selected,
                        root.bridge-rev,
                        PopupBridge.selection-revision
                    )
                    : PopupBridge.nested-render-glossary(
                        root.scan-depth,
                        root.res.index,
                        self.width / 1px,
                        root.res.selected,
                        root.bridge-rev,
                        PopupBridge.selection-revision
                    ))
                : { has-rich: false };
            property <bool> has-rich-glossary: !root.res.is-kanji && PopupBridge.rich-enabled && self.cached-rich-doc.has-rich;

            width: parent.width;
            spacing: 4px;
            opacity: root.active-glossary-opacity;
            animate opacity { duration: 120ms; }

            // 3-Column Kanji Detail View
            if gloss-wrap.has-rich-kanji : VerticalLayout {
                width: parent.width;
                spacing: 6px;
                property <RichKanjiDetail> kdetail: gloss-wrap.cached-kanji-detail;

                Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }

                HorizontalLayout {
                    width: parent.width;
                    spacing: 8px;
                    DictionaryText { horizontal-stretch: 1; width: 0px; text: "Glossary"; font-size: 12px; font-weight: 700; color: PopupBridge.css-text-color; }
                    DictionaryText { horizontal-stretch: 1; width: 0px; text: "Reading"; font-size: 12px; font-weight: 700; color: PopupBridge.css-text-color; }
                    DictionaryText { horizontal-stretch: 1; width: 0px; text: "Statistics"; font-size: 12px; font-weight: 700; color: PopupBridge.css-text-color; }
                }

                Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }

                HorizontalLayout {
                    width: parent.width;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        width: 0px;
                        spacing: 2px;
                        alignment: start;
                        for meaning[m-idx] in kdetail.meanings : DictionaryText {
                            width: parent.width;
                            text: (m-idx + 1) + ". " + meaning;
                            font-size: 13px;
                            color: root.res.selected ? PopupBridge.css-text-color : PopupBridge.css-muted-color;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        width: 0px;
                        spacing: 2px;
                        alignment: start;
                        for r-line in kdetail.readings : DictionaryText {
                            width: parent.width;
                            text: r-line;
                            font-size: 13px;
                            color: PopupBridge.css-text-color;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        width: 0px;
                        spacing: 3px;
                        alignment: start;
                        for stat in kdetail.stats : HorizontalLayout {
                            width: parent.width;
                            spacing: 4px;
                            DictionaryText {
                                horizontal-stretch: 1;
                                text: stat.label;
                                font-size: 11px;
                                font-weight: 700;
                                color: PopupBridge.css-muted-color;
                                wrap: word-wrap;
                            }
                            DictionaryText {
                                text: stat.value;
                                font-size: 11px;
                                color: PopupBridge.css-freq-color;
                            }
                        }
                    }
                }

                if PopupBridge.css-show-kanji-extra && kdetail.classifications.length > 0 : VerticalLayout {
                    spacing: 3px;
                    Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }
                    DictionaryText { text: "Classifications"; font-size: 11px; font-weight: 700; color: PopupBridge.css-text-color; }
                    for item in kdetail.classifications : HorizontalLayout {
                        spacing: 6px;
                        DictionaryText { horizontal-stretch: 1; text: item.label; font-size: 11px; font-weight: 600; color: PopupBridge.css-muted-color; wrap: word-wrap; }
                        DictionaryText { text: item.value; font-size: 11px; color: PopupBridge.css-text-color; }
                    }
                }

                if PopupBridge.css-show-kanji-extra && kdetail.codepoints.length > 0 : VerticalLayout {
                    spacing: 3px;
                    Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }
                    DictionaryText { text: "Codepoints"; font-size: 11px; font-weight: 700; color: PopupBridge.css-text-color; }
                    for item in kdetail.codepoints : HorizontalLayout {
                        spacing: 6px;
                        DictionaryText { horizontal-stretch: 1; text: item.label; font-size: 11px; font-weight: 600; color: PopupBridge.css-muted-color; wrap: word-wrap; }
                        DictionaryText { text: item.value; font-size: 11px; color: PopupBridge.css-text-color; }
                    }
                }

                if PopupBridge.css-show-kanji-extra && kdetail.indices.length > 0 : VerticalLayout {
                    spacing: 3px;
                    Rectangle { height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }
                    DictionaryText { text: "Dictionary Indices"; font-size: 11px; font-weight: 700; color: PopupBridge.css-text-color; }
                    for item in kdetail.indices : HorizontalLayout {
                        spacing: 6px;
                        DictionaryText { horizontal-stretch: 1; text: item.label; font-size: 11px; font-weight: 600; color: PopupBridge.css-muted-color; wrap: word-wrap; }
                        DictionaryText { text: item.value; font-size: 11px; color: PopupBridge.css-text-color; }
                    }
                }
            }

            // Rich Structured Content Surface (tables, ruby, details, ?query= links, images/SVGs,
            // mouse selection, recursive hover-scan, and per-dictionary collapsible line clamping)
            if gloss-wrap.has-rich-glossary : rich-container := VerticalLayout {
                property <RichGlossaryRender> rich-doc: gloss-wrap.cached-rich-doc;
                property <bool> is-collapsed: self.rich-doc.collapsible && !self.rich-doc.expanded;
                width: parent.width;
                spacing: 2px;

                rich-surface := Rectangle {
                    visible: rich-container.rich-doc.has-rich;
                    width: parent.width;
                    height: !rich-container.rich-doc.has-rich
                        ? 0px
                        : (rich-container.is-collapsed ? rich-container.rich-doc.collapsed-height : rich-container.rich-doc.height-px * 1px);
                    clip: true;
                    background: transparent;

                    for scan-rect in rich-container.rich-doc.scan-highlight-rects : Rectangle {
                        x: scan-rect.x-px * 1px;
                        y: scan-rect.y-px * 1px;
                        width: scan-rect.w-px * 1px;
                        height: scan-rect.h-px * 1px;
                        background: #38a6d699;
                        border-radius: 3px;
                    }

                    for sel-rect in rich-container.rich-doc.selection-rects : Rectangle {
                        x: sel-rect.x-px * 1px;
                        y: sel-rect.y-px * 1px;
                        width: sel-rect.w-px * 1px;
                        height: sel-rect.h-px * 1px;
                        background: #38a6d666;
                        border-radius: 2px;
                    }

                    if rich-container.rich-doc.has-rich : Image {
                        x: 0px;
                        y: 0px;
                        width: rich-container.rich-doc.width-px * 1px;
                        height: rich-container.rich-doc.height-px * 1px;
                        source: rich-container.rich-doc.rendered;
                        image-fit: fill;
                        image-rendering: smooth;
                    }

                    if rich-container.is-collapsed : Rectangle {
                        x: 0px;
                        y: max(0px, parent.height - 22px);
                        width: parent.width;
                        height: min(22px, parent.height);
                        background: @linear-gradient(180deg, #00000000 0%, PopupBridge.css-popup-bg 100%);
                    }

                    if rich-container.rich-doc.has-rich : rich-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: (root.scan-depth == 0
                            ? PopupBridge.glossary-cursor-is-pointer(
                                root.res.index,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px
                            )
                            : PopupBridge.nested-glossary-cursor-is-pointer(
                                root.scan-depth,
                                root.res.index,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px
                            )) ? pointer : text;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.focus-glossary();
                                if (root.scan-depth == 0) {
                                    PopupBridge.glossary-pointer-down(
                                        root.res.index,
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px
                                    );
                                } else {
                                    PopupBridge.nested-glossary-pointer-down(
                                        root.scan-depth,
                                        root.res.index,
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px
                                    );
                                }
                            } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                                root.focus-glossary();
                                PopupBridge.glossary-scan-middle-click(
                                    root.scan-depth,
                                    root.res.index,
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px,
                                    (root.scan-offset-x + root.tooltip-base-x + root.pad + self.mouse-x) / 1px,
                                    (root.scan-offset-y + root.tooltip-base-y + root.pad + gloss-wrap.y + rich-container.y + rich-surface.y + self.mouse-y) / 1px
                                );
                            } else if (event.kind == PointerEventKind.move) {
                                if (self.pressed) {
                                    if (root.scan-depth == 0) {
                                        PopupBridge.glossary-pointer-drag(
                                            root.res.index,
                                            self.mouse-x / 1px,
                                            self.mouse-y / 1px
                                        );
                                    } else {
                                        PopupBridge.nested-glossary-pointer-drag(
                                            root.scan-depth,
                                            root.res.index,
                                            self.mouse-x / 1px,
                                            self.mouse-y / 1px
                                        );
                                    }
                                } else {
                                    root.focus-glossary();
                                    PopupBridge.glossary-scan-hover(
                                        root.scan-depth,
                                        root.res.index,
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px,
                                        (root.scan-offset-x + root.tooltip-base-x + root.pad + self.mouse-x) / 1px,
                                        (root.scan-offset-y + root.tooltip-base-y + root.pad + gloss-wrap.y + rich-container.y + rich-surface.y + self.mouse-y) / 1px,
                                        event.modifiers.control,
                                        event.modifiers.shift,
                                        event.modifiers.alt,
                                        event.modifiers.meta
                                    );
                                }
                            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                if (root.scan-depth == 0) {
                                    PopupBridge.glossary-pointer-up(
                                        root.res.index,
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px
                                    );
                                } else {
                                    PopupBridge.nested-glossary-pointer-up(
                                        root.scan-depth,
                                        root.res.index,
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px
                                    );
                                }
                            } else if (event.kind == PointerEventKind.cancel) {
                                PopupBridge.hide-tooltip();
                                PopupBridge.glossary-scan-leave(root.scan-depth, root.res.index);
                            }
                        }
                        double-clicked => {
                            root.focus-glossary();
                            if (root.scan-depth == 0) {
                                PopupBridge.glossary-double-clicked(
                                    root.res.index,
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px
                                );
                            } else {
                                PopupBridge.nested-glossary-double-clicked(
                                    root.scan-depth,
                                    root.res.index,
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px
                                );
                            }
                        }
                        changed has-hover => {
                            root.rich-hovered = self.has-hover;
                            if self.has-hover {
                                root.focus-glossary();
                            } else {
                                PopupBridge.hide-tooltip();
                                PopupBridge.glossary-scan-leave(root.scan-depth, root.res.index);
                            }
                        }
                    }
                }

                if rich-container.rich-doc.collapsible : collapse-toggle-bar := Rectangle {
                    width: parent.width;
                    height: 22px;
                    border-radius: 3px;
                    background: expand-touch.has-hover ? #33415555 : transparent;
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: PopupBridge.css-divider-color;
                        opacity: 0.65;
                    }
                    DictionaryText {
                        x: 4px;
                        width: parent.width - 8px;
                        height: parent.height;
                        text: rich-container.rich-doc.expanded
                            ? "▴ Show less"
                            : ("▾ Show more (" + rich-container.rich-doc.total-lines + " lines)");
                        font-size: 11px;
                        font-weight: 600;
                        color: PopupBridge.css-link-color;
                        vertical-alignment: center;
                    }
                    expand-touch := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => { root.expand-hovered = self.has-hover; }
                        clicked => {
                            if root.scan-depth > 0 {
                                PopupBridge.lock-nested-popup();
                            }
                            PopupBridge.toggle-definition-expanded(root.scan-depth, root.res.index);
                        }
                    }
                }
            }

            // Fallback Definition Meaning Text (when rich surface is not rendered for this row)
            if !gloss-wrap.has-rich-kanji
                && !gloss-wrap.has-rich-glossary
                && root.res.glossary-blocks.length > 0 : VerticalLayout
            {
                width: parent.width;
                spacing: 4px;
                for block in root.res.glossary-blocks : Rectangle {
                    width: parent.width;
                    height: rich-text.preferred-height + 2px;
                    rich-text := DictionaryText {
                        width: parent.width;
                        height: self.preferred-height;
                        text: block.kind == 2 ? "◦  " + block.text : block.text;
                        wrap: word-wrap;
                        font-size: block.kind == 1 ? max(11px, PopupBridge.css-glossary-font-size - 1.5px) : PopupBridge.css-glossary-font-size;
                        font-weight: block.kind == 1 ? 700 : 400;
                        color: !root.res.selected ? PopupBridge.css-muted-color : block.kind == 3 ? PopupBridge.css-link-color : block.kind == 1 ? #D8C9FC : PopupBridge.css-text-color;
                    }
                    if block.href != "" : TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if !(PopupBridge.rich-enabled && PopupBridge.activate-glossary-link(block.href)) {
                                root.open-rich-link(block.href);
                            }
                        }
                    }
                }
            }

            if !gloss-wrap.has-rich-kanji
                && !gloss-wrap.has-rich-glossary
                && root.res.glossary-blocks.length == 0 : DictionaryText
            {
                width: parent.width;
                text: root.res.glossary;
                font-size: PopupBridge.css-glossary-font-size;
                font-weight: 400;
                color: root.res.selected ? PopupBridge.css-text-color : PopupBridge.css-muted-color;
                wrap: word-wrap;
                height: self.preferred-height;
            }

            // Japanese Example Sentence (fallback)
            if !gloss-wrap.has-rich-glossary
                && root.res.example-ja != "" : HorizontalLayout
            {
                width: parent.width;
                spacing: 5px;
                Rectangle {
                    width: 16px;
                    Image { y: 4px; width: 16px; height: 11px; source: @image-url("icons/flag-jp.svg"); }
                }
                DictionaryText {
                    text: root.res.example-ja;
                    font-size: 13px;
                    color: PopupBridge.css-text-color;
                    wrap: word-wrap;
                    height: self.preferred-height;
                    horizontal-stretch: 1;
                }
            }

            // English Example Translation (fallback)
            if !gloss-wrap.has-rich-glossary
                && root.res.example-en != "" : HorizontalLayout
            {
                width: parent.width;
                spacing: 5px;
                Rectangle {
                    width: 16px;
                    Image { y: 4px; width: 16px; height: 11px; source: @image-url("icons/flag-gb.svg"); }
                }
                DictionaryText {
                    text: root.res.example-en;
                    font-size: 12px;
                    color: PopupBridge.css-muted-color;
                    wrap: word-wrap;
                    height: self.preferred-height;
                    horizontal-stretch: 1;
                }
            }

            // Notes / Explanations (fallback)
            if !gloss-wrap.has-rich-kanji
                && root.res.notes != "" : DictionaryText
            {
                width: parent.width;
                text: "Note: " + root.res.notes;
                font-size: 12px;
                color: PopupBridge.css-muted-color;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }
    }
}

// ── Yomitan-Style Floating Recursive Child Popup (depth 1..=N) ───────────────
// Mounted in the player viewport right after `YomitanPopup` (with `render-nested-inline: false`
// on the parent), or inline inside `YomitanPopup` when `inline-mode: true`.
export component NestedYomitanPopup inherits Rectangle {
    in property <bool> is-open: false;
    in property <length> viewport-width: 1280px;
    in property <length> viewport-height: 720px;
    in property <length> parent-x: 0px;
    in property <length> parent-y: 0px;
    in property <length> configured-width: 480px;
    in property <length> configured-height: 500px;
    in property <bool> inline-mode: false;
    in property <bool> anki-enabled: false;
    in property <bool> show-anki-checkbox: true;
    in property <string> added-note-id: "";
    in property <int> added-result-index: -1;
    in property <[PopupAudioSource]> audio-sources;
    in property <bool> audio-sources-loading: false;
    in-out property <int> selected-audio-source: -1;
    in-out property <bool> audio-menu-open: false;
    in-out property <string> audio-menu-expression: "";
    in-out property <string> audio-menu-reading: "";
    in-out property <length> audio-menu-x: 210px;
    in-out property <length> audio-menu-y: 62px;
    callback browse-anki-note(string);
    callback play-audio(string, string);
    callback request-audio-sources(string, string);
    callback select-audio-source(int);
    callback open-rich-link(string);
    callback close-parent-requested();

    property <length> desired-w: PopupBridge.css-popup-width > 0px
        ? PopupBridge.css-popup-width
        : root.configured-width;
    property <length> desired-h: PopupBridge.css-popup-height > 0px
        ? PopupBridge.css-popup-height
        : root.configured-height;
    property <length> anchor-vx: root.parent-x + PopupBridge.nested-anchor-x * 1px;
    property <length> anchor-vy: root.parent-y + PopupBridge.nested-anchor-y * 1px;

    // Viewport-floating geometry (full configured width/height, flipped above/below the scanned line
    // so the highlighted word in the parent popup remains visible).
    property <length> float-w: max(240px, min(self.desired-w, max(240px, root.viewport-width - 24px)));
    property <length> float-max-h: max(180px, min(self.desired-h, max(180px, root.viewport-height - 24px)));
    property <length> space-below: max(0px, root.viewport-height - (self.anchor-vy + 22px) - 12px);
    property <length> space-above: max(0px, (self.anchor-vy - 18px) - 12px);
    property <bool> float-place-above: self.space-below < self.float-max-h && self.space-above > self.space-below;
    property <length> float-h: min(
        self.float-max-h,
        max(160px, self.float-place-above ? self.space-above : self.space-below)
    );

    // Inline fallback geometry (contained inside parent YomitanPopup when render-nested-inline: true).
    property <length> inline-w: max(0px, min(root.viewport-width - 20px, max(300px, root.viewport-width * 0.88)));
    property <length> inline-h: max(0px, min(root.viewport-height - 36px, max(190px, root.viewport-height * 0.68)));
    property <bool> inline-place-above: self.anchor-vy > root.viewport-height * 0.48
        && (self.anchor-vy - 18px) >= 160px;

    property <length> card-w: root.inline-mode ? self.inline-w : self.float-w;
    property <length> card-h: root.inline-mode ? self.inline-h : self.float-h;
    property <bool> use-two-columns: PopupBridge.rich-enabled
        && PopupBridge.css-definition-columns >= 2
        && self.width >= PopupBridge.css-definition-columns-min-width;
    property <length> card-pad: root.inline-mode ? 8px : PopupBridge.css-popup-padding;
    property <int> nav-rev: PopupBridge.nested-nav-revision;

    visible: root.is-open
        && PopupBridge.rich-enabled
        && PopupBridge.nested-depth > 0
        && PopupBridge.nested-results.length > 0;
    x: root.inline-mode
        ? max(10px, min(root.viewport-width - self.card-w - 10px, self.anchor-vx - self.card-w * 0.3))
        : max(12px, min(root.viewport-width - self.card-w - 12px, self.anchor-vx - self.card-w * 0.25));
    y: root.inline-mode
        ? (self.inline-place-above
            ? max(10px, self.anchor-vy - self.card-h - 14px)
            : max(10px, min(root.viewport-height - self.card-h - 10px, self.anchor-vy + 18px)))
        : (self.float-place-above
            ? max(12px, self.anchor-vy - self.card-h - 18px)
            : max(12px, min(root.viewport-height - self.card-h - 12px, self.anchor-vy + 22px)));
    width: self.card-w;
    height: self.card-h;
    background: PopupBridge.css-popup-bg;
    border-width: max(1.5px, PopupBridge.css-popup-border-width);
    border-color: PopupBridge.nested-locked ? #38BDF8 : #64748B;
    border-radius: PopupBridge.css-popup-radius;
    drop-shadow-blur: max(18px, PopupBridge.css-popup-shadow-blur);
    drop-shadow-color: PopupBridge.css-popup-shadow-color;
    clip: true;

    changed nav-rev => {
        nested-definition-list.viewport-y = 0px;
        root.audio-menu-open = false;
    }
    changed is-open => {
        if !root.is-open {
            root.audio-menu-open = false;
        }
    }

    nested-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: PopupBridge.rich-enabled;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (PopupBridge.nested-depth > 0) {
                    PopupBridge.pop-nested-popup();
                    return accept;
                }
                root.close-parent-requested();
                return accept;
            }
            if ((event.modifiers.control || event.modifiers.meta)
                && !event.modifiers.alt
                && (event.text == "c" || event.text == "C")
                && PopupBridge.selected-glossary-text != "")
            {
                PopupBridge.copy-selected-glossary();
                return accept;
            }
            if (PopupBridge.popup-key-pressed(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            )) {
                return accept;
            }
            reject
        }
        key-released(event) => {
            PopupBridge.popup-key-released(
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            );
            reject
        }
    }

    // Catch clicks & track hover on nested card surface
    nested-card-touch := TouchArea {
        width: 100%;
        height: 100%;
        changed has-hover => {
            PopupBridge.nested-popup-hover-changed(self.has-hover);
            if self.has-hover && !nested-focus.has-focus {
                nested-focus.focus();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if !nested-focus.has-focus {
                    nested-focus.focus();
                }
                PopupBridge.lock-nested-popup();
            }
        }
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding: root.card-pad;
        spacing: 4px;

        // Nested popup header: Back button, depth indicator, breadcrumb
        HorizontalLayout {
            height: 24px;
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: nested-back-lbl.preferred-width + 12px;
                height: 22px;
                border-radius: 3px;
                background: nested-back-touch.has-hover ? #384046 : #2B3238;
                nested-back-lbl := DictionaryText {
                    x: 6px;
                    height: parent.height;
                    text: "← Back";
                    font-size: 11px;
                    font-weight: 700;
                    color: #E2E8F0;
                    vertical-alignment: center;
                }
                nested-back-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { PopupBridge.pop-nested-popup(); }
                }
            }

            Rectangle {
                width: depth-badge-lbl.preferred-width + 10px;
                height: 20px;
                y: 1px;
                border-radius: 3px;
                background: PopupBridge.nested-locked ? #0C4A6E : #1E293B;
                border-width: 1px;
                border-color: PopupBridge.nested-locked ? #38BDF8 : #475569;
                depth-badge-lbl := DictionaryText {
                    x: 5px;
                    height: parent.height;
                    text: PopupBridge.nested-depth + "/" + PopupBridge.nested-max-depth;
                    font-size: 10px;
                    font-weight: 700;
                    color: PopupBridge.nested-locked ? #BAE6FD : #94A3B8;
                    vertical-alignment: center;
                }
            }

            DictionaryText {
                text: PopupBridge.nested-breadcrumb;
                font-size: 11px;
                color: PopupBridge.css-muted-color;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        Rectangle {
            width: parent.width;
            height: 1px;
            background: PopupBridge.css-divider-color;
        }

        nested-definition-list := ScrollView {
            vertical-stretch: 1;
            changed viewport-y => {
                PopupBridge.hide-tooltip();
                if self.viewport-y < -1px {
                    PopupBridge.lock-nested-popup();
                }
            }
            nested-definition-content := VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                spacing: 0px;

                for nres[nidx] in PopupBridge.nested-results : nested-row-wrapper := Rectangle {
                    property <bool> nhidden-by-grid: root.use-two-columns && !nres.term-start;
                    property <bool> nrow-hidden: self.nhidden-by-grid || (nres.collapsed && !nres.term-start);
                    width: parent.width - 6px;
                    height: self.nrow-hidden ? 0px : nested-term-segment.height + ((nres.term-end || root.use-two-columns || (nres.collapsed && nres.term-start)) ? 8px : 0px);
                    visible: !self.nrow-hidden;
                    background: transparent;

                    nested-term-segment := Rectangle {
                        property <int> nrow-zero-idx: nres.index - 1;
                        property <bool> nadded-this-row: PopupBridge.last-added-was-nested && root.added-note-id != "" && root.added-result-index == self.nrow-zero-idx;
                        property <bool> nrow-is-duplicate:
                            (PopupBridge.nested-revision >= 0)
                            && self.nrow-zero-idx >= 0
                            && self.nrow-zero-idx < PopupBridge.nested-row-anki-duplicates.length
                            && PopupBridge.nested-row-anki-duplicates[self.nrow-zero-idx];
                        property <int> nrow-anki-note-id:
                            (PopupBridge.nested-revision >= 0)
                            && self.nrow-zero-idx >= 0
                            && self.nrow-zero-idx < PopupBridge.nested-row-anki-note-ids.length
                                ? PopupBridge.nested-row-anki-note-ids[self.nrow-zero-idx]
                                : 0;
                        property <string> nrow-browse-query:
                            self.nadded-this-row
                                ? root.added-note-id
                                : ((self.nrow-zero-idx >= 0 && self.nrow-zero-idx < PopupBridge.nested-row-anki-browse-queries.length)
                                    ? PopupBridge.nested-row-anki-browse-queries[self.nrow-zero-idx]
                                    : "");
                        property <string> nrow-raw-anki-tags:
                            (PopupBridge.nested-revision >= 0)
                            && self.nrow-zero-idx >= 0
                            && self.nrow-zero-idx < PopupBridge.nested-row-anki-tags.length
                                ? PopupBridge.nested-row-anki-tags[self.nrow-zero-idx]
                                : "";
                        property <bool> nshow-browse-btn: self.nadded-this-row || (root.anki-enabled && self.nrow-is-duplicate);
                        property <bool> nshow-update-btn: root.anki-enabled && self.nrow-is-duplicate && self.nrow-anki-note-id > 0;
                        property <color> nterm-headword-color: PopupBridge.nested-headword-pitch-color(
                            PopupBridge.nested-depth,
                            nres.index,
                            PopupBridge.nested-revision
                        );

                        width: parent.width;
                        height: nested-row-wrapper.nrow-hidden ? 0px : nested-card-content.preferred-height + 8px;
                        background: transparent;
                        if !nested-row-wrapper.nrow-hidden && nres.term-start && nres.index > 1 : Rectangle { y: 0px; height: 2px; width: parent.width; background: PopupBridge.css-term-divider-color; }
                        if !nested-row-wrapper.nrow-hidden && !nres.term-end && !nres.collapsed && !root.use-two-columns : Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }

                        nested-card-content := VerticalLayout {
                            x: 0px;
                            y: 4px;
                            width: parent.width;
                            height: self.preferred-height;
                            spacing: 4px;

                            if nres.term-start : HorizontalLayout {
                                width: parent.width;
                                spacing: 5px;
                                min-height: 30px;
                                property <length> nbuttons-w:
                                    (!nres.is-kanji && nres.has-kanji ? 30px : 0px)
                                    + (!nres.is-kanji ? 30px : 0px)
                                    + (nested-term-segment.nshow-browse-btn || root.anki-enabled ? 30px : 0px)
                                    + (nested-term-segment.nshow-update-btn ? 30px : 0px)
                                    + 30px;
                                property <length> navail-title-w: max(84px, nested-card-content.width - self.nbuttons-w);

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    spacing: 2px;

                                    if !nres.is-kanji && nres.reading != "" && nres.reading != nres.expression : DictionaryText {
                                        text: nres.reading;
                                        height: self.preferred-height;
                                        wrap: word-wrap;
                                        font-family: PopupBridge.css-reading-font-family;
                                        font-size: PopupBridge.css-reading-size;
                                        color: PopupBridge.css-reading-color;
                                    }
                                    if !nres.is-kanji : VerticalLayout {
                                        spacing: 1px;
                                        for hw-line in PopupBridge.headword-lines(nres.expression, navail-title-w / 1px) : HorizontalLayout {
                                            alignment: start;
                                            spacing: 0px;
                                            for ch in hw-line.chars : Rectangle {
                                                width: nch-text.preferred-width;
                                                height: nch-text.preferred-height;
                                                background: ch.is-kanji && nch-touch.has-hover ? #283442 : transparent;
                                                border-radius: 3px;
                                                nch-text := DictionaryText {
                                                    text: ch.text;
                                                    font-family: PopupBridge.css-headword-font-family;
                                                    font-size: root.inline-mode ? max(16px, PopupBridge.css-headword-size - 2px) : PopupBridge.css-headword-size;
                                                    font-weight: 700;
                                                    color: ch.is-kanji && nch-touch.has-hover ? PopupBridge.css-link-color : nested-term-segment.nterm-headword-color;
                                                }
                                                nch-touch := TouchArea {
                                                    enabled: ch.is-kanji;
                                                    mouse-cursor: ch.is-kanji ? pointer : default;
                                                    clicked => {
                                                        PopupBridge.lock-nested-popup();
                                                        PopupBridge.nested-lookup-kanji-char(PopupBridge.nested-depth, nres.expression, ch.text);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if nres.is-kanji : DictionaryText {
                                        text: nres.expression;
                                        height: self.preferred-height;
                                        wrap: word-wrap;
                                        font-family: PopupBridge.css-kanji-font-family;
                                        font-size: PopupBridge.css-kanji-font-size > 0px ? PopupBridge.css-kanji-font-size : PopupBridge.css-headword-size * 1.4;
                                        font-weight: 700;
                                        color: nested-term-segment.nterm-headword-color;
                                    }

                                    // Conjugation derivation steps
                                    if !nres.is-kanji && !PopupBridge.css-compact-derivations : HorizontalLayout {
                                        alignment: start;
                                        spacing: 2px;
                                        for step[step-idx] in PopupBridge.nested-derivation-steps(PopupBridge.nested-depth, nres.index, PopupBridge.nested-revision) : HorizontalLayout {
                                            spacing: 2px;
                                            if step-idx == 0 : DictionaryText {
                                                text: "« ";
                                                font-family: PopupBridge.css-conj-font-family;
                                                font-size: PopupBridge.css-conj-font-size;
                                                color: #94A3B8;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: nstep-lbl.preferred-width + 6px;
                                                height: max(17px, PopupBridge.css-conj-font-size + 6px);
                                                border-radius: 3px;
                                                background: nstep-touch.has-hover ? #334155 : #252D35;
                                                nstep-lbl := DictionaryText {
                                                    x: 3px;
                                                    height: parent.height;
                                                    text: step.label;
                                                    font-family: PopupBridge.css-conj-font-family;
                                                    font-size: PopupBridge.css-conj-font-size;
                                                    color: #CBD5E1;
                                                    vertical-alignment: center;
                                                }
                                                nstep-touch := TouchArea {
                                                    mouse-cursor: step.description != "" ? help : default;
                                                    changed has-hover => {
                                                        if self.has-hover && step.description != "" {
                                                            PopupBridge.show-tooltip(
                                                                step.label + ": " + step.description,
                                                                (root.x - root.parent-x + 20px) / 1px,
                                                                (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 44px) / 1px
                                                            );
                                                        } else if !self.has-hover {
                                                            PopupBridge.hide-tooltip();
                                                        }
                                                    }
                                                }
                                            }
                                            if step.has-arrow : DictionaryText {
                                                text: "←";
                                                font-family: PopupBridge.css-conj-font-family;
                                                font-size: PopupBridge.css-conj-font-size;
                                                color: #64748B;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if !nres.is-kanji && PopupBridge.css-compact-derivations && PopupBridge.nested-derivation-summary(PopupBridge.nested-depth, nres.index, PopupBridge.nested-revision) != "" : HorizontalLayout {
                                        alignment: start;
                                        Rectangle {
                                            width: 22px;
                                            height: 18px;
                                            border-radius: 4px;
                                            background: ncompact-deriv-touch.has-hover ? #334155 : transparent;
                                            DictionaryText {
                                                text: "ⓘ";
                                                font-size: 12px;
                                                color: PopupBridge.css-muted-color;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            ncompact-deriv-touch := TouchArea {
                                                mouse-cursor: help;
                                                changed has-hover => {
                                                    if self.has-hover {
                                                        PopupBridge.show-tooltip(
                                                            PopupBridge.nested-derivation-summary(PopupBridge.nested-depth, nres.index, PopupBridge.nested-revision),
                                                            (root.x - root.parent-x + 20px) / 1px,
                                                            (root.y - root.parent-y + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 44px) / 1px
                                                        );
                                                    } else {
                                                        PopupBridge.hide-tooltip();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                if !nres.is-kanji && nres.has-kanji : Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 3px;
                                    background: nkanji-touch.has-hover ? #384046 : transparent;
                                    DictionaryText { text: "字"; color: #CBD5E1; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                                    nkanji-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PopupBridge.lock-nested-popup();
                                            PopupBridge.nested-lookup-kanji-char(PopupBridge.nested-depth, nres.expression, "");
                                        }
                                    }
                                }

                                if !nres.is-kanji : nested-audio-btn := Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 3px;
                                    background: naudio-touch.has-hover ? #384046 : #2B3238;
                                    Image {
                                        x: 5px;
                                        y: 5px;
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("icons/volume-on.svg");
                                        colorize: #CBD5E1;
                                    }
                                    naudio-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PopupBridge.lock-nested-popup();
                                            if (!root.audio-menu-open) { root.play-audio(nres.expression, nres.reading); }
                                        }
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                                PopupBridge.lock-nested-popup();
                                                root.audio-menu-expression = nres.expression;
                                                root.audio-menu-reading = nres.reading;
                                                root.audio-menu-x = max(8px, min(root.width - 238px, root.card-pad + nested-audio-btn.x - 190px));
                                                root.audio-menu-y = max(36px, min(root.height - 140px, nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 38px));
                                                root.audio-menu-open = true;
                                                root.request-audio-sources(nres.expression, nres.reading);
                                            }
                                        }
                                    }
                                }

                                if nested-term-segment.nshow-browse-btn : Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 3px;
                                    background: nbrowse-touch.has-hover ? #385D75 : #24465C;
                                    Image {
                                        x: 5px;
                                        y: 5px;
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("icons/note-stack.svg");
                                        colorize: #BAE6FD;
                                    }
                                    nbrowse-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PopupBridge.lock-nested-popup();
                                            if (nested-term-segment.nrow-browse-query != "") {
                                                root.browse-anki-note(nested-term-segment.nrow-browse-query);
                                            }
                                        }
                                    }
                                }

                                if nested-term-segment.nshow-update-btn : Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 3px;
                                    background: nupdate-touch.has-hover ? #785A28 : #5C431D;
                                    DictionaryText {
                                        text: "↻";
                                        color: #FDE68A;
                                        font-size: 15px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    nupdate-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PopupBridge.lock-nested-popup();
                                            PopupBridge.update-anki-note-requested(
                                                nested-term-segment.nrow-zero-idx,
                                                nested-term-segment.nrow-anki-note-id,
                                                nres.expression,
                                                nres.reading,
                                                nres.glossary
                                            );
                                        }
                                    }
                                }

                                if root.anki-enabled && !nested-term-segment.nshow-browse-btn : Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 3px;
                                    background: nanki-touch.has-hover ? #2D624D : #20503E;
                                    DictionaryText {
                                        text: "+";
                                        color: #A7F3D0;
                                        font-size: 18px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    nanki-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PopupBridge.lock-nested-popup();
                                            PopupBridge.nested-add-anki-note(nres.index - 1);
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 3px;
                                    background: ncollapse-touch.has-hover ? #384046 : #2B3238;
                                    DictionaryText { text: nres.collapsed ? "›" : "⌄"; color: #CBD5E1; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                    ncollapse-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            PopupBridge.lock-nested-popup();
                                            PopupBridge.nested-toggle-term-collapse(PopupBridge.nested-depth, nres.index - 1);
                                        }
                                    }
                                }
                            }

                            if !nres.collapsed && nres.term-start && PopupBridge.css-show-term-tags : HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                for pill in PopupBridge.nested-term-tag-pills(PopupBridge.nested-depth, nres.index, PopupBridge.nested-revision) : RichTagPillBadge {
                                    pill: pill;
                                    anchor-x: (root.x - root.parent-x) + 16px;
                                    anchor-y: (root.y - root.parent-y) + nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 44px;
                                }
                            }

                            if !nres.collapsed && nres.term-start && PopupBridge.anki-show-tags && nested-term-segment.nrow-raw-anki-tags != "" : HorizontalLayout {
                                property <[string]> nsplit-tags: PopupBridge.split-anki-tags(nested-term-segment.nrow-raw-anki-tags);
                                property <[string]> neffective-tags: self.nsplit-tags.length > 0 ? self.nsplit-tags : [nested-term-segment.nrow-raw-anki-tags];
                                spacing: 4px;
                                alignment: start;
                                for anki-tag in self.neffective-tags : Rectangle {
                                    height: 18px;
                                    width: nanki-tag-lbl.preferred-width + 12px;
                                    background: PopupBridge.css-anki-tag-bg;
                                    border-width: 1px;
                                    border-color: PopupBridge.css-anki-tag-border;
                                    border-radius: 3px;
                                    nanki-tag-lbl := DictionaryText {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height;
                                        text: anki-tag;
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: PopupBridge.css-anki-tag-color;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !nres.collapsed && nres.term-start && nres.frequencies.length > 0 : VerticalLayout {
                                width: parent.width;
                                spacing: 3px;
                                for line in PopupLayout.frequency-lines(nres.frequencies, self.width / 1px) : HorizontalLayout {
                                    width: parent.width;
                                    alignment: start;
                                    spacing: 4px;
                                    for frequency in line.entries : Rectangle {
                                        property <PopupFreqStyle> nfstyle: PopupBridge.freq-badge-style(frequency.dictionary, PopupBridge.rich-revision);
                                        width: min(nfreq-lbl.preferred-width + 10px, parent.width);
                                        height: max(18px, nfreq-lbl.preferred-height + 2px);
                                        background: self.nfstyle.bg;
                                        border-radius: 3px;
                                        nfreq-lbl := DictionaryText {
                                            x: 5px;
                                            width: parent.width - 10px;
                                            height: parent.height;
                                            text: frequency.dictionary + " " + frequency.value;
                                            font-size: PopupBridge.css-freq-font-size;
                                            color: parent.nfstyle.color;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            if !nres.collapsed && nres.term-start : VerticalLayout {
                                spacing: 4px;
                                for pitch in PopupBridge.nested-rich-pitch-graphs(PopupBridge.nested-depth, nres.index, PopupBridge.nested-revision) : Rectangle {
                                    width: parent.width;
                                    height: 28px;
                                    background: transparent;
                                    HorizontalLayout {
                                        width: parent.width;
                                        height: 28px;
                                        spacing: 6px;
                                        alignment: start;
                                        if PopupBridge.css-show-pitch-dict : Rectangle {
                                            height: 18px;
                                            y: 5px;
                                            width: min(npitch-dict-lbl.preferred-width + 10px, parent.width * 0.42);
                                            background: PopupBridge.pitch-dict-bg(pitch.dictionary, PopupBridge.rich-revision);
                                            border-radius: 3px;
                                            npitch-dict-lbl := DictionaryText {
                                                x: 5px;
                                                width: parent.width - 10px;
                                                height: parent.height;
                                                text: pitch.dictionary + " [" + pitch.position + "]";
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #FFFFFF;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        HorizontalLayout {
                                            width: self.preferred-width;
                                            height: 28px;
                                            horizontal-stretch: 0;
                                            spacing: 0px;
                                            for mora in pitch.mora : Rectangle {
                                                width: max(18px, nmora-lbl.preferred-width + 5px);
                                                height: 28px;
                                                Rectangle { x: 0px; y: mora.high ? 3px : 11px; width: parent.width; height: 1.5px; background: PopupBridge.css-pitch-color; }
                                                if mora.rises-after || mora.falls-after : Rectangle { x: parent.width - 1.5px; y: 3px; width: 1.5px; height: 9.5px; background: PopupBridge.css-pitch-color; }
                                                if mora.devoice : Image {
                                                    x: (parent.width - 18px) / 2;
                                                    y: 10px;
                                                    width: 18px;
                                                    height: 18px;
                                                    source: PopupBridge.devoice-circle-image();
                                                }
                                                nmora-lbl := DictionaryText {
                                                    text: mora.text;
                                                    y: 12px;
                                                    horizontal-alignment: center;
                                                    width: parent.width;
                                                    font-size: 11px;
                                                    color: mora.devoice ? #FCA5A5 : PopupBridge.css-text-color;
                                                }
                                                if mora.nasal : Rectangle {
                                                    x: parent.width - 6px;
                                                    y: 10px;
                                                    width: 5px;
                                                    height: 5px;
                                                    border-radius: 2.5px;
                                                    border-width: 1.2px;
                                                    border-color: #FBBF24;
                                                    background: PopupBridge.css-popup-bg;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Single-column definition body inside nested popup
                            if !nres.collapsed && !root.use-two-columns : DefinitionEntryBody {
                                width: parent.width;
                                res: nres;
                                scan-depth: PopupBridge.nested-depth;
                                bridge-rev: PopupBridge.nested-revision;
                                is-solo: nres.term-start && nres.term-end;
                                show-anki-checkbox: root.show-anki-checkbox;
                                tooltip-base-x: root.card-pad;
                                tooltip-base-y: nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 4px + self.y;
                                scan-offset-x: root.x - root.parent-x;
                                scan-offset-y: root.y - root.parent-y;
                                toggle-select-definition(i) => { PopupBridge.nested-toggle-select-definition(PopupBridge.nested-depth, i); }
                                open-rich-link(href) => { root.open-rich-link(href); }
                                focus-glossary => {
                                    if !nested-focus.has-focus {
                                        nested-focus.focus();
                                    }
                                }
                            }

                            // 2-column card grid inside full-size Yomitan-style nested popup
                            if !nres.collapsed && nres.term-start && root.use-two-columns : ngrid-container := VerticalLayout {
                                width: parent.width;
                                spacing: PopupBridge.css-definition-gap;
                                for ngrid-row in PopupBridge.definition-grid-rows(PopupBridge.nested-results, nres.index) : ngrid-row-box := HorizontalLayout {
                                    width: parent.width;
                                    spacing: PopupBridge.css-definition-gap;
                                    alignment: start;

                                    DefinitionEntryBody {
                                        width: ngrid-row.is-solo ? parent.width : max(120px, (parent.width - PopupBridge.css-definition-gap) / 2);
                                        res: ngrid-row.left;
                                        scan-depth: PopupBridge.nested-depth;
                                        bridge-rev: PopupBridge.nested-revision;
                                        is-solo: ngrid-row.is-solo;
                                        show-anki-checkbox: root.show-anki-checkbox;
                                        tooltip-base-x: root.card-pad;
                                        tooltip-base-y: nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 4px + ngrid-container.y + ngrid-row-box.y;
                                        scan-offset-x: root.x - root.parent-x;
                                        scan-offset-y: root.y - root.parent-y;
                                        toggle-select-definition(i) => { PopupBridge.nested-toggle-select-definition(PopupBridge.nested-depth, i); }
                                        open-rich-link(href) => { root.open-rich-link(href); }
                                        focus-glossary => {
                                            if !nested-focus.has-focus {
                                                nested-focus.focus();
                                            }
                                        }
                                    }

                                    if ngrid-row.has-right : DefinitionEntryBody {
                                        width: max(120px, (parent.width - PopupBridge.css-definition-gap) / 2);
                                        res: ngrid-row.right;
                                        scan-depth: PopupBridge.nested-depth;
                                        bridge-rev: PopupBridge.nested-revision;
                                        is-solo: false;
                                        show-anki-checkbox: root.show-anki-checkbox;
                                        tooltip-base-x: root.card-pad + (parent.width + PopupBridge.css-definition-gap) / 2;
                                        tooltip-base-y: nested-definition-list.y + nested-definition-list.viewport-y + nested-row-wrapper.y + 4px + ngrid-container.y + ngrid-row-box.y;
                                        scan-offset-x: root.x - root.parent-x;
                                        scan-offset-y: root.y - root.parent-y;
                                        toggle-select-definition(i) => { PopupBridge.nested-toggle-select-definition(PopupBridge.nested-depth, i); }
                                        open-rich-link(href) => { root.open-rich-link(href); }
                                        focus-glossary => {
                                            if !nested-focus.has-focus {
                                                nested-focus.focus();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Floating Tooltip Overlay inside NestedYomitanPopup
    if PopupBridge.tooltip-visible && PopupBridge.tooltip-text != "" && PopupBridge.nested-depth > 0 : Rectangle {
        property <length> tip-w: min(root.width - 16px, ntip-label.preferred-width + 16px);
        property <length> tip-h: ntip-label.preferred-height + 10px;
        property <length> local-tip-x: PopupBridge.tooltip-x * 1px - (root.x - root.parent-x);
        property <length> local-tip-y: PopupBridge.tooltip-y * 1px - (root.y - root.parent-y);
        x: max(8px, min(root.width - self.tip-w - 8px, self.local-tip-x));
        y: max(8px, min(root.height - self.tip-h - 8px, self.local-tip-y - self.tip-h - 6px));
        width: self.tip-w;
        height: self.tip-h;
        background: #0F172AEE;
        border-width: 1px;
        border-color: #475569;
        border-radius: 4px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #000000AA;
        ntip-label := DictionaryText {
            x: 8px;
            y: 5px;
            width: parent.width - 16px;
            text: PopupBridge.tooltip-text;
            font-size: 12px;
            color: #F8FAFC;
            wrap: word-wrap;
        }
    }

    if root.audio-menu-open : TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.audio-menu-open = false; }
    }

    if root.audio-menu-open : Rectangle {
        x: max(8px, min(parent.width - self.width - 8px, root.audio-menu-x));
        y: max(36px, min(parent.height - self.height - 8px, root.audio-menu-y));
        width: 230px;
        height: min(nsource-items.preferred-height + 12px, parent.height - 75px);
        background: #252A2F;
        border-width: 1px;
        border-color: #52616B;
        border-radius: 4px;
        ScrollView {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            nsource-items := VerticalLayout {
                x: 0px; y: 0px; width: parent.width - 6px; height: self.preferred-height;
                alignment: start;
                if root.audio-sources-loading : DictionaryText {
                    text: "Loading recordings…";
                    height: 24px;
                    color: #94A3B8;
                    vertical-alignment: center;
                }
                if !root.audio-sources-loading && root.audio-sources.length == 0 : DictionaryText {
                    text: "No audio sources available";
                    height: 30px;
                    color: #94A3B8;
                    vertical-alignment: center;
                }
                for source in root.audio-sources : Rectangle {
                    height: 30px;
                    background: nsource-touch.has-hover ? #384046 : transparent;
                    DictionaryText { text: (root.selected-audio-source == source.index ? "✓  " : "   ") + source.name; color: #E2E8F0; vertical-alignment: center; x: 7px; }
                    nsource-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.select-audio-source(source.index);
                            root.audio-menu-open = false;
                            root.play-audio(root.audio-menu-expression, root.audio-menu-reading);
                        }
                    }
                }
            }
        }
    }
}

export component YomitanPopup inherits Rectangle {
    in property <string> headword: "";
    in property <string> reading: "";
    in property <string> pitch-accent: "";
    in property <string> freq-rank: "";
    in property <string> jpdb-rank: "";
    in property <[DictResult]> results;
    in property <bool> has-more-results: false;
    in property <[PopupAudioSource]> audio-sources;
    in property <bool> audio-sources-loading: false;
    in-out property <int> selected-audio-source: -1;
    in-out property <bool> audio-menu-open: false;
    in-out property <string> audio-menu-expression: "";
    in-out property <string> audio-menu-reading: "";
    in-out property <length> audio-menu-x: 210px;
    in-out property <length> audio-menu-y: 62px;
    in property <bool> is-open: false;
    in property <bool> anki-enabled: false;
    in property <bool> show-anki-checkbox: true;
    in property <string> added-note-id: "";
    in property <int> added-result-index: -1;
    in property <bool> render-nested-inline: true;
    callback close-requested();
    callback add-anki-note(int);
    callback browse-anki-note(string);
    callback play-audio(string, string);
    callback request-audio-sources(string, string);
    callback kanji-info(string);
    callback toggle-select-definition(int);
    callback toggle-term-collapse(int);
    callback select-audio-source(int);
    callback open-rich-link(string);
    callback reset-scroll();
    callback load-more-results(bool);
    out property <bool> needs-more: root.is-open && root.has-more-results
        && definition-list.height > 0px
        && definition-list.viewport-height + definition-list.viewport-y <= definition-list.height + 180px;
    property <bool> use-two-columns: PopupBridge.rich-enabled
        && PopupBridge.css-definition-columns >= 2
        && root.width >= PopupBridge.css-definition-columns-min-width;
    property <int> watched-nested-depth: PopupBridge.nested-depth;

    visible: root.is-open && root.results.length > 0;
    width: 480px;
    height: 500px;
    background: PopupBridge.css-popup-bg;
    border-width: PopupBridge.css-popup-border-width;
    border-color: PopupBridge.css-popup-border;
    border-radius: PopupBridge.css-popup-radius;
    drop-shadow-blur: PopupBridge.css-popup-shadow-blur;
    drop-shadow-color: PopupBridge.css-popup-shadow-color;

    changed watched-nested-depth => {
        if root.is-open && !glossary-focus.has-focus {
            glossary-focus.focus();
        }
    }
    changed is-open => {
        root.audio-menu-open = false;
        PopupBridge.hide-tooltip();
        if root.is-open {
            definition-list.viewport-y = 0px;
            definition-list.fill-viewport();
        } else {
            PopupBridge.dismiss-all-nested-popups();
        }
    }
    reset-scroll => {
        definition-list.viewport-y = 0px;
        root.audio-menu-open = false;
        PopupBridge.hide-tooltip();
    }

    // Keep clicks on the card's padding from reaching the video underneath.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && PopupBridge.nested-depth > 0) {
                PopupBridge.dismiss-all-nested-popups();
            }
        }
    }

    glossary-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: PopupBridge.rich-enabled;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (PopupBridge.nested-depth > 0) {
                    PopupBridge.pop-nested-popup();
                    return accept;
                }
                root.close-requested();
                return accept;
            }
            if ((event.modifiers.control || event.modifiers.meta)
                && !event.modifiers.alt
                && (event.text == "c" || event.text == "C")
                && PopupBridge.selected-glossary-text != "")
            {
                PopupBridge.copy-selected-glossary();
                return accept;
            }
            if (PopupBridge.popup-key-pressed(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            )) {
                return accept;
            }
            reject
        }
        key-released(event) => {
            PopupBridge.popup-key-released(
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            );
            reject
        }
    }

    popup-content := VerticalLayout {
        cache-rendering-hint: true;
        padding: PopupBridge.css-popup-padding;
        spacing: 4px;

        // Back / Forward Navigation History Bar (shown when internal navigation occurred)
        if PopupBridge.rich-enabled && (PopupBridge.can-go-back || PopupBridge.can-go-forward) : HorizontalLayout {
            height: 26px;
            spacing: 4px;
            alignment: start;

            Rectangle {
                width: 26px;
                height: 24px;
                border-radius: 3px;
                background: !PopupBridge.can-go-back ? #1F2429 : (nav-back-touch.has-hover ? #384046 : #2B3238);
                DictionaryText {
                    text: "←";
                    font-size: 14px;
                    color: PopupBridge.can-go-back ? #E2E8F0 : #52616B;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                nav-back-touch := TouchArea {
                    enabled: PopupBridge.can-go-back;
                    mouse-cursor: PopupBridge.can-go-back ? pointer : default;
                    clicked => { PopupBridge.nav-back(); }
                }
            }

            Rectangle {
                width: 26px;
                height: 24px;
                border-radius: 3px;
                background: !PopupBridge.can-go-forward ? #1F2429 : (nav-fwd-touch.has-hover ? #384046 : #2B3238);
                DictionaryText {
                    text: "→";
                    font-size: 14px;
                    color: PopupBridge.can-go-forward ? #E2E8F0 : #52616B;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                nav-fwd-touch := TouchArea {
                    enabled: PopupBridge.can-go-forward;
                    mouse-cursor: PopupBridge.can-go-forward ? pointer : default;
                    clicked => { PopupBridge.nav-forward(); }
                }
            }

            if PopupBridge.nav-breadcrumb != "" : DictionaryText {
                text: PopupBridge.nav-breadcrumb;
                font-size: 11px;
                color: #94A3B8;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // Definitions List
        definition-list := ScrollView {
            vertical-stretch: 1;
            callback fill-viewport();
            fill-viewport => {
                if root.needs-more {
                    root.load-more-results(false);
                }
            }
            changed viewport-y => { self.fill-viewport(); PopupBridge.hide-tooltip(); }
            changed viewport-height => { self.fill-viewport(); }
            changed height => { self.fill-viewport(); }
            definition-content := VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                spacing: 0px;
                for res[idx] in root.results : row-wrapper := Rectangle {
                property <bool> hidden-by-grid: root.use-two-columns && !res.term-start;
                property <bool> row-hidden: self.hidden-by-grid || (res.collapsed && !res.term-start);
                width: parent.width - 6px;
                height: self.row-hidden ? 0px : term-segment.height + ((res.term-end || root.use-two-columns || (res.collapsed && res.term-start)) ? 10px : 0px);
                visible: !self.row-hidden;
                background: transparent;
                term-segment := Rectangle {
                    property <int> row-zero-idx: res.index - 1;
                    property <bool> added-this-row: !PopupBridge.last-added-was-nested && root.added-note-id != "" && root.added-result-index == self.row-zero-idx;
                    property <bool> row-is-duplicate:
                        (PopupBridge.popup-revision >= 0)
                        && self.row-zero-idx >= 0
                        && self.row-zero-idx < PopupBridge.row-anki-duplicates.length
                        && PopupBridge.row-anki-duplicates[self.row-zero-idx];
                    property <int> row-anki-note-id:
                        (PopupBridge.popup-revision >= 0)
                        && self.row-zero-idx >= 0
                        && self.row-zero-idx < PopupBridge.row-anki-note-ids.length
                            ? PopupBridge.row-anki-note-ids[self.row-zero-idx]
                            : 0;
                    property <string> row-browse-query:
                        self.added-this-row
                            ? root.added-note-id
                            : ((self.row-zero-idx >= 0 && self.row-zero-idx < PopupBridge.row-anki-browse-queries.length)
                                ? PopupBridge.row-anki-browse-queries[self.row-zero-idx]
                                : "");
                    property <string> row-raw-anki-tags:
                        (PopupBridge.popup-revision >= 0)
                        && self.row-zero-idx >= 0
                        && self.row-zero-idx < PopupBridge.row-anki-tags.length
                            ? PopupBridge.row-anki-tags[self.row-zero-idx]
                            : "";
                    property <bool> show-browse-btn: self.added-this-row || (root.anki-enabled && self.row-is-duplicate);
                    property <bool> show-update-btn: root.anki-enabled && self.row-is-duplicate && self.row-anki-note-id > 0;
                    property <color> term-headword-color: PopupBridge.rich-enabled
                        ? PopupBridge.headword-pitch-color(res.index, PopupBridge.rich-revision)
                        : PopupBridge.css-headword-color;

                    width: parent.width;
                    height: row-wrapper.row-hidden ? 0px : card-content.preferred-height + 10px;
                    background: transparent;
                    if !row-wrapper.row-hidden && res.term-start && res.index > 1 : Rectangle { y: 0px; height: 2px; width: parent.width; background: PopupBridge.css-term-divider-color; }
                    if !row-wrapper.row-hidden && !res.term-end && !res.collapsed && !root.use-two-columns : Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: PopupBridge.css-divider-color; }
                    card-content := VerticalLayout {
                    x: 0px;
                    y: 4px;
                    width: parent.width;
                    height: self.preferred-height;
                    spacing: 4px;

                    if res.term-start : HorizontalLayout {
                        width: parent.width;
                        spacing: 6px;
                        min-height: 34px;
                        property <length> buttons-reserved-w:
                            (PopupBridge.rich-enabled && !res.is-kanji && res.reading != "" && res.reading != res.expression ? 40px : 0px)
                            + (!res.is-kanji && res.has-kanji ? 34px : 0px)
                            + (!res.is-kanji ? 34px : 0px)
                            + (term-segment.show-browse-btn || root.anki-enabled ? 34px : 0px)
                            + (term-segment.show-update-btn ? 34px : 0px)
                            + 34px;
                        property <length> avail-title-w: max(96px, card-content.width - self.buttons-reserved-w);
                        term-title := VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            preferred-width: 0px;
                            spacing: 2px;
                            if !res.is-kanji && res.reading != "" && res.reading != res.expression : DictionaryText {
                                text: res.reading;
                                height: self.preferred-height;
                                wrap: word-wrap;
                                font-family: PopupBridge.css-reading-font-family;
                                font-size: PopupBridge.css-reading-size;
                                color: PopupBridge.css-reading-color;
                            }
                            if PopupBridge.rich-enabled && !res.is-kanji : VerticalLayout {
                                spacing: 1px;
                                for hw-line in PopupBridge.headword-lines(res.expression, avail-title-w / 1px) : HorizontalLayout {
                                    alignment: start;
                                    spacing: 0px;
                                    for ch in hw-line.chars : Rectangle {
                                        width: ch-text.preferred-width;
                                        height: ch-text.preferred-height;
                                        background: ch.is-kanji && ch-touch.has-hover ? #283442 : transparent;
                                        border-radius: 3px;
                                        ch-text := DictionaryText {
                                            text: ch.text;
                                            font-family: PopupBridge.css-headword-font-family;
                                            font-size: PopupBridge.css-headword-size;
                                            font-weight: 700;
                                            color: ch.is-kanji && ch-touch.has-hover ? PopupBridge.css-link-color : term-segment.term-headword-color;
                                        }
                                        ch-touch := TouchArea {
                                            enabled: ch.is-kanji;
                                            mouse-cursor: ch.is-kanji ? pointer : default;
                                            clicked => {
                                                PopupBridge.lookup-kanji-char(res.expression, ch.text);
                                            }
                                        }
                                    }
                                }
                            }
                            if !PopupBridge.rich-enabled || res.is-kanji : DictionaryText {
                                text: res.expression;
                                height: self.preferred-height;
                                wrap: word-wrap;
                                font-family: res.is-kanji ? PopupBridge.css-kanji-font-family : PopupBridge.css-headword-font-family;
                                font-size: res.is-kanji
                                    ? (PopupBridge.css-kanji-font-size > 0px ? PopupBridge.css-kanji-font-size : PopupBridge.css-headword-size * 1.56)
                                    : PopupBridge.css-headword-size;
                                font-weight: 700;
                                color: term-segment.term-headword-color;
                            }

                            // Conjugation derivation steps (#279) — full pills or compact `ⓘ` tooltip pill
                            if PopupBridge.rich-enabled && !res.is-kanji && !PopupBridge.css-compact-derivations : HorizontalLayout {
                                alignment: start;
                                spacing: 2px;
                                for step[step-idx] in PopupBridge.derivation-steps(res.index, PopupBridge.rich-revision) : HorizontalLayout {
                                    spacing: 2px;
                                    if step-idx == 0 : DictionaryText {
                                        text: "« ";
                                        font-family: PopupBridge.css-conj-font-family;
                                        font-size: PopupBridge.css-conj-font-size;
                                        color: #94A3B8;
                                        vertical-alignment: center;
                                    }
                                    step-box := Rectangle {
                                        width: step-lbl.preferred-width + 6px;
                                        height: max(17px, PopupBridge.css-conj-font-size + 6px);
                                        border-radius: 3px;
                                        background: step-touch.has-hover ? #334155 : #252D35;
                                        step-lbl := DictionaryText {
                                            x: 3px;
                                            height: parent.height;
                                            text: step.label;
                                            font-family: PopupBridge.css-conj-font-family;
                                            font-size: PopupBridge.css-conj-font-size;
                                            color: #CBD5E1;
                                            vertical-alignment: center;
                                        }
                                        step-touch := TouchArea {
                                            mouse-cursor: step.description != "" ? help : default;
                                            changed has-hover => {
                                                if self.has-hover && step.description != "" {
                                                    PopupBridge.show-tooltip(
                                                        step.label + ": " + step.description,
                                                        24.0,
                                                        (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 48px) / 1px
                                                    );
                                                } else if !self.has-hover {
                                                    PopupBridge.hide-tooltip();
                                                }
                                            }
                                        }
                                    }
                                    if step.has-arrow : DictionaryText {
                                        text: "←";
                                        font-family: PopupBridge.css-conj-font-family;
                                        font-size: PopupBridge.css-conj-font-size;
                                        color: #64748B;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if PopupBridge.rich-enabled && !res.is-kanji && PopupBridge.css-compact-derivations && PopupBridge.derivation-summary(res.index, PopupBridge.rich-revision) != "" : HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 22px;
                                    height: 18px;
                                    border-radius: 4px;
                                    background: compact-deriv-touch.has-hover ? #334155 : transparent;
                                    DictionaryText {
                                        text: "ⓘ";
                                        font-size: 12px;
                                        color: PopupBridge.css-muted-color;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    compact-deriv-touch := TouchArea {
                                        mouse-cursor: help;
                                        changed has-hover => {
                                            if self.has-hover {
                                                PopupBridge.show-tooltip(
                                                    PopupBridge.derivation-summary(res.index, PopupBridge.rich-revision),
                                                    24.0,
                                                    (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 48px) / 1px
                                                );
                                            } else {
                                                PopupBridge.hide-tooltip();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // `かな` reading-search toggle button
                        if PopupBridge.rich-enabled && !res.is-kanji && res.reading != "" && res.reading != res.expression : Rectangle {
                            width: 34px;
                            height: 28px;
                            border-radius: 3px;
                            background: (PopupBridge.kana-reading-active && PopupBridge.active-kana-reading == res.reading)
                                ? (kana-touch.has-hover ? #0D9488 : #0F766E)
                                : (kana-touch.has-hover ? #384046 : #2B3238);
                            DictionaryText {
                                text: "かな";
                                color: #E2E8F0;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            kana-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    PopupBridge.toggle-kana-reading-search(res.expression, res.reading);
                                }
                            }
                        }

                        if !res.is-kanji && res.has-kanji : Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: kanji-touch.has-hover ? #384046 : transparent;
                            DictionaryText { text: "字"; color: #CBD5E1; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                            kanji-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if PopupBridge.rich-enabled {
                                        PopupBridge.lookup-kanji-char(res.expression, "");
                                    } else {
                                        root.kanji-info(res.expression);
                                    }
                                }
                            }
                        }

                        if !res.is-kanji : audio-btn-box := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: row-audio-touch.has-hover ? #384046 : #2B3238;
                            Image {
                                x: 6px;
                                y: 6px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("icons/volume-on.svg");
                                colorize: #CBD5E1;
                            }
                            row-audio-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { if (!root.audio-menu-open) { root.play-audio(res.expression, res.reading); } }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        root.audio-menu-expression = res.expression;
                                        root.audio-menu-reading = res.reading;
                                        root.audio-menu-x = max(8px, min(root.width - 238px, 12px + audio-btn-box.x - 190px));
                                        root.audio-menu-y = max(36px, min(root.height - 140px, 12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 38px));
                                        root.audio-menu-open = true;
                                        root.request-audio-sources(res.expression, res.reading);
                                    }
                                }
                            }
                        }

                        if term-segment.show-browse-btn : browse-btn-box := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: browse-touch.has-hover ? #385D75 : #24465C;
                            Image {
                                x: 6px;
                                y: 6px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("icons/note-stack.svg");
                                colorize: #BAE6FD;
                            }
                            browse-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (term-segment.row-browse-query != "") {
                                        root.browse-anki-note(term-segment.row-browse-query);
                                    }
                                }
                                changed has-hover => {
                                    if self.has-hover && PopupBridge.rich-enabled {
                                        PopupBridge.show-tooltip(
                                            "Browse in Anki",
                                            (root.width - 140px) / 1px,
                                            (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 38px) / 1px
                                        );
                                    } else if !self.has-hover && PopupBridge.rich-enabled {
                                        PopupBridge.hide-tooltip();
                                    }
                                }
                            }
                        }

                        if term-segment.show-update-btn : update-anki-btn-box := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: update-anki-touch.has-hover ? #785A28 : #5C431D;
                            DictionaryText {
                                text: "↻";
                                color: #FDE68A;
                                font-size: 16px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            update-anki-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if PopupBridge.nested-depth > 0 {
                                        PopupBridge.dismiss-all-nested-popups();
                                    }
                                    PopupBridge.update-anki-note-requested(
                                        term-segment.row-zero-idx,
                                        term-segment.row-anki-note-id,
                                        res.expression,
                                        res.reading,
                                        res.glossary
                                    );
                                }
                                changed has-hover => {
                                    if self.has-hover && PopupBridge.rich-enabled {
                                        PopupBridge.show-tooltip(
                                            "Update existing Anki note",
                                            (root.width - 170px) / 1px,
                                            (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 38px) / 1px
                                        );
                                    } else if !self.has-hover && PopupBridge.rich-enabled {
                                        PopupBridge.hide-tooltip();
                                    }
                                }
                            }
                        }

                        if root.anki-enabled && !term-segment.show-browse-btn : Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: row-anki-touch.has-hover ? #2D624D : #20503E;
                            DictionaryText {
                                text: "+";
                                color: #A7F3D0;
                                font-size: 20px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            row-anki-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add-anki-note(res.index - 1); }
                            }
                        }

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 3px;
                            background: collapse-touch.has-hover ? #384046 : #2B3238;
                            DictionaryText { text: res.collapsed ? "›" : "⌄"; color: #CBD5E1; font-size: 19px; horizontal-alignment: center; vertical-alignment: center; }
                            collapse-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-term-collapse(res.index - 1); } }
                        }
                    }

                    // Term-level deduplicated category-colored tag pills (#220)
                    if !res.collapsed && res.term-start && PopupBridge.rich-enabled && PopupBridge.css-show-term-tags : HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for pill in PopupBridge.term-tag-pills(res.index, PopupBridge.rich-revision) : RichTagPillBadge {
                            pill: pill;
                            anchor-x: 20px;
                            anchor-y: 12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 44px;
                        }
                    }

                    // Existing Anki card tag pills when `show-tag` is enabled (#346)
                    if !res.collapsed && res.term-start && PopupBridge.anki-show-tags && term-segment.row-raw-anki-tags != "" : anki-tag-row := HorizontalLayout {
                        property <[string]> split-tags: PopupBridge.split-anki-tags(term-segment.row-raw-anki-tags);
                        property <[string]> effective-tags: self.split-tags.length > 0 ? self.split-tags : [term-segment.row-raw-anki-tags];
                        spacing: 4px;
                        alignment: start;
                        for anki-tag in self.effective-tags : anki-tag-pill := Rectangle {
                            height: 18px;
                            width: anki-tag-lbl.preferred-width + 12px;
                            background: PopupBridge.css-anki-tag-bg;
                            border-width: 1px;
                            border-color: PopupBridge.css-anki-tag-border;
                            border-radius: 3px;
                            anki-tag-lbl := DictionaryText {
                                x: 6px;
                                width: parent.width - 12px;
                                height: parent.height;
                                text: anki-tag;
                                font-size: 10px;
                                font-weight: 700;
                                color: PopupBridge.css-anki-tag-color;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: PopupBridge.rich-enabled ? help : default;
                                changed has-hover => {
                                    if self.has-hover && PopupBridge.rich-enabled {
                                        PopupBridge.show-tooltip(
                                            "Anki tag: " + anki-tag,
                                            20.0,
                                            (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 44px) / 1px
                                        );
                                    } else if !self.has-hover && PopupBridge.rich-enabled {
                                        PopupBridge.hide-tooltip();
                                    }
                                }
                            }
                        }
                    }

                    if !res.collapsed && res.index == 1 && res.frequencies.length == 0 && (root.jpdb-rank != "" || root.freq-rank != "" || root.pitch-accent != "") : HorizontalLayout {
                        width: parent.width;
                        spacing: 6px;
                        alignment: start;
                        if root.jpdb-rank != "" : DictionaryText { text: "JPDB " + root.jpdb-rank; color: #6EE7B7; font-size: 11px; }
                        if root.freq-rank != "" : DictionaryText { text: root.freq-rank; color: #6EE7B7; font-size: 11px; }
                        if root.pitch-accent != "" : DictionaryText { text: root.pitch-accent; color: #C4B5FD; font-size: 11px; }
                    }

                    if !res.collapsed && res.term-start && res.frequencies.length > 0 : VerticalLayout {
                        width: parent.width;
                        spacing: 3px;
                        for line in PopupLayout.frequency-lines(res.frequencies, self.width / 1px) : HorizontalLayout {
                            width: parent.width;
                            alignment: start;
                            spacing: 4px;
                            for frequency in line.entries : Rectangle {
                                property <PopupFreqStyle> fstyle: PopupBridge.rich-enabled
                                    ? PopupBridge.freq-badge-style(frequency.dictionary, PopupBridge.rich-revision)
                                    : { bg: PopupBridge.css-freq-bg, color: PopupBridge.css-freq-color };
                                width: min(frequency-label.preferred-width + 10px, parent.width);
                                height: max(18px, frequency-label.preferred-height + 2px);
                                background: self.fstyle.bg;
                                border-radius: 3px;
                                frequency-label := DictionaryText {
                                    x: 5px;
                                    width: parent.width - 10px;
                                    height: parent.height;
                                    text: frequency.dictionary + " " + frequency.value;
                                    font-size: PopupBridge.css-freq-font-size;
                                    color: parent.fstyle.color;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // Rich pitch graphs with nasal (`゜`/ring) & devoice (dotted circle) markers
                    if !res.collapsed && res.term-start && PopupBridge.rich-enabled : VerticalLayout {
                        spacing: 4px;
                        for pitch in PopupBridge.rich-pitch-graphs(res.index, PopupBridge.rich-revision) : Rectangle {
                            width: parent.width;
                            height: 30px;
                            background: transparent;
                            HorizontalLayout {
                                width: parent.width;
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                if PopupBridge.css-show-pitch-dict : Rectangle {
                                    height: 20px;
                                    y: 5px;
                                    width: min(pitch-dict-lbl.preferred-width + 10px, parent.width * 0.42);
                                    background: PopupBridge.pitch-dict-bg(pitch.dictionary, PopupBridge.rich-revision);
                                    border-radius: 3px;
                                    pitch-dict-lbl := DictionaryText {
                                        x: 5px;
                                        width: parent.width - 10px;
                                        height: parent.height;
                                        text: pitch.dictionary + " [" + pitch.position + "]";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                HorizontalLayout {
                                    width: self.preferred-width;
                                    height: 30px;
                                    horizontal-stretch: 0;
                                    spacing: 0px;
                                    for mora in pitch.mora : Rectangle {
                                        width: max(20px, rich-mora-lbl.preferred-width + 6px);
                                        height: 30px;
                                        Rectangle { x: 0px; y: mora.high ? 3px : 11px; width: parent.width; height: 1.5px; background: PopupBridge.css-pitch-color; }
                                        if mora.rises-after || mora.falls-after : Rectangle { x: parent.width - 1.5px; y: 3px; width: 1.5px; height: 9.5px; background: PopupBridge.css-pitch-color; }
                                        if mora.devoice : Image {
                                            x: (parent.width - 18px) / 2;
                                            y: 11px;
                                            width: 18px;
                                            height: 18px;
                                            source: PopupBridge.devoice-circle-image();
                                        }
                                        rich-mora-lbl := DictionaryText {
                                            text: mora.text;
                                            y: 13px;
                                            horizontal-alignment: center;
                                            width: parent.width;
                                            font-size: 11px;
                                            color: mora.devoice ? #FCA5A5 : PopupBridge.css-text-color;
                                        }
                                        if mora.nasal : Rectangle {
                                            x: parent.width - 6px;
                                            y: 11px;
                                            width: 5px;
                                            height: 5px;
                                            border-radius: 2.5px;
                                            border-width: 1.2px;
                                            border-color: #FBBF24;
                                            background: PopupBridge.css-popup-bg;
                                        }
                                        if mora.nasal || mora.devoice : TouchArea {
                                            mouse-cursor: help;
                                            changed has-hover => {
                                                if self.has-hover {
                                                    PopupBridge.show-tooltip(
                                                        mora.nasal && mora.devoice
                                                            ? "Nasalized & devoiced mora (鼻濁音・母音無声化)"
                                                            : (mora.nasal ? "Nasalized mora (鼻濁音 ゜)" : "Devoiced mora (母音無声化)"),
                                                        30.0,
                                                        (12px + definition-list.y + definition-list.viewport-y + row-wrapper.y + 64px) / 1px
                                                    );
                                                } else {
                                                    PopupBridge.hide-tooltip();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Fallback pitch graphs when rich bridge has none or is disabled
                    if !res.collapsed && res.term-start && (!PopupBridge.rich-enabled || PopupBridge.rich-pitch-graphs(res.index, PopupBridge.rich-revision).length == 0) : VerticalLayout {
                        spacing: 4px;
                        for pitch in res.pitch-graphs : Rectangle {
                            width: parent.width;
                            height: 28px;
                            background: transparent;
                            HorizontalLayout {
                                width: parent.width;
                                height: 28px;
                                spacing: 8px;
                                alignment: start;
                                DictionaryText {
                                    text: pitch.dictionary + " [" + pitch.position + "]";
                                    width: min(self.preferred-width, parent.width * 0.4);
                                    horizontal-stretch: 0;
                                    font-size: 11px;
                                    color: #C4B5FD;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    width: self.preferred-width;
                                    height: 28px;
                                    horizontal-stretch: 0;
                                    spacing: 0px;
                                    for mora in pitch.mora : Rectangle {
                                        width: max(18px, mora-label.preferred-width + 3px);
                                        height: 28px;
                                        Rectangle { x: 0px; y: mora.high ? 3px : 11px; width: parent.width; height: 1px; background: PopupBridge.css-pitch-color; }
                                        if mora.rises-after || mora.falls-after : Rectangle { x: parent.width - 1px; y: 3px; width: 1px; height: 9px; background: PopupBridge.css-pitch-color; }
                                        mora-label := DictionaryText { text: mora.text; y: 13px; horizontal-alignment: center; width: parent.width; font-size: 10px; color: PopupBridge.css-text-color; }
                                    }
                                }
                            }
                        }
                    }

                    // Single-column definition body (default)
                    if !res.collapsed && !root.use-two-columns : DefinitionEntryBody {
                        width: parent.width;
                        res: res;
                        scan-depth: 0;
                        bridge-rev: PopupBridge.rich-revision;
                        is-solo: res.term-start && res.term-end;
                        show-anki-checkbox: root.show-anki-checkbox;
                        tooltip-base-x: PopupBridge.css-popup-padding;
                        tooltip-base-y: definition-list.y + definition-list.viewport-y + row-wrapper.y + 4px + self.y;
                        toggle-select-definition(i) => { root.toggle-select-definition(i); }
                        open-rich-link(href) => { root.open-rich-link(href); }
                        focus-glossary => {
                            if !glossary-focus.has-focus {
                                glossary-focus.focus();
                            }
                        }
                    }

                    // Responsive 2-column card grid (enabled by `--definition-columns: 2` when width >= min-width)
                    if !res.collapsed && res.term-start && root.use-two-columns : grid-container := VerticalLayout {
                        width: parent.width;
                        spacing: PopupBridge.css-definition-gap;
                        for grid-row in PopupBridge.definition-grid-rows(root.results, res.index) : grid-row-box := HorizontalLayout {
                            width: parent.width;
                            spacing: PopupBridge.css-definition-gap;
                            alignment: start;

                            DefinitionEntryBody {
                                width: grid-row.is-solo ? parent.width : max(120px, (parent.width - PopupBridge.css-definition-gap) / 2);
                                res: grid-row.left;
                                scan-depth: 0;
                                bridge-rev: PopupBridge.rich-revision;
                                is-solo: grid-row.is-solo;
                                show-anki-checkbox: root.show-anki-checkbox;
                                tooltip-base-x: PopupBridge.css-popup-padding;
                                tooltip-base-y: definition-list.y + definition-list.viewport-y + row-wrapper.y + 4px + grid-container.y + grid-row-box.y;
                                toggle-select-definition(i) => { root.toggle-select-definition(i); }
                                open-rich-link(href) => { root.open-rich-link(href); }
                                focus-glossary => {
                                    if !glossary-focus.has-focus {
                                        glossary-focus.focus();
                                    }
                                }
                            }

                            if grid-row.has-right : DefinitionEntryBody {
                                width: max(120px, (parent.width - PopupBridge.css-definition-gap) / 2);
                                res: grid-row.right;
                                scan-depth: 0;
                                bridge-rev: PopupBridge.rich-revision;
                                is-solo: false;
                                show-anki-checkbox: root.show-anki-checkbox;
                                tooltip-base-x: PopupBridge.css-popup-padding + (parent.width + PopupBridge.css-definition-gap) / 2;
                                tooltip-base-y: definition-list.y + definition-list.viewport-y + row-wrapper.y + 4px + grid-container.y + grid-row-box.y;
                                toggle-select-definition(i) => { root.toggle-select-definition(i); }
                                open-rich-link(href) => { root.open-rich-link(href); }
                                focus-glossary => {
                                    if !glossary-focus.has-focus {
                                        glossary-focus.focus();
                                    }
                                }
                            }
                        }
                    }

                    }
                }
                }
            }
        }
    }

    // Inline Nested Child Popup fallback (used when `render-nested-inline: true`; in full app
    // `ui/app.slint` mounts `NestedYomitanPopup` directly in the viewport with `render-nested-inline: false`
    // so child popups float freely at full popup size overlapping/extending beyond the parent).
    if root.render-nested-inline : nested-popup-card := NestedYomitanPopup {
        is-open: root.is-open;
        inline-mode: true;
        viewport-width: root.width;
        viewport-height: root.height;
        parent-x: 0px;
        parent-y: 0px;
        configured-width: root.width;
        configured-height: root.height;
        anki-enabled: root.anki-enabled;
        show-anki-checkbox: root.show-anki-checkbox;
        added-note-id: root.added-note-id;
        added-result-index: root.added-result-index;
        audio-sources: root.audio-sources;
        audio-sources-loading: root.audio-sources-loading;
        selected-audio-source: root.selected-audio-source;
        browse-anki-note(id) => { root.browse-anki-note(id); }
        play-audio(word, reading) => { root.play-audio(word, reading); }
        request-audio-sources(word, reading) => { root.request-audio-sources(word, reading); }
        select-audio-source(idx) => { root.select-audio-source(idx); }
        open-rich-link(href) => { root.open-rich-link(href); }
        close-parent-requested => { root.close-requested(); }
    }

    // Floating Tooltip Overlay (for title attributes, <ruby> readings, tag notes, conjugation derivations #279)
    if PopupBridge.tooltip-visible && PopupBridge.tooltip-text != "" && PopupBridge.nested-depth == 0 : Rectangle {
        property <length> tip-w: min(root.width - 16px, tip-label.preferred-width + 16px);
        property <length> tip-h: tip-label.preferred-height + 10px;
        x: max(8px, min(root.width - self.tip-w - 8px, PopupBridge.tooltip-x * 1px));
        y: max(8px, min(root.height - self.tip-h - 8px, PopupBridge.tooltip-y * 1px - self.tip-h - 6px));
        width: self.tip-w;
        height: self.tip-h;
        background: #0F172AEE;
        border-width: 1px;
        border-color: #475569;
        border-radius: 4px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #000000AA;
        tip-label := DictionaryText {
            x: 8px;
            y: 5px;
            width: parent.width - 16px;
            text: PopupBridge.tooltip-text;
            font-size: 12px;
            color: #F8FAFC;
            wrap: word-wrap;
        }
    }

    if root.audio-menu-open : TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.audio-menu-open = false; }
    }

    if root.audio-menu-open : Rectangle {
        x: max(8px, min(parent.width - self.width - 8px, root.audio-menu-x));
        y: max(36px, min(parent.height - self.height - 8px, root.audio-menu-y));
        width: 230px;
        height: min(source-items.preferred-height + 12px, parent.height - 75px);
        background: #252A2F;
        border-width: 1px;
        border-color: #52616B;
        border-radius: 4px;
        source-scroll := ScrollView {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            source-items := VerticalLayout {
                x: 0px; y: 0px; width: parent.width - 6px; height: self.preferred-height;
                alignment: start;
                if root.audio-sources-loading : DictionaryText {
                    text: "Loading recordings…";
                    height: 24px;
                    color: #94A3B8;
                    vertical-alignment: center;
                }
                if !root.audio-sources-loading && root.audio-sources.length == 0 : DictionaryText {
                    text: "No audio sources available";
                    height: 30px;
                    color: #94A3B8;
                    vertical-alignment: center;
                }
                for source in root.audio-sources : Rectangle {
                    height: 30px;
                    background: source-touch.has-hover ? #384046 : transparent;
                    DictionaryText { text: (root.selected-audio-source == source.index ? "✓  " : "   ") + source.name; color: #E2E8F0; vertical-alignment: center; x: 7px; }
                    source-touch := TouchArea { mouse-cursor: pointer; clicked => {
                        root.select-audio-source(source.index);
                        root.audio-menu-open = false;
                        root.play-audio(root.audio-menu-expression, root.audio-menu-reading);
                    } }
                }
            }
        }
    }
}

// ── Manual Dictionary Search ───────────────────────────────────────────────
export component DictionarySearchPanel inherits Rectangle {
    in property <[DictResult]> results;
    in-out property <string> query: "";
    callback search-changed(string);
    callback lookup(string);
    callback close();

    private property <[DictResult]> active-results: PopupBridge.rich-enabled ? PopupBridge.panel-results : root.results;

    background: MementoPalette.surface-bg;
    border-color: MementoPalette.border;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "Search";
                font-size: 16px;
                font-weight: 700;
                color: #F1F5F9;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if PopupBridge.rich-enabled : Rectangle {
                width: 38px;
                height: 26px;
                border-radius: 4px;
                background: PopupBridge.panel-kana-only
                    ? (panel-kana-touch.has-hover ? #0D9488 : #0F766E)
                    : (panel-kana-touch.has-hover ? #384046 : #252A30);
                DictionaryText {
                    text: "かな";
                    font-size: 11px;
                    font-weight: 700;
                    color: #F1F5F9;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                panel-kana-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { PopupBridge.panel-toggle-kana-only(); }
                }
            }
            Button { text: "×"; clicked => { root.close(); } }
        }

        if PopupBridge.rich-enabled : LineEdit {
            placeholder-text: PopupBridge.panel-kana-only ? "Search by reading (かな)…" : "Search Japanese…";
            text <=> PopupBridge.panel-query;
            edited(value) => { PopupBridge.panel-search-requested(value); }
        }
        if !PopupBridge.rich-enabled : LineEdit {
            placeholder-text: "Search Japanese…";
            text <=> root.query;
            edited(value) => { root.search-changed(value); }
        }

        if PopupBridge.rich-enabled && PopupBridge.panel-searching : HorizontalLayout {
            height: 18px;
            spacing: 6px;
            alignment: start;
            Rectangle {
                y: 5px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: #38BDF8;
            }
            DictionaryText {
                text: "Searching…";
                font-size: 11px;
                color: #94A3B8;
                vertical-alignment: center;
            }
        }

        ListView {
            for hit[index] in root.active-results : Rectangle {
                height: 124px;
                clip: true;
                border-radius: 5px;
                background: result-touch.has-hover ? MementoPalette.list-hover : transparent;
                VerticalLayout {
                    height: parent.height;
                    padding: 7px;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 8px;
                        DictionaryText {
                            text: hit.expression;
                            font-size: 18px;
                            font-weight: 700;
                            color: #F8FAFC;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        DictionaryText {
                            text: hit.reading;
                            font-size: 12px;
                            color: #94A3B8;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    DictionaryText {
                        text: hit.dict-name;
                        font-size: 11px;
                        color: #72C9B9;
                        overflow: elide;
                    }
                    DictionaryText {
                        text: hit.glossary;
                        font-size: 12px;
                        color: #E2E8F0;
                        wrap: word-wrap;
                        overflow: elide;
                        vertical-stretch: 1;
                        vertical-alignment: top;
                    }
                }
                result-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        if PopupBridge.rich-enabled {
                            PopupBridge.panel-lookup-requested(hit.expression);
                        } else {
                            root.lookup(hit.expression);
                        }
                    }
                }
            }
        }
    }
}
